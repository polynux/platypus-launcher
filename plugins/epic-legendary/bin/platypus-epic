#!/usr/bin/env python3
"""Platypus store plugin for the Epic Games Store, wrapping legendary.

Speaks Platypus's plugin protocol (api 1, docs/plugins/protocol.md): JSON-RPC 2.0
over stdin/stdout, one object per line. Everything store-specific is done by
the `legendary` CLI, which keeps the user's login in ~/.config/legendary; this
plugin never sees or stores credentials beyond passing the one-time
authorization code to `legendary auth`.

It only installs and launches games the logged-in account owns, through
Epic's own APIs. Launch specs carry Epic's normal launch arguments (an
exchange code for the game's online services), and Platypus runs the game
through its own runner pipeline.
"""

import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time

API = 1
CODE_AUTH_REQUIRED = -32001
LOGIN_URL = "https://legendary.gl/epiclogin"
NOT_LOGGED_IN = "<not logged in>"

# Env keys Platypus refuses in launch specs (see internal/stores/launchspec.go).
# legendary adds WINEPREFIX and friends from its own config; Platypus owns those.
DENIED_ENV_PREFIXES = ("LD_", "DYLD_", "WINE", "PROTON_", "STEAM_COMPAT_", "VK_",
                       "__EGL_", "__GLX_", "LIBGL_", "GST_", "GTK_", "GIO_", "QT_",
                       "XDG_", "PYTHON", "PERL", "RUBY", "NODE_")
DENIED_ENV = {"PATH", "HOME", "USER", "LOGNAME", "SHELL", "IFS", "ENV", "BASH_ENV",
              "TMPDIR", "GCONV_PATH", "MANGOHUD_CONFIGFILE", "MANGOHUD_CONFIG"}

out_lock = threading.Lock()
jobs_lock = threading.Lock()
jobs = {}  # jobId -> {"proc": Popen, "canceled": bool}


class RPCError(Exception):
    def __init__(self, message, code=-32000):
        super().__init__(message)
        self.code = code


def send(msg):
    msg["jsonrpc"] = "2.0"
    line = json.dumps(msg, separators=(",", ":"))
    with out_lock:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()


def notify(method, params):
    send({"method": method, "params": params})


def log(level, message):
    notify("log", {"level": level, "message": message})


def legendary(*args, timeout=300):
    """Runs legendary and returns (exit code, stdout, stderr)."""
    try:
        p = subprocess.run(["legendary", *args], stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, timeout=timeout)
    except FileNotFoundError:
        raise RPCError("legendary is not installed (uv tool install legendary-gl)")
    except subprocess.TimeoutExpired:
        raise RPCError(f"legendary {args[0]} timed out")
    return p.returncode, p.stdout, p.stderr


def tail(text, n=3):
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    return " · ".join(lines[-n:]) if lines else "no output"


def legendary_json(*args, timeout=300):
    code, out, err = legendary(*args, timeout=timeout)
    if code != 0:
        if "Login failed" in err or "not logged in" in err.lower():
            raise RPCError("log in to Epic first", CODE_AUTH_REQUIRED)
        raise RPCError(f"legendary {args[0]} failed: {tail(err)}")
    try:
        return json.loads(out)
    except ValueError:
        raise RPCError(f"legendary {args[0]} printed no JSON: {tail(err)}")


# --- auth ---------------------------------------------------------------

def auth_status(_params=None):
    status = legendary_json("status", "--json", "--offline", timeout=60)
    account = status.get("account") or NOT_LOGGED_IN
    if account == NOT_LOGGED_IN:
        return {"loggedIn": False}
    return {"loggedIn": True, "user": account}


def auth_begin(_params):
    return {
        "url": LOGIN_URL,
        "instructions": "Log in to Epic in your browser. The page then shows a short JSON "
                        "response: copy the authorizationCode value (or the whole response) here.",
        "fields": [{"id": "code", "label": "authorizationCode", "placeholder": "32 characters", "secret": True}],
    }


def auth_complete(params):
    code = ((params or {}).get("fields") or {}).get("code", "").strip()
    if code.startswith("{"):
        try:
            code = json.loads(code).get("authorizationCode", "")
        except ValueError:
            raise RPCError("that isn't the JSON response from the login page")
    code = code.strip().strip('"')
    if not re.fullmatch(r"[A-Za-z0-9]{8,128}", code):
        raise RPCError("the authorization code should be letters and digits only")
    # NOTE (PLUG-3): the one-time code travels on argv, visible in ps(1)
    # while auth runs. legendary offers no stdin/env alternative for --code
    # (see `legendary auth --help`), so this is upstream-limited; the code is
    # short-lived, single-use, and never logged (only the CLI's tail is kept).
    rc, _out, err = legendary("auth", "--code", code, "--disable-webview", timeout=120)
    status = auth_status()
    if rc != 0 or not status["loggedIn"]:
        raise RPCError(f"login failed: {tail(err)}")
    return status


def auth_logout(_params):
    legendary("auth", "--delete", timeout=60)
    return auth_status()


# --- library ------------------------------------------------------------

def key_image(meta, *types):
    images = (meta or {}).get("keyImages") or []
    for t in types:
        for img in images:
            if img.get("type") == t and img.get("url"):
                return img["url"]
    return ""


def custom_attr(meta, name):
    return (((meta or {}).get("customAttributes") or {}).get(name) or {}).get("value")


def installed_games():
    try:
        games = legendary_json("list-installed", "--json", timeout=120)
    except RPCError:
        return {}
    return {g["app_name"]: g for g in games if g.get("app_name") and not g.get("is_dlc")}


def library_list(_params):
    if not auth_status()["loggedIn"]:
        raise RPCError("log in to Epic first", CODE_AUTH_REQUIRED)
    owned = legendary_json("list", "--json", timeout=600)
    installed = installed_games()
    games = []
    seen = set()
    for g in owned:
        app = g.get("app_name")
        meta = g.get("metadata") or {}
        if not app or "mainGameItem" in meta:  # DLC
            continue
        seen.add(app)
        assets = g.get("asset_infos") or {}
        latest = (assets.get("Windows") or {}).get("build_version", "")
        entry = {
            "id": app,
            "title": g.get("app_title") or app,
            "installed": False,
            "installable": "Windows" in assets,
            "coverUrl": key_image(meta, "DieselGameBoxTall", "OfferImageTall", "Thumbnail"),
            "heroUrl": key_image(meta, "DieselGameBox", "OfferImageWide"),
            "bannerUrl": key_image(meta, "DieselGameBox", "OfferImageWide"),
            "version": latest,
        }
        store = custom_attr(meta, "ThirdPartyManagedApp") or custom_attr(meta, "ThirdPartyManagedProvider")
        if store:
            entry["installable"] = False
            entry["note"] = f"Installed and launched through {store}; Platypus can't install it."
        elif custom_attr(meta, "partnerLinkType") == "ubisoft":
            entry["note"] = "Needs Ubisoft Connect at runtime."
        elif not entry["installable"]:
            entry["note"] = "No Windows build available through legendary."
        add_installed(entry, installed.get(app), latest)
        games.append(entry)
    for app, ig in installed.items():  # installed but missing from the owned list
        if app not in seen:
            entry = {"id": app, "title": ig.get("title") or app, "installable": False}
            add_installed(entry, ig, "")
            games.append(entry)
    return {"games": games}


def game_details(params):
    """Game page metadata from Epic's catalogue entry, which library.list
    already carries. Epic's achievements are per user, and legendary's offline
    status has no progress, so they are only listed when the catalogue has
    them ("achievements" in list --json)."""
    app = params["id"]
    owned = legendary_json("list", "--json", timeout=600)
    g = next((g for g in owned if g.get("app_name") == app), None)
    if not g:
        raise RPCError(f"{app} is not in your Epic library")
    meta = g.get("metadata") or {}
    out = {
        "summary": ((meta.get("description") or "").split("\n")[0]).strip(),
        "genres": [c.get("value", "") for c in meta.get("categories") or [] if c.get("value")][:4],
        "developers": [d.get("value", "") for d in meta.get("developer") or [] if d.get("value")],
        "publishers": [p.get("value", "") for p in meta.get("publisher") or [] if p.get("value")],
        "releaseDate": (meta.get("releaseDate") or "")[:10],
        "heroUrl": key_image(meta, "DieselGameBox", "OfferImageWide"),
    }
    screenshots = [i["url"] for i in meta.get("keyImages") or []
                   if i.get("type") in ("Screenshot", "DieselGameBoxMedia") and i.get("url")]
    if screenshots:
        out["screenshots"] = screenshots[:6]
    ach = g.get("achievements") or {}
    entries = (ach.get("achievement_set") or {}).get("achievements") or []
    if ach and entries:
        out["achievements"] = {
            "total": (ach.get("achievement_set") or {}).get("achievements_count", len(entries)),
            "list": [{"id": e.get("id", ""), "name": e.get("displayName", ""),
                      "description": e.get("description", ""),
                      "icon": ((e.get("icons") or [{}])[0].get("url") or "")}
                     for e in entries[:10]],
        }
    return out


def add_installed(entry, ig, latest):
    if not ig:
        return
    entry["installed"] = True
    entry["installPath"] = ig.get("install_path", "")
    entry["sizeBytes"] = int(ig.get("install_size") or 0)
    entry["version"] = ig.get("version", "")
    entry["updateAvailable"] = bool(latest) and latest != ig.get("version")


def install_size(params):
    info = legendary_json("info", params["id"], "--json", timeout=300)
    m = info.get("manifest") or {}
    return {"downloadBytes": int(m.get("download_size") or 0), "diskBytes": int(m.get("disk_size") or 0)}


# --- jobs ---------------------------------------------------------------

PROGRESS_RE = re.compile(r"= Progress: ([\d.]+)%")
DOWNLOADED_RE = re.compile(r"- Downloaded: ([\d.]+) MiB")
SPEED_RE = re.compile(r"\+ Download\s+- ([\d.]+) MiB/s \(raw\)")
DLSIZE_RE = re.compile(r"Download size: ([\d.]+) MiB")
MIB = 1024 * 1024


def start_job(params, kind):
    app, job_id = params["id"], params["jobId"]
    if kind == "install":
        args = ["-y", "install", app, "--base-path", params["installDir"], "--skip-sdl", "--platform", "Windows"]
    elif kind == "update":
        args = ["-y", "install", app, "--update-only", "--skip-sdl"]
    else:
        args = ["-y", "uninstall", app]
    # Platypus resends a job with the same jobId after a crash: run it once. A job
    # just paused or canceled is still stopping: wait, then let legendary pick
    # up from its resume file.
    if not claim_job(job_id, {"proc": None, "canceled": False}):
        return {}
    job_started(job_id, app, kind, params.get("installDir") or "")
    try:
        proc = subprocess.Popen(["legendary", *args], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True, bufsize=1)
    except FileNotFoundError:
        with jobs_lock:
            jobs.pop(job_id, None)
        raise RPCError("legendary is not installed (uv tool install legendary-gl)")
    with jobs_lock:
        job = jobs.setdefault(job_id, {"canceled": False})
        job["proc"] = proc
        canceled = job["canceled"]
    threading.Thread(target=follow_job, args=(job_id, kind, proc), daemon=True).start()
    if canceled:  # job.cancel arrived while the process was starting
        stop_proc(proc, grace=5)
    return {}


def follow_job(job_id, kind, proc):
    state = {"jobId": job_id, "phase": "uninstalling" if kind == "uninstall" else "preparing"}
    recent = []
    for line in proc.stdout:
        line = line.rstrip()
        if not line:
            continue
        recent = (recent + [line])[-5:]
        changed = False
        if m := DLSIZE_RE.search(line):
            state["total"] = int(float(m.group(1)) * MIB)
        if m := PROGRESS_RE.search(line):
            state["percent"] = float(m.group(1))
            state["phase"] = "downloading"
            changed = True
        if m := DOWNLOADED_RE.search(line):
            state["bytes"] = int(float(m.group(1)) * MIB)
        if m := SPEED_RE.search(line):
            state["speed"] = float(m.group(1)) * MIB
            changed = True
        if changed:
            notify("job.progress", dict(state))
    rc = proc.wait()
    with jobs_lock:
        canceled = jobs.pop(job_id, {}).get("canceled", False)
    if canceled:
        job_stopped(job_id)
        return
    if rc == 0:
        job_finished(job_id)
        notify("job.done", {"jobId": job_id})
    else:
        job_stopped(job_id)
        notify("job.failed", {"jobId": job_id, "error": " · ".join(recent[-3:]) or f"legendary exited with {rc}"})


def claim_job(job_id, entry, timeout=90):
    """Registers entry as the run of job_id and returns True. False when the
    job is already running (a repeated start). A job that job.cancel just
    stopped is still shutting down legendary: wait for it to go, so a resume
    with the same jobId doesn't lose to the old run and report nothing."""
    deadline = time.monotonic() + timeout
    while True:
        with jobs_lock:
            job = jobs.get(job_id)
            if job is None:
                jobs[job_id] = entry
                return True
            if not job.get("canceled"):
                return False
        if time.monotonic() > deadline:
            raise RPCError("the previous run of this download is still stopping; try again in a moment")
        time.sleep(0.05)


def stop_proc(proc, grace=15):
    """SIGINT lets legendary save its resume state; SIGKILL if it hangs.

    legendary stays in the plugin's process group, so if the plugin itself
    dies, Platypus's group kill takes legendary with it."""
    try:
        proc.send_signal(signal.SIGINT)
        proc.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        proc.kill()
    except ProcessLookupError:
        pass


def job_cancel(params):
    with jobs_lock:
        job = jobs.get(params.get("jobId"))
        if job:
            job["canceled"] = True
    if job:
        threading.Thread(target=stop_proc, args=(job["proc"],), daemon=True).start()
    return {}


# --- discarding a canceled job's data ---------------------------------------
# legendary keeps a download cache in the game folder it installs into
# (<base>/<game>/.cache) and a resume file in its config folder
# (tmp/<app>.resume); a canceled install leaves both. The plugin can't know the
# game folder's name before legendary has made it, so it remembers which
# folders appeared in the install folder while an install job ran
# ($PLATYPUS_PLUGIN_DATA/jobs-meta.json) and job.discard deletes exactly those,
# never one that is installed.

meta_lock = threading.RLock()
JOB_ID_RE = re.compile(r"[A-Za-z0-9_-]{1,64}")
APP_RE = re.compile(r"[A-Za-z0-9_.-]{1,128}")


def meta_file():
    return os.path.join(os.environ.get("PLATYPUS_PLUGIN_DATA") or ".", "jobs-meta.json")


def load_meta():
    try:
        with open(meta_file()) as f:
            meta = json.load(f)
        return meta if isinstance(meta, dict) else {}
    except (OSError, ValueError):
        return {}


def save_meta(meta):
    path = meta_file()
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    tmp = path + ".new"
    with open(tmp, "w") as f:
        json.dump(meta, f)
    os.replace(tmp, path)


def list_dir(path):
    try:
        return sorted(os.listdir(path))
    except OSError:
        return []


def installed_dirs():
    return [os.path.realpath(g["install_path"]) for g in installed_games().values() if g.get("install_path")]


def claim_new_dirs(meta, m):
    """Attributes to the job the folders that showed up since it began and that
    nothing else accounts for: not there before, not another job's, not installed."""
    taken = set(m["pre"]) | set(m["dirs"])
    for o in meta.values():
        if o is not m and o.get("installDir") == m["installDir"]:
            taken |= set(o.get("dirs", []))
    installed = installed_dirs()
    for name in list_dir(m["installDir"]):
        path = os.path.realpath(os.path.join(m["installDir"], name))
        if name in taken or path in installed:
            continue
        m["dirs"].append(name)


def job_started(job_id, app, kind, install_dir):
    if kind != "install" or not install_dir:
        return
    with meta_lock:
        meta = load_meta()
        m = meta.get(job_id)
        if m is None:
            meta[job_id] = {"app": app, "installDir": install_dir, "pre": list_dir(install_dir), "dirs": []}
        else:
            claim_new_dirs(meta, m)  # a run that was cut short, now resuming
        try:
            save_meta(meta)
        except OSError as e:
            log("warn", f"couldn't record job {job_id}: {e}")


def job_stopped(job_id):
    """The run ended without finishing: note what it left."""
    with meta_lock:
        meta = load_meta()
        m = meta.get(job_id)
        if m is None:
            return
        claim_new_dirs(meta, m)
        try:
            save_meta(meta)
        except OSError:
            pass


def job_finished(job_id):
    with meta_lock:
        meta = load_meta()
        if meta.pop(job_id, None) is not None:
            try:
                save_meta(meta)
            except OSError:
                pass


def resume_file(app):
    """legendary's resume file for an app, in its config folder."""
    if not isinstance(app, str) or not APP_RE.fullmatch(app):
        return None
    cfg = os.environ.get("LEGENDARY_CONFIG_PATH")
    if not cfg:
        base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
        cfg = os.path.join(base, "legendary")
    return os.path.join(cfg, "tmp", app + ".resume")


def job_discard(params):
    """Deletes the partial install of a job that was canceled: the folders it
    created in the install folder, and legendary's resume file. Updates and
    anything installed are left (an update only loses its resume file)."""
    job_id = params.get("jobId")
    if not isinstance(job_id, str) or not JOB_ID_RE.fullmatch(job_id):
        raise RPCError("invalid jobId", -32602)
    job_cancel({"jobId": job_id})
    deadline = time.monotonic() + 90
    while True:  # the job may still be shutting down
        with jobs_lock:
            running = job_id in jobs
        if not running:
            break
        if time.monotonic() > deadline:
            raise RPCError("the download is still stopping; try again in a moment")
        time.sleep(0.05)
    with meta_lock:
        meta = load_meta()
        m = meta.pop(job_id, None)
        if m is not None:
            if params.get("kind", "install") == "install" and m.get("installDir") == params.get("installDir"):
                claim_new_dirs({**meta, job_id: m}, m)
                remove_job_dirs(m)
            try:
                save_meta(meta)
            except OSError:
                pass
    rf = resume_file(params.get("id") or (m or {}).get("app"))
    if rf:
        try:
            os.unlink(rf)
        except OSError:
            pass
    return {}


def remove_job_dirs(m):
    base = os.path.realpath(m["installDir"])
    installed = installed_dirs()
    for name in m.get("dirs", []):
        if not isinstance(name, str) or name in ("", ".", "..") or "/" in name:
            continue
        path = os.path.join(base, name)
        real = os.path.realpath(path)
        if os.path.islink(path) or not os.path.isdir(path) or os.path.dirname(real) != base:
            continue
        if any(i == real or i.startswith(real + os.sep) or real.startswith(i + os.sep) for i in installed):
            log("warn", f"not deleting {path}: it holds an installed game")
            continue
        shutil.rmtree(path, ignore_errors=True)


# --- launch -------------------------------------------------------------

def launch_spec(params):
    app = params["id"]
    preview = bool(params.get("preview"))
    ig = installed_games().get(app)
    if not ig:
        raise RPCError(f"{app} is not installed")
    args = ["launch", app, "--json"]
    if preview:
        # No exchange code and no update check just to show a command.
        args += ["--offline", "--skip-version-check"]
    code, out, err = legendary(*args, timeout=120)
    if code != 0:
        if "out of date" in err:
            raise RPCError("this game has an update; update it before playing")
        raise RPCError(f"legendary launch failed: {tail(err)}")
    try:
        p = json.loads(out)
    except ValueError:
        raise RPCError(f"legendary launch printed no JSON: {tail(err)}")
    exe = os.path.join(p.get("game_directory", ""), p.get("game_executable", ""))
    env = {k: v for k, v in (p.get("environment") or {}).items()
           if k.upper() not in DENIED_ENV and not k.upper().startswith(DENIED_ENV_PREFIXES)}
    return {
        "exe": exe,
        "args": (p.get("game_parameters") or []) + (p.get("user_parameters") or []) + (p.get("egl_parameters") or []),
        "cwd": p.get("working_directory") or p.get("game_directory", ""),
        "env": env,
        "needsWine": str(ig.get("platform", "Windows")).startswith("Win"),
        "redact": ["-AUTH_PASSWORD="],
    }


# --- dispatch -----------------------------------------------------------

def initialize(params):
    return {"name": "Epic Games (legendary)", "version": "0.1.0", "api": API,
            "capabilities": ["library", "install", "launch", "auth", "discard"], "missing": []}


METHODS = {
    "initialize": initialize,
    "auth.status": auth_status,
    "auth.begin": auth_begin,
    "auth.complete": auth_complete,
    "auth.logout": auth_logout,
    "library.list": library_list,
    "game.details": game_details,
    "game.installSize": install_size,
    "game.install": lambda p: start_job(p, "install"),
    "game.update": lambda p: start_job(p, "update"),
    "game.uninstall": lambda p: start_job(p, "uninstall"),
    "job.cancel": job_cancel,
    "job.discard": job_discard,
    "game.launchSpec": launch_spec,
}


def handle(msg):
    fn = METHODS.get(msg.get("method"))
    resp = {"id": msg["id"]}
    if fn is None:
        resp["error"] = {"code": -32601, "message": f"method not found: {msg.get('method')}"}
    else:
        try:
            result = fn(msg.get("params") or {})
            resp["result"] = result if result is not None else {}
        except RPCError as e:
            resp["error"] = {"code": e.code, "message": str(e)}
        except (KeyError, TypeError) as e:
            resp["error"] = {"code": -32602, "message": f"invalid params: {e}"}
        except Exception as e:  # report, never crash the plugin
            resp["error"] = {"code": -32000, "message": f"{type(e).__name__}: {e}"}
    send(resp)


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError as e:
            send({"error": {"code": -32700, "message": str(e)}})
            continue
        if "id" not in msg:
            continue  # notifications need no answer
        # Library listing and logins take seconds; keep reading meanwhile so
        # job.cancel stays responsive.
        threading.Thread(target=handle, args=(msg,), daemon=True).start()
    # stdin closed: Platypus is shutting down. Interrupted installs resume later.
    with jobs_lock:
        procs = [j.get("proc") for j in jobs.values()]
    for p in procs:
        stop_proc(p, grace=5)


if __name__ == "__main__":
    main()
