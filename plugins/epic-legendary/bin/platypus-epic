#!/usr/bin/env python3
"""Platypus store plugin for the Epic Games Store, wrapping legendary.

Speaks Platypus's plugin protocol (api 1, docs/plugins/protocol.md): JSON-RPC 2.0
over stdin/stdout, one object per line. Everything store-specific is done by
the `legendary` CLI, which keeps the user's login in ~/.config/legendary; this
plugin never sees or stores credentials beyond passing the one-time
authorization code to `legendary auth`.

It only installs and launches games the logged-in account owns, through
Epic's own APIs. Launch specs carry Epic's normal launch arguments (an
exchange code for the game's online services), and Platypus runs the game
through its own runner pipeline.
"""

import datetime
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

API = 1
CODE_AUTH_REQUIRED = -32001
LOGIN_URL = "https://legendary.gl/epiclogin"
NOT_LOGGED_IN = "<not logged in>"
# Epic's launcher services want the launcher's user agent, not Python's.
EPIC_UA = "UELauncher/11.0.1-14907503+++Portal+Release-Live Windows/10.0.19041.1.256.64bit"
LIBRARY_HOST = "https://library-service.live.use1a.on.epicgames.com"

# Env keys Platypus refuses in launch specs (see internal/stores/launchspec.go).
# legendary adds WINEPREFIX and friends from its own config; Platypus owns those.
DENIED_ENV_PREFIXES = ("LD_", "DYLD_", "WINE", "PROTON_", "STEAM_COMPAT_", "VK_",
                       "__EGL_", "__GLX_", "LIBGL_", "GST_", "GTK_", "GIO_", "QT_",
                       "XDG_", "PYTHON", "PERL", "RUBY", "NODE_")
DENIED_ENV = {"PATH", "HOME", "USER", "LOGNAME", "SHELL", "IFS", "ENV", "BASH_ENV",
              "TMPDIR", "GCONV_PATH", "MANGOHUD_CONFIGFILE", "MANGOHUD_CONFIG"}

out_lock = threading.Lock()
jobs_lock = threading.Lock()
jobs = {}  # jobId -> {"proc": Popen, "canceled": bool}


class RPCError(Exception):
    def __init__(self, message, code=-32000):
        super().__init__(message)
        self.code = code


def send(msg):
    msg["jsonrpc"] = "2.0"
    line = json.dumps(msg, separators=(",", ":"))
    with out_lock:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()


def notify(method, params):
    send({"method": method, "params": params})


def log(level, message):
    notify("log", {"level": level, "message": message})


def legendary(*args, timeout=300):
    """Runs legendary and returns (exit code, stdout, stderr)."""
    try:
        p = subprocess.run(["legendary", *args], stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, timeout=timeout)
    except FileNotFoundError:
        raise RPCError("legendary is not installed (uv tool install legendary-gl)")
    except subprocess.TimeoutExpired:
        raise RPCError(f"legendary {args[0]} timed out")
    return p.returncode, p.stdout, p.stderr


def tail(text, n=3):
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    return " · ".join(lines[-n:]) if lines else "no output"


AUTH_PROBLEMS = ("login failed", "not logged in", "no saved credentials",
                 "stored credentials are no longer valid")


def auth_problem(text):
    """Whether legendary's output says the user has to log in (upstream raises
    ValueError('No saved credentials') as a traceback in some commands)."""
    low = (text or "").lower()
    return any(s in low for s in AUTH_PROBLEMS)


def legendary_json(*args, timeout=300):
    code, out, err = legendary(*args, timeout=timeout)
    if code != 0:
        if auth_problem(err):
            raise RPCError("log in to Epic first", CODE_AUTH_REQUIRED)
        raise RPCError(f"legendary {args[0]} failed: {tail(err)}")
    try:
        return json.loads(out)
    except ValueError:
        # `legendary get-token` and `achievements` report a failed login (or
        # raise ValueError without credentials) and still exit 0.
        if auth_problem(err):
            raise RPCError("log in to Epic first", CODE_AUTH_REQUIRED)
        raise RPCError(f"legendary {args[0]} printed no JSON: {tail(err)}")


# `achievements` joined legendary's CLI in 0.21.0; older builds answer
# "invalid choice" from argparse.
MIN_ACHIEVEMENTS = (0, 21, 0)
_achievements_ok = None


def achievements_supported():
    global _achievements_ok
    if _achievements_ok is None:
        try:
            code, out, _err = legendary("--version", timeout=10)
        except RPCError:
            _achievements_ok = True  # the tool missing is reported by every call
            return _achievements_ok
        m = re.search(r"(\d+)\.(\d+)\.(\d+)", out) if code == 0 else None
        _achievements_ok = not m or (int(m.group(1)), int(m.group(2)), int(m.group(3))) >= MIN_ACHIEVEMENTS
    return _achievements_ok


# --- auth ---------------------------------------------------------------

def auth_status(_params=None):
    status = legendary_json("status", "--json", "--offline", timeout=60)
    account = status.get("account") or NOT_LOGGED_IN
    if account == NOT_LOGGED_IN:
        return {"loggedIn": False}
    return {"loggedIn": True, "user": account}


def auth_begin(_params):
    return {
        "url": LOGIN_URL,
        "instructions": "Log in to Epic in your browser. The page then shows a short JSON "
                        "response: copy the authorizationCode value (or the whole response) here.",
        "fields": [{"id": "code", "label": "authorizationCode", "placeholder": "32 characters", "secret": True}],
    }


def auth_complete(params):
    code = ((params or {}).get("fields") or {}).get("code", "").strip()
    if code.startswith("{"):
        try:
            code = json.loads(code).get("authorizationCode", "")
        except ValueError:
            raise RPCError("that isn't the JSON response from the login page")
    code = code.strip().strip('"')
    if not re.fullmatch(r"[A-Za-z0-9]{8,128}", code):
        raise RPCError("the authorization code should be letters and digits only")
    # NOTE (PLUG-3): the one-time code travels on argv, visible in ps(1)
    # while auth runs. legendary offers no stdin/env alternative for --code
    # (see `legendary auth --help`), so this is upstream-limited; the code is
    # short-lived, single-use, and never logged (only the CLI's tail is kept).
    rc, _out, err = legendary("auth", "--code", code, "--disable-webview", timeout=120)
    status = auth_status()
    if rc != 0 or not status["loggedIn"]:
        raise RPCError(f"login failed: {tail(err)}")
    return status


def auth_logout(_params):
    legendary("auth", "--delete", timeout=60)
    return auth_status()


# --- library ------------------------------------------------------------

def key_image(meta, *types):
    images = (meta or {}).get("keyImages") or []
    for t in types:
        for img in images:
            if img.get("type") == t and img.get("url"):
                return img["url"]
    return ""


def custom_attr(meta, name):
    return (((meta or {}).get("customAttributes") or {}).get(name) or {}).get("value")


def installed_games():
    try:
        games = legendary_json("list-installed", "--json", timeout=120)
    except RPCError:
        return {}
    return {g["app_name"]: g for g in games if g.get("app_name") and not g.get("is_dlc")}


def library_list(_params):
    if not auth_status()["loggedIn"]:
        raise RPCError("log in to Epic first", CODE_AUTH_REQUIRED)
    owned = legendary_json("list", "--json", timeout=600)
    installed = installed_games()
    games = []
    seen = set()
    for g in owned:
        app = g.get("app_name")
        meta = g.get("metadata") or {}
        if not app or "mainGameItem" in meta:  # DLC
            continue
        seen.add(app)
        assets = g.get("asset_infos") or {}
        latest = (assets.get("Windows") or {}).get("build_version", "")
        entry = {
            "id": app,
            "title": g.get("app_title") or app,
            "installed": False,
            "installable": "Windows" in assets,
            "coverUrl": key_image(meta, "DieselGameBoxTall", "OfferImageTall", "Thumbnail"),
            "heroUrl": key_image(meta, "DieselGameBox", "OfferImageWide"),
            "bannerUrl": key_image(meta, "DieselGameBox", "OfferImageWide"),
            "version": latest,
        }
        store = custom_attr(meta, "ThirdPartyManagedApp") or custom_attr(meta, "ThirdPartyManagedProvider")
        if store:
            entry["installable"] = False
            entry["note"] = f"Installed and launched through {store}; Platypus can't install it."
        elif custom_attr(meta, "partnerLinkType") == "ubisoft":
            entry["note"] = "Needs Ubisoft Connect at runtime."
        elif not entry["installable"]:
            entry["note"] = "No Windows build available through legendary."
        add_installed(entry, installed.get(app), latest)
        games.append(entry)
    for app, ig in installed.items():  # installed but missing from the owned list
        if app not in seen:
            entry = {"id": app, "title": ig.get("title") or app, "installable": False}
            add_installed(entry, ig, "")
            games.append(entry)
    return {"games": games}


def game_details(params):
    """Game page metadata from Epic's catalogue entry, which library.list
    already carries. Epic's achievements are per user, and legendary's offline
    status has no progress, so they are only listed when the catalogue has
    them ("achievements" in list --json)."""
    app = params["id"]
    owned = legendary_json("list", "--json", timeout=600)
    g = next((g for g in owned if g.get("app_name") == app), None)
    if not g:
        raise RPCError(f"{app} is not in your Epic library")
    meta = g.get("metadata") or {}
    out = {
        "summary": ((meta.get("description") or "").split("\n")[0]).strip(),
        "genres": [c.get("value", "") for c in meta.get("categories") or [] if c.get("value")][:4],
        "developers": [d.get("value", "") for d in meta.get("developer") or [] if d.get("value")],
        "publishers": [p.get("value", "") for p in meta.get("publisher") or [] if p.get("value")],
        "releaseDate": (meta.get("releaseDate") or "")[:10],
        "heroUrl": key_image(meta, "DieselGameBox", "OfferImageWide"),
    }
    screenshots = [i["url"] for i in meta.get("keyImages") or []
                   if i.get("type") in ("Screenshot", "DieselGameBoxMedia") and i.get("url")]
    if screenshots:
        out["screenshots"] = screenshots[:6]
    ach = g.get("achievements") or {}
    entries = (ach.get("achievement_set") or {}).get("achievements") or []
    if ach and entries:
        out["achievements"] = {
            "total": (ach.get("achievement_set") or {}).get("achievements_count", len(entries)),
            "list": [{"id": e.get("id", ""), "name": e.get("displayName", ""),
                      "description": e.get("description", ""),
                      "icon": ((e.get("icons") or [{}])[0].get("url") or "")}
                     for e in entries[:10]],
        }
    return out


def add_installed(entry, ig, latest):
    if not ig:
        return
    entry["installed"] = True
    entry["installPath"] = ig.get("install_path", "")
    entry["sizeBytes"] = int(ig.get("install_size") or 0)
    entry["version"] = ig.get("version", "")
    entry["updateAvailable"] = bool(latest) and latest != ig.get("version")


def install_size(params):
    path, meta = target_manifest(params.get("id") or "", params.get("target"))
    if path:
        if not meta.get("downloadBytes") and not meta.get("diskBytes"):
            meta = manifest_meta(path)
        return {"downloadBytes": int(meta.get("downloadBytes") or 0),
                "diskBytes": int(meta.get("diskBytes") or 0)}
    info = legendary_json("info", params["id"], "--json", timeout=300)
    m = info.get("manifest") or {}
    return {"downloadBytes": int(m.get("download_size") or 0), "diskBytes": int(m.get("disk_size") or 0)}


# --- versions (1.3) -------------------------------------------------------
# Epic publishes no list of old builds. The only builds that can come back are
# the manifests legendary saved while installing them: `legendary install
# --manifest <file>` is its documented downgrade path (cli.py). So the plugin
# copies the installed manifest into its data folder before every update and
# after every install, keeps the last MAX_ARCHIVES per game, and lists those as
# archive builds. A version target names one of them by archiveRef or build.

MAX_ARCHIVES = 3  # older builds kept per game, on top of the installed one
MANIFEST_EXT = ".manifest"


def plugin_data():
    return os.environ.get("PLATYPUS_PLUGIN_DATA") or "."


def clean_filename(name):
    # legendary/lfs/utils.py: the characters its config filenames drop.
    return "".join(c for c in str(name) if c not in '<>:"/\\|?*')


def safe_name(value):
    name = clean_filename(value).strip().lstrip(".").strip()
    return name[:120]


def valid_app(app):
    return isinstance(app, str) and bool(APP_RE.fullmatch(app)) and bool(app.strip("."))


def archive_dir(app):
    if not valid_app(app):
        return None
    return os.path.join(plugin_data(), "archive", app)


def installed_manifest(app, version, platform):
    """The manifest file legendary saved for an installed build: its config
    folder's manifests/<app>_<platform>_<version>.manifest (lfs/lgndry.py), or
    the older name without the platform."""
    base = os.path.join(config_dir(), "manifests")
    for name in (clean_filename(f"{app}_{platform}_{version}"), clean_filename(f"{app}_{version}")):
        path = os.path.join(base, name + MANIFEST_EXT)
        if os.path.isfile(path):
            return path
    return None


def manifest_meta(path):
    """A manifest file's own build fields. `legendary info <path> --json
    --offline` parses a local manifest without logging in or refreshing the
    game list (cli.py: a path is a manifest URI and offline skips update_meta)."""
    try:
        data = legendary_json("info", path, "--json", "--offline", timeout=60)
    except RPCError:
        return {}
    m = data.get("manifest") or {}
    return {"buildId": str(m.get("build_id") or ""),
            "downloadBytes": int(m.get("download_size") or 0),
            "diskBytes": int(m.get("disk_size") or 0)}


def load_archive(app):
    """Saved builds for a game: {build: metadata} from archive/<app>/*.json,
    only while the build's manifest is still there."""
    d = archive_dir(app)
    if not d:
        return {}
    found = {}
    for name in list_dir(d):
        if not name.endswith(".json"):
            continue
        stem = name[:-len(".json")]
        if not os.path.isfile(os.path.join(d, stem + MANIFEST_EXT)):
            continue
        try:
            with open(os.path.join(d, name)) as f:
                meta = json.load(f)
        except (OSError, ValueError):
            continue
        build = str(meta.get("build") or "") if isinstance(meta, dict) else ""
        if build:
            found[build] = meta
    return found


def prune_archives(d, protected=()):
    """Keeps the protected builds (the installed one, and the one a job is
    about to install) plus the MAX_ARCHIVES most recently saved others. A
    manifest with no sidecar is an orphan from an interrupted save."""
    protected = {s for s in protected if s}
    entries = []
    for name in list_dir(d):
        if not name.endswith(".json"):
            continue
        stem = name[:-len(".json")]
        if not os.path.isfile(os.path.join(d, stem + MANIFEST_EXT)):
            _unlink(os.path.join(d, name))
            continue
        try:
            entries.append((os.stat(os.path.join(d, name)).st_mtime, stem))
        except OSError:
            continue
    entries.sort()
    others = [stem for _, stem in entries if stem not in protected]
    dropped = set(others[:-MAX_ARCHIVES])
    for _, stem in entries:
        if stem not in dropped:
            continue
        for ext in (".json", MANIFEST_EXT):
            _unlink(os.path.join(d, stem + ext))
    sidecars = {stem for _, stem in entries}
    for name in list_dir(d):
        if name.endswith(MANIFEST_EXT) and name[:-len(MANIFEST_EXT)] not in sidecars:
            _unlink(os.path.join(d, name))


def _unlink(path):
    try:
        os.unlink(path)
    except OSError:
        pass


def archive_installed(app, keep=""):
    """Copies the installed build's manifest into the plugin's data folder and
    returns the archiveRef for it (the saved manifest's name), or None."""
    ig = installed_games().get(app)
    d = archive_dir(app)
    if not ig or not d:
        return None
    version = str(ig.get("version") or "")
    name = safe_name(version)
    if not name:
        return None
    src = installed_manifest(app, version, ig.get("platform") or "Windows")
    dest = os.path.join(d, name + MANIFEST_EXT)
    if not src:
        return os.path.basename(dest) if os.path.isfile(dest) else None
    sidecar = os.path.join(d, name + ".json")
    saved = {}
    try:
        with open(sidecar) as f:
            loaded = json.load(f)
        if isinstance(loaded, dict):
            saved = loaded
    except (OSError, ValueError):
        pass
    # An install made with --manifest records no base URLs of its own
    # (core.py:prepare_download); keep the ones the sidecar already has.
    base_urls = [u for u in (ig.get("base_urls") or []) if isinstance(u, str) and u]
    if not base_urls and isinstance(saved.get("baseUrls"), list):
        base_urls = [u for u in saved["baseUrls"] if isinstance(u, str) and u]
    meta = {"build": version, "versionName": version,
            "date": datetime.date.today().isoformat(),
            "platform": ig.get("platform") or "Windows",
            "baseUrls": base_urls,
            "downloadBytes": 0, "diskBytes": int(ig.get("install_size") or 0)}
    info = manifest_meta(src)
    meta["downloadBytes"] = info.get("downloadBytes") or 0
    meta["diskBytes"] = info.get("diskBytes") or meta["diskBytes"]
    meta["buildId"] = info.get("buildId") or ""
    try:
        os.makedirs(d, exist_ok=True)
        shutil.copyfile(src, dest + ".new")
        os.replace(dest + ".new", dest)
        with open(sidecar + ".new", "w") as f:
            json.dump(meta, f)
        os.replace(sidecar + ".new", sidecar)
    except OSError as e:
        _unlink(dest + ".new")
        _unlink(sidecar + ".new")
        log("warn", f"couldn't archive {app} {version}: {e}")
        return None
    prune_archives(d, protected={name, keep})
    return os.path.basename(dest)


def target_manifest(app, target):
    """(manifest path, its saved metadata) for a Versions target, or
    (None, {}) when there is none. Epic has no channels and no typed versions:
    a target names a build from the install history and/or the archiveRef
    Platypus kept for it."""
    if not target:
        return None, {}
    if target.get("channel"):
        raise RPCError("Epic has no channels; pick a build you had installed before", -32000)
    if target.get("manual"):
        raise RPCError("Epic's versions come from saved manifests, not typed values", -32000)
    d = archive_dir(app)
    if not d:
        raise RPCError("invalid params: id is required", -32602)
    build = str(target.get("build") or "")
    ref = target.get("archiveRef")
    name = ref if isinstance(ref, str) else ""
    if isinstance(ref, dict):
        name = str(ref.get("manifest") or ref.get("build") or "")
    if name:
        base = os.path.basename(name)
        if base != name or not base.endswith(MANIFEST_EXT) or base.startswith("."):
            raise RPCError("that archive reference is not a saved manifest", -32000)
        path = os.path.join(d, base)
        stem = base[:-len(MANIFEST_EXT)]
    elif build:
        stem = safe_name(build)
        path = os.path.join(d, stem + MANIFEST_EXT) if stem else ""
    else:
        raise RPCError("pick an archived build to install", -32000)
    if not os.path.isfile(path):
        raise RPCError("that build's manifest is no longer saved; only builds from your "
                       "install history can be restored", -32000)
    meta = {}
    try:
        with open(os.path.join(d, stem + ".json")) as f:
            saved = json.load(f)
        if isinstance(saved, dict):
            meta = saved
    except (OSError, ValueError):
        pass
    return path, meta


def store_entry(app):
    """(the store's current Windows build version, whether the account owns the
    app). One `legendary list` for both: versions.list needs the latest build
    for updateAvailable, and ownership to refuse an unknown id."""
    owned = legendary_json("list", "--json", timeout=300)
    for g in owned:
        if g.get("app_name") == app:
            assets = g.get("asset_infos") or {}
            return str((assets.get("Windows") or {}).get("build_version") or ""), True
    return "", False


def versions_list(params):
    app = str((params or {}).get("id") or "")
    if not app:
        raise RPCError("invalid params: id is required", -32602)
    if not valid_app(app):
        raise RPCError(f"{app} is not a valid Epic app id", -32002)
    ig = installed_games().get(app)
    archived = load_archive(app)
    pinned = (params or {}).get("pinned")
    if not isinstance(pinned, dict):
        pinned = {}
    pinned_build = str(pinned.get("id") or "") if pinned.get("kind") == "build" else ""
    latest = ""
    if ig or archived:
        try:
            latest, _owned = store_entry(app)
        except RPCError:
            latest = ""  # no update information beats failing a local list
    else:
        latest, owned = store_entry(app)
        if not owned:
            raise RPCError(f"{app} is not in your Epic library", -32002)
    current = str((ig or {}).get("version") or "")
    builds = []
    known = set()
    # An installed build the store has moved past is only reachable through
    # the saved manifest, so it is labelled as an archive build.
    if current:
        known.add(current)
        builds.append({"id": current, "name": current,
                       "source": "archive" if latest and latest != current else "store",
                       "current": True})
    elif latest:
        known.add(latest)
        builds.append({"id": latest, "name": latest, "source": "store"})
    for build, meta in archived.items():
        if build in known:
            continue
        known.add(build)
        # publishedAt is when the plugin saved the manifest (today's date at
        # install): Epic's manifests carry no publication date.
        builds.append({"id": build, "name": str(meta.get("versionName") or build),
                       "publishedAt": str(meta.get("date") or "")[:10],
                       "source": "archive", "current": False})
    # Builds Platypus remembers that the plugin no longer has a manifest for:
    # listed so the history stays visible, but not installable.
    for entry in (params or {}).get("ledger") or []:
        if not isinstance(entry, dict):
            continue
        build = str(entry.get("build") or "")
        if not build or build in known:
            continue
        known.add(build)
        builds.append({"id": build, "name": str(entry.get("versionName") or build),
                       "publishedAt": str(entry.get("date") or "")[:10],
                       "source": "archive", "available": False})
    update_available = False
    if current:
        if pinned_build:
            update_available = current != pinned_build
        else:
            update_available = bool(latest) and latest != current
    return {"channels": [], "builds": builds, "manual": None, "links": [],
            "updateAvailable": update_available, "pinned": pinned}


# --- jobs ---------------------------------------------------------------

PROGRESS_RE = re.compile(r"= Progress: ([\d.]+)%")
DOWNLOADED_RE = re.compile(r"- Downloaded: ([\d.]+) MiB")
SPEED_RE = re.compile(r"\+ Download\s+- ([\d.]+) MiB/s \(raw\)")
DLSIZE_RE = re.compile(r"Download size: ([\d.]+) MiB")
MIB = 1024 * 1024


def start_job(params, kind):
    app, job_id = params["id"], params["jobId"]
    manifest, meta = target_manifest(app, params.get("target")) if kind != "uninstall" else (None, {})
    if kind == "install":
        platform = str(meta.get("platform") or "Windows")
        args = ["-y", "install", app, "--base-path", params["installDir"], "--skip-sdl",
                "--platform", platform]
    elif kind == "update":
        args = ["-y", "install", app, "--update-only", "--skip-sdl"]
    else:
        args = ["-y", "uninstall", app]
    if manifest:
        args += ["--manifest", manifest]
        base_urls = meta.get("baseUrls")
        if isinstance(base_urls, list) and base_urls and isinstance(base_urls[0], str):
            # A fresh install has no installed record, and a metadata refetch
            # drops the app's base URLs: legendary then raises "No base URLs
            # found" (core.py). The saved record's first one goes with it.
            args += ["--base-url", base_urls[0]]
    # Platypus resends a job with the same jobId after a crash: run it once. A job
    # just paused or canceled is still stopping: wait, then let legendary pick
    # up from its resume file.
    if not claim_job(job_id, {"proc": None, "canceled": False}):
        return {}
    if kind == "update":
        # The build being replaced may never come back from Epic. The target
        # manifest must survive this archive's pruning to be installed.
        keep = os.path.basename(manifest)[:-len(MANIFEST_EXT)] if manifest else ""
        try:
            archive_installed(app, keep)
        except Exception as e:  # never stop an update over the archive copy
            log("warn", f"couldn't archive the installed build of {app}: {e}")
    job_started(job_id, app, kind, params.get("installDir") or "")
    try:
        proc = subprocess.Popen(["legendary", *args], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True, bufsize=1)
    except FileNotFoundError:
        with jobs_lock:
            jobs.pop(job_id, None)
        raise RPCError("legendary is not installed (uv tool install legendary-gl)")
    with jobs_lock:
        job = jobs.setdefault(job_id, {"canceled": False})
        job["proc"] = proc
        canceled = job["canceled"]
    threading.Thread(target=follow_job, args=(job_id, kind, app, proc), daemon=True).start()
    if canceled:  # job.cancel arrived while the process was starting
        stop_proc(proc, grace=5)
    return {}


def follow_job(job_id, kind, app, proc):
    state = {"jobId": job_id, "phase": "uninstalling" if kind == "uninstall" else "preparing"}
    recent = []
    for line in proc.stdout:
        line = line.rstrip()
        if not line:
            continue
        recent = (recent + [line])[-5:]
        changed = False
        if m := DLSIZE_RE.search(line):
            state["total"] = int(float(m.group(1)) * MIB)
        if m := PROGRESS_RE.search(line):
            state["percent"] = float(m.group(1))
            state["phase"] = "downloading"
            changed = True
        if m := DOWNLOADED_RE.search(line):
            state["bytes"] = int(float(m.group(1)) * MIB)
        if m := SPEED_RE.search(line):
            state["speed"] = float(m.group(1)) * MIB
            changed = True
        if changed:
            notify("job.progress", dict(state))
    rc = proc.wait()
    with jobs_lock:
        canceled = jobs.pop(job_id, {}).get("canceled", False)
    if canceled:
        job_stopped(job_id)
        return
    if rc == 0:
        job_finished(job_id)
        notify("job.done", {"jobId": job_id, **installed_after(app, kind)})
    else:
        job_stopped(job_id)
        notify("job.failed", {"jobId": job_id, "error": " · ".join(recent[-3:]) or f"legendary exited with {rc}"})


def installed_after(app, kind):
    """job.done's `installed` for a finished install or update: the build
    legendary recorded, with the manifest the plugin saved for it."""
    if kind == "uninstall":
        return {}
    try:
        ref = archive_installed(app)
    except Exception as e:
        log("warn", f"couldn't archive {app} after {kind}: {e}")
        ref = None
    build = str((installed_games().get(app) or {}).get("version") or "")
    if not build:
        return {}
    installed = {"build": build, "versionName": build}
    if ref:
        installed["archiveRef"] = ref
    return {"installed": installed}


def claim_job(job_id, entry, timeout=90):
    """Registers entry as the run of job_id and returns True. False when the
    job is already running (a repeated start). A job that job.cancel just
    stopped is still shutting down legendary: wait for it to go, so a resume
    with the same jobId doesn't lose to the old run and report nothing."""
    deadline = time.monotonic() + timeout
    while True:
        with jobs_lock:
            job = jobs.get(job_id)
            if job is None:
                jobs[job_id] = entry
                return True
            if not job.get("canceled"):
                return False
        if time.monotonic() > deadline:
            raise RPCError("the previous run of this download is still stopping; try again in a moment")
        time.sleep(0.05)


def stop_proc(proc, grace=15):
    """SIGINT lets legendary save its resume state; SIGKILL if it hangs.

    legendary stays in the plugin's process group, so if the plugin itself
    dies, Platypus's group kill takes legendary with it."""
    try:
        proc.send_signal(signal.SIGINT)
        proc.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        proc.kill()
    except ProcessLookupError:
        pass


def job_cancel(params):
    with jobs_lock:
        job = jobs.get(params.get("jobId"))
        if job:
            job["canceled"] = True
    if job:
        threading.Thread(target=stop_proc, args=(job["proc"],), daemon=True).start()
    return {}


# --- discarding a canceled job's data ---------------------------------------
# legendary keeps a download cache in the game folder it installs into
# (<base>/<game>/.cache) and a resume file in its config folder
# (tmp/<app>.resume); a canceled install leaves both. The plugin can't know the
# game folder's name before legendary has made it, so it remembers which
# folders appeared in the install folder while an install job ran
# ($PLATYPUS_PLUGIN_DATA/jobs-meta.json) and job.discard deletes exactly those,
# never one that is installed.

meta_lock = threading.RLock()
JOB_ID_RE = re.compile(r"[A-Za-z0-9_-]{1,64}")
APP_RE = re.compile(r"[A-Za-z0-9_.-]{1,128}")


def meta_file():
    return os.path.join(os.environ.get("PLATYPUS_PLUGIN_DATA") or ".", "jobs-meta.json")


def load_meta():
    try:
        with open(meta_file()) as f:
            meta = json.load(f)
        return meta if isinstance(meta, dict) else {}
    except (OSError, ValueError):
        return {}


def save_meta(meta):
    path = meta_file()
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    tmp = path + ".new"
    with open(tmp, "w") as f:
        json.dump(meta, f)
    os.replace(tmp, path)


def list_dir(path):
    try:
        return sorted(os.listdir(path))
    except OSError:
        return []


def installed_dirs():
    return [os.path.realpath(g["install_path"]) for g in installed_games().values() if g.get("install_path")]


def claim_new_dirs(meta, m):
    """Attributes to the job the folders that showed up since it began and that
    nothing else accounts for: not there before, not another job's, not installed."""
    taken = set(m["pre"]) | set(m["dirs"])
    for o in meta.values():
        if o is not m and o.get("installDir") == m["installDir"]:
            taken |= set(o.get("dirs", []))
    installed = installed_dirs()
    for name in list_dir(m["installDir"]):
        path = os.path.realpath(os.path.join(m["installDir"], name))
        if name in taken or path in installed:
            continue
        m["dirs"].append(name)


def job_started(job_id, app, kind, install_dir):
    if kind != "install" or not install_dir:
        return
    with meta_lock:
        meta = load_meta()
        m = meta.get(job_id)
        if m is None:
            meta[job_id] = {"app": app, "installDir": install_dir, "pre": list_dir(install_dir), "dirs": []}
        else:
            claim_new_dirs(meta, m)  # a run that was cut short, now resuming
        try:
            save_meta(meta)
        except OSError as e:
            log("warn", f"couldn't record job {job_id}: {e}")


def job_stopped(job_id):
    """The run ended without finishing: note what it left."""
    with meta_lock:
        meta = load_meta()
        m = meta.get(job_id)
        if m is None:
            return
        claim_new_dirs(meta, m)
        try:
            save_meta(meta)
        except OSError:
            pass


def job_finished(job_id):
    with meta_lock:
        meta = load_meta()
        if meta.pop(job_id, None) is not None:
            try:
                save_meta(meta)
            except OSError:
                pass


def config_dir():
    """legendary's config folder, where it keeps installed.json and tmp/."""
    cfg = os.environ.get("LEGENDARY_CONFIG_PATH")
    if not cfg:
        base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
        cfg = os.path.join(base, "legendary")
    return cfg


def resume_file(app):
    """legendary's resume file for an app, in its config folder."""
    if not isinstance(app, str) or not APP_RE.fullmatch(app):
        return None
    return os.path.join(config_dir(), "tmp", app + ".resume")


def job_discard(params):
    """Deletes the partial install of a job that was canceled: the folders it
    created in the install folder, and legendary's resume file. Updates and
    anything installed are left (an update only loses its resume file)."""
    job_id = params.get("jobId")
    if not isinstance(job_id, str) or not JOB_ID_RE.fullmatch(job_id):
        raise RPCError("invalid jobId", -32602)
    job_cancel({"jobId": job_id})
    deadline = time.monotonic() + 90
    while True:  # the job may still be shutting down
        with jobs_lock:
            running = job_id in jobs
        if not running:
            break
        if time.monotonic() > deadline:
            raise RPCError("the download is still stopping; try again in a moment")
        time.sleep(0.05)
    with meta_lock:
        meta = load_meta()
        m = meta.pop(job_id, None)
        if m is not None:
            if params.get("kind", "install") == "install" and m.get("installDir") == params.get("installDir"):
                claim_new_dirs({**meta, job_id: m}, m)
                remove_job_dirs(m)
            try:
                save_meta(meta)
            except OSError:
                pass
    rf = resume_file(params.get("id") or (m or {}).get("app"))
    if rf:
        try:
            os.unlink(rf)
        except OSError:
            pass
    return {}


def remove_job_dirs(m):
    base = os.path.realpath(m["installDir"])
    installed = installed_dirs()
    for name in m.get("dirs", []):
        if not isinstance(name, str) or name in ("", ".", "..") or "/" in name:
            continue
        path = os.path.join(base, name)
        real = os.path.realpath(path)
        if os.path.islink(path) or not os.path.isdir(path) or os.path.dirname(real) != base:
            continue
        if any(i == real or i.startswith(real + os.sep) or real.startswith(i + os.sep) for i in installed):
            log("warn", f"not deleting {path}: it holds an installed game")
            continue
        shutil.rmtree(path, ignore_errors=True)


# --- verify (protocol 1.4) -------------------------------------------------
# `legendary verify` checks the installed manifest's files and prints one
# "Verification progress: n/total (pct%)" update per second; the summary says
# how many files were corrupted or missing. A repair is `legendary repair`,
# which verifies first (when no `.repair` file is lying around from an earlier
# check) and then re-downloads the files it listed.
VERIFY_RE = re.compile(r"Verification progress: (\d+)/(\d+) \(([\d.]+)%\) \[([\d.]+) MiB/s\]")
VERIFY_FAIL_RE = re.compile(r"Verification failed, (\d+) file\(s\) corrupted, (\d+) file\(s\) are missing")
VERIFY_OK = "Verification finished successfully."


def verify_file(app):
    if not isinstance(app, str) or not APP_RE.fullmatch(app):
        return None
    return os.path.join(config_dir(), "tmp", app + ".repair")


def start_verify(params):
    app, job_id = params.get("id"), params.get("jobId")
    install_dir = params.get("installDir") or ""
    if not isinstance(app, str) or not app or not isinstance(job_id, str) or not job_id:
        raise RPCError("invalid params: id and jobId are required", -32602)
    if not isinstance(install_dir, str) or not os.path.isabs(install_dir):
        raise RPCError("invalid params: installDir must be an absolute path", -32602)
    ig = installed_games().get(app)
    if not ig:
        raise RPCError(f"{app} is not installed")
    recorded = ig.get("install_path") or ""
    if os.path.normpath(recorded) != os.path.normpath(install_dir):
        raise RPCError(f"Platypus says {install_dir} but legendary has {recorded}; move the game again")
    repair = bool(params.get("repair"))
    if not claim_job(job_id, {"proc": None, "canceled": False}):
        return {}
    if repair:
        # A .repair file left by the check would make legendary skip the
        # verification, and then there is no report to count the repair from.
        rf = verify_file(app)
        if rf:
            try:
                os.unlink(rf)
            except OSError:
                pass
    args = ["-y", "repair", app] if repair else ["verify", app]
    try:
        proc = subprocess.Popen(["legendary", *args], stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    except FileNotFoundError:
        with jobs_lock:
            jobs.pop(job_id, None)
        raise RPCError("legendary is not installed (uv tool install legendary-gl)")
    with jobs_lock:
        job = jobs.setdefault(job_id, {"canceled": False})
        job["proc"] = proc
        canceled = job["canceled"]
    threading.Thread(target=follow_verify, args=(job_id, repair, proc), daemon=True).start()
    if canceled:
        stop_proc(proc, grace=5)
    return {}


def follow_verify(job_id, repair, proc):
    state = {"jobId": job_id, "phase": "checking"}
    recent, buf = [], b""
    checked = damaged = missing = 0
    summary = finished = False

    def line(text):
        nonlocal checked, damaged, missing, summary, finished
        recent[:] = (recent + [text])[-5:]
        if m := VERIFY_FAIL_RE.search(text):
            damaged, missing, summary = int(m.group(1)), int(m.group(2)), True
        elif VERIFY_OK in text:
            summary = True
        changed = False
        for m in VERIFY_RE.finditer(text):
            checked = int(m.group(2))
            state["percent"] = float(m.group(3))
            state["speed"] = float(m.group(4)) * MIB
            state["phase"] = "checking"
            changed = True
        if repair:
            if "Finished installation process" in text or "Download size is 0" in text:
                finished = True
            if m := DLSIZE_RE.search(text):
                state["total"] = int(float(m.group(1)) * MIB)
            if m := PROGRESS_RE.search(text):
                state["percent"] = float(m.group(1))
                state["phase"] = "repairing"
                changed = True
            if m := DOWNLOADED_RE.search(text):
                state["bytes"] = int(float(m.group(1)) * MIB)
            if m := SPEED_RE.search(text):
                state["speed"] = float(m.group(1)) * MIB
                changed = True
        if changed:
            notify("job.progress", dict(state))

    while True:
        chunk = proc.stdout.read1(65536)
        if not chunk:
            break
        buf += chunk
        parts = re.split(rb"[\r\n]", buf)
        buf = parts.pop()
        for raw in parts:
            text = raw.decode("utf-8", "replace").strip()
            if text:
                line(text)
    if buf:
        text = buf.decode("utf-8", "replace").strip()
        if text:
            line(text)
    rc = proc.wait()
    with jobs_lock:
        canceled = jobs.pop(job_id, {}).get("canceled", False)
    if canceled:
        return
    # A check needs its summary; a repair needs the downloader's finish line:
    # a failed download logs "Installation failed" and exits 0 without it.
    if rc != 0 or not (finished if repair else summary):
        notify("job.failed", {"jobId": job_id, "error": " · ".join(recent[-3:]) or f"legendary exited with {rc}"})
        return
    if repair:
        # The run restored what the check found and, having finished, leaves
        # nothing wrong behind.
        report = {"checked": checked, "damaged": 0, "missing": 0,
                  "repaired": (damaged + missing) if finished else 0}
    else:
        report = {"checked": checked, "damaged": damaged, "missing": missing}
    notify("job.done", {"jobId": job_id, "verify": report})


def game_relocated(params):
    """Platypus moved the game's folder itself (protocol 1.4, no capability):
    rewrite legendary's install record with `legendary move --skip-move`, which
    takes its installed.json lock and rebases the record the way it documents."""
    app, src, dst = params.get("id"), params.get("from"), params.get("to")
    if not isinstance(app, str) or not app or not isinstance(src, str) or not isinstance(dst, str) or not src or not dst:
        raise RPCError("invalid params: id, from and to are required", -32602)
    if not os.path.isabs(src) or not os.path.isabs(dst):
        raise RPCError("invalid params: from and to must be absolute paths", -32602)
    ig = installed_games().get(app)
    if not ig or os.path.normpath(ig.get("install_path") or "") != os.path.normpath(src):
        raise RPCError(f"no install record at {src}", -32602)
    if os.path.basename(os.path.normpath(src)) != os.path.basename(os.path.normpath(dst)):
        raise RPCError("Platypus renamed the game's folder; legendary can only follow a move into a new parent", -32000)
    code, out, err = legendary("move", app, os.path.dirname(os.path.normpath(dst)), "--skip-move", timeout=25)
    moved = installed_games().get(app) or {}
    if os.path.normpath(moved.get("install_path") or "") != os.path.normpath(dst):
        raise RPCError(f"legendary move failed: {tail(err) or tail(out)}")
    return {}


# --- achievements and playtime (protocol 1.7) ------------------------------
# `legendary achievements --json` asks Epic's launcher GraphQL for the game's
# achievement definitions and the user's own progress, through the credentials
# legendary already stores. Playtime is not a legendary command: its launcher
# library endpoint is read with the bearer token `legendary get-token` prints.
ACH_GROUPS = ("completed", "in_progress", "uninitiated", "hidden")


def unix_time(value):
    if not value:
        return None
    try:
        dt = datetime.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=datetime.timezone.utc)
    return int(dt.timestamp())


def achievements_list(params):
    app = params.get("id")
    if not isinstance(app, str) or not app:
        raise RPCError("invalid params: id is required", -32602)
    code, out, err = legendary("achievements", app, "--json", timeout=25)
    if code != 0:
        if auth_problem(err):
            raise RPCError("log in to Epic first", CODE_AUTH_REQUIRED)
        if "invalid choice" in err and "achievements" in err:
            raise RPCError("update legendary to 0.21 or later for achievements")
        raise RPCError(f"legendary achievements failed: {tail(err)}")
    if not out.strip():
        if auth_problem(err):
            raise RPCError("log in to Epic first", CODE_AUTH_REQUIRED)
        if "No game found" in err:
            raise RPCError(f"{app} is not in your Epic library")
        if "No achievements" in err:
            return {"total": 0, "unlocked": 0, "list": []}
        raise RPCError(f"legendary achievements printed no JSON: {tail(err)}")
    try:
        data = json.loads(out)
    except ValueError:
        raise RPCError(f"legendary achievements printed no JSON: {tail(err)}")
    entries = []
    for group in ACH_GROUPS:
        for a in data.get(group) or []:
            if not isinstance(a, dict) or not a.get("name"):
                continue
            e = {"id": a["name"], "name": a.get("display_name") or a["name"],
                 "description": a.get("description") or "", "hidden": bool(a.get("hidden"))}
            if a.get("icon_link"):
                e["icon"] = a["icon_link"]
            if a.get("unlocked"):
                # "N/A" is what legendary prints for an unlock without a
                # timestamp; an unlocked achievement still needs one.
                e["unlockedAt"] = unix_time(a.get("unlock_date")) or 1
            rarity = a.get("rarity") or {}
            if isinstance(rarity, dict) and isinstance(rarity.get("percent"), (int, float)):
                e["globalPercent"] = float(rarity["percent"])
            entries.append(e)
    unlocked = data.get("user_unlocked")
    if not isinstance(unlocked, int) or isinstance(unlocked, bool):
        unlocked = sum(1 for e in entries if "unlockedAt" in e)
    total = data.get("total_achievements")
    if not isinstance(total, int) or isinstance(total, bool) or total < len(entries):
        total = len(entries)
    return {"total": total, "unlocked": unlocked, "list": entries}


def epic_bearer():
    token = legendary_json("get-token", "--json", "--bearer", timeout=15)
    access, account = token.get("access_token"), token.get("account_id")
    if not isinstance(access, str) or not access or not isinstance(account, str) or not account:
        raise RPCError("legendary printed no access token")
    return access, account


def library_host():
    """Epic's library host. The environment override is a test hook and only
    a loopback address is accepted, so the bearer token can't be pointed at
    another machine."""
    override = os.environ.get("PLATYPUS_EPIC_LIBRARY_URL")
    if override:
        parts = urllib.parse.urlsplit(override)
        if parts.scheme in ("http", "https") and parts.hostname in ("127.0.0.1", "localhost", "::1"):
            return override
        log("warn", "PLATYPUS_EPIC_LIBRARY_URL is not a loopback address; using Epic's library service")
    return LIBRARY_HOST


def playtime_list(_params):
    access, account = epic_bearer()
    host = library_host()
    url = f"{host.rstrip('/')}/library/api/public/playtime/account/{urllib.parse.quote(account)}/all"
    req = urllib.request.Request(url, headers={"Authorization": f"bearer {access}",
                                               "User-Agent": EPIC_UA, "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=12) as r:
            rows = json.load(r)
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            raise RPCError("Epic didn't accept the login; log in again", CODE_AUTH_REQUIRED)
        raise RPCError(f"Epic's playtime service answered {e.code}")
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise RPCError(f"Epic's playtime service is unreachable: {e}")
    if not isinstance(rows, list):
        raise RPCError("Epic's playtime service sent an unexpected answer")
    seconds = {}
    for row in rows:
        if not isinstance(row, dict):
            continue
        app, total = row.get("artifactId"), row.get("totalTime")
        if not isinstance(app, str) or not app or not isinstance(total, int) or isinstance(total, bool) or total < 0:
            continue
        seconds[app] = max(seconds.get(app, 0), total)
    return {"games": [{"id": app, "minutes": total // 60} for app, total in sorted(seconds.items())]}


# --- launch -------------------------------------------------------------

def launch_spec(params):
    app = params["id"]
    preview = bool(params.get("preview"))
    ig = installed_games().get(app)
    if not ig:
        raise RPCError(f"{app} is not installed")
    args = ["launch", app, "--json"]
    if preview:
        # No exchange code and no update check just to show a command.
        args += ["--offline", "--skip-version-check"]
    elif ig.get("manifest_path"):
        # legendary records the manifest path of an install made with
        # --manifest (an archived build) and clears it on any normal download.
        # Its version check would compare that build with the store's latest
        # and refuse the launch as out of date.
        args += ["--skip-version-check"]
    code, out, err = legendary(*args, timeout=120)
    if code != 0:
        if "out of date" in err:
            raise RPCError("this game has an update; update it before playing")
        raise RPCError(f"legendary launch failed: {tail(err)}")
    try:
        p = json.loads(out)
    except ValueError:
        raise RPCError(f"legendary launch printed no JSON: {tail(err)}")
    exe = os.path.join(p.get("game_directory", ""), p.get("game_executable", ""))
    env = {k: v for k, v in (p.get("environment") or {}).items()
           if k.upper() not in DENIED_ENV and not k.upper().startswith(DENIED_ENV_PREFIXES)}
    return {
        "exe": exe,
        "args": (p.get("game_parameters") or []) + (p.get("user_parameters") or []) + (p.get("egl_parameters") or []),
        "cwd": p.get("working_directory") or p.get("game_directory", ""),
        "env": env,
        "needsWine": str(ig.get("platform", "Windows")).startswith("Win"),
        "redact": ["-AUTH_PASSWORD="],
    }


# --- dispatch -----------------------------------------------------------

def initialize(params):
    capabilities = ["library", "install", "launch", "auth", "discard", "verify", "playtime", "versions"]
    if achievements_supported():
        capabilities.append("achievements")
    return {"name": "Epic Games (legendary)", "version": "0.4.0", "api": API,
            "capabilities": capabilities, "missing": []}


METHODS = {
    "initialize": initialize,
    "auth.status": auth_status,
    "auth.begin": auth_begin,
    "auth.complete": auth_complete,
    "auth.logout": auth_logout,
    "library.list": library_list,
    "game.details": game_details,
    "game.installSize": install_size,
    "versions.list": versions_list,
    "game.install": lambda p: start_job(p, "install"),
    "game.update": lambda p: start_job(p, "update"),
    "game.uninstall": lambda p: start_job(p, "uninstall"),
    "job.cancel": job_cancel,
    "job.discard": job_discard,
    "game.verify": start_verify,
    "game.relocated": game_relocated,
    "achievements.list": achievements_list,
    "playtime.list": playtime_list,
    "game.launchSpec": launch_spec,
}


def handle(msg):
    fn = METHODS.get(msg.get("method"))
    resp = {"id": msg["id"]}
    if fn is None:
        resp["error"] = {"code": -32601, "message": f"method not found: {msg.get('method')}"}
    else:
        try:
            result = fn(msg.get("params") or {})
            resp["result"] = result if result is not None else {}
        except RPCError as e:
            resp["error"] = {"code": e.code, "message": str(e)}
        except (KeyError, TypeError) as e:
            resp["error"] = {"code": -32602, "message": f"invalid params: {e}"}
        except Exception as e:  # report, never crash the plugin
            resp["error"] = {"code": -32000, "message": f"{type(e).__name__}: {e}"}
    send(resp)


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError as e:
            send({"error": {"code": -32700, "message": str(e)}})
            continue
        if "id" not in msg:
            continue  # notifications need no answer
        # Library listing and logins take seconds; keep reading meanwhile so
        # job.cancel stays responsive.
        threading.Thread(target=handle, args=(msg,), daemon=True).start()
    # stdin closed: Platypus is shutting down. Interrupted installs resume later.
    with jobs_lock:
        procs = [j.get("proc") for j in jobs.values()]
    for p in procs:
        stop_proc(p, grace=5)


if __name__ == "__main__":
    main()
