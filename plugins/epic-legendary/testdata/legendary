#!/usr/bin/env python3
"""A fake legendary for the plugin's tests. It mimics the output formats of
the real CLI (legendary/cli.py: list/list-installed/info/launch --json, the
DLManager progress log lines) without touching the network. State lives in
$FAKE_LEGENDARY_STATE; every call is appended to $FAKE_LEGENDARY_STATE.calls."""

import json
import os
import shutil
import sys
import tempfile
import time

STATE = os.environ["FAKE_LEGENDARY_STATE"]
GOOD_CODE = "abcdef0123456789abcdef0123456789"
ACCOUNT_ID = "0123456789abcdef0123456789abcdef"

CATALOG = [
    {"app_name": "Goose", "app_title": "Untitled Goose Game", "latest": "1.0", "platforms": ["Windows"],
     "meta": {"keyImages": [{"type": "DieselGameBoxTall", "url": "https://cdn1.epicgames.com/goose-tall.jpg"},
                            {"type": "DieselGameBox", "url": "https://cdn1.epicgames.com/goose-wide.jpg"},
                            {"type": "Screenshot", "url": "https://cdn1.epicgames.com/goose-shot1.jpg"}],
               "description": "A troublesome goose.\nLonger text.",
               "categories": [{"value": "Comedy"}], "developer": [{"value": "House House"}],
               "publisher": [{"value": "Panic"}], "releaseDate": "2019-09-20T00:00:00Z"},
     "achievements": {"achievement_set": {"achievements_count": 2,
                                          "achievements": [{"id": "prank", "displayName": "First prank", "description": "Be a goose.",
                                                            "icons": [{"url": "https://cdn1.epicgames.com/prank.png"}]},
                                                           {"id": "honk", "displayName": "Honk", "description": "Honk.",
                                                            "icons": [{"url": "https://cdn1.epicgames.com/honk.png"}]}]}}},
    {"app_name": "Pre", "app_title": "Preinstalled", "latest": "1.1", "platforms": ["Windows"], "meta": {}},
    {"app_name": "GooseDLC", "app_title": "Goose DLC", "latest": "1.0", "platforms": ["Windows"],
     "meta": {"mainGameItem": {"id": "x"}}},
    {"app_name": "Origin", "app_title": "An EA Game", "latest": "", "platforms": [],
     "meta": {"customAttributes": {"ThirdPartyManagedApp": {"type": "STRING", "value": "Origin"}}}},
]


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except FileNotFoundError:
        return {"account": None, "installed": {}}


def save(st):
    # Atomic replace: a concurrent reader (the conformance suite runs 5
    # library.list while an install/update job runs) must never see the
    # truncated moment of an in-place "w" write — that raced as a
    # JSONDecodeError: "Expecting value: line 1 column 1" (the file was
    # empty at read time), failing library.list at random.
    d = os.path.dirname(STATE) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".state-", suffix=".json")
    with os.fdopen(fd, "w") as f:
        json.dump(st, f)
    os.replace(tmp, STATE)


def err(msg, code=1):
    print(f"[cli] ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def latest_version(st, app):
    """The store's current build: state's per-game override, else the catalogue's."""
    return (st.get("latest") or {}).get(app) or next(g["latest"] for g in CATALOG if g["app_name"] == app)


def config_dir():
    """legendary's config folder, where manifests are saved (lfs/lgndry.py)."""
    return os.environ.get("LEGENDARY_CONFIG_PATH") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "legendary")


def manifest_path(app, platform, version):
    name = "".join(c for c in f"{app}_{platform}_{version}" if c not in '<>:"/\\|?*')
    return os.path.join(config_dir(), "manifests", name + ".manifest")


def write_manifest(app, platform, version):
    """The manifest legendary saves after preparing a download (save_manifest).
    Its fields are what `legendary info <file> --json` reports."""
    path = manifest_path(app, platform, version)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    build = "".join(c for c in version if c.isdigit()) or "1"
    data = {"app_name": app, "build_version": version, "build_id": build,
            "download_size": 7 * 1024 * 1024, "disk_size": 9 * 1024 * 1024,
            "file_manifest_list": [{"path": "Binaries/Game.exe", "size": 2}]}
    with open(path, "w") as f:
        json.dump(data, f)
    return path


def read_manifest(path):
    with open(path) as f:
        return json.load(f)


def no_credentials():
    """What upstream does when core.login() finds no user.json."""
    print("Traceback (most recent call last):", file=sys.stderr)
    print('  File ".../legendary/core.py", line 224, in _login', file=sys.stderr)
    print("    raise ValueError('No saved credentials')", file=sys.stderr)
    print("ValueError: No saved credentials", file=sys.stderr)
    sys.exit(1)


def main():
    args = [a for a in sys.argv[1:] if a not in ("-y", "--yes")]
    with open(STATE + ".calls", "a") as f:
        f.write(" ".join(args) + "\n")
    if args[0] in ("--version", "version"):
        print(f'legendary version "{os.environ.get("FAKE_LEGENDARY_VERSION", "0.21.1")}", '
              'codename "Fake"')
        return
    st = load()
    cmd, rest = args[0], args[1:]

    if cmd == "status":
        print(json.dumps({"account": st["account"] or "<not logged in>", "games_available": len(CATALOG),
                          "games_installed": len(st["installed"]), "egl_sync_enabled": False,
                          "config_directory": "/fake/.config/legendary"}))
    elif cmd == "auth":
        if "--delete" in rest:
            st["account"] = None
            save(st)
            print("[cli] INFO: User data deleted.", file=sys.stderr)
            return
        code = rest[rest.index("--code") + 1]
        if code != GOOD_CODE:
            print("[cli] ERROR: Login attempt failed, please see log for details.", file=sys.stderr)
            return  # the real CLI exits 0 here too
        st["account"] = "EpicUser"
        save(st)
        print('[cli] INFO: Successfully logged in as "EpicUser"', file=sys.stderr)
    elif cmd == "list":
        if not st["account"]:
            err("Login failed, cannot continue!")
        out = []
        for g in CATALOG:
            out.append({"metadata": g["meta"], "app_name": g["app_name"], "app_title": g["app_title"],
                        "asset_infos": {p: {"app_name": g["app_name"], "build_version": latest_version(st, g["app_name"])} for p in g["platforms"]},
                        "base_urls": [], "sidecar": None, "achievements": g.get("achievements"), "dlcs": []})
        print(json.dumps(out))
    elif cmd == "list-installed":
        print(json.dumps([dict(v, app_name=k) for k, v in st["installed"].items()]))
    elif cmd == "info":
        target = rest[0]
        if os.path.exists(target):
            m = read_manifest(target)
            print(json.dumps({"game": {}, "install": {}, "manifest": {
                "app_name": m.get("app_name", ""), "build_version": m.get("build_version", ""),
                "build_id": m.get("build_id", ""),
                "disk_size": m.get("disk_size", 0), "download_size": m.get("download_size", 0)}}))
        else:
            print(json.dumps({"game": {}, "install": {}, "manifest": {"disk_size": 12 * 1024 * 1024, "download_size": 10 * 1024 * 1024}}))
    elif cmd == "install":
        app = rest[0]
        update = "--update-only" in rest
        if update and app not in st["installed"]:
            err(f'Update requested for "{app}", but app not installed!')
        game = next(g for g in CATALOG if g["app_name"] == app)
        platform = rest[rest.index("--platform") + 1] if "--platform" in rest else \
            st["installed"].get(app, {}).get("platform", "Windows")
        override = rest[rest.index("--manifest") + 1] if "--manifest" in rest else None
        version = read_manifest(override)["build_version"] if override else latest_version(st, app)
        if update:
            st["installed"][app]["version"] = version
            write_manifest(app, platform, version)
            save(st)
            print("[cli] INFO: Finished installation process in 0.10 seconds.", file=sys.stderr)
            return
        base = rest[rest.index("--base-path") + 1]
        # Like the real tool: the game folder (with its download cache) and a
        # resume file in the config folder exist before the first byte lands.
        if app in st["installed"]:
            path = st["installed"][app]["install_path"]
        else:
            path = os.path.join(base, game["app_title"].replace(" ", ""))
        os.makedirs(os.path.join(path, ".cache"), exist_ok=True)
        cfg = os.environ.get("LEGENDARY_CONFIG_PATH")
        if cfg:
            os.makedirs(os.path.join(cfg, "tmp"), exist_ok=True)
            open(os.path.join(cfg, "tmp", f"{app}.resume"), "w").write("{}")
        step = float(os.environ.get("FAKE_LEGENDARY_STEP", "0.1"))
        print(f"[cli] INFO: Install size: 12.00 MiB", file=sys.stderr, flush=True)
        print(f"[cli] INFO: Download size: 10.00 MiB (Compression savings: 16.7%)", file=sys.stderr, flush=True)
        for i, mib in enumerate((2.5, 5.0, 10.0), 1):
            time.sleep(step)
            pct = mib * 10
            print(f"[DLManager] INFO: = Progress: {pct:.02f}% ({i}/3), Running for 00:00:0{i}, ETA: 00:00:01", file=sys.stderr, flush=True)
            print(f"[DLManager] INFO:  - Downloaded: {mib:.02f} MiB, Written: {mib:.02f} MiB", file=sys.stderr, flush=True)
            print(f"[DLManager] INFO:  + Download\t- 25.00 MiB/s (raw) / 30.00 MiB/s (decompressed)", file=sys.stderr, flush=True)
        os.makedirs(os.path.join(path, "Binaries"), exist_ok=True)
        shutil.rmtree(os.path.join(path, ".cache"), ignore_errors=True)
        if cfg:
            os.unlink(os.path.join(cfg, "tmp", f"{app}.resume"))
        open(os.path.join(path, "Binaries", "Game.exe"), "wb").write(b"MZ")
        write_manifest(app, platform, version)  # save_manifest, as prepare_download does
        st["installed"][app] = {"install_path": path, "title": game["app_title"], "version": version,
                                "platform": platform, "install_size": 12 * 1024 * 1024, "is_dlc": False,
                                "executable": "Binaries\\Game.exe", "can_run_offline": True}
        save(st)
        print("[cli] INFO: Finished installation process in 0.30 seconds.", file=sys.stderr)
    elif cmd == "move":
        if os.environ.get("FAKE_LEGENDARY_MOVE_FAIL"):
            print("[cli] FATAL: Failed to acquire installed data lock, only one instance of Legendary "
                  "may install/import/move applications at a time.", file=sys.stderr)
            return
        app, new_base = rest[0], rest[1]
        ig = st["installed"].get(app)
        if not ig:
            err(f'No installed game found for "{app}"')
        ig["install_path"] = os.path.join(new_base, os.path.basename(ig["install_path"]))
        save(st)
        print("[cli] INFO: Not moving, just rewriting legendary metadata...", file=sys.stderr)
        print("[cli] INFO: Finished.", file=sys.stderr)
    elif cmd in ("verify", "repair"):
        app = rest[0]
        ig = st["installed"].get(app)
        if not ig:
            err(f'Game "{app}" is not installed')
        path = ig["install_path"]
        if not os.path.isdir(path):
            err(f'Install path "{path}" does not exist')
        if os.path.exists(os.path.join(path, ".no-manifest")):
            print("[cli] CRITICAL: Manifest appears to be missing! To repair, run "
                  f'"legendary repair {app} --repair-and-update"', file=sys.stderr)
            return
        damaged = 1 if os.path.exists(os.path.join(path, ".damaged")) else 0
        total = 3
        for i in range(1, total + 1):
            sys.stdout.write(f'Verification progress: {i}/{total} ({i * 100 / total:.01f}%) [10.0 MiB/s]\t\r')
            sys.stdout.flush()
        sys.stdout.write(f'Verification progress: {total}/{total} (100.0%) [10.0 MiB/s]\t\n')
        sys.stdout.flush()
        if damaged:
            print('[cli] ERROR: File does not match hash: "Binaries/Game.exe"', file=sys.stderr)
            print(f'[cli] ERROR: Verification failed, {damaged} file(s) corrupted, 0 file(s) are missing.',
                  file=sys.stderr)
        else:
            print("[cli] INFO: Verification finished successfully.", file=sys.stderr)
        if cmd == "repair":
            if not damaged:
                print("[cli] INFO: Download size is 0, the game is either already up to date or has not "
                      "changed. Exiting...", file=sys.stderr)
                return
            print("[cli] INFO: Download size: 1.00 MiB (Compression savings: 0.0%)", file=sys.stderr, flush=True)
            if os.path.exists(os.path.join(path, ".repair-fail")):
                print("[cli] ERROR: Installation failed: fake download error", file=sys.stderr)
                return
            for i, mib in enumerate((0.5, 1.0), 1):
                print(f"[DLManager] INFO: = Progress: {i * 50:.02f}% ({i}/2), Running for 00:00:0{i}, "
                      f"ETA: 00:00:01", file=sys.stderr, flush=True)
                print(f"[DLManager] INFO:  - Downloaded: {mib:.02f} MiB, Written: {mib:.02f} MiB",
                      file=sys.stderr, flush=True)
            os.unlink(os.path.join(path, ".damaged"))
            print("[cli] INFO: Finished installation process in 0.10 seconds.", file=sys.stderr)
    elif cmd == "achievements":
        app = rest[0]
        if not st["account"]:
            no_credentials()
        game = next((g for g in CATALOG if g["app_name"] == app), None)
        if not game:
            err(f'No game found for "{app}"')
        ach = game.get("achievements")
        if not ach:
            print(f'[cli] INFO: No achievements found for "{app}"', file=sys.stderr)
            return
        unlocked = {"prank": "N/A" if os.path.exists(STATE + ".na-unlock")
                    else "2020-05-01 12:00:00.123456+00:00"}
        groups = {"completed": [], "in_progress": [], "uninitiated": [], "hidden": []}
        for e in ach["achievement_set"]["achievements"]:
            is_unlocked = e["id"] in unlocked
            entry = {"name": e["id"], "is_base": True, "hidden": False if is_unlocked else e["id"] == "honk",
                     "xp": 0, "unlocked": is_unlocked, "progress": 1.0 if is_unlocked else 0.0,
                     "unlock_date": unlocked.get(e["id"]), "display_name": e["displayName"],
                     "description": e["description"], "icon_id": "", "icon_link": e["icons"][0]["url"],
                     "tier": None, "rarity": {"percent": 42.5} if e["id"] == "honk" else None}
            group = "completed" if is_unlocked else ("hidden" if entry["hidden"] else "uninitiated")
            groups[group].append(entry)
        print(json.dumps({"total_achievements": ach["achievement_set"]["achievements_count"],
                          "total_product_xp": 0, "achievement_sets": [], "platinum_rarity": None,
                          "completed": groups["completed"], "in_progress": groups["in_progress"],
                          "uninitiated": groups["uninitiated"], "hidden": groups["hidden"],
                          "user_unlocked": len(groups["completed"]), "user_xp": 0, "user_awards": []}))
    elif cmd == "get-token":
        if not st["account"]:
            no_credentials()
        print(json.dumps({"token_type": "bearer", "access_token": "eg1~faketoken", "expires_in": 7200,
                          "expires_at": "2026-01-01T00:00:00.000Z", "account_id": ACCOUNT_ID}))
    elif cmd == "uninstall":
        app = rest[0]
        ig = st["installed"].pop(app, None)
        if not ig:
            err(f'Game "{app}" is not installed')
        time.sleep(0.6)  # real uninstalls take a moment; leaves room for job.cancel
        shutil.rmtree(ig["install_path"], ignore_errors=True)
        save(st)
    elif cmd == "launch":
        app = rest[0]
        ig = st["installed"].get(app)
        if not ig:
            err(f"Game {app} is not currently installed!")
        offline = "--offline" in rest
        latest = latest_version(st, app)
        if "--skip-version-check" not in rest and latest != ig["version"]:
            err("Game is out of date, please update or launch with update check skipping!")
        token = "" if offline else "exchange0123456789"
        print(json.dumps({
            "game_parameters": ["-SaveToUserDir"],
            "game_executable": ig["executable"].replace("\\", "/"),
            "game_directory": ig["install_path"],
            "egl_parameters": ["-AUTH_LOGIN=unused", f"-AUTH_PASSWORD={token}", "-AUTH_TYPE=exchangecode",
                               f"-epicapp={app}", "-epicenv=Prod", "-EpicPortal", "-epicusername=EpicUser",
                               "-epicuserid=0123", "-epiclocale=en", "-epicsandboxid=ns"],
            "launch_command": ["wine"],
            "working_directory": os.path.join(ig["install_path"], "Binaries"),
            "user_parameters": [],
            "environment": {"WINEPREFIX": "/home/u/.wine", "DXVK_HUD": "fps"},
            "pre_launch_command": "",
            "pre_launch_wait": False,
        }))
    else:
        err(f"fake legendary doesn't know {cmd}")


if __name__ == "__main__":
    main()
