#!/usr/bin/env python3
"""Platypus store plugin for Ubisoft Connect (issues #193/#194, #212/#213).

The official Ubisoft Connect client, in one Platypus-managed Wine prefix,
owns installs and launches; this plugin only answers specs and reads the
client's on-disk state (docs/research/ubisoft-options.md §1-§5). No Ubisoft
account is handled here: the user signs into the real client, Platypus never
sees the password and never sends an app id. The plugin starts no process of
its own: only the core runs Wine (installer, client, client commands), from
the specs this plugin answers.

Speaks Platypus's plugin protocol (api 1, docs/plugins/protocol.md): JSON-RPC 2.0
over stdin/stdout, one object per line. Negotiates 1.20 or 1.23 (whichever
the core offers highest): the `install` capability is on only over 1.23,
where game.install/game.update/game.uninstall answer a clientRun command
(`uplay://install/<id>` / `uplay://uninstall/<id>`) the core runs in the
pinned client prefix as part of the plugin's job, and the plugin ends the
job from its watch of the client's on-disk install state.

What is real here and what is a stand-in (live checks L-U1/L-U2, issue #195):

- `client.setup` downloads the pinned Connect installer to
  PLATYPUS_PLUGIN_DATA (kept across restarts, hash-verified), copies it into
  the client prefix for the run (the spec's exe must validate inside the
  prefix), and answers `{exe, args: ["/S"], size, confirm}`. The copy stays in
  the prefix: the protocol gives the plugin no post-setup callback. The
  Lutris recipe also applies winetricks `d3dcompiler_43` + `corefonts` and
  disables the overlay; nothing applies those yet (see README).
- `game.launchSpec` answers the `wine-client` delegate: the client exe with
  `uplay://launch/<id>/0`, and `find` carries the game's exe name from the
  client's own product catalogue, never anything matching the client command.
  When the client exe is missing the spec is still answered (Windows paths):
  the core's validation reports `client.notSetUp` and the game page offers the
  setup.
- `game.clientStatus` maps what the prefix shows onto the accepted states:
  no client exe → `idle`, game installed → `launching`, client process up
  without the game past a short grace → `signin` (the user must act in the
  client: sign in, accept terms, confirm a dialog), else `updating`
  (waiting for sign-in). A first-run client self-update or sign-in can take a
  while, hence the generous `startTimeout`; a dedicated waiting-for-signin
  state is protocol 1.23 (issue #213).
- `library.list` reads the client's own caches in the prefix (issue #192;
  docs/research/ubisoft-library-format.md is the clean-room format note this
  reader was written from): the product catalogue
  `AppData/Local/Ubisoft Game Launcher/cache/configuration/configurations`, the
  account's `cache/ownership/<userId>`, and the install records in Wine's
  `system.reg` (`HKLM\\Software\\Wow6432Node\\Ubisoft\\Launcher\\Installs\\<id>\\InstallDir`).
  Owned, launchable games are listed; DLC/add-ons are filtered out; installed
  ones carry the registry path. When the caches are missing, encrypted (the
  2026 `.vdat` container), or unreadable, the plugin answers one clear status
  instead of a per-call error: "Start Ubisoft Connect once and sign in so
  Platypus can read your games", localized from the protocol `locale` (1.14).

Signin heuristic (no account, no client API): the plugin scans /proc for a
process naming the client executable (UbisoftConnect.exe / upc.exe) whose
WINEPREFIX is this prefix (or whose command line holds it when no environ
is visible; other users' processes never count; rescanned at most every
2 s). A launchable game (a catalogue record naming a game exe) whose client
runs in this prefix without the game past SIGNIN_GRACE_SECONDS is a client
waiting for the user (`signin`); a running game is `launching` as before.
First-seen times are kept in memory only. PLATYPUS_UBISOFT_SIGNIN_GRACE
overrides the grace in tests.

Test hooks (never set in production): PLATYPUS_UBISOFT_INSTALLER_URL,
PLATYPUS_UBISOFT_INSTALLER_SHA256 and PLATYPUS_UBISOFT_INSTALLER_SIZE
override the pin below, so tests drive the real fetch path through a
loopback server with no network. PLATYPUS_UBISOFT_WATCH_TIMEOUT and
PLATYPUS_UBISOFT_WATCH_POLL bound the install/uninstall watch;
PLATYPUS_UBISOFT_SIGNIN_GRACE overrides the signin grace.
"""

import hashlib
import json
import os
import re
import shutil
import sys
import tempfile
import threading
import time
import urllib.parse
import urllib.request

API = 1
PLUGIN_VERSION = "0.3.0"
# The manifest's promise; initialize narrows it to what was negotiated
# (install only over 1.23).
CAPABILITIES = ["library", "install", "launch"]

# Pinned Connect installer (Lutris `ubisoft-connect-latest` recipe):
# Pinned 2026-11-17: download once, sha256sum it, delete it. To bump: fetch
# the new installer from the same URL, replace SHA-256 and SIZE below, and
# note the date. Never check the binary itself into the repo.
INSTALLER_URL = ("https://ubistatic3-a.akamaihd.net/orbit/launcher_installer/"
                 "UbisoftConnectInstaller.exe")
INSTALLER_SHA256 = "50431349564846c751281be4b855e00cc6a6d9ffcb2f8ec88c6745a61ad0d4b8"
INSTALLER_SIZE = 259083384  # bytes on 2026-11-17 (~247 MB)
INSTALLER_NAME = "UbisoftConnectInstaller.exe"
INSTALLER_ARGS = ["/S"]  # silent install, per the Lutris recipe

# The client executable: UbisoftConnect.exe is the modern name (preferred),
# upc.exe the older one both the research and unifideck attest. The exact
# install folder is confirmed against a real prefix in L-U1 (#195).
CLIENT_DIR_WINDOWS = ("C:\\Program Files (x86)\\Ubisoft\\Ubisoft Game Launcher")
CLIENT_NAMES = ("UbisoftConnect.exe", "upc.exe")
# find must never match the client command itself, only the game process.
CLIENT_NAMES_LOWER = frozenset(n.lower() for n in CLIENT_NAMES)
# First-run self-update plus sign-in can take a while (within the protocol's
# 30-minute clamp on startTimeout).
START_TIMEOUT = 900

# Protocol versions spoken: 1.20 (setup + launch), 1.23 (plus install via
# clientRun, and the signin clientStatus state) and 1.25 (plus client.openSpec,
# so the card can open the client with no game). The install capability is
# on only when 1.23 or later is negotiated.
PROTOCOLS = ("1.20", "1.23", "1.25")

# Seconds a client process may run without the game before clientStatus
# reports signin (the user must act in the client). Overridden in tests.
SIGNIN_GRACE_SECONDS = 30.0

# Bounds for the install/uninstall watch (the plugin ends its own job from
# the client's on-disk state). Overridden in tests.
WATCH_TIMEOUT_SECONDS = 30 * 60.0
WATCH_POLL_SECONDS = 0.5
# Wine and Proton prefix layouts, probed in this order.
LAYOUTS = ("drive_c", os.path.join("pfx", "drive_c"))

# The client's on-disk library state in the prefix (issue #192; see
# docs/research/ubisoft-library-format.md). Both cache files are read-only.
CONFIG_DIRS = ("cache", "configuration")
CONFIG_NAME = "configurations"
CONFIG_VDAT = "configurations.vdat"
OWNERSHIP_DIRS = ("cache", "ownership")
INSTALLS_RE = re.compile(r"(?i)^software\\(wow6432node\\)?ubisoft\\launcher\\"
                         r"installs\\([0-9]+)$")
MAX_CACHE_BYTES = 32 << 20      # a real configurations file is a few MB
MAX_REG_BYTES = 32 << 20        # system.reg is ~1 MB in a normal prefix
MAX_CACHE_RECORDS = 50000

# The user's BCP 47 locale from initialize {locale} (protocol 1.14), kept
# current through locale.changed {locale}: the empty-library status is
# returned already-localized for it (issue #39), English by default.
LOCALE = "en"
LOCALES = {
    "en": {
        "needs_client": "Start Ubisoft Connect once and sign in so Platypus "
                        "can read your games",
    },
    "fr": {
        "needs_client": "Lancez Ubisoft Connect une fois et connectez-vous "
                        "pour que Platypus puisse lire vos jeux",
    },
}

# The "library not readable" state: -32002 is the protocol's "unavailable
# right now", which the core shows as a library warning with the message as
# written and no login prompt (there is no auth capability here).
CODE_UNAVAILABLE = -32002

# Test-only pin overrides (see module docstring).
HOOK_URL = "PLATYPUS_UBISOFT_INSTALLER_URL"
HOOK_SHA256 = "PLATYPUS_UBISOFT_INSTALLER_SHA256"
HOOK_SIZE = "PLATYPUS_UBISOFT_INSTALLER_SIZE"
HOOK_WATCH_TIMEOUT = "PLATYPUS_UBISOFT_WATCH_TIMEOUT"
HOOK_WATCH_POLL = "PLATYPUS_UBISOFT_WATCH_POLL"
HOOK_SIGNIN_GRACE = "PLATYPUS_UBISOFT_SIGNIN_GRACE"

out_lock = threading.Lock()
_state_lock = threading.Lock()
# The .vdat detail is logged once per process, not per library.list call.
_warned_vdat = False
# The negotiated protocol ("1.20" until initialize runs); the install
# capability is on only over 1.23.
_negotiated = "1.20"
# First-seen times (monotonic) of a running client without the game, by
# (prefix, app): the signin grace heuristic. In memory only.
_client_seen = {}
# Stop flags for install/uninstall watches, by jobId.
_watch_stops = {}
# Stat-keyed parse caches: the library (a few MB of protobuf/YAML) and the
# install registry (read by the 2 s clientStatus polls and the job watch).
_library_cache = {}
_installs_cache = {}


class RPCError(Exception):
    def __init__(self, message, code=-32000):
        super().__init__(message)
        self.code = code


def send(msg):
    msg["jsonrpc"] = "2.0"
    line = json.dumps(msg, separators=(",", ":"))
    with out_lock:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()


def notify(method, params):
    send({"method": method, "params": params})


def log(level, message):
    notify("log", {"level": level, "message": message})


def data_dir():
    return os.environ.get("PLATYPUS_PLUGIN_DATA") or "."


def prefix_file():
    return os.path.join(data_dir(), "client-prefix")


def remember_prefix(prefix):
    with open(prefix_file(), "w") as f:
        f.write(prefix)


def remembered_prefix():
    try:
        with open(prefix_file()) as f:
            return f.read().strip()
    except OSError:
        return ""


def layouts(prefix):
    """The Wine and Proton drive layouts under the prefix, in probe order."""
    return [os.path.join(prefix, lay) for lay in LAYOUTS]


def find_client_exe(prefix):
    """The client's absolute Linux path, preferred name then fallback, Wine
    layout then Proton layout, or None (see CLIENT_NAMES)."""
    for drive in layouts(prefix):
        for name in CLIENT_NAMES:
            exe = os.path.join(drive, "Program Files (x86)", "Ubisoft",
                               "Ubisoft Game Launcher", name)
            if os.path.isfile(exe):
                return exe
    return None


def set_locale(tag):
    """The user's BCP 47 locale (protocol 1.14); English when empty."""
    global LOCALE
    LOCALE = str(tag or "").strip() or "en"


def tr(key):
    """A user-facing string for the current locale, English per key."""
    tag = LOCALE.strip().lower().replace("_", "-")
    table = LOCALES.get(tag.split("-")[0]) or LOCALES["en"]
    return table.get(key) or LOCALES["en"][key]


# The client's caches are protobuf containers of bounded varint/
# length-delimited fields (docs/research/ubisoft-library-format.md §§2-3).
# The walker below refuses truncated or oversized input instead of reading
# past it, and every caller turns a refusal into the one "unreadable" state.

def _varint(buf, i):
    """(value, next index) of one base-128 varint."""
    value = 0
    shift = 0
    while True:
        if i >= len(buf) or shift > 63:
            raise ValueError("truncated varint")
        byte = buf[i]
        i += 1
        value |= (byte & 0x7F) << shift
        if not byte & 0x80:
            return value, i
        shift += 7


def _fields(buf):
    """(field, int | bytes) for each protobuf field in buf, in order.

    Varint and length-delimited fields only: the client's caches use no
    packed fixed-width fields. A truncated or malformed field raises
    ValueError, which every caller turns into the unreadable-cache state."""
    i = 0
    while i < len(buf):
        key, i = _varint(buf, i)
        field, wire = key >> 3, key & 7
        if field == 0:
            raise ValueError("field 0")
        if wire == 0:
            value, i = _varint(buf, i)
            yield field, value
        elif wire == 2:
            size, i = _varint(buf, i)
            if size > len(buf) - i:
                raise ValueError("truncated field")
            yield field, buf[i:i + size]
            i += size
        elif wire == 1:
            if len(buf) - i < 8:
                raise ValueError("truncated field")
            i += 8
        elif wire == 5:
            if len(buf) - i < 4:
                raise ValueError("truncated field")
            i += 4
        else:
            raise ValueError(f"wire type {wire}")


def parse_configurations(data):
    """[(product id, YAML text)] from a `configurations` payload.

    ConfigurationCache's repeated field 1 holds one Configuration per
    product: field 1 product id, field 2 uplay id, field 3 the YAML blob."""
    out = []
    for field, value in _fields(data):
        if field != 1 or not isinstance(value, bytes):
            continue
        product = 0
        text = ""
        for sub, inner in _fields(value):
            if sub == 1 and isinstance(inner, int):
                product = inner
            elif sub == 3 and isinstance(inner, bytes):
                text = inner.decode("utf-8", "replace")
        if product and text:
            out.append((product, text))
            if len(out) >= MAX_CACHE_RECORDS:
                break
    return out


def parse_ownership(data):
    """The product ids an `ownership/<userId>` payload says the account owns.

    OwnershipCache: field 1 is one OwnedGame per product (product id in
    field 1), field 2 the same set as plain/packed uint32 ids. Field 3
    (visible or installable) is a superset that includes add-ons, so it is
    not read on its own."""
    owned = set()
    for field, value in _fields(data):
        if field == 1 and isinstance(value, bytes):
            try:
                for sub, inner in _fields(value):
                    if sub == 1 and isinstance(inner, int) and inner:
                        owned.add(inner)
                continue
            except ValueError:
                pass  # not an OwnedGame list: read it as packed ids below
            i = 0
            while i < len(value):
                product, i = _varint(value, i)
                if product:
                    owned.add(product)
        elif field == 2 and isinstance(value, int) and value:
            owned.add(value)
        elif field == 2 and isinstance(value, bytes):
            i = 0
            while i < len(value):
                product, i = _varint(value, i)
                if product:
                    owned.add(product)
    return owned


def _yaml_value(text):
    text = text.strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
        return text[1:-1]
    cut = text.find(" #")
    if cut >= 0:
        text = text[:cut].rstrip()
    return text


def config_hints(text):
    """(title, is_ulc, third_party, exe) from one product's YAML config.

    A deliberately small key scanner, not a YAML parser: it follows the
    `root:` block by indentation and reads only the keys the library needs
    (docs/research/ubisoft-library-format.md §2). `exe` is the basename of
    the first `start_game` executable."""
    title = ""
    identifier = ""
    is_ulc = False
    third_party = False
    exe = ""
    in_root = False
    child_indent = None
    installer_indent = None
    start_indent = None
    exec_indent = None
    for raw in text.splitlines():
        line = raw.rstrip("\r")
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" \t"))
        if indent == 0:
            in_root = stripped == "root:"
            child_indent = installer_indent = start_indent = exec_indent = None
            continue
        if not in_root:
            continue
        if child_indent is None and not stripped.startswith("-"):
            child_indent = indent
        key, _sep, rest = stripped.partition(":")
        key = key.strip()
        value = rest.strip()
        if installer_indent is not None:
            if indent <= installer_indent:
                installer_indent = None
            elif key == "game_identifier" and not identifier:
                identifier = _yaml_value(value)
        if start_indent is not None:
            if indent <= start_indent:
                start_indent = exec_indent = None
            elif key == "executables":
                exec_indent = indent
            elif exec_indent is not None:
                # The list items sit either below the key or at its own
                # indent ("executables:" then "- path:"); the first
                # relative path in the block is the game executable (an
                # updater entry may follow it).
                if indent <= exec_indent and not stripped.startswith("- "):
                    exec_indent = None
                elif key == "relative" and not exe:
                    exe = os.path.basename(
                        _yaml_value(value).replace("\\", "/"))
        if indent != child_indent or stripped.startswith("-"):
            continue
        start_indent = exec_indent = None
        if key == "name":
            title = _yaml_value(value)
        elif key == "is_ulc":
            is_ulc = _yaml_value(value).lower() in ("yes", "true", "on", "y",
                                                    "1")
        elif key == "third_party_platform":
            third_party = True
        elif key == "installer":
            installer_indent = indent
        elif key == "start_game":
            start_indent = indent
    return (title or identifier, is_ulc, third_party, exe)


def _reg_quoted(text):
    """(unquoted string, text after the closing quote), or (None, text)."""
    if not text.startswith('"'):
        return None, text
    out = []
    i = 1
    while i < len(text):
        char = text[i]
        if char == "\\" and i + 1 < len(text):
            nxt = text[i + 1]
            out.append({"\\": "\\", '"': '"', "n": "\n", "r": "\r",
                        "t": "\t"}.get(nxt, nxt))
            i += 2
            continue
        if char == '"':
            return "".join(out), text[i + 1:]
        out.append(char)
        i += 1
    return None, text


def parse_installs(text):
    """product id -> Windows install dir from a Wine `system.reg` (read-only).

    Only the client's own install keys count:
    HKLM\\Software[\\Wow6432Node]\\Ubisoft\\Launcher\\Installs\\<id>.
    Keys and strings are escaped like any .reg text (\\\\ and \\")."""
    out = {}
    current = None
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or line.startswith(";"):
            continue
        if line.startswith("["):
            end = line.find("]")
            current = None
            if end > 0:
                key = line[1:end].replace("\\\\", "\\")
                match = INSTALLS_RE.match(key)
                if match:
                    current = match.group(2)
            continue
        if current is None or not line.startswith('"'):
            continue
        name, rest = _reg_quoted(line)
        if name is None:
            continue
        rest = rest.lstrip()
        if not rest.startswith("="):
            continue
        value, _end = _reg_quoted(rest[1:].lstrip())
        if name == "InstallDir" and value:
            out.setdefault(current, value)
    return out


def installs(prefix):
    """The client's install registry in this prefix (stat-cached)."""
    path = os.path.join(prefix, "system.reg")
    try:
        st = os.stat(path)
    except OSError:
        return {}
    stamp = (st.st_mtime_ns, st.st_size)
    with _state_lock:
        hit = _installs_cache.get(prefix)
        if hit and hit[0] == stamp:
            return hit[1]
    try:
        with open(path, "rb") as f:
            data = f.read(MAX_REG_BYTES)
    except OSError:
        return {}
    parsed = parse_installs(data.decode("utf-8", "replace"))
    with _state_lock:
        _installs_cache[prefix] = (stamp, parsed)
    return parsed


def install_dir(prefix, app):
    """The Windows install dir the client recorded for app, or ""."""
    return installs(prefix).get(str(app), "")


def windows_path(prefix, winpath):
    """The Linux path of a registry Windows path, or "" if unmappable."""
    text = str(winpath or "").replace("/", "\\")
    drive, sep, rest = text.partition(":")
    if not sep or len(drive) != 1:
        return ""
    raw = [part for part in rest.split("\\") if part]
    if any(part == ".." for part in raw):
        return ""
    parts = [part for part in raw if part != "."]
    if drive.upper() == "C":
        base = next((d for d in layouts(prefix) if os.path.isdir(d)),
                    os.path.join(prefix, "drive_c"))
    else:
        # Wine drive letters are the prefix's own dosdevices mappings (Z: is
        # / by default), so the result is a host path outside the prefix:
        # that is where the client really installed the game.
        base = os.path.realpath(os.path.join(prefix, "dosdevices",
                                             drive.lower() + ":"))
        if not os.path.isdir(base):
            return ""
    return os.path.join(base, *parts) if parts else base


def launcher_roots(prefix):
    """The `Ubisoft Game Launcher` folders a prefix may hold, users first."""
    roots = []
    for drive in layouts(prefix):
        users = os.path.join(drive, "users")
        try:
            names = sorted(os.listdir(users))
        except OSError:
            names = []
        for name in names:
            roots.append(os.path.join(users, name, "AppData", "Local",
                                      "Ubisoft Game Launcher"))
        roots.append(os.path.join(drive, "Program Files (x86)", "Ubisoft",
                                  "Ubisoft Game Launcher"))
    return roots


def cache_files(root):
    """(configurations, configurations.vdat, [ownership], [ownership .vdat])
    under one launcher root; empty strings and lists when absent."""
    config_dir = os.path.join(root, *CONFIG_DIRS)
    config = os.path.join(config_dir, CONFIG_NAME)
    vdat = os.path.join(config_dir, CONFIG_VDAT)
    own_dir = os.path.join(root, *OWNERSHIP_DIRS)
    try:
        names = sorted(os.listdir(own_dir))
    except OSError:
        names = []
    own, own_vdat = [], []
    for name in names:
        path = os.path.join(own_dir, name)
        if not os.path.isfile(path):
            continue
        if name.endswith(".vdat"):
            own_vdat.append(path)
        else:
            own.append(path)
    return (config if os.path.isfile(config) else "",
            vdat if os.path.isfile(vdat) else "", own, own_vdat)


def cache_state(prefix):
    """The cache files of the first launcher root that has a catalogue."""
    for root in launcher_roots(prefix):
        config, vdat, own, own_vdat = cache_files(root)
        if config or vdat:
            return root, config, vdat, own, own_vdat
    return "", "", "", [], []


def cache_stamp(prefix):
    """The identity of the cache files now: changes when the client rewrites
    them, which is what the install watch and the parse cache key on."""
    root, config, vdat, own, own_vdat = cache_state(prefix)
    stamp = [root, config, vdat]
    for path in [config, vdat] + own + own_vdat:
        if not path:
            continue
        try:
            st = os.stat(path)
            stamp.append((path, st.st_size, st.st_mtime_ns))
        except OSError:
            stamp.append((path, None, None))
    return tuple(stamp)


def _read_cache(path):
    """The file's bytes, refusing a file over the cap (read MAX+1, no stat)."""
    with open(path, "rb") as f:
        data = f.read(MAX_CACHE_BYTES + 1)
    if len(data) > MAX_CACHE_BYTES:
        raise ValueError("cache file too large")
    return data


def vdat_info(data):
    """(version, scheme) of an encrypted `versioned_storage` envelope.

    Detection only, never decryption: the 2026 client wraps the cache in
    this container and keeps the AES-256-GCM key DPAPI-protected outside the
    prefix (docs/research/ubisoft-library-format.md §5)."""
    try:
        for field, value in _fields(data):
            if field != 1 or not isinstance(value, bytes):
                continue
            for sub, header in _fields(value):
                if sub != 1 or not isinstance(header, bytes):
                    continue
                version, scheme = 0, -1
                for hf, hv in _fields(header):
                    if hf == 1 and isinstance(hv, int):
                        version = hv
                    elif hf == 2 and isinstance(hv, bytes):
                        for cf, cv in _fields(hv):
                            if cf == 1 and isinstance(cv, int):
                                scheme = cv
                return (version, scheme)
    except ValueError:
        return None
    return None


def _warn_vdat(path):
    """Log the .vdat detail once (the user-facing state is the same hint)."""
    global _warned_vdat
    with _state_lock:
        if _warned_vdat:
            return
        _warned_vdat = True
    info = None
    try:
        info = vdat_info(_read_cache(path))
    except (OSError, ValueError):
        pass
    detail = ""
    if info:
        detail = (f" (envelope version {info[0]}, encryption scheme "
                  f"{info[1]})")
    log("warning", "the Ubisoft Connect cache is encrypted (.vdat)"
        + detail + ": Platypus can't read the library from it")


def read_library(prefix):
    """(games, unreadable, {game id: exe}) from the client's caches.

    Never raises. Missing, encrypted or garbage caches all answer
    ([], True, {}); a cache that parses with nothing owned answers
    ([], False, {}) — the account simply has no games."""
    stamp = cache_stamp(prefix)
    with _state_lock:
        hit = _library_cache.get(prefix)
        if hit and hit[0] == stamp:
            return hit[1]
    result = _read_library(prefix)
    with _state_lock:
        _library_cache[prefix] = (stamp, result)
    return result


def _read_library(prefix):
    _root, config, vdat, own, own_vdat = cache_state(prefix)
    if not config:
        if vdat or own_vdat:
            _warn_vdat(vdat or own_vdat[0])
        return [], True, {}
    if not own:
        return [], True, {}
    try:
        configs = parse_configurations(_read_cache(config))
    except (OSError, ValueError):
        return [], True, {}
    if not configs:
        return [], True, {}
    owned = set()
    parsed = False
    for path in own:
        try:
            owned |= parse_ownership(_read_cache(path))
            parsed = True
        except (OSError, ValueError):
            continue  # a stale/garbage sidecar must not hide the others
    if not parsed:
        return [], True, {}
    installed = installs(prefix)
    games = []
    exes = {}
    seen = set()
    for product, text in configs:
        if product not in owned or product in seen:
            continue
        seen.add(product)
        title, ulc, third_party, exe = config_hints(text)
        if ulc or third_party or not exe:
            continue
        game = {"id": str(product),
                "title": title or f"Ubisoft {product}",
                "installed": False, "installable": True}
        win = installed.get(str(product))
        if win:
            game["installed"] = True
            path = windows_path(prefix, win)
            if path:
                game["installPath"] = path
        exes[game["id"]] = exe
        games.append(game)
    games.sort(key=lambda g: g["title"].casefold())
    return games, False, exes


def game_exe_name(prefix, app):
    """The exe name launchSpec tracks, or None when the game isn't installed
    (or the catalogue names no game exe, or names the client itself, which
    find must never match)."""
    if not install_dir(prefix, app):
        return None
    _games, _unreadable, exes = read_library(prefix)
    exe = exes.get(str(app), "")
    if not exe or exe.lower() in CLIENT_NAMES_LOWER:
        return None
    return exe


def install_snapshot(prefix, app):
    """The client's on-disk install state for app: (install dir, cache stamp).

    The install/update watch ends on a change from this: the client writes
    the product's InstallDir (install) or rewrites the catalogue cache."""
    return (install_dir(prefix, app), cache_stamp(prefix))


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            block = f.read(1 << 20)
            if not block:
                break
            h.update(block)
    return h.hexdigest()


def installer_pin():
    url = os.environ.get(HOOK_URL) or INSTALLER_URL
    sha = os.environ.get(HOOK_SHA256) or INSTALLER_SHA256
    try:
        size = int(os.environ.get(HOOK_SIZE) or INSTALLER_SIZE)
    except ValueError:
        size = INSTALLER_SIZE
    return url, sha, size


def bump_message():
    return ("the Ubisoft Connect installer failed its pin check "
            "(the pin may need a bump: see this plugin's docstring)")


def fetch_installer():
    """The pinned installer under PLATYPUS_PLUGIN_DATA, downloading and
    verifying it as needed. A complete verified file is kept across
    restarts; each download goes to a unique temp file."""
    url, sha, size = installer_pin()
    os.makedirs(data_dir(), exist_ok=True)
    cached = os.path.join(data_dir(), INSTALLER_NAME)
    if (os.path.isfile(cached) and os.path.getsize(cached) == size
            and sha256_file(cached) == sha):
        return cached
    fd, tmp = tempfile.mkstemp(dir=data_dir(), prefix=INSTALLER_NAME + ".")
    try:
        with os.fdopen(fd, "wb") as f:
            with urllib.request.urlopen(url, timeout=600) as r:
                shutil.copyfileobj(r, f)
        if os.path.getsize(tmp) != size:
            raise RPCError(bump_message())
        if sha256_file(tmp) != sha:
            raise RPCError(bump_message())
        os.replace(tmp, cached)
    except RPCError:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise
    except Exception as e:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise RPCError(f"couldn't download the Ubisoft Connect installer: {e}")
    return cached


def pick_protocol(offered):
    """The highest protocol both sides speak (1.20, 1.23 or 1.25)."""
    for version in ("1.25", "1.23"):
        if version in (offered or []) and version in PROTOCOLS:
            return version
    return "1.20"


def initialize(params):
    global _negotiated
    offered = params.get("protocols") or []
    if not isinstance(offered, list):
        offered = []
    set_locale(params.get("locale"))
    _negotiated = pick_protocol([str(v) for v in offered])
    caps = ["library", "launch"]
    if _negotiated in ("1.23", "1.25"):
        caps = ["library", "install", "launch"]
    with _state_lock:
        _client_seen.clear()
    return {"name": "Ubisoft Connect", "version": PLUGIN_VERSION,
            "api": API, "protocol": _negotiated,
            "capabilities": caps, "missing": []}


def negotiated_123():
    with _state_lock:
        return _negotiated in ("1.23", "1.25")


def watch_timeout():
    try:
        return float(os.environ.get(HOOK_WATCH_TIMEOUT) or WATCH_TIMEOUT_SECONDS)
    except ValueError:
        return WATCH_TIMEOUT_SECONDS


def watch_poll():
    try:
        return float(os.environ.get(HOOK_WATCH_POLL) or WATCH_POLL_SECONDS)
    except ValueError:
        return WATCH_POLL_SECONDS


def signin_grace():
    try:
        return float(os.environ.get(HOOK_SIGNIN_GRACE) or SIGNIN_GRACE_SECONDS)
    except ValueError:
        return SIGNIN_GRACE_SECONDS


# Cache of the last /proc scan (rescanned at most every ~2 s).
_proc_cache = {"at": 0.0, "procs": []}
PROC_CACHE_SECONDS = 2.0


def _scan_processes():
    """One /proc pass: [(wineprefix, cmd_basenames, cmd_parts)]. Only the
    user's own processes count: other users' entries are unreadable or
    skipped by uid."""
    now = time.monotonic()
    with _state_lock:
        if now - _proc_cache["at"] < PROC_CACHE_SECONDS:
            return list(_proc_cache["procs"])
    me = os.getuid()
    procs = []
    try:
        pids = os.listdir("/proc")
    except OSError:
        pids = []
    for pid in pids:
        if not pid.isdigit():
            continue
        base = os.path.join("/proc", pid)
        try:
            if os.stat(base).st_uid != me:
                continue
            with open(os.path.join(base, "cmdline"), "rb") as f:
                raw = f.read().split(b"\0")
        except (OSError, ValueError):
            continue
        parts = []
        for part in raw:
            if not part:
                continue
            try:
                parts.append(part.decode("utf-8", "replace"))
            except Exception:
                continue
        try:
            with open(os.path.join(base, "environ"), "rb") as f:
                env = f.read().split(b"\0")
        except (OSError, ValueError):
            env = []
        wineprefix = None
        for var in env:
            if var.startswith(b"WINEPREFIX="):
                try:
                    wineprefix = var[len(b"WINEPREFIX="):].decode("utf-8", "replace")
                except Exception:
                    pass
                break
        basenames = set()
        for text in parts:
            name = os.path.basename(text.replace("\\", "/")).lower()
            if name:
                basenames.add(name)
        procs.append((wineprefix, basenames, parts))
    with _state_lock:
        _proc_cache["at"] = now
        _proc_cache["procs"] = procs
    return list(procs)


def _proc_in_prefix(procs, prefix, names):
    """Whether a process naming one of names runs in this prefix: its
    WINEPREFIX matches, or (no environ visible) its command line holds the
    prefix path."""
    want = os.path.normpath(prefix)
    for wineprefix, basenames, parts in procs:
        if not (basenames & names):
            continue
        if wineprefix is not None:
            if os.path.normpath(wineprefix) == want:
                return True
            continue
        if any(prefix in part for part in parts):
            return True
    return False


def client_running(prefix):
    """Whether the store client runs in this prefix (no account, no client
    API: a /proc command line naming the client executable with this
    prefix's WINEPREFIX; see module docstring)."""
    return _proc_in_prefix(_scan_processes(), prefix, CLIENT_NAMES_LOWER)


def game_running(prefix, exe_name):
    """Whether the game's own process runs in this prefix."""
    if not exe_name:
        return False
    return _proc_in_prefix(_scan_processes(), prefix, {exe_name.lower()})

def client_url(action, app):
    if action == "uninstall":
        return f"uplay://uninstall/{app}"
    return f"uplay://install/{app}"


def answer_client_run(app, action):
    """The clientRun answer for an install/update/uninstall (protocol 1.23):
    the client exe with its install/uninstall URL. The client owns the
    install location, so no size is sent and the free-space check is
    skipped."""
    return {"clientRun": {
                "exe": CLIENT_DIR_WINDOWS + "\\" + CLIENT_NAMES[0],
                "args": [client_url(action, app)]},
            "clientOwnsLocation": True}


def watch_job(job_id, prefix, app, action, before, stop):
    """End the job from a CHANGE in the client's on-disk state, observed
    after the answer was sent: an install completes when the client records
    the game's InstallDir, an update when it rewrites the catalogue cache,
    an uninstall when the install key is gone (bounded wait; a readable
    failure on timeout). A canceled watch sends nothing, per the Jobs
    contract."""
    deadline = time.monotonic() + watch_timeout()
    try:
        while time.monotonic() < deadline:
            if stop.is_set():
                return
            current = install_snapshot(prefix, app)
            if action == "uninstall":
                done = not current[0]
            else:
                done = current != before
            if done:
                notify("job.done", {"jobId": job_id})
                return
            stop.wait(watch_poll())
        if stop.is_set():
            return
        if action == "uninstall":
            notify("job.failed", {"jobId": job_id,
                   "error": (f"timed out waiting for Ubisoft Connect to "
                             f"uninstall {app}")})
        else:
            notify("job.failed", {"jobId": job_id,
                   "error": (f"Ubisoft Connect didn't report the install "
                             f"of {app} in time")})
    finally:
        with _state_lock:
            if _watch_stops.get(job_id) is stop:
                del _watch_stops[job_id]


def start_client_command(params, action):
    """Answer a game.install/game.update/game.uninstall with the clientRun
    command the core runs (protocol 1.23), and watch the client's install
    state to end the job. Over 1.20 the capability is off: -32601, as if the
    method didn't exist."""
    if not negotiated_123():
        raise RPCError(f"method not found: game.{action}", code=-32601)
    app = params.get("id")
    job_id = params.get("jobId")
    if not app or not job_id:
        raise RPCError("invalid params: id and jobId are required",
                       code=-32602)
    prefix = remembered_prefix()
    if not prefix:
        raise RPCError("invalid params: the client prefix is unknown "
                       "(run client.setup first)", code=-32602)
    if action == "uninstall" and not install_dir(prefix, app):
        raise RPCError(f"{app} is not installed in Ubisoft Connect")
    # Snapshot the state and register the cancel before answering, so the
    # watch only ends on a change from this answer on and a cancel can never
    # slip in between.
    before = install_snapshot(prefix, app)
    stop = threading.Event()
    with _state_lock:
        _watch_stops[job_id] = stop
    threading.Thread(target=watch_job,
                     args=(job_id, prefix, app, action, before, stop),
                     daemon=True).start()
    return answer_client_run(app, action)


def game_install(params):
    return start_client_command(params, "install")


def game_update(params):
    return start_client_command(params, "update")


def game_uninstall(params):
    return start_client_command(params, "uninstall")


def job_cancel(params):
    job_id = params.get("jobId")
    with _state_lock:
        stop = _watch_stops.get(job_id)
    if stop is not None:
        stop.set()
    return {}


def library_list(_params):
    """Owned games from the client's caches (issue #192). A cache that is
    missing, encrypted or unreadable answers the one localized status the
    library shows, not a per-call error."""
    prefix = remembered_prefix()
    if not prefix:
        raise RPCError(tr("needs_client"), CODE_UNAVAILABLE)
    games, unreadable, _exes = read_library(prefix)
    if unreadable:
        raise RPCError(tr("needs_client"), CODE_UNAVAILABLE)
    return {"games": games}


def game_details(params):
    """No metadata source: a known game answers {}, an unknown id errors."""
    app = str(params["id"])
    prefix = remembered_prefix()
    if not prefix:
        raise RPCError(tr("needs_client"), CODE_UNAVAILABLE)
    games, unreadable, _exes = read_library(prefix)
    if unreadable:
        raise RPCError(tr("needs_client"), CODE_UNAVAILABLE)
    if any(game["id"] == app for game in games):
        return {}
    raise RPCError(f"{app} is unknown to the Ubisoft library")


def client_setup(params):
    """The Connect installer spec the core runs (protocol 1.20). jobId is
    empty when the core only inspects the spec: answer the same either way."""
    prefix = (params.get("prefix") or "")
    if not os.path.isabs(prefix):
        raise RPCError("invalid params: prefix is required", code=-32602)
    cached = fetch_installer()
    # The spec's exe must validate inside the prefix: copy the cached
    # download there. Prefer whichever drive layout already exists.
    drive = next((d for d in layouts(prefix) if os.path.isdir(d)),
                 os.path.join(prefix, LAYOUTS[0]))
    dest_dir = os.path.join(drive, "platypus-ubisoft")
    os.makedirs(dest_dir, exist_ok=True)
    dest = os.path.join(dest_dir, INSTALLER_NAME)
    shutil.copyfile(cached, dest)
    remember_prefix(prefix)
    url, _sha, size = installer_pin()
    host = urllib.parse.urlparse(url).netloc or url
    confirm = (f"This downloads the Ubisoft Connect installer "
               f"(~{size // (1 << 20)} MB) from {host} and runs it silently "
               "(/S) in Platypus's managed prefix. "
               "Sign into Ubisoft Connect when it opens.")
    return {"exe": dest, "args": list(INSTALLER_ARGS),
            "size": os.path.getsize(dest), "confirm": confirm}


def launch_spec(params):
    """The wine-client delegate for the game (protocol 1.20). Answered from
    Windows paths without preflighting the client: a missing client exe is
    the core's client.notSetUp, not a plugin error."""
    app = params["id"]
    prefix = (params.get("prefix") or "") or remembered_prefix()
    if not prefix:
        raise RPCError("invalid params: prefix is required", code=-32602)
    exe = game_exe_name(prefix, app)
    if exe is None:
        if install_dir(prefix, app):
            raise RPCError(f"{app} is installed, but its game executable "
                           "isn't in Ubisoft Connect's catalogue cache")
        raise RPCError(f"{app} is not installed in Ubisoft Connect")
    return {"delegate": "wine-client", "client": "Ubisoft Connect",
            "exe": CLIENT_DIR_WINDOWS + "\\" + CLIENT_NAMES[0],
            "args": [f"uplay://launch/{app}/0"],
            "prefix": "client", "find": {"cmdline": [exe]},
            "startTimeout": START_TIMEOUT}

def open_spec(params):
    """The standalone client spec (protocol 1.25): the client exe with no
    game args, so the card can open the client for sign-in. Answered from
    Windows paths without preflighting the client: a missing client exe is
    the core's client.notSetUp, not a plugin error."""
    prefix = (params.get("prefix") or "") or remembered_prefix()
    if not prefix:
        raise RPCError("invalid params: prefix is required", code=-32602)
    return {"exe": CLIENT_DIR_WINDOWS + "\\" + CLIENT_NAMES[0]}


def client_status(params):
    """Client-side launch status (protocol 1.18, plus signin over 1.23).
    Process state, not the install registry: a launchable game whose client runs
    in this prefix without the game past the signin grace is a client
    waiting for the user (signin); a running game is launching as today."""
    app = params["id"]
    prefix = remembered_prefix()
    if not prefix or find_client_exe(prefix) is None:
        return {"state": "idle", "label": "Ubisoft Connect isn't set up yet"}
    exe = game_exe_name(prefix, app)
    if exe is None:
        with _state_lock:
            _client_seen.pop((prefix, app), None)
        return {"state": "updating",
                "label": "Waiting for Ubisoft Connect (sign in if it asks)"}
    if game_running(prefix, exe):
        with _state_lock:
            _client_seen.pop((prefix, app), None)
        return {"state": "launching",
                "label": f"Starting {app} in Ubisoft Connect"}
    if client_running(prefix):
        key = (prefix, app)
        now = time.monotonic()
        with _state_lock:
            seen = _client_seen.get(key)
            if seen is None:
                _client_seen[key] = now
                seen = now
            waiting = now - seen >= signin_grace()
        if waiting:
            return {"state": "signin",
                    "label": "Waiting for you in Ubisoft Connect"}
        return {"state": "updating",
                "label": "Waiting for Ubisoft Connect (sign in if it asks)"}
    with _state_lock:
        _client_seen.pop((prefix, app), None)
    return {"state": "launching",
            "label": f"Starting {app} in Ubisoft Connect"}


METHODS = {
    "initialize": initialize,
    "library.list": library_list,
    "game.details": game_details,
    "game.install": game_install,
    "game.update": game_update,
    "game.uninstall": game_uninstall,
    "job.cancel": job_cancel,
    "client.setup": client_setup,
    "client.openSpec": open_spec,
    "game.launchSpec": launch_spec,
    "game.clientStatus": client_status,
}


def handle(msg):
    fn = METHODS.get(msg.get("method"))
    resp = {"id": msg["id"]}
    if fn is None:
        resp["error"] = {"code": -32601, "message": f"method not found: {msg.get('method')}"}
    else:
        try:
            result = fn(msg.get("params") or {})
            resp["result"] = result if result is not None else {}
        except RPCError as e:
            resp["error"] = {"code": e.code, "message": str(e)}
        except (KeyError, TypeError) as e:
            resp["error"] = {"code": -32602, "message": f"invalid params: {e}"}
        except Exception as e:  # report, never crash the plugin
            resp["error"] = {"code": -32000, "message": f"{type(e).__name__}: {e}"}
    send(resp)


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError as e:
            send({"error": {"code": -32700, "message": str(e)}})
            continue
        if "id" not in msg:
            # Notifications need no answer; the only one this plugin uses is
            # the core's language switch (protocol 1.14).
            if msg.get("method") == "locale.changed":
                set_locale((msg.get("params") or {}).get("locale"))
            continue
        threading.Thread(target=handle, args=(msg,), daemon=True).start()


if __name__ == "__main__":
    main()
