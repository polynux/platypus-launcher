#!/usr/bin/env python3
"""Platypus store plugin for Ubisoft Connect (issues #193/#194, #212/#213).

The official Ubisoft Connect client, in one Platypus-managed Wine prefix,
owns installs and launches; this plugin only answers specs and reads the
client's on-disk state (docs/research/ubisoft-options.md §1-§5). No Ubisoft
account is handled here: the user signs into the real client, Platypus never
sees the password and never sends an app id. The plugin starts no process of
its own: only the core runs Wine (installer, client, client commands), from
the specs this plugin answers.

Speaks Platypus's plugin protocol (api 1, docs/plugins/protocol.md): JSON-RPC 2.0
over stdin/stdout, one object per line. Negotiates 1.20 or 1.23 (whichever
the core offers highest): the `install` capability is on only over 1.23,
where game.install/game.update/game.uninstall answer a clientRun command
(`uplay://install/<id>` / `uplay://uninstall/<id>`) the core runs in the
pinned client prefix as part of the plugin's job, and the plugin ends the
job from its watch of the client's on-disk install records.

What is real here and what is a stand-in (live checks L-U1/L-U2, issue #195):

- `client.setup` downloads the pinned Connect installer to
  PLATYPUS_PLUGIN_DATA (kept across restarts, hash-verified), copies it into
  the client prefix for the run (the spec's exe must validate inside the
  prefix), and answers `{exe, args: ["/S"], size, confirm}`. The copy stays in
  the prefix: the protocol gives the plugin no post-setup callback. The
  Lutris recipe also applies winetricks `d3dcompiler_43` + `corefonts` and
  disables the overlay; nothing applies those yet (see README).
- `game.launchSpec` answers the `wine-client` delegate: the client exe with
  `uplay://launch/<id>/0`, and `find` carries the game's exe name from its
  install record, never anything matching the client command. When the client
  exe is missing the spec is still answered (Windows paths): the core's
  validation reports `client.notSetUp` and the game page offers the setup.
- `game.clientStatus` maps what the prefix shows onto the accepted states:
  no client exe → `idle`, game installed → `launching`, client process up
  without the game past a short grace → `signin` (the user must act in the
  client: sign in, accept terms, confirm a dialog), else `updating`
  (waiting for sign-in). A first-run client self-update or sign-in can take a
  while, hence the generous `startTimeout`; a dedicated waiting-for-signin
  state is protocol 1.23 (issue #213).
- `library.list` is empty: the local-cache reader (issue #192) is blocked on
  the licence decision (issue #197).

The per-game install records stand in for the real client records until L-U1
pins down their location and format (candidates: Wine system.reg
HKLM\\SOFTWARE\\(WOW6432Node\\)\\Ubisoft\\Launcher\\Installs\\<id>\\InstallDir per
Playnite, uplay_install.manifest/.state per Optima). The plugin only reads
them; whatever the client (real or test double) wrote is the state.

Signin heuristic (no account, no client API): the plugin scans /proc for a
process naming the client executable (UbisoftConnect.exe / upc.exe) whose
WINEPREFIX is this prefix (or whose command line holds it when no environ
is visible; other users' processes never count; rescanned at most every
2 s). A launchable game (an install record naming a game exe) whose client
runs in this prefix without the game past SIGNIN_GRACE_SECONDS is a client
waiting for the user (`signin`); a running game is `launching` as before.
First-seen times are kept in memory only. PLATYPUS_UBISOFT_SIGNIN_GRACE
overrides the grace in tests.

Test hooks (never set in production): PLATYPUS_UBISOFT_INSTALLER_URL,
PLATYPUS_UBISOFT_INSTALLER_SHA256 and PLATYPUS_UBISOFT_INSTALLER_SIZE
override the pin below, so tests drive the real fetch path through a
loopback server with no network. PLATYPUS_UBISOFT_WATCH_TIMEOUT and
PLATYPUS_UBISOFT_WATCH_POLL bound the install/uninstall watch;
PLATYPUS_UBISOFT_SIGNIN_GRACE overrides the signin grace.
"""

import hashlib
import json
import os
import shutil
import sys
import tempfile
import threading
import time
import urllib.parse
import urllib.request

API = 1
PLUGIN_VERSION = "0.2.0"
# The manifest's promise; initialize narrows it to what was negotiated
# (install only over 1.23).
CAPABILITIES = ["library", "install", "launch"]

# Pinned Connect installer (Lutris `ubisoft-connect-latest` recipe):
# Pinned 2026-11-17: download once, sha256sum it, delete it. To bump: fetch
# the new installer from the same URL, replace SHA-256 and SIZE below, and
# note the date. Never check the binary itself into the repo.
INSTALLER_URL = ("https://ubistatic3-a.akamaihd.net/orbit/launcher_installer/"
                 "UbisoftConnectInstaller.exe")
INSTALLER_SHA256 = "50431349564846c751281be4b855e00cc6a6d9ffcb2f8ec88c6745a61ad0d4b8"
INSTALLER_SIZE = 259083384  # bytes on 2026-11-17 (~247 MB)
INSTALLER_NAME = "UbisoftConnectInstaller.exe"
INSTALLER_ARGS = ["/S"]  # silent install, per the Lutris recipe

# The client executable: UbisoftConnect.exe is the modern name (preferred),
# upc.exe the older one both the research and unifideck attest. The exact
# install folder is confirmed against a real prefix in L-U1 (#195).
CLIENT_DIR_WINDOWS = ("C:\\Program Files (x86)\\Ubisoft\\Ubisoft Game Launcher")
CLIENT_NAMES = ("UbisoftConnect.exe", "upc.exe")
# find must never match the client command itself, only the game process.
CLIENT_NAMES_LOWER = frozenset(n.lower() for n in CLIENT_NAMES)
# First-run self-update plus sign-in can take a while (within the protocol's
# 30-minute clamp on startTimeout).
START_TIMEOUT = 900

# Protocol versions spoken: 1.20 (setup + launch) and 1.23 (plus install via
# clientRun, and the signin clientStatus state). The install capability is
# on only when 1.23 is negotiated.
PROTOCOLS = ("1.20", "1.23")

# Seconds a client process may run without the game before clientStatus
# reports signin (the user must act in the client). Overridden in tests.
SIGNIN_GRACE_SECONDS = 30.0

# Bounds for the install/uninstall watch (the plugin ends its own job from
# the client's on-disk state). Overridden in tests.
WATCH_TIMEOUT_SECONDS = 30 * 60.0
WATCH_POLL_SECONDS = 0.5
# Wine and Proton prefix layouts, probed in this order.
LAYOUTS = ("drive_c", os.path.join("pfx", "drive_c"))

# Where the client's per-game install records live in the prefix. INTERIM,
# read-only (see module docstring): one JSON file per product id,
# {"exe": "<game exe name>"}, owned by the client. Replaced by the L-U1
# findings, never written by this plugin.
RECORDS_REL = os.path.join("drive_c", "platypus-ubisoft", "records")

# Test-only pin overrides (see module docstring).
HOOK_URL = "PLATYPUS_UBISOFT_INSTALLER_URL"
HOOK_SHA256 = "PLATYPUS_UBISOFT_INSTALLER_SHA256"
HOOK_SIZE = "PLATYPUS_UBISOFT_INSTALLER_SIZE"
HOOK_WATCH_TIMEOUT = "PLATYPUS_UBISOFT_WATCH_TIMEOUT"
HOOK_WATCH_POLL = "PLATYPUS_UBISOFT_WATCH_POLL"
HOOK_SIGNIN_GRACE = "PLATYPUS_UBISOFT_SIGNIN_GRACE"

out_lock = threading.Lock()
_state_lock = threading.Lock()
_warned_empty = False
# The negotiated protocol ("1.20" until initialize runs); the install
# capability is on only over 1.23.
_negotiated = "1.20"
# First-seen times (monotonic) of a running client without the game, by
# (prefix, app): the signin grace heuristic. In memory only.
_client_seen = {}
# Stop flags for install/uninstall watches, by jobId.
_watch_stops = {}


class RPCError(Exception):
    def __init__(self, message, code=-32000):
        super().__init__(message)
        self.code = code


def send(msg):
    msg["jsonrpc"] = "2.0"
    line = json.dumps(msg, separators=(",", ":"))
    with out_lock:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()


def notify(method, params):
    send({"method": method, "params": params})


def log(level, message):
    notify("log", {"level": level, "message": message})


def data_dir():
    return os.environ.get("PLATYPUS_PLUGIN_DATA") or "."


def prefix_file():
    return os.path.join(data_dir(), "client-prefix")


def remember_prefix(prefix):
    with open(prefix_file(), "w") as f:
        f.write(prefix)


def remembered_prefix():
    try:
        with open(prefix_file()) as f:
            return f.read().strip()
    except OSError:
        return ""


def layouts(prefix):
    """The Wine and Proton drive layouts under the prefix, in probe order."""
    return [os.path.join(prefix, lay) for lay in LAYOUTS]


def find_client_exe(prefix):
    """The client's absolute Linux path, preferred name then fallback, Wine
    layout then Proton layout, or None (see CLIENT_NAMES)."""
    for drive in layouts(prefix):
        for name in CLIENT_NAMES:
            exe = os.path.join(drive, "Program Files (x86)", "Ubisoft",
                               "Ubisoft Game Launcher", name)
            if os.path.isfile(exe):
                return exe
    return None


def record_path(prefix, app):
    safe = "".join(c for c in app if c.isalnum() or c in ("-", "_", "."))
    if not safe or safe != app:
        raise RPCError(f"{app!r} is not a Ubisoft product id")
    return os.path.join(prefix, RECORDS_REL, safe + ".json")


def read_record(prefix, app):
    """The client's install record for the game, or None (read-only)."""
    try:
        with open(record_path(prefix, app)) as f:
            rec = json.load(f)
    except (OSError, ValueError):
        return None
    return rec if isinstance(rec, dict) else None


def game_exe_name(prefix, app):
    """The exe name launchSpec tracks, or None when the game isn't installed
    (or the record names the client itself, which find must never match)."""
    rec = read_record(prefix, app)
    if not rec:
        return None
    base = os.path.basename(str(rec.get("exe") or "").replace("\\", "/"))
    if not base or base.lower() in CLIENT_NAMES_LOWER:
        return None
    return base


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            block = f.read(1 << 20)
            if not block:
                break
            h.update(block)
    return h.hexdigest()


def installer_pin():
    url = os.environ.get(HOOK_URL) or INSTALLER_URL
    sha = os.environ.get(HOOK_SHA256) or INSTALLER_SHA256
    try:
        size = int(os.environ.get(HOOK_SIZE) or INSTALLER_SIZE)
    except ValueError:
        size = INSTALLER_SIZE
    return url, sha, size


def bump_message():
    return ("the Ubisoft Connect installer failed its pin check "
            "(the pin may need a bump: see this plugin's docstring)")


def fetch_installer():
    """The pinned installer under PLATYPUS_PLUGIN_DATA, downloading and
    verifying it as needed. A complete verified file is kept across
    restarts; each download goes to a unique temp file."""
    url, sha, size = installer_pin()
    os.makedirs(data_dir(), exist_ok=True)
    cached = os.path.join(data_dir(), INSTALLER_NAME)
    if (os.path.isfile(cached) and os.path.getsize(cached) == size
            and sha256_file(cached) == sha):
        return cached
    fd, tmp = tempfile.mkstemp(dir=data_dir(), prefix=INSTALLER_NAME + ".")
    try:
        with os.fdopen(fd, "wb") as f:
            with urllib.request.urlopen(url, timeout=600) as r:
                shutil.copyfileobj(r, f)
        if os.path.getsize(tmp) != size:
            raise RPCError(bump_message())
        if sha256_file(tmp) != sha:
            raise RPCError(bump_message())
        os.replace(tmp, cached)
    except RPCError:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise
    except Exception as e:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise RPCError(f"couldn't download the Ubisoft Connect installer: {e}")
    return cached


def pick_protocol(offered):
    """The highest protocol both sides speak (1.20 or 1.23)."""
    if "1.23" in (offered or []) and "1.23" in PROTOCOLS:
        return "1.23"
    return "1.20"


def initialize(params):
    global _negotiated
    offered = params.get("protocols") or []
    if not isinstance(offered, list):
        offered = []
    _negotiated = pick_protocol([str(v) for v in offered])
    caps = ["library", "launch"]
    if _negotiated == "1.23":
        caps = ["library", "install", "launch"]
    with _state_lock:
        _client_seen.clear()
    return {"name": "Ubisoft Connect", "version": PLUGIN_VERSION,
            "api": API, "protocol": _negotiated,
            "capabilities": caps, "missing": []}


def negotiated_123():
    with _state_lock:
        return _negotiated == "1.23"


def watch_timeout():
    try:
        return float(os.environ.get(HOOK_WATCH_TIMEOUT) or WATCH_TIMEOUT_SECONDS)
    except ValueError:
        return WATCH_TIMEOUT_SECONDS


def watch_poll():
    try:
        return float(os.environ.get(HOOK_WATCH_POLL) or WATCH_POLL_SECONDS)
    except ValueError:
        return WATCH_POLL_SECONDS


def signin_grace():
    try:
        return float(os.environ.get(HOOK_SIGNIN_GRACE) or SIGNIN_GRACE_SECONDS)
    except ValueError:
        return SIGNIN_GRACE_SECONDS


# Cache of the last /proc scan (rescanned at most every ~2 s).
_proc_cache = {"at": 0.0, "procs": []}
PROC_CACHE_SECONDS = 2.0


def _scan_processes():
    """One /proc pass: [(wineprefix, cmd_basenames, cmd_parts)]. Only the
    user's own processes count: other users' entries are unreadable or
    skipped by uid."""
    now = time.monotonic()
    with _state_lock:
        if now - _proc_cache["at"] < PROC_CACHE_SECONDS:
            return list(_proc_cache["procs"])
    me = os.getuid()
    procs = []
    try:
        pids = os.listdir("/proc")
    except OSError:
        pids = []
    for pid in pids:
        if not pid.isdigit():
            continue
        base = os.path.join("/proc", pid)
        try:
            if os.stat(base).st_uid != me:
                continue
            with open(os.path.join(base, "cmdline"), "rb") as f:
                raw = f.read().split(b"\0")
        except (OSError, ValueError):
            continue
        parts = []
        for part in raw:
            if not part:
                continue
            try:
                parts.append(part.decode("utf-8", "replace"))
            except Exception:
                continue
        try:
            with open(os.path.join(base, "environ"), "rb") as f:
                env = f.read().split(b"\0")
        except (OSError, ValueError):
            env = []
        wineprefix = None
        for var in env:
            if var.startswith(b"WINEPREFIX="):
                try:
                    wineprefix = var[len(b"WINEPREFIX="):].decode("utf-8", "replace")
                except Exception:
                    pass
                break
        basenames = set()
        for text in parts:
            name = os.path.basename(text.replace("\\", "/")).lower()
            if name:
                basenames.add(name)
        procs.append((wineprefix, basenames, parts))
    with _state_lock:
        _proc_cache["at"] = now
        _proc_cache["procs"] = procs
    return list(procs)


def _proc_in_prefix(procs, prefix, names):
    """Whether a process naming one of names runs in this prefix: its
    WINEPREFIX matches, or (no environ visible) its command line holds the
    prefix path."""
    want = os.path.normpath(prefix)
    for wineprefix, basenames, parts in procs:
        if not (basenames & names):
            continue
        if wineprefix is not None:
            if os.path.normpath(wineprefix) == want:
                return True
            continue
        if any(prefix in part for part in parts):
            return True
    return False


def client_running(prefix):
    """Whether the store client runs in this prefix (no account, no client
    API: a /proc command line naming the client executable with this
    prefix's WINEPREFIX; see module docstring)."""
    return _proc_in_prefix(_scan_processes(), prefix, CLIENT_NAMES_LOWER)


def game_running(prefix, exe_name):
    """Whether the game's own process runs in this prefix."""
    if not exe_name:
        return False
    return _proc_in_prefix(_scan_processes(), prefix, {exe_name.lower()})

def snapshot_record(prefix, app):
    """The install record's current (bytes, mtime), or (None, None)."""
    try:
        path = record_path(prefix, app)
    except RPCError:
        return (None, None)
    try:
        with open(path, "rb") as f:
            data = f.read()
        return (data, os.path.getmtime(path))
    except OSError:
        return (None, None)


def client_url(action, app):
    if action == "uninstall":
        return f"uplay://uninstall/{app}"
    return f"uplay://install/{app}"


def answer_client_run(app, action):
    """The clientRun answer for an install/update/uninstall (protocol 1.23):
    the client exe with its install/uninstall URL. The client owns the
    install location, so no size is sent and the free-space check is
    skipped."""
    return {"clientRun": {
                "exe": CLIENT_DIR_WINDOWS + "\\" + CLIENT_NAMES[0],
                "args": [client_url(action, app)]},
            "clientOwnsLocation": True}


def watch_job(job_id, prefix, app, action, before, stop):
    """End the job from a CHANGE in the client's on-disk state, observed
    after the answer was sent: an install/update completes when the game's
    record appears or changes, an uninstall when it is gone (bounded wait;
    a readable failure on timeout). A canceled watch sends nothing, per the
    Jobs contract."""
    deadline = time.monotonic() + watch_timeout()
    try:
        while time.monotonic() < deadline:
            if stop.is_set():
                return
            current = snapshot_record(prefix, app)
            if action == "uninstall":
                done = current[0] is None
            else:
                done = current != before
            if done:
                notify("job.done", {"jobId": job_id})
                return
            stop.wait(watch_poll())
        if stop.is_set():
            return
        if action == "uninstall":
            notify("job.failed", {"jobId": job_id,
                   "error": (f"timed out waiting for Ubisoft Connect to "
                             f"uninstall {app}")})
        else:
            notify("job.failed", {"jobId": job_id,
                   "error": (f"Ubisoft Connect didn't report the install "
                             f"of {app} in time")})
    finally:
        with _state_lock:
            if _watch_stops.get(job_id) is stop:
                del _watch_stops[job_id]


def start_client_command(params, action):
    """Answer a game.install/game.update/game.uninstall with the clientRun
    command the core runs (protocol 1.23), and watch the client's records
    to end the job. Over 1.20 the capability is off: -32601, as if the
    method didn't exist."""
    if not negotiated_123():
        raise RPCError(f"method not found: game.{action}", code=-32601)
    app = params.get("id")
    job_id = params.get("jobId")
    if not app or not job_id:
        raise RPCError("invalid params: id and jobId are required",
                       code=-32602)
    prefix = remembered_prefix()
    if not prefix:
        raise RPCError("invalid params: the client prefix is unknown "
                       "(run client.setup first)", code=-32602)
    if action == "uninstall" and read_record(prefix, app) is None:
        raise RPCError(f"{app} is not installed in Ubisoft Connect")
    # Snapshot the records and register the cancel before answering, so the
    # watch only ends on a change from this answer on and a cancel can never
    # slip in between.
    before = snapshot_record(prefix, app)
    stop = threading.Event()
    with _state_lock:
        _watch_stops[job_id] = stop
    threading.Thread(target=watch_job,
                     args=(job_id, prefix, app, action, before, stop),
                     daemon=True).start()
    return answer_client_run(app, action)


def game_install(params):
    return start_client_command(params, "install")


def game_update(params):
    return start_client_command(params, "update")


def game_uninstall(params):
    return start_client_command(params, "uninstall")


def job_cancel(params):
    job_id = params.get("jobId")
    with _state_lock:
        stop = _watch_stops.get(job_id)
    if stop is not None:
        stop.set()
    return {}


def library_list(_params):
    # Empty on purpose: the local-cache reader (issue #192) is blocked on the
    # licence decision (issue #197). Warn once per process, not per call.
    global _warned_empty
    if not _warned_empty:
        _warned_empty = True
        log("warning", "the Ubisoft library is empty: the local-cache reader "
            "(issue #192) is blocked on the licence decision (issue #197)")
    return {"games": []}


def game_details(params):
    app = params["id"]
    raise RPCError(f"{app} is unknown: the Ubisoft library is empty until the "
                   "local-cache reader lands (issues #192, #197)")


def client_setup(params):
    """The Connect installer spec the core runs (protocol 1.20). jobId is
    empty when the core only inspects the spec: answer the same either way."""
    prefix = (params.get("prefix") or "")
    if not os.path.isabs(prefix):
        raise RPCError("invalid params: prefix is required", code=-32602)
    cached = fetch_installer()
    # The spec's exe must validate inside the prefix: copy the cached
    # download there. Prefer whichever drive layout already exists.
    drive = next((d for d in layouts(prefix) if os.path.isdir(d)),
                 os.path.join(prefix, LAYOUTS[0]))
    dest_dir = os.path.join(drive, "platypus-ubisoft")
    os.makedirs(dest_dir, exist_ok=True)
    dest = os.path.join(dest_dir, INSTALLER_NAME)
    shutil.copyfile(cached, dest)
    remember_prefix(prefix)
    url, _sha, size = installer_pin()
    host = urllib.parse.urlparse(url).netloc or url
    confirm = (f"This downloads the Ubisoft Connect installer "
               f"(~{size // (1 << 20)} MB) from {host} and runs it silently "
               "(/S) in Platypus's managed prefix. "
               "Sign into Ubisoft Connect when it opens.")
    return {"exe": dest, "args": list(INSTALLER_ARGS),
            "size": os.path.getsize(dest), "confirm": confirm}


def launch_spec(params):
    """The wine-client delegate for the game (protocol 1.20). Answered from
    Windows paths without preflighting the client: a missing client exe is
    the core's client.notSetUp, not a plugin error."""
    app = params["id"]
    prefix = (params.get("prefix") or "") or remembered_prefix()
    if not prefix:
        raise RPCError("invalid params: prefix is required", code=-32602)
    exe = game_exe_name(prefix, app)
    if exe is None:
        raise RPCError(f"{app} is not installed in Ubisoft Connect")
    return {"delegate": "wine-client", "client": "Ubisoft Connect",
            "exe": CLIENT_DIR_WINDOWS + "\\" + CLIENT_NAMES[0],
            "args": [f"uplay://launch/{app}/0"],
            "prefix": "client", "find": {"cmdline": [exe]},
            "startTimeout": START_TIMEOUT}


def client_status(params):
    """Client-side launch status (protocol 1.18, plus signin over 1.23).
    Process state, not install records: a launchable game whose client runs
    in this prefix without the game past the signin grace is a client
    waiting for the user (signin); a running game is launching as today."""
    app = params["id"]
    prefix = remembered_prefix()
    if not prefix or find_client_exe(prefix) is None:
        return {"state": "idle", "label": "Ubisoft Connect isn't set up yet"}
    exe = game_exe_name(prefix, app)
    if exe is None:
        with _state_lock:
            _client_seen.pop((prefix, app), None)
        return {"state": "updating",
                "label": "Waiting for Ubisoft Connect (sign in if it asks)"}
    if game_running(prefix, exe):
        with _state_lock:
            _client_seen.pop((prefix, app), None)
        return {"state": "launching",
                "label": f"Starting {app} in Ubisoft Connect"}
    if client_running(prefix):
        key = (prefix, app)
        now = time.monotonic()
        with _state_lock:
            seen = _client_seen.get(key)
            if seen is None:
                _client_seen[key] = now
                seen = now
            waiting = now - seen >= signin_grace()
        if waiting:
            return {"state": "signin",
                    "label": "Waiting for you in Ubisoft Connect"}
        return {"state": "updating",
                "label": "Waiting for Ubisoft Connect (sign in if it asks)"}
    with _state_lock:
        _client_seen.pop((prefix, app), None)
    return {"state": "launching",
            "label": f"Starting {app} in Ubisoft Connect"}


METHODS = {
    "initialize": initialize,
    "library.list": library_list,
    "game.details": game_details,
    "game.install": game_install,
    "game.update": game_update,
    "game.uninstall": game_uninstall,
    "job.cancel": job_cancel,
    "client.setup": client_setup,
    "game.launchSpec": launch_spec,
    "game.clientStatus": client_status,
}


def handle(msg):
    fn = METHODS.get(msg.get("method"))
    resp = {"id": msg["id"]}
    if fn is None:
        resp["error"] = {"code": -32601, "message": f"method not found: {msg.get('method')}"}
    else:
        try:
            result = fn(msg.get("params") or {})
            resp["result"] = result if result is not None else {}
        except RPCError as e:
            resp["error"] = {"code": e.code, "message": str(e)}
        except (KeyError, TypeError) as e:
            resp["error"] = {"code": -32602, "message": f"invalid params: {e}"}
        except Exception as e:  # report, never crash the plugin
            resp["error"] = {"code": -32000, "message": f"{type(e).__name__}: {e}"}
    send(resp)


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError as e:
            send({"error": {"code": -32700, "message": str(e)}})
            continue
        if "id" not in msg:
            continue  # notifications need no answer
        threading.Thread(target=handle, args=(msg,), daemon=True).start()


if __name__ == "__main__":
    main()
