{
  "id": "ubisoft-connect",
  "name": "Ubisoft Connect",
  "version": "0.2.0",
  "author": "Platypus",
  "description": "Ubisoft games through the official Ubisoft Connect client in a Platypus-managed prefix (installs and launches run through the client; the library reader is pending issue #192).",
  "manifestVersion": 1,
  "protocol": { "versions": ["1.20", "1.23", "1.25"], "transport": "jsonrpc-stdio" },
  "store": "ubisoft",
  "exec": "bin/platypus-ubisoft",
  "capabilities": ["library", "install", "launch"],
  "requires": [
    { "bin": "python3", "hint": "install python3 from your distribution" }
  ],
  "install_dir": "ubisoft",
  "permissions": {
    "network": ["ubistatic3-a.akamaihd.net"],
    "read": [],
    "write": ["~/.local/share/platypus"]
  }
}
