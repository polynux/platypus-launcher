#!/usr/bin/env python3
"""Platypus store plugin for GOG, wrapping gogdl.

Speaks Platypus's plugin protocol (api 1, docs/plugins/protocol.md): JSON-RPC 2.0
over stdin/stdout, one object per line. Everything store-specific is done by
the `gogdl` CLI (Heroic's downloader, Heroic-Games-Launcher/heroic-gogdl),
which keeps the user's tokens in its own auth file; this plugin only passes it
paths and a one-time authorization code, and never stores credentials.

GOG games are DRM-free: gogdl downloads offline installers and unpacks them,
and the games run without any GOG client. Platypus runs them through its own
runner pipeline.

gogdl notes that shape this plugin:
  - `--auth-config-path` picks where tokens live; the plugin points it into
    $PLATYPUS_PLUGIN_DATA so Platypus's sandbox rules hold.
  - `auth --code <code>` exchanges a code from the OAuth login page.
  - `auth` (no arguments) prints the stored credentials as JSON, which is how
    login state is checked without network (gogdl refreshes an expired token
    before answering).
  - Library listing needs GOG's web API, which gogdl doesn't expose directly;
    the plugin calls GOG's gamesdb endpoint with gogdl's credentials itself.
  - `info` prints the download and disk size, the install languages and the
    owned DLCs; `download` installs (`--lang`, `--with-dlcs`/`--dlcs`); progress
    lines come on stdout/stderr and are parsed into job.progress.
  - `repair` is `download` with verification: it re-hashes every file against
    the manifest it stored during the install and re-downloads what differs.
    It always repairs, so a check hashes here (see "verify" below).
  - Achievements and playtime live on GOG's gameplay service and take the
    access token gogdl stores; Heroic reads them the same way. See
    docs/research/gog-apis.md.
"""

import datetime
import glob
import hashlib
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import zlib
from concurrent.futures import ThreadPoolExecutor

API = 1
PLUGIN_VERSION = "0.3.0"
CODE_AUTH_REQUIRED = -32001
# GOG build ids are long digits (e.g. 57200821661238017).
BUILD_ID_RE = re.compile(r"[0-9]{4,32}")
# The language GOG's gameplay API answers in (X-Gog-Lc), from initialize.
LOCALE = "en-US"
CAPABILITIES = ["library", "install", "launch", "auth", "discard", "versions",
                "verify", "install-options", "achievements", "playtime"]


def stall_limits():
    """How long a download may go without progress before the plugin fails it
    instead of hanging: no growth in downloaded bytes (bytes stall), or no
    output line at all (quiet stall). Tests shrink both through the environment."""
    def secs(name, default):
        try:
            return max(1.0, float(os.environ.get(name, default)))
        except ValueError:
            return default
    return secs("PLATYPUS_GOG_STALL_BYTES_S", 600), secs("PLATYPUS_GOG_STALL_QUIET_S", 900)

 # GOG's login page for Platypus's client id (gogdl's own OAuth client). The page
 # redirects to embed.gog.com/on_login_success?... with the code in the query.
LOGIN_URL = ("https://auth.gog.com/auth?client_id=46899977096215655&response_type=code"
             "&redirect_uri=https%3A%2F%2Fembed.gog.com%2Fon_login_success%3Forigin%3Dclient")

out_lock = threading.Lock()
jobs_lock = threading.Lock()
# Serializes read-modify-write of installed.json / titles.json: finishing jobs
# and library listings run on different threads.
state_lock = threading.RLock()
jobs = {}  # jobId -> {"proc": Popen, "canceled": bool}

MIB = 1024 * 1024
# gogdl download progress. 1.3.0 prints `[PROGRESS] INFO: = Progress: 22.36
# 16802208/75133843, Running for: …` (byte counts); older ones printed
# `Progress: 42.13% (123.45/292.88 MiB) @ 5.61 MiB/s`.
PROGRESS_RE = re.compile(r"Progress:\s*([\d.]+)%\s*\(([\d.]+)/([\d.]+)\s*MiB\)(?:\s*@\s*([\d.]+)\s*MiB/s)?")
PROGRESS2_RE = re.compile(r"=\s*Progress:\s*([\d.]+)\s+(\d+)/(\d+)")
SPEED_RE = re.compile(r"\+\s*Download\s*-\s*([\d.]+)\s*MiB/s")
# 1.3.0's liveness signals besides written bytes: downloaded MiB (which grow
# while chunks land in the cache) and non-zero throughput or disk activity
# (slow chunks and xdelta patches move no written bytes for a while).
DL_RE = re.compile(r"=\s*Downloaded:\s*([\d.]+)\s*MiB")
DISK_RE = re.compile(r"\+\s*Disk\s*-\s*([\d.]+)\s*MiB/s\s*\(write\)\s*/\s*([\d.]+)\s*MiB/s\s*\(read\)")

def parse_progress(line):
    """(percent, done_bytes, total_bytes, speed_bps|None) from a gogdl progress
    line, or None for any other output."""
    m = PROGRESS_RE.search(line)
    if m:
        speed = float(m.group(4)) * MIB if m.group(4) else None
        return (float(m.group(1)), int(float(m.group(2)) * MIB),
                int(float(m.group(3)) * MIB), speed)
    m = PROGRESS2_RE.search(line)
    if m:
        return float(m.group(1)), int(m.group(2)), int(m.group(3)), None
    return None


class RPCError(Exception):
    def __init__(self, message, code=-32000):
        super().__init__(message)
        self.code = code


def send(msg):
    msg["jsonrpc"] = "2.0"
    line = json.dumps(msg, separators=(",", ":"))
    with out_lock:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()


def notify(method, params):
    send({"method": method, "params": params})


def log(level, message):
    notify("log", {"level": level, "message": message})


def auth_file():
    """Where gogdl keeps its tokens: the plugin's private data folder."""
    data = os.environ.get("PLATYPUS_PLUGIN_DATA") or "."
    os.makedirs(data, exist_ok=True)
    return os.path.join(data, "gogdl-auth.json")


def gogdl_config_base():
    """gogdl's config dir for this plugin: manifests and chunk caches."""
    return os.path.join(os.environ.get("PLATYPUS_PLUGIN_DATA") or ".", "gogdl")


def gogdl_env():
    """The environment gogdl runs in. Its own state (manifest and chunk
    caches) moves under our data dir via GOGDL_CONFIG_PATH (since gogdl
    1.1.0): --auth-config-path only moves the tokens, and without this the
    shared manifest cache breaks installs (a cached manifest diffs as
    up-to-date against an empty folder) and we overwrite Heroic's."""
    base = gogdl_config_base()
    for sub in ("manifests", os.path.join("heroic_gogdl", "manifests")):
        try:  # either layout gogdl may use under the config path
            os.makedirs(os.path.join(base, sub), exist_ok=True)
        except OSError:
            pass
    return {**os.environ, "GOGDL_CONFIG_PATH": base}


def gogdl(*args, timeout=300):
    """Runs gogdl and returns (exit code, stdout, stderr)."""
    try:
        p = subprocess.run(["gogdl", "--auth-config-path", auth_file(), *args],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           timeout=timeout, env=gogdl_env())
    except FileNotFoundError:
        raise RPCError("gogdl is not installed (needs version 1.1 or newer); get the "
                       "binary from github.com/Heroic-Games-Launcher/heroic-gogdl/releases")
    except subprocess.TimeoutExpired:
        raise RPCError(f"gogdl {args[0]} timed out")
    return p.returncode, p.stdout, p.stderr


def tail(text, n=3):
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    return " · ".join(lines[-n:]) if lines else "no output"


def credentials():
    """The stored credentials, or None. `gogdl auth` prints them without
    touching the network when they are present."""
    code, out, _ = gogdl("auth", timeout=60)
    if code != 0:
        return None
    try:
        creds = json.loads(out)
    except ValueError:
        return None
    if not isinstance(creds, dict) or "access_token" not in creds:
        return None
    return creds


def api_url(url):
    """The URL with its origin swapped for a test server's
    (PLATYPUS_GOG_API_BASE): tests answer every store API from one loopback
    port, real runs use the stores' own hosts."""
    base = os.environ.get("PLATYPUS_GOG_API_BASE")
    if not base:
        return url
    part, origin = urllib.parse.urlsplit(url), urllib.parse.urlsplit(base)
    return urllib.parse.urlunsplit((origin.scheme, origin.netloc,
                                    origin.path.rstrip("/") + part.path,
                                    part.query, ""))


def api_get(url, token, headers=None):
    # Test hook: tests point this at a file with the response, so nothing
    # reaches the network. Not set in normal runs.
    hook = os.environ.get("PLATYPUS_GOG_API_FILE")
    if hook:
        with open(hook) as f:
            return json.load(f)
    req_headers = {"User-Agent": "gogdl (Platypus)"}
    if token:  # anonymous endpoints can reject an empty Bearer
        req_headers["Authorization"] = f"Bearer {token}"
    req_headers.update(headers or {})
    req = urllib.request.Request(api_url(url), headers=req_headers)
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read().decode())


def api_get_zjson(url):
    """A CDN metadata document: zlib-compressed JSON (content system v2), or
    plain JSON for the endpoints that don't compress."""
    req = urllib.request.Request(api_url(url), headers={"User-Agent": "gogdl (Platypus)"})
    with urllib.request.urlopen(req, timeout=60) as r:
        raw = r.read()
    try:
        return json.loads(zlib.decompress(raw, 15))
    except zlib.error:
        return json.loads(raw)


# --- auth ---------------------------------------------------------------

def auth_status(_params=None):
    creds = credentials()
    if not creds:
        return {"loggedIn": False}
    user = ""
    try:
        me = api_get("https://embed.gog.com/userData.json", creds["access_token"])
        user = me.get("username") or ""
    except Exception:
        pass  # expired token or network trouble: still logged in, name unknown
    return {"loggedIn": True, "user": user} if user else {"loggedIn": True}


def auth_begin(_params):
    return {
        "url": LOGIN_URL,
        "instructions": "Log in to GOG in your browser. You land on a page that "
                        "doesn't load (on_login_success): copy its full address and paste "
                        "it here, or just the code=... value from it.",
        "fields": [{"id": "code", "label": "code or page address", "placeholder": "embed.gog.com/on_login_success?…code=…", "secret": True}],
    }


def extract_code(text):
    text = (text or "").strip()
    if text.startswith("{"):  # the whole JSON query string pasted by mistake
        try:
            text = json.loads(text).get("code", "")
        except ValueError:
            pass
    m = re.search(r"[?&]code=([^&\s]+)", text)
    if m:
        return m.group(1)
    return text.strip('"')


def auth_complete(params):
    code = extract_code(((params or {}).get("fields") or {}).get("code"))
    if not re.fullmatch(r"[A-Za-z0-9._-]{5,512}", code or ""):
        raise RPCError("that doesn't look like the address of the login page; "
                       "copy the whole address including the code= part")
    # NOTE (PLUG-3): the one-time code travels on argv, visible in ps(1)
    # while auth runs. gogdl offers no stdin/env alternative for --code
    # (see `gogdl auth --help`), so this is upstream-limited; the code is
    # short-lived, single-use, and never logged (only the CLI's tail is kept).
    rc, out, err = gogdl("auth", "--code", code, timeout=120)
    if rc != 0 or not credentials():
        raise RPCError(f"login failed: {tail(err)}")
    return auth_status()


def auth_logout(_params):
    try:
        os.remove(auth_file())
    except FileNotFoundError:
        pass
    return {"loggedIn": False}


# --- library ------------------------------------------------------------

def game_details_meta(app_id, token):
    """The store's product data: art and description for the game page."""
    try:
        return api_get(f"https://www.gog.com/games/ajax/filtered?search={app_id}", token)
    except Exception:
        return {}


def account_products(token):
    """The owned games from GOG's account API (paged). userData.json no longer
    lists owned games (it dropped ownedGames); this endpoint does, with title
    and art included."""
    page, games = 1, []
    while True:
        data = api_get(f"https://www.gog.com/account/getFilteredProducts"
                       f"?mediaType=1&page={page}", token)
        games += data.get("products") or []
        if page >= (data.get("totalPages") or 1):
            break
        page += 1
    return games


def library_list(_params):
    creds = credentials()
    if not creds:
        raise RPCError("log in to GOG first", CODE_AUTH_REQUIRED)
    token = creds["access_token"]
    try:
        games = account_products(token)
    except Exception as e:
        raise RPCError(f"GOG API is unreachable: {e}")
    installed = installed_games()
    remember_titles({str(g.get("id")): g["title"] for g in games if g.get("id") and g.get("title")})
    out = []
    for g in games:
        app = str(g.get("id") or "")
        if not app or g.get("isGame") is False:
            continue
        title = g.get("title") or app
        img = (g.get("image") or "").strip()
        if img.startswith("//"):
            img = "https:" + img
        entry = {
            "id": app,
            "title": title,
            "installed": app in installed,
            "installable": True,
            # The _2 (2x) variant answers 400 for some products; the 639 px one always exists and is plenty for a card.
            "coverUrl": f"{img}_product_card_v2_mobile_slider_639.jpg" if img else "",
            "heroUrl": f"{img}_scaled_1366x768.jpg" if img else "",
            "bannerUrl": f"{img}.jpg" if img else "",
        }
        # gogdl's linux manager has no builds: a Linux installer gets every
        # capability except version selection. features replaces the plugin's
        # set for this game, so every capability must be listed here (a
        # missing one would be off for these games).
        if (g.get("worksOn") or {}).get("Linux"):
            entry["features"] = [c for c in CAPABILITIES if c != "versions"]
        # Movie extras sit in the same account list.
        if g.get("isMovie") or g.get("category") == "movie" or g.get("url", "").startswith("/movie/"):
            entry["installable"] = False
            entry["note"] = "This is a movie or extra, not a game."
        if app in installed:
            add_installed(entry, installed[app])
        out.append(entry)
    for app, ig in installed.items():  # installed but missing from the owned list
        if not any(e["id"] == app for e in out):
            entry = {"id": app, "title": ig.get("title") or known_titles().get(app) or app,
                     "installable": False}
            add_installed(entry, ig)
            out.append(entry)
    return {"games": out}


def known_titles():
    """Titles the account listing returned, so an install whose account entry
    later vanishes keeps its name instead of the numeric id."""
    data = os.environ.get("PLATYPUS_PLUGIN_DATA") or "."
    try:
        with open(os.path.join(data, "titles.json")) as f:
            t = json.load(f)
        return t if isinstance(t, dict) else {}
    except (OSError, ValueError):
        return {}


def remember_titles(new):
    with state_lock:
        known = known_titles()
        if all(known.get(k) == v for k, v in new.items()):
            return
        known.update(new)
        data = os.environ.get("PLATYPUS_PLUGIN_DATA") or "."
        try:
            write_json_atomic(os.path.join(data, "titles.json"), known)
        except OSError:
            pass


def write_json_atomic(path, obj):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    tmp = path + ".new"
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, path)


def installed_games():
    """gogdl doesn't list installs, so the plugin scans its own state file."""
    data = os.environ.get("PLATYPUS_PLUGIN_DATA") or "."
    try:
        with open(os.path.join(data, "installed.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_installed(state):
    data = os.environ.get("PLATYPUS_PLUGIN_DATA") or "."
    write_json_atomic(os.path.join(data, "installed.json"), state)


def add_installed(entry, ig):
    entry["installed"] = True
    entry["installPath"] = ig.get("path", "")
    entry["version"] = ig.get("version", "")
    entry["native"] = ig.get("platform", "windows") == "linux"


def gog_info(app, platform, build=None, branch=None, timeout=600):
    """gogdl info as a dict. build/branch narrow it to one build's metadata."""
    cmd = ["info", app, "--platform", platform]
    if build:
        cmd += ["--build", build]
    if branch:
        cmd += ["--branch", branch]
    code, out, err = gogdl(*cmd, timeout=timeout)
    if code != 0:
        # Logged out = gogdl says so, or no stored credentials. A bare "auth"
        # substring also matches unrelated words ("authoritative").
        if "not logged in" in err.lower() or credentials() is None:
            raise RPCError("log in to GOG first", CODE_AUTH_REQUIRED)
        raise RPCError(f"gogdl info failed: {tail(err)}")
    return parse_gogdl_json(out, err)


def parse_gogdl_json(out, err):
    """The info JSON, tolerating log lines some gogdl versions print on stdout."""
    text = out[out.index("{"):] if "{" in out else out
    try:
        return json.loads(text)
    except ValueError:
        raise RPCError(f"gogdl info printed no JSON: {tail(err)}")


def size_pair(entry):
    entry = entry or {}
    return int(entry.get("download_size") or 0), int(entry.get("disk_size") or 0)


def best_sizes(data, lang=""):
    """The expected (download, disk) pair. A chosen language adds the depots
    every install gets ("*"); without one gogdl installs en-US, so that entry
    wins when it carries numbers; then the * entry; then the biggest language
    (the max overstates multilingual games). Older gogdl builds printed the
    fields at top level."""
    sizes = (data or {}).get("size") or {"*": data}
    if lang and isinstance(sizes.get(lang), dict):
        download, disk = size_pair(sizes[lang])
        base_download, base_disk = size_pair(sizes.get("*"))
        return download + base_download, disk + base_disk
    for key in ("en-US", "*"):
        e = sizes.get(key) or {}
        if e.get("download_size") or e.get("disk_size"):
            return size_pair(e)
    entries = list(sizes.values()) or [data]
    best = max(entries, key=lambda e: int((e or {}).get("disk_size") or 0))
    return size_pair(best)


def expected_sizes(data, lang="", dlcs=()):
    """(download, disk) for the chosen language and add-ons: gogdl reports each
    DLC's sizes keyed by language, like the base game's."""
    download, disk = best_sizes(data, lang)
    wanted = {str(d) for d in dlcs or []}
    for dlc in (data or {}).get("dlcs") or []:
        if not isinstance(dlc, dict) or str(dlc.get("id")) not in wanted:
            continue
        sizes = dlc.get("size")
        if isinstance(sizes, dict):
            d, k = best_sizes({"size": sizes}, lang)
            download += d
            disk += k
    return download, disk


def option_choices(options):
    """(language, DLC ids) from a job's install-option choices. Platypus sends
    the complete set, so an absent group means the game offers none."""
    o = options if isinstance(options, dict) else {}
    lang = str(o.get("language") or "")
    raw = o.get("dlc")
    dlcs = [str(d) for d in raw if str(d)] if isinstance(raw, list) else []
    return lang, dlcs


def install_size(params):
    app = params["id"]
    lang, dlcs = option_choices(params.get("options"))
    build, branch = resolve_target(params.get("target"))
    if build:
        data = require_served_build(app, platform_of(app), build, branch or None)
    else:
        data = gog_info(app, platform_of(app))
    download, disk = expected_sizes(data, lang, dlcs)
    return {"downloadBytes": download, "diskBytes": disk}


def platform_of(app):
    """The platform to install: what the user installed before, else what the
    product offers (a game with no Linux installer must install Windows).
    gogdl crashes on a platform with no installer, so never guess linux."""
    ig = installed_games().get(app)
    if ig:
        return ig.get("platform", "windows")
    try:
        data = api_get(f"https://api.gog.com/products/{app}?expand=downloads", "")
        installers = (data.get("downloads") or {}).get("installers") or []
        for i in installers:
            if i.get("os") == "linux":
                return "linux"
    except Exception:
        pass
    return "windows"


# --- install options (protocol 1.5) -----------------------------------------
#
# gogdl installs one language (--lang, en-US by default) and, with --with-dlcs
# plus --dlcs, exactly the owned add-ons named; without those flags it skips
# DLC. `info` lists both for a game.

def stored_manifest(app):
    """gogdl's manifest for a game: what it verifies against, and where the
    installed language and add-ons are recorded. {} when there is none."""
    for sub in (os.path.join("heroic_gogdl", "manifests"), "manifests"):
        try:
            with open(os.path.join(gogdl_config_base(), sub, app)) as f:
                data = json.load(f)
            if isinstance(data, dict):
                return data
        except (OSError, ValueError):
            pass
    return {}


def installed_language(app):
    return str(stored_manifest(app).get("HGLInstallLanguage") or "")


def installed_dlcs(app):
    ids = set()
    for d in stored_manifest(app).get("HGLdlcs") or []:
        if isinstance(d, dict) and d.get("id") is not None:
            ids.add(str(d["id"]))
    return ids


def game_options(params):
    """The install choices gogdl offers: the install language and the owned
    add-ons (gogdl lists only DLC the account owns)."""
    app = str((params or {}).get("id") or "")
    if not app:
        raise RPCError("invalid params: id is required", -32602)
    try:
        data = gog_info(app, platform_of(app), timeout=120)
    except RPCError as e:
        if e.code == CODE_AUTH_REQUIRED:
            raise
        raise RPCError(f"couldn't list install options for {app}: {e}", -32002)
    lang = installed_language(app)
    groups = []
    langs = [str(l) for l in (data.get("languages") or []) if l]
    if langs:
        default = lang if lang in langs else ("en-US" if "en-US" in langs else langs[0])
        groups.append({"id": "language", "label": "Language", "kind": "select",
                       "default": default,
                       "values": [{"id": l, "label": l} for l in langs]})
    dlcs = [d for d in (data.get("dlcs") or []) if isinstance(d, dict) and d.get("id") is not None]
    if dlcs:
        have = installed_dlcs(app)
        values = []
        for d in dlcs:
            v = {"id": str(d["id"]), "label": str(d.get("title") or d["id"]), "owned": True}
            sizes = d.get("size")
            if isinstance(sizes, dict):
                disk = best_sizes({"size": sizes}, lang)[1]
                if disk:
                    v["sizeBytes"] = disk
            if str(d["id"]) in have:
                v["installed"] = True
            values.append(v)
        groups.append({"id": "dlc", "label": "Add-ons", "kind": "multi",
                       "dlc": True, "values": values})
    return {"groups": groups}


# --- versions (1.3) ---------------------------------------------------------
#
# Builds come from `gogdl info` (its builds[] lists what this user can fetch).
# The content-system builds endpoint only names the total: when it reports more
# builds than gogdl lists, or private branches, the rest sit on branches this
# user can't see, and versions.list offers a build-id box instead of pretending
# the list is complete. No password branches are known (available_branches is
# [null]), so there is no versions.unlock: the first -32601 tells Platypus.

def resolve_target(target):
    """(build, branch) for gogdl from a Versions target. ("", "") by default;
    manual.input (or manual.build) is a build id the store doesn't list."""
    if not target:
        return "", ""
    build = str(target.get("build") or "")
    branch = str(target.get("channel") or "")
    manual = target.get("manual") or {}
    if not build:
        build = str(manual.get("input") or manual.get("build") or "").strip()
    if build and not BUILD_ID_RE.fullmatch(build):
        raise RPCError(f"GOG build ids are digits (got {build!r}); pick a build "
                       f"from the list or type its numeric id", -32000)
    return build, branch


def channel_head(items, channel):
    """The first listed build on a channel (branches are the store's moving
    pointers; the default channel's head is the latest build)."""
    for i in items:
        if str(i.get("branch") or "") == (channel or ""):
            return str(i.get("build_id"))
    return ""


def versions_list(params):
    app = (params or {}).get("id") or ""
    if not app:
        raise RPCError("invalid params: id is required", -32602)
    platform = platform_of(app)
    try:
        data = gog_info(app, platform)  # unknown id or logged out, usually
    except RPCError as e:
        if e.code == CODE_AUTH_REQUIRED:
            raise
        raise RPCError(f"couldn't list GOG builds for {app}: {e}", -32002)
    raw = data.get("builds") or {}
    items = raw.get("items", []) if isinstance(raw, dict) else raw or []
    latest = str(data.get("buildId") or "")
    branches = [b for b in (data.get("available_branches") or []) if b]
    known = {str(i.get("build_id")) for i in items if i.get("build_id")}
    listed = {bid for bid in known if bid}
    installed = installed_games().get(app) or {}
    current = str(installed.get("build") or "")
    if not current and installed.get("path"):
        # A 0.1.0 install predates build tracking: read the marker gogdl left.
        current = marker_build(installed["path"], app)
    channels = [{"id": b, "name": b, "requires": "none",
                 "current": installed.get("channel") == b}
                for b in branches]
    builds = []
    for i in items:
        bid = str(i.get("build_id"))
        if not bid:
            continue
        entry = {"id": bid, "name": str(i.get("version_name") or f"build {bid}"),
                 "publishedAt": str(i.get("date_published") or "")[:10],
                 "source": "store", "current": bid == current}
        if i.get("branch"):
            entry["channel"] = str(i["branch"])
        builds.append(entry)
    # History the store no longer lists: unlisted ids can never be served
    # (gogdl falls back to the default build for an id it doesn't serve), so
    # mark them unavailable without probing.
    for l in ((params or {}).get("ledger") or [])[-5:]:
        if not isinstance(l, dict):
            continue
        lb = str(l.get("build") or "")
        if not lb or lb in known:
            continue
        known.add(lb)  # one row per build, even if history repeats it
        entry = {"id": lb, "name": str(l.get("versionName") or f"build {lb}"),
                 "publishedAt": str(l.get("date") or "")[:10],
                 "source": "archive", "available": False,
                 "current": lb == current}
        if l.get("channel"):
            entry["channel"] = str(l["channel"])
        builds.append(entry)
    # No manual box: gogdl matches --build only against the public items, so
    # a typed private-branch id could never install. (VersionList has no note
    # field to say how many builds stay hidden.)
    pinned = (params or {}).get("pinned") or {}
    update_available = False
    if current:
        if pinned.get("kind") == "build" and pinned.get("id"):
            update_available = current != str(pinned["id"])
        else:
            channel = installed.get("channel") or ""
            if pinned.get("kind") == "channel" and pinned.get("id"):
                channel = str(pinned["id"])
            head = channel_head(items, channel) if channel else latest
            # A build the store doesn't list (removed, or newer than the
            # store's) never claims an update.
            update_available = bool(head) and current != head and current in listed
    return {"channels": channels, "builds": builds, "manual": None,
            "links": [], "updateAvailable": update_available,
            "pinned": (params or {}).get("pinned")}

# --- jobs ---------------------------------------------------------------

def start_job(params, kind):
    app, job_id = params["id"], params["jobId"]
    if kind == "uninstall":
        ig = installed_games().get(app)
        if not ig:
            raise RPCError(f"{app} is not installed")
        ev = threading.Event()
        if not claim_job(job_id, {"proc": None, "canceled": False, "id": app, "event": ev}):
            return {}
        threading.Thread(target=follow_uninstall, args=(job_id, app, ev), daemon=True).start()
        return {}
    path = params.get("installDir") or ""
    if not os.path.isabs(path):
        raise RPCError("installDir is missing or relative; Platypus always sends one")
    build, branch = resolve_target(params.get("target"))
    platform = platform_of(app)
    if kind == "update" and build and app in installed_games():
        # Fail fast when the store doesn't serve the build: gogdl would
        # silently converge to the default instead.
        require_served_build(app, platform, build, branch or None, timeout=60)
    if kind == "update" and app in installed_games():
        cmd = ["update", app, "--path", path]
    else:
        cmd = ["download", app, "--path", path]
    if build:
        cmd += ["--build", build]
    if branch:
        cmd += ["--branch", branch]
    cmd += ["--platform", platform]
    lang, dlcs = option_choices(params.get("options"))
    if lang:
        cmd += ["--lang", lang]
    if dlcs:
        # --dlcs only lists what to take; --with-dlcs lets gogdl take any.
        cmd += ["--with-dlcs", "--dlcs", ",".join(dlcs)]
    else:
        cmd += ["--skip-dlcs"]
    cmd += ["--max-workers", "4"]
    if kind == "install":
        # A fresh install (resume included) with no marker on disk must not
        # diff against a cached manifest: gogdl compares manifest vs manifest
        # and would report a same-build cache as up to date in an empty folder.
        clear_cached_manifest(app, find_game_dir(app, path, platform), platform)
    elif platform != "linux" and kind == "update":
        prime_legacy_manifest(app, find_game_dir(app, path, platform))
    argv = ["gogdl", "--auth-config-path", auth_file(), *cmd]
    # Platypus resends a job with the same jobId after a crash: run it once. A job
    # just paused or canceled is still stopping: wait, then resume from what
    # gogdl left in the game folder.
    if not claim_job(job_id, {"proc": None, "canceled": False, "id": app, "path": path}):
        return {}
    job_started(job_id, app, kind, path)
    try:
        proc = spawn_gogdl(argv)
    except FileNotFoundError:
        with jobs_lock:
            jobs.pop(job_id, None)
        raise RPCError("gogdl is not installed (needs version 1.1 or newer); get the "
                       "binary from github.com/Heroic-Games-Launcher/heroic-gogdl/releases")
    with jobs_lock:
        job = jobs.setdefault(job_id, {"canceled": False, "id": app})
        job["proc"] = proc
        job["argv"] = argv
        canceled = job["canceled"]
        job["title"] = params.get("title") or ""
        job["options"] = params.get("options") or {}
        # What this run converges to, and when it last moved: the stall
        # watchdog fails the job when gogdl hangs (see follow_job).
        job["build"], job["channel"], job["platform"] = build, branch, platform
        reset_run_state(job, time.monotonic())
    threading.Thread(target=follow_job, args=(job_id, kind, proc), daemon=True).start()
    if canceled:  # job.cancel arrived while the process was starting
        stop_proc(proc, grace=5)
    return {}


def require_served_build(app, platform, build, branch=None, timeout=600):
    """The info for a requested build, or -32002: gogdl silently keeps the
    default build for an id it doesn't serve."""
    data = gog_info(app, platform, build, branch, timeout=timeout)
    if str(data.get("buildId") or "") != build:
        raise RPCError(f"GOG doesn't offer build {build} to this account; pick a "
                       f"listed build or install the latest.", -32002)
    return data


def prime_legacy_manifest(app, game_dir):
    """0.1.0 kept gogdl's manifest in the shared config dir. On update, when
    the isolated cache has nothing for the game, copy the legacy manifest
    over if it matches the installed build; else warn that the update will
    download everything. Never moves: Heroic's copy stays theirs."""
    base = gogdl_config_base()
    subs = ("manifests", os.path.join("heroic_gogdl", "manifests"))
    if any(os.path.isfile(os.path.join(base, s, app)) for s in subs):
        return  # the isolated cache already has it
    for s in subs:
        try:
            os.makedirs(os.path.join(base, s), exist_ok=True)
        except OSError:
            pass
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    legacy = os.path.join(xdg, "heroic_gogdl", "manifests", app)
    try:
        with open(legacy) as f:
            legacy_build = str(json.load(f).get("buildId") or "")
    except (OSError, ValueError):
        legacy_build = ""
    if legacy_build and legacy_build == marker_build(game_dir, app):
        for s in subs:
            try:
                shutil.copyfile(legacy, os.path.join(base, s, app))
            except OSError:
                pass
    else:
        log("warn", f"no cached manifest matches the installed {app}; "
                    f"the update will download everything")


def clear_cached_manifest(app, game_dir, platform="windows"):
    """Drops our isolated manifest cache for a game with no marker on disk, so
    a fresh install always fetches. Never called for updates: those must diff
    against the installed manifest."""
    if has_marker(game_dir, app, platform):
        return
    for sub in ("manifests", os.path.join("heroic_gogdl", "manifests")):
        try:
            os.remove(os.path.join(gogdl_config_base(), sub, app))
        except OSError:
            pass


def clear_download_cache(job_id):
    """Deletes gogdl's chunk cache for a stalled job: its chunks are reused
    without verification, so the retry refetches them with fresh links. The
    cache lives in the game folder, which may not be resolvable yet (no
    marker): then delete it in every folder this job created, tracked in
    jobs-meta — never a glob over the install folder."""
    with jobs_lock:
        job = jobs.get(job_id, {})
        app, path = job.get("id"), job.get("path")
    if not app or not path:
        return
    platform = job.get("platform") or "windows"
    game_dir = find_game_dir(app, path, platform)
    dirs = [game_dir] if has_marker(game_dir, app, platform) else []
    with meta_lock:
        meta = load_meta()
        m = meta.get(job_id)
        if m is not None:
            claim_new_dirs(meta, m)
            base = m.get("installDir") or path
            for name in m.get("dirs", []):
                if isinstance(name, str) and name not in ("", ".", "..") and "/" not in name:
                    dirs.append(os.path.join(base, name))
            try:
                write_json_atomic(meta_file(), meta)
            except OSError:
                pass
    for d in dirs:
        shutil.rmtree(os.path.join(d, ".gogdl-download-cache"), ignore_errors=True)


def reset_run_state(job, now=None):
    """(Re)arms a run's stall timers. Called with the lock held at spawn and
    before a stall retry, with a fresh timestamp."""
    now = now if now is not None else time.monotonic()
    job.pop("stalled", None)
    job["last_line_at"] = job["last_bytes_at"] = job["last_live_at"] = now
    job["top_bytes"], job["dl_mib"] = 0, 0
    job["seen_progress"] = False
    job.pop("speed", None)


def spawn_gogdl(argv):
    """Starts gogdl in its own process session and records the group id, so
    stop_proc can kill the whole download tree: forked workers outlive a lone
    SIGINT to the parent and would hold our stdout pipe open forever."""
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, bufsize=1,
                            start_new_session=True, env=gogdl_env())
    try:
        proc.pgid = os.getpgid(proc.pid)
    except OSError:
        proc.pgid = None
    return proc


def respawn_job(job_id):
    """Starts the same gogdl command again after a stall (fresh links and a
    fresh session). None when the job went away or was canceled meanwhile."""
    with jobs_lock:
        job = jobs.get(job_id)
        if job is None or job.get("canceled"):
            return None
        argv = job.get("argv")
    if not argv:
        return None
    try:
        proc = spawn_gogdl(argv)
    except (FileNotFoundError, OSError):
        return None
    with jobs_lock:
        job = jobs.get(job_id)
        if job is None or job.get("canceled"):
            stop_proc(proc, grace=5)
            return None
        job["proc"] = proc
    return proc


def follow_job(job_id, kind, proc):
    """Reports gogdl's progress, then its outcome. Two guards turn silent
    corruption into loud errors: a stall detector fails a run gogdl hangs on
    (no liveness for a while, or no output at all), then retries it once with
    a fresh connection; and a size check fails a run gogdl reports as done
    but left far short on disk (an unserved build, a filtered language, a
    gogdl bug)."""
    state = {"jobId": job_id, "phase": "downloading", "percent": 0}
    bytes_stall, quiet_stall = stall_limits()
    for attempt in (1, 2):
        outcome = watch_attempt(job_id, proc, state, bytes_stall, quiet_stall)
        if outcome == "canceled":
            with jobs_lock:
                jobs.pop(job_id, None)
            job_stopped(job_id)
            return
        if outcome == "stalled" and attempt == 1:
            with jobs_lock:
                job = jobs.get(job_id, {})
                if job.get("canceled"):
                    jobs.pop(job_id, None)
                    job_stopped(job_id)
                    return
                msg = job.get("stalled") or "gogdl stalled"
            log("warn", f"{msg} Retrying once with a fresh connection.")
            stop_proc(proc)
            clear_download_cache(job_id)
            with jobs_lock:
                reset_run_state(jobs.get(job_id, {}))
            proc = respawn_job(job_id)
            if proc is None:
                with jobs_lock:
                    gone = jobs.get(job_id, {}).get("canceled")
                job_stopped(job_id)
                if gone:
                    return
                notify("job.failed", {"jobId": job_id,
                                      "error": "gogdl stalled and couldn't be restarted; "
                                               "retry the job"})
                return
            continue
        break
    try:  # the reader may have left on an abnormal pipe break
        rc = proc.wait(timeout=30)
    except subprocess.TimeoutExpired:
        stop_proc(proc, grace=5)
        try:
            rc = proc.wait(timeout=30)
        except subprocess.TimeoutExpired:
            rc = -1  # wedged kernel-side; the failure below says so
    with jobs_lock:
        job = jobs.pop(job_id, {})
    if job.get("canceled"):
        job_stopped(job_id)
        return
    if job.get("stalled"):
        job_stopped(job_id)
        notify("job.failed", {"jobId": job_id, "error": job["stalled"]})
        return
    if rc != 0:
        job_stopped(job_id)
        notify("job.failed", {"jobId": job_id, "error": f"gogdl exited with {rc}"})
        return
    failed, installed = finish_install(job, kind)
    if failed:
        job_stopped(job_id)
        notify("job.failed", {"jobId": job_id, "error": failed})
        return
    record_install(job, kind, installed)
    job_finished(job_id)
    done = {"jobId": job_id}
    if installed.get("build"):
        done["installed"] = installed
    notify("job.done", done)


def line_reader(fd):
    """A next_line(timeout) reader for fd: one line within timeout, "" at end
    of stream (or a closed pipe), None on timeout. Keeps a byte buffer across
    calls. Reads the raw fd, not the TextIOWrapper: the wrapper readaheads into
    an internal buffer that select() can't see, so select-then-readline would
    stall with whole lines already buffered but the fd dry."""
    buf = b""

    def next_line(timeout):
        nonlocal buf
        while b"\n" not in buf:
            try:
                ready, _, _ = select.select([fd], [], [], timeout)
            except (OSError, ValueError):
                return ""
            if not ready:
                return None
            try:
                chunk = os.read(fd, 65536)
            except OSError:
                return ""
            if chunk == b"":
                line, buf = buf, b""
                return line.decode("utf-8", "replace") if line else ""
            buf += chunk
            timeout = 0
        line, buf = buf.split(b"\n", 1)
        return line.decode("utf-8", "replace")

    return next_line


def pump(proc, next_line, on_line):
    """Feeds proc's output lines to on_line until it exits or every writer
    closes. gogdl forks workers that can hold the pipe open after the parent:
    once the process is gone, take the lines already here and stop instead of
    hanging on EOF."""
    while True:
        line = next_line(5)
        if line is None:
            pass  # timeout: re-check the process below
        elif line == "":
            return  # every writer closed: EOF (or the pipe went away)
        else:
            on_line(line)
        if proc.poll() is not None:
            while True:
                line = next_line(0)
                if not line:  # "" (EOF) or None (nothing waiting)
                    return
                on_line(line)


def watch_attempt(job_id, proc, state, bytes_stall, quiet_stall):
    """Reads one gogdl run to its end: "eof", "stalled" or "canceled". A stall
    kills the run's process group; the caller decides whether to retry."""
    stop = threading.Event()

    def watchdog():
        while not stop.wait(10):
            with jobs_lock:
                job = jobs.get(job_id)
            if job is None:
                return
            stalled = stall_message(job, bytes_stall, quiet_stall)
            if stalled is not None:
                with jobs_lock:
                    jobs.get(job_id, {})["stalled"] = stalled
                stop_proc(proc)
                return

    def stall_message(job, bytes_stall, quiet_stall):
        last_line = job.get("last_line_at")
        if last_line is None:
            return None  # already reaped
        now = time.monotonic()
        if job.get("seen_progress") and now - job.get("last_live_at", now) > bytes_stall:
            dl = job.get("dl_mib", 0)
            return (f"gogdl stalled: no progress for {int(bytes_stall)}s "
                    f"(still {job.get('percent', 0):.1f}%, "
                    f"{job.get('top_mib', 0):.0f}/{job.get('total_mib', 0):.0f} MiB, "
                    f"downloaded {dl:.1f} MiB). "
                    f"The connection or GOG's CDN may be stuck; retry, or "
                    f"update to the latest build.")
        if now - last_line > quiet_stall:
            return (f"gogdl went quiet for {int(quiet_stall)}s with no output. "
                    f"The download may be stuck; retry the job.")
        return None

    threading.Thread(target=watchdog, daemon=True).start()
    try:
        fd = proc.stdout.fileno()
    except (OSError, ValueError):
        stop.set()
        return "eof"
    next_line = line_reader(fd)

    def handle_line(line):
        """Folds one gogdl output line into the job's progress timers and the
        reported state. Besides written bytes, growing downloaded MiB and any
        non-zero throughput or disk activity count as liveness (slow chunks
        and xdelta patches move no written bytes for a while)."""
        line = line.rstrip()
        if not line:
            return
        live = False
        parsed = parse_progress(line)
        now = time.monotonic()
        if parsed is None:
            m = SPEED_RE.search(line)  # 1.3.0 reports throughput on its own lines
            if m:
                if float(m.group(1)) > 0:
                    live = True
                with jobs_lock:
                    jobs.get(job_id, {})["speed"] = float(m.group(1)) * MIB
            m = DL_RE.search(line)
            if m:
                dl = float(m.group(1))
                with jobs_lock:
                    job = jobs.get(job_id, {})
                    if dl > job.get("dl_mib", 0):
                        job["dl_mib"] = dl
                        live = True
            m = DISK_RE.search(line)
            if m and (float(m.group(1)) > 0 or float(m.group(2)) > 0):
                live = True
        with jobs_lock:
            job = jobs.get(job_id, {})
            job["last_line_at"] = now
            if parsed:
                pct, done, total, speed = parsed
                job["seen_progress"] = True
                job["percent"] = pct
                if done > job.get("top_bytes", 0):
                    job["top_bytes"], job["last_bytes_at"] = done, now
                    live = True
                job["top_mib"] = done / MIB
                job["total_mib"] = total / MIB
            if live:
                job["last_live_at"] = now
        if parsed:
            pct, done, total, speed = parsed
            state["percent"] = pct
            state["bytes"] = done
            state["total"] = total
            if speed is None:
                with jobs_lock:
                    speed = jobs.get(job_id, {}).get("speed")
            if speed is not None:
                state["speed"] = speed
            notify("job.progress", dict(state))

    pump(proc, next_line, handle_line)
    stop.set()
    with jobs_lock:
        job = jobs.get(job_id, {})
        if job.get("canceled"):
            return "canceled"
        if job.get("stalled"):
            return "stalled"
    return "eof"


def finish_install(job, kind):
    """What a successful run put on disk: ("", installed) normally, or
    (error, {}) when gogdl reported done but the game isn't what was asked
    for. installed feeds job.done and the install ledger
    (docs/plugins/protocol.md, "Versions")."""
    app, path = job.get("id"), job.get("path")
    build, channel = job.get("build") or "", job.get("channel") or ""
    platform = job.get("platform") or platform_of(app)
    lang, dlcs = option_choices(job.get("options"))
    game_dir = find_game_dir(app, path, platform) if app and path else ""
    if not has_marker(game_dir, app, platform):
        marker_name = "a Linux installer marker" if platform == "linux" else f"goggame-{app}.info"
        return (f"gogdl reported success but left no game in "
                f"{game_dir or path or 'the install folder'} "
                f"(no {marker_name}); the install did not land, "
                f"retry the job.", {})
    if platform == "linux":
        # The Linux installer manager has no builds and no buildId: verify
        # the size only, and report no version (those games already omit
        # "versions" from their library features).
        try:
            data = gog_info(app, platform, timeout=60)
        except RPCError as e:
            log("warn", f"couldn't confirm the installed size for {app}: {e}")
            data = None
        if data:
            _, expected = expected_sizes(data, lang, dlcs)
            actual_bytes = dir_size(game_dir)
            if expected > 0 and actual_bytes < expected // 2:
                return (f"installed only {fmt_bytes(actual_bytes)} of the expected "
                        f"{fmt_bytes(expected)}; the game looks incomplete, "
                        f"retry the job.", {})
        return "", {}
    marker = marker_build(game_dir, app)
    data = None
    try:  # short timeout: this gates the job's outcome, not the download
        data = gog_info(app, platform, build or None, channel or None,
                        timeout=60)
    except RPCError as e:
        log("warn", f"couldn't confirm the installed build for {app}: {e}")
    served = str((data or {}).get("buildId") or "")
    if build:
        # gogdl silently keeps the default build for an id it doesn't serve.
        if served and served != build:
            return (f"gogdl installed build {served}, not the requested build "
                    f"{build}; that build is no longer served. Pick a listed "
                    f"build or update to the latest.", {})
        if not served and marker and marker != build:
            return (f"gogdl installed build {marker}, not the requested build "
                    f"{build}; that build is no longer served. Pick a listed "
                    f"build or update to the latest.", {})
        if not served and not marker:
            return (f"installed the requested build {build} but couldn't confirm "
                    f"it (the store didn't answer); retry the job.", {})
        actual = build
    else:
        actual = served or marker
        if not actual:
            return (f"installed {app} but couldn't determine the build (the "
                    f"store didn't answer); retry the job.", {})
    if data:
        _, expected = expected_sizes(data, lang, dlcs)
        actual_bytes = dir_size(game_dir)
        if expected > 0 and actual_bytes < expected // 2:
            return (f"installed only {fmt_bytes(actual_bytes)} of the expected "
                    f"{fmt_bytes(expected)} for build {actual}. "
                    f"gogdl reported success but the game looks incomplete "
                    f"(a filtered language, or files GOG no longer serves); "
                    f"retry, or update to the latest build.", {})
    installed = {"build": actual, "channel": channel,
                 "versionName": str((data or {}).get("versionName") or "")}
    if not installed["channel"]:
        del installed["channel"]
    if not installed["versionName"]:
        del installed["versionName"]
    return "", installed


def has_marker(game_dir, app, platform="windows"):
    """Whether gogdl left the game's marker file in the resolved folder."""
    if not game_dir:
        return False
    markers = linux_markers() if platform == "linux" else [f"goggame-{app}.info"]
    return any(os.path.isfile(os.path.join(game_dir, m)) for m in markers)


def marker_build(game_dir, app):
    """The build id gogdl wrote into the game's marker file, if any."""
    try:
        with open(os.path.join(game_dir or "", f"goggame-{app}.info"),
                  encoding="utf-8-sig") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return ""
    for key in ("buildId", "build_id", "build"):
        if data.get(key):
            return str(data[key])
    return ""


def dir_size(path):
    """Apparent bytes under path (st_size: sparse test files count fully)."""
    total = 0
    try:
        for root, _dirs, files in os.walk(path):
            for f in files:
                try:
                    total += os.path.getsize(os.path.join(root, f))
                except OSError:
                    pass
    except OSError:
        pass
    return total


def fmt_bytes(n):
    return f"{n / (1024 ** 3):.2f} GiB" if n >= 1024 ** 3 else f"{n / 1024 ** 2:.0f} MiB"


def record_install(job, kind, installed):
    """Remember the install so launches and updates can find it. gogdl imports
    don't exist here, so the plugin keeps its own index of what it installed."""
    app, path = job.get("id"), job.get("path")
    if not app or not path:
        return
    platform = job.get("platform") or platform_of(app)
    game_dir = find_game_dir(app, path, platform)
    exe = find_executable(game_dir)
    with state_lock:
        state = installed_games()
        state[app] = {
            "path": game_dir,
            "platform": platform,
            "version": installed.get("versionName", ""),
            "build": installed.get("build", ""),
            "channel": installed.get("channel", ""),
            "executable": exe,
            "title": job.get("title") or known_titles().get(app, ""),
        }
        save_installed(state)


def find_game_dir(app, path, platform="windows"):
    """gogdl unpacks into <path>/<folder_name> (the store's folder name, not
    the numeric id). Find the dir holding the game's marker (goggame-<id>.info
    on Windows, .gogdl-linux-manifest or gameinfo for a Linux installer);
    fall back to the id-named dir, then the path itself."""
    markers = linux_markers() if platform == "linux" else [f"goggame-{app}.info"]
    direct = os.path.join(path, app)
    if os.path.isdir(direct):
        return direct
    try:
        for name in sorted(os.listdir(path)):
            sub = os.path.join(path, name)
            if not os.path.isdir(sub):
                continue
            if any(os.path.isfile(os.path.join(sub, m)) for m in markers):
                return sub
    except OSError:
        pass
    if platform == "linux" and any(os.path.isfile(os.path.join(path, m)) for m in markers):
        return path  # a Linux installer may unpack straight into installDir
    return path


def linux_markers():
    """The files gogdl's Linux installer manager leaves in the game folder
    instead of a goggame-<id>.info marker."""
    return (".gogdl-linux-manifest", "gameinfo")


def find_executable(game_dir):
    """The start script or binary gogdl unpacked: start.sh, then the game's
    own .exe (Windows installs ship many helper exes; goggame-*.info names
    the real one), then any *.sh."""
    for name in ("start.sh",):
        p = os.path.join(game_dir, name)
        if os.path.isfile(p):
            return p
    # The goggame info file carries the primary executable (playTasks).
    candidates = []
    for info in glob.glob(os.path.join(game_dir, "goggame-*.info")):
        try:
            with open(info, encoding="utf-8-sig") as f:
                data = json.load(f)
        except (OSError, ValueError):
            continue
        for task in (data.get("playTasks") or []):
            rel = task.get("path") or ""
            if not rel:
                continue
            p = os.path.join(game_dir, rel.replace("\\", os.sep))
            if os.path.isfile(p):
                candidates.append((not task.get("isPrimary"), p))
    if candidates:
        # Prefer the primary task; any playTask beats guessing a script.
        return min(candidates, key=lambda c: c[0])[1]
    try:
        for root, _dirs, files in os.walk(game_dir):
            for f in files:
                if f.endswith(".sh") and os.access(os.path.join(root, f), os.X_OK):
                    return os.path.join(root, f)
    except OSError:
        pass
    return ""


def follow_uninstall(job_id, app, ev=None):
    if ev is not None:
        ev.wait(0.5)
    else:
        time.sleep(0.2)
    with jobs_lock:
        if jobs.get(job_id, {}).get("canceled"):
            jobs.pop(job_id, None)
            return
    with state_lock:
        state = installed_games()
        ig = state.pop(app, None)
        with jobs_lock:
            if jobs.get(job_id, {}).get("canceled"):
                jobs.pop(job_id, None)
                return
            jobs.pop(job_id, None)
        if ig and ig.get("path") and os.path.isdir(ig["path"]):
            import shutil
            shutil.rmtree(ig["path"], ignore_errors=True)
        save_installed(state)
    notify("job.done", {"jobId": job_id})


def claim_job(job_id, entry, timeout=90):
    """Registers entry as the run of job_id and returns True. False when the
    job is already running (a repeated start). A job that job.cancel just
    stopped is still shutting down gogdl: wait for it to go, so a resume with
    the same jobId doesn't lose to the old run and report nothing."""
    deadline = time.monotonic() + timeout
    while True:
        with jobs_lock:
            job = jobs.get(job_id)
            if job is None:
                jobs[job_id] = entry
                return True
            if not job.get("canceled"):
                return False
        if time.monotonic() > deadline:
            raise RPCError("the previous run of this download is still stopping; try again in a moment")
        time.sleep(0.05)


def stop_proc(proc, grace=15):
    """Stops a job's gogdl: SIGINT to its process group, SIGKILL after the
    grace period, and one last SIGKILL sweep once the parent is reaped.
    gogdl forks download workers that outlive a lone SIGINT to the parent,
    and its ProcessingManager server ignores SIGINT entirely; left running,
    they keep the network and our stdout pipe busy (the reader then never
    sees EOF, so the job hangs instead of failing). The group id is captured
    at spawn; without killpg (or a group) it falls back to the parent."""
    if proc is None:
        return
    pgid = getattr(proc, "pgid", None)
    grouped = pgid is not None and hasattr(os, "killpg")

    def sweep(sig):
        try:
            if grouped:
                os.killpg(pgid, sig)
            elif sig == signal.SIGINT:
                proc.send_signal(sig)
            else:
                proc.kill()
        except OSError:
            pass  # group already gone; the wait below reaps what's left

    sweep(signal.SIGINT)
    try:
        proc.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        pass
    except (ProcessLookupError, OSError):
        return
    # The parent may be gone while a SIGINT-ignoring child survives: sweep
    # the group once more. ProcessLookupError means nothing is left.
    try:
        if grouped:
            os.killpg(pgid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except OSError:
        pass
    try:
        proc.kill()
    except OSError:
        pass
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    except (ProcessLookupError, OSError):
        pass


def job_cancel(params):
    with jobs_lock:
        job = jobs.get(params.get("jobId"))
        if job:
            job["canceled"] = True
            proc, ev = job.get("proc"), job.get("event")
        else:
            proc, ev = None, None
    if ev is not None:
        ev.set()
    if proc:
        threading.Thread(target=stop_proc, args=(proc,), daemon=True).start()
    return {}


# --- discarding a canceled job's data ---------------------------------------
# gogdl unpacks into <installDir>/<the store's folder name> and keeps its resume
# files (.gogdl-resume, the download cache) inside that folder, so deleting the
# folder deletes everything. The plugin can't know the folder's name before
# gogdl has made it, so it remembers which folders appeared in the install folder
# while an install job ran ($PLATYPUS_PLUGIN_DATA/jobs-meta.json) and job.discard
# deletes exactly those, never one that is installed.

meta_lock = threading.RLock()
JOB_ID_RE = re.compile(r"[A-Za-z0-9_-]{1,64}")


def meta_file():
    return os.path.join(os.environ.get("PLATYPUS_PLUGIN_DATA") or ".", "jobs-meta.json")


def load_meta():
    try:
        with open(meta_file()) as f:
            meta = json.load(f)
        return meta if isinstance(meta, dict) else {}
    except (OSError, ValueError):
        return {}


def list_dir(path):
    try:
        return sorted(os.listdir(path))
    except OSError:
        return []


def installed_dirs():
    return [os.path.realpath(g["path"]) for g in installed_games().values() if g.get("path")]


def claim_new_dirs(meta, m):
    """Attributes to the job the folders that showed up since it began and that
    nothing else accounts for: not there before, not another job's, not installed."""
    taken = set(m["pre"]) | set(m["dirs"])
    for o in meta.values():
        if o is not m and o.get("installDir") == m["installDir"]:
            taken |= set(o.get("dirs", []))
    installed = installed_dirs()
    for name in list_dir(m["installDir"]):
        path = os.path.realpath(os.path.join(m["installDir"], name))
        if name in taken or path in installed:
            continue
        m["dirs"].append(name)


def job_started(job_id, app, kind, install_dir):
    if kind != "install":
        return
    with meta_lock:
        meta = load_meta()
        m = meta.get(job_id)
        if m is None:
            meta[job_id] = {"app": app, "installDir": install_dir, "pre": list_dir(install_dir), "dirs": []}
        else:
            claim_new_dirs(meta, m)  # a run that was cut short, now resuming
        try:
            write_json_atomic(meta_file(), meta)
        except OSError as e:
            log("warn", f"couldn't record job {job_id}: {e}")


def job_stopped(job_id):
    """The run ended without finishing: note what it left."""
    with meta_lock:
        meta = load_meta()
        m = meta.get(job_id)
        if m is None:
            return
        claim_new_dirs(meta, m)
        try:
            write_json_atomic(meta_file(), meta)
        except OSError:
            pass


def job_finished(job_id):
    with meta_lock:
        meta = load_meta()
        if meta.pop(job_id, None) is not None:
            try:
                write_json_atomic(meta_file(), meta)
            except OSError:
                pass


def job_discard(params):
    """Deletes the partial install of a job that was canceled: the folders it
    created in the install folder. Updates and anything installed are left."""
    job_id = params.get("jobId")
    if not isinstance(job_id, str) or not JOB_ID_RE.fullmatch(job_id):
        raise RPCError("invalid jobId", -32602)
    job_cancel({"jobId": job_id})
    deadline = time.monotonic() + 90
    while True:  # the job may still be shutting down
        with jobs_lock:
            running = job_id in jobs
        if not running:
            break
        if time.monotonic() > deadline:
            raise RPCError("the download is still stopping; try again in a moment")
        time.sleep(0.05)
    with meta_lock:
        meta = load_meta()
        m = meta.pop(job_id, None)
        if m is not None:
            if params.get("kind", "install") == "install" and m.get("installDir") == params.get("installDir"):
                claim_new_dirs({**meta, job_id: m}, m)
                remove_job_dirs(m)
            try:
                write_json_atomic(meta_file(), meta)
            except OSError:
                pass
    return {}


def remove_job_dirs(m):
    base = os.path.realpath(m["installDir"])
    installed = installed_dirs()
    for name in m.get("dirs", []):
        if not isinstance(name, str) or name in ("", ".", "..") or "/" in name:
            continue
        path = os.path.join(base, name)
        real = os.path.realpath(path)
        if os.path.islink(path) or not os.path.isdir(path) or os.path.dirname(real) != base:
            continue
        if any(i == real or i.startswith(real + os.sep) or real.startswith(i + os.sep) for i in installed):
            log("warn", f"not deleting {path}: it holds an installed game")
            continue
        shutil.rmtree(path, ignore_errors=True)


# --- launch -------------------------------------------------------------

def launch_spec(params):
    app = params["id"]
    ig = installed_games().get(app)
    if not ig:
        raise RPCError(f"{app} is not installed")
    path, exe = ig.get("path") or "", ig.get("executable") or ""
    if not exe or not os.path.isfile(exe):
        exe = find_executable(path)
    if not exe:
        raise RPCError(f"couldn't find a start script for {app} in {path or 'the install folder'}")
    native = ig.get("platform") == "linux"
    # Windows installers run their exe directly through Proton; Linux installers
    # run the start script. GOG scripts take care of their own working dir.
    return {
        "exe": exe,
        "args": [],
        "cwd": os.path.dirname(exe),
        "env": {},
        "needsWine": not native,
    }


# --- verify and move (protocol 1.4) ------------------------------------------
#
# game.verify: a check hashes the installed files against what gogdl recorded
# during the install — its content-system manifest for Windows installs (whose
# per-depot file lists live on GOG's CDN) or the Linux installer's
# .gogdl-linux-manifest — and a repair then runs `gogdl repair` (download with
# verification) and re-checks. game.relocated rebases the install record after
# Platypus moved the folder itself.

def galaxy_path(name):
    """GOG's CDN layout for a manifest hash: ab/cd/abcd…."""
    return name if "/" in name else name[:2] + "/" + name[2:4] + "/" + name


def lang_matches(depot_langs, installed):
    """Whether a depot belongs to an install of `installed`: "*" or that
    language. Depot languages may be shortened ("en" for "en-US"), which gogdl
    treats as equal (its table maps deprecated codes)."""
    want = (installed or "").lower()
    for l in depot_langs or []:
        l = str(l).lower()
        if l == "*" or (want and (l == want or l.startswith(want + "-")
                                  or want.startswith(l + "-"))):
            return True
    return False


def case_insensitive_path(path):
    """The path as it is on disk when only its case differs, else path."""
    if os.path.exists(path):
        return path
    folder, name = os.path.split(path)
    try:
        for entry in os.listdir(folder or "."):
            if entry.lower() == name.lower():
                return os.path.join(folder, entry)
    except OSError:
        pass
    return path


def crc32_matches(path, want):
    crc = 0
    try:
        with open(path, "rb") as f:
            while True:
                block = f.read(1 << 20)
                if not block:
                    break
                crc = zlib.crc32(block, crc)
    except OSError:
        return False
    return crc & 0xFFFFFFFF == want & 0xFFFFFFFF


def hashes_match(path, chunks):
    """Whether every chunk of the file matches the store's md5, streamed one
    chunk at a time (a check never loads a file into memory)."""
    try:
        with open(path, "rb") as f:
            for c in chunks:
                if not isinstance(c, dict):
                    return False
                want = str(c.get("md5") or "").lower()
                left = int(c.get("size") or 0)
                h = hashlib.md5()
                while left > 0:
                    block = f.read(min(left, 1 << 20))
                    if not block:
                        return False
                    h.update(block)
                    left -= len(block)
                if want and h.hexdigest() != want:
                    return False
    except OSError:
        return False
    return True


def depot_files(meta):
    """(path, chunks) for the game files a stored manifest lists: the install's
    language and DLC depots only; support files are left out (gogdl installs
    those outside the game folder)."""
    base = str(meta.get("baseProductId") or "")
    dlcs = {str(d["id"]) for d in meta.get("HGLdlcs") or []
            if isinstance(d, dict) and d.get("id") is not None}
    lang = str(meta.get("HGLInstallLanguage") or "")
    bits = "64" if sys.maxsize > 2 ** 32 else "32"
    files = []
    for depot in meta.get("depots") or []:
        if not isinstance(depot, dict) or not depot.get("manifest"):
            continue
        product = str(depot.get("productId") or "")
        if product != base and product not in dlcs:
            continue
        if not lang_matches(depot.get("languages"), lang):
            continue
        if depot.get("osBitness") and bits not in [str(b) for b in depot["osBitness"]]:
            continue
        data = api_get_zjson("https://cdn.gog.com/content-system/v2/meta/"
                             + galaxy_path(str(depot["manifest"])))
        for item in ((data or {}).get("depot") or {}).get("items") or []:
            if not isinstance(item, dict) or item.get("type") != "DepotFile":
                continue
            if "support" in (item.get("flags") or []):
                continue
            path = str(item.get("path") or "").replace("\\", "/").lstrip("/")
            if path:
                files.append((path, item.get("chunks") or []))
    return files


def check_progress(job_id, done, total, last):
    """job.progress for a file check, at most every half second."""
    now = time.monotonic()
    if done < total and now - last[0] < 0.5:
        return
    last[0] = now
    notify("job.progress", {"jobId": job_id, "phase": "checking",
                            "bytes": done, "total": total,
                            "percent": (100.0 * done / total) if total else 0.0})


def canceled(job_id):
    with jobs_lock:
        return bool(jobs.get(job_id, {}).get("canceled"))


def verify_files(job_id, app, game_dir, platform):
    """(checked, damaged, missing) for an installed game, or None when the job
    was canceled. Raises RPCError when there is nothing to check against."""
    last = [0.0]
    checked = damaged = missing = done = 0
    if platform == "linux":
        try:
            with open(os.path.join(game_dir, ".gogdl-linux-manifest")) as f:
                manifest = json.load(f)
        except (OSError, ValueError):
            raise RPCError("this install has no stored game manifest to check; "
                           "reinstall the game, then verify again")
        files = [f for f in (manifest.get("files") or [])
                 if isinstance(f, dict) and not f.get("is_symlink")
                 and str(f.get("file_name") or "").startswith("data/noarch/")]
        total = sum(int(f.get("size") or 0) for f in files)
        for f in files:
            if canceled(job_id):
                return None
            checked += 1
            path = str(f["file_name"]).replace("data/noarch", game_dir)
            if not os.path.isfile(path):
                missing += 1
            elif not crc32_matches(path, int(f.get("crc32") or 0)):
                damaged += 1
            done += int(f.get("size") or 0)
            check_progress(job_id, done, total, last)
        return checked, damaged, missing
    meta = stored_manifest(app)
    if int(meta.get("version") or 0) == 1:
        raise RPCError("file checking isn't available for this game yet (it "
                       "installs from GOG's older content system); update the "
                       "game once, then verify again")
    try:
        files = depot_files(meta)
    except Exception as e:
        raise RPCError(f"couldn't read GOG's file list for {app}: {e}")
    if not files:
        raise RPCError("this install has no stored game file list to check; "
                       "update the game once, then verify again")
    total = sum(sum(int(c.get("size") or 0) for c in chunks if isinstance(c, dict))
                for _path, chunks in files)
    for rel, chunks in files:
        if canceled(job_id):
            return None
        checked += 1
        path = case_insensitive_path(os.path.join(game_dir, rel))
        if not os.path.isfile(path):
            missing += 1
        elif not hashes_match(path, chunks):
            damaged += 1
        done += sum(int(c.get("size") or 0) for c in chunks if isinstance(c, dict))
        check_progress(job_id, done, total, last)
    return checked, damaged, missing


def ensure_exclude_file(app):
    """gogdl's Linux repair reads its exclude list without a fallback; an empty
    one keeps that from crashing a repair."""
    path = os.path.join(gogdl_config_base(), "heroic_gogdl", "exclude", app)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a"):
            pass
    except OSError:
        pass


def start_verify(params):
    app = str(params.get("id") or "")
    job_id = str(params.get("jobId") or "")
    install_dir = str(params.get("installDir") or "")
    if not app or not job_id:
        raise RPCError("invalid params: id and jobId are required", -32602)
    if not os.path.isabs(install_dir):
        raise RPCError("installDir is missing or relative; Platypus always sends one")
    ig = installed_games().get(app)
    if not ig:
        raise RPCError(f"{app} is not installed")
    if not os.path.isdir(install_dir):
        raise RPCError(f"{install_dir} isn't a folder")
    platform = ig.get("platform") or "windows"
    if platform == "linux":
        if not os.path.isfile(os.path.join(install_dir, ".gogdl-linux-manifest")):
            raise RPCError("this install has no stored game manifest to check; "
                           "reinstall the game, then verify again")
    else:
        if not stored_manifest(app):
            # A 0.1.0 install may have kept gogdl's manifest in the shared
            # config dir; adopt it when it matches the installed build.
            prime_legacy_manifest(app, install_dir)
        meta = stored_manifest(app)
        if not meta:
            raise RPCError("this install has no stored game manifest to check; "
                           "update the game once, then verify again")
        if int(meta.get("version") or 0) == 1:
            raise RPCError("file checking isn't available for this game yet (it "
                           "installs from GOG's older content system); update the "
                           "game once, then verify again")
    repair = bool(params.get("repair"))
    if not claim_job(job_id, {"proc": None, "canceled": False, "id": app, "dir": install_dir}):
        return {}
    threading.Thread(target=follow_verify,
                     args=(job_id, app, install_dir, platform, repair),
                     daemon=True).start()
    return {}


def report_repair_line(job_id, state, line):
    parsed = parse_progress(line)
    if not parsed:
        return
    pct, done, total, speed = parsed
    state.update({"percent": pct, "bytes": done, "total": total})
    if speed is not None:
        state["speed"] = speed
    notify("job.progress", dict(state))


def run_repair(job_id, app, install_dir, platform):
    """The repair half of a verify: gogdl re-hashes the files and re-downloads
    the broken ones. None on success, else the message for job.failed."""
    ensure_exclude_file(app)
    argv = ["gogdl", "--auth-config-path", auth_file(), "repair", app,
            "--path", install_dir, "--platform", platform, "--max-workers", "4"]
    try:
        proc = spawn_gogdl(argv)
    except FileNotFoundError:
        return "gogdl is not installed (needs version 1.1 or newer)"
    with jobs_lock:
        job = jobs.get(job_id)
        if job is None or job.get("canceled"):
            stop_proc(proc, grace=5)
            return None
        job["proc"] = proc
    state = {"jobId": job_id, "phase": "repairing", "percent": 0}
    try:
        next_line = line_reader(proc.stdout.fileno())
    except (OSError, ValueError, AttributeError):
        next_line = None
    if next_line is not None:
        pump(proc, next_line, lambda line: report_repair_line(job_id, state, line))
    try:
        rc = proc.wait(timeout=30)
    except subprocess.TimeoutExpired:
        stop_proc(proc, grace=5)
        rc = -1
    return None if rc == 0 else f"gogdl repair exited with {rc}"


def follow_verify(job_id, app, install_dir, platform, repair):
    notify("job.progress", {"jobId": job_id, "phase": "checking"})
    repaired = 0
    try:
        report = verify_files(job_id, app, install_dir, platform)
        if report is None:  # canceled while hashing
            with jobs_lock:
                jobs.pop(job_id, None)
            return
        checked, damaged, missing = report
        if repair and (damaged or missing):
            failed = run_repair(job_id, app, install_dir, platform)
            if canceled(job_id):
                with jobs_lock:
                    jobs.pop(job_id, None)
                return
            if failed is not None:
                with jobs_lock:
                    jobs.pop(job_id, None)
                notify("job.failed", {"jobId": job_id, "error": failed})
                return
            after = verify_files(job_id, app, install_dir, platform)
            if after is None:
                with jobs_lock:
                    jobs.pop(job_id, None)
                return
            left = after[1] + after[2]
            repaired = max(0, damaged + missing - left)
            damaged, missing = after[1], after[2]
    except Exception as e:
        with jobs_lock:
            jobs.pop(job_id, None)
        if canceled(job_id):
            return
        error = str(e) if isinstance(e, RPCError) else f"{type(e).__name__}: {e}"
        notify("job.failed", {"jobId": job_id, "error": error})
        return
    with jobs_lock:
        job = jobs.pop(job_id, {})
    if job.get("canceled"):
        return
    notify("job.done", {"jobId": job_id,
                        "verify": {"checked": checked, "damaged": damaged,
                                   "missing": missing, "repaired": repaired}})


def game_relocated(params):
    """Platypus moved the game's folder itself (protocol 1.4, no capability):
    rebase the install record from `from` to `to`. -32602 when the record
    doesn't point at `from`."""
    app = str(params.get("id") or "")
    src, dst = params.get("from") or "", params.get("to") or ""
    if not app or not src or not dst:
        raise RPCError("invalid params: id, from and to are required", -32602)
    if not os.path.isabs(dst):
        raise RPCError("invalid params: to must be an absolute path", -32602)
    nsrc = os.path.normpath(src)
    with state_lock:
        state = installed_games()
        entry = state.get(app)
        if entry is None or os.path.normpath(entry.get("path") or "") != nsrc:
            raise RPCError(f"no install record at {src}", -32602)
        entry["path"] = dst
        exe = os.path.normpath(entry.get("executable") or "")
        if exe == nsrc or exe.startswith(nsrc + os.sep):
            entry["executable"] = os.path.join(dst, os.path.relpath(exe, nsrc))
        save_installed(state)
    return {}


# --- achievements and playtime (protocol 1.7) -------------------------------
#
# Both live on GOG's gameplay service and take gogdl's stored access token:
# achievements are per game (icons, unlock times and rarity included), playtime
# is one sessions call per owned game (time_sum, in minutes) — GOG exposes no
# library-wide playtime call (Heroic reads the same endpoint, per game).

def iso_unix(text):
    """Unix seconds from GOG's ISO-8601 date, or None."""
    if not isinstance(text, str) or not text:
        return None
    try:
        return int(datetime.datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp())
    except ValueError:
        return None


def gameplay(path, token):
    return api_get("https://gameplay.gog.com" + path, token, {"X-Gog-Lc": LOCALE})


def achievements_list(params):
    app = str((params or {}).get("id") or "")
    if not app:
        raise RPCError("invalid params: id is required", -32602)
    creds = credentials()
    if not creds:
        raise RPCError("log in to GOG first", CODE_AUTH_REQUIRED)
    user = str(creds.get("user_id") or "")
    if not user:
        raise RPCError("GOG's credentials don't name the account; log in again")
    try:
        data = gameplay(f"/clients/{app}/users/{user}/achievements", creds["access_token"])
    except urllib.error.HTTPError as e:
        if e.code == 404:  # the game has no achievements
            data = {}
        elif e.code in (401, 403):
            raise RPCError("GOG refused the session; log in again", CODE_AUTH_REQUIRED)
        else:
            raise RPCError(f"GOG's achievements service answered {e.code}", -32002)
    except Exception as e:
        raise RPCError(f"GOG's achievements service is unreachable: {e}", -32002)
    out, unlocked = [], 0
    for a in data.get("items") or []:
        if not isinstance(a, dict):
            continue
        aid = str(a.get("achievement_key") or a.get("achievement_id") or "")
        if not aid:
            continue
        entry = {"id": aid, "name": str(a.get("name") or aid),
                 "description": str(a.get("description") or ""),
                 "hidden": a.get("visible") is False}
        when = iso_unix(a.get("date_unlocked"))
        icon = a.get("image_url_unlocked") if when else a.get("image_url_locked")
        if isinstance(icon, str) and icon.startswith("http"):
            entry["icon"] = icon
        if when:
            entry["unlockedAt"] = when
            unlocked += 1
        try:
            rarity = float(a.get("rarity"))
        except (TypeError, ValueError):
            rarity = 0.0
        if rarity > 0:
            entry["globalPercent"] = round(min(rarity, 100.0), 1)
        out.append(entry)
    return {"total": len(out), "unlocked": unlocked, "list": out}


def playtime_list(_params=None):
    creds = credentials()
    if not creds:
        raise RPCError("log in to GOG first", CODE_AUTH_REQUIRED)
    user = str(creds.get("user_id") or "")
    if not user:
        raise RPCError("GOG's credentials don't name the account; log in again")
    token = creds["access_token"]
    try:
        games = account_products(token)
    except Exception as e:
        raise RPCError(f"GOG API is unreachable: {e}", -32002)
    apps = [str(g.get("id")) for g in games if isinstance(g, dict) and g.get("id")]

    def minutes(app):
        try:
            return max(0, int(gameplay(f"/games/{app}/users/{user}/sessions",
                                       token).get("time_sum") or 0))
        except Exception:
            return 0  # one game's sessions failing hides only its time

    out = []
    if apps:
        with ThreadPoolExecutor(max_workers=8) as pool:
            for app, mins in zip(apps, pool.map(minutes, apps)):
                if mins:
                    out.append({"id": app, "minutes": mins})
    return {"games": out}


# --- dispatch -----------------------------------------------------------

def initialize(params):
    global LOCALE
    LOCALE = str((params or {}).get("locale") or "") or "en-US"
    return {"name": "GOG (gogdl)", "version": PLUGIN_VERSION, "api": API,
            "capabilities": list(CAPABILITIES),
            "features": {"versions": {"builds": True, "channels": True,
                                     "manual": False, "password": False}},
            "missing": []}


def game_details(params):
    """Art and description from the product API, no login needed. The old
    store-search endpoint (games/ajax/filtered) stopped returning products
    for id searches. GOG has no EULA/terms data (live check 2026-11-15: neither
    the account gameDetails nor the product API carries one), so the plugin
    lists no terms and doesn't declare the `terms` capability."""
    app = params["id"]
    try:
        data = api_get(f"https://api.gog.com/products/{app}?expand=description,screenshots", "")
    except urllib.error.HTTPError as e:
        if e.code == 404:  # the other plugins error on an unknown id too
            raise RPCError(f"{app} is not a GOG product")
        return {}
    except Exception:
        return {}
    if isinstance(data, dict) and data.get("_test"):
        data = data["_test"]  # test hook: file carries the whole response
    try:
        out = {}
        desc = data.get("description") or {}
        if isinstance(desc, str):
            text = desc
        else:
            text = desc.get("lead") or desc.get("full") or ""
        text = re.sub(r"<[^>]+>", " ", text)
        text = re.sub(r"\s+", " ", text).strip()
        if text:
            out["summary"] = text[:2000]
        genres = data.get("genres") or []
        names = [g.get("name") if isinstance(g, dict) else str(g) for g in genres]
        names = [g for g in names if g]
        if names:
            out["genres"] = names[:4]
        date = data.get("release_date") or ""
        if isinstance(date, dict):
            date = date.get("date") or ""
        if date:
            out["releaseDate"] = str(date)[:10]
        shots = []
        for s in (data.get("screenshots") or [])[:6]:
            if not isinstance(s, dict):
                continue
            # formatted_images carries ready URLs; the template with {formatter}
            # is the fallback. .ggvgl is a large screenshot format.
            u = ""
            for f in s.get("formatted_images") or []:
                if f.get("formatter_name") == "ggvgl":
                    u = f.get("image_url") or ""
                    break
            u = u or (s.get("formatter_template_url") or "").replace("{formatter}", ".ggvgl.jpg")
            if not u:
                continue
            if u.startswith("//"):
                u = "https:" + u
            shots.append(u)
        if shots:
            out["screenshots"] = shots
        return out
    except Exception:
        return {}


METHODS = {
    "initialize": initialize,
    "auth.status": auth_status,
    "auth.begin": auth_begin,
    "auth.complete": auth_complete,
    "auth.logout": auth_logout,
    "library.list": library_list,
    "game.details": game_details,
    "game.installSize": install_size,
    "game.options": game_options,
    "game.install": lambda p: start_job(p, "install"),
    "game.update": lambda p: start_job(p, "update"),
    "game.uninstall": lambda p: start_job(p, "uninstall"),
    "game.verify": start_verify,
    "game.relocated": game_relocated,
    "achievements.list": achievements_list,
    "playtime.list": playtime_list,
    "job.cancel": job_cancel,
    "job.discard": job_discard,
    "game.launchSpec": launch_spec,
    "versions.list": versions_list,
}


def handle(msg):
    fn = METHODS.get(msg.get("method"))
    resp = {"id": msg["id"]}
    if fn is None:
        resp["error"] = {"code": -32601, "message": f"method not found: {msg.get('method')}"}
    else:
        try:
            result = fn(msg.get("params") or {})
            resp["result"] = result if result is not None else {}
        except RPCError as e:
            resp["error"] = {"code": e.code, "message": str(e)}
        except (KeyError, TypeError) as e:
            resp["error"] = {"code": -32602, "message": f"invalid params: {e}"}
        except Exception as e:  # report, never crash the plugin
            resp["error"] = {"code": -32000, "message": f"{type(e).__name__}: {e}"}
    send(resp)


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError as e:
            send({"error": {"code": -32700, "message": str(e)}})
            continue
        if "id" not in msg:
            continue  # notifications need no answer
        # Library listing and logins can take seconds; keep reading so
        # job.cancel stays responsive.
        threading.Thread(target=handle, args=(msg,), daemon=True).start()
    # stdin closed: Platypus is shutting down. Interrupted installs resume later.
    with jobs_lock:
        procs = [j.get("proc") for j in jobs.values()]
    for p in procs:
        stop_proc(p, grace=5)


if __name__ == "__main__":
    main()
