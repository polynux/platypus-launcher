{
  "id": "gog-gogdl",
  "name": "GOG (gogdl)",
  "version": "0.3.0",
  "author": "Platypus",
  "description": "Your GOG library through gogdl: install and launch DRM-free games you own, no GOG Galaxy needed.",
  "manifestVersion": 1,
  "protocol": { "versions": ["1.0", "1.3", "1.4", "1.5", "1.7"], "transport": "jsonrpc-stdio" },
  "store": "gog",
  "exec": "bin/platypus-gog",
  "icon": "icon.svg",
  "capabilities": ["library", "install", "launch", "auth", "discard", "versions", "verify", "install-options", "achievements", "playtime"],
  "requires": [
    { "bin": "gogdl", "hint": "get gogdl 1.1 or newer from github.com/Heroic-Games-Launcher/heroic-gogdl/releases and put it on your PATH as gogdl" },
    { "bin": "python3", "hint": "install python3 from your distribution" }
  ],
  "install_dir": "gog",
  "permissions": {
    "network": ["*.gog.com"],
    "read": [],
    "write": []
  },
  "storefront": { "url": "https://www.gog.com/", "domains": ["gog.com"] }
}
