#!/usr/bin/env python3
"""Platypus store plugin for Steam without the Steam client.

Speaks Platypus's plugin protocol (api 1, docs/plugins/protocol.md): JSON-RPC 2.0
over stdin/stdout, one object per line. Logins are done by platypus-steam-dl
(Go, next to this file), which logs into Steam with the user's own account
and Steam Guard over the CM (QR via BeginAuthSessionViaQR + Poll, password
via GetPasswordRSAPublicKey + BeginAuthSessionViaCredentials + Steam Guard
code or mobile confirmation); the plugin never stores the password — it
feeds it to one platypus-steam-dl auth run on stdin, and the refresh token
Steam issues afterwards stays in $PLATYPUS_PLUGIN_DATA (refresh.token 0600,
plus token.json/session.json). Downloads are done by the same binary,
which logs on to a CM with the stored refresh token and spreads chunk
fetches over many CDN hosts like the Steam client does.

Only what the logged-in account owns is installed, through Steam's own CDN,
with the account's own licence. No DRM or licence circumvention, and no Steam
API emulators: games that need the Steam client at runtime get the real
client, started hidden (`steam -silent`), and the game runs against it.
"""

import json
import os
import queue
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request
import zlib

import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import steam_cm  # the CM session module, next to this file

API = 1
CODE_AUTH_REQUIRED = -32001

# The user's BCP 47 locale from initialize {locale} (protocol 1.14), kept
# current through locale.changed {locale}. Plugin UI text is returned
# already-localized for it (issue #39, phase 4): mode notes and a few
# user-facing errors via the small LOCALES dict below, falling back to
# English. Store lookups pass the Steam language (l=<steam_lang>).
LOCALE = "en"
LOCALE_LOCK = threading.Lock()

STEAM_LANG_MAP = {
    "en": "english", "fr": "french", "de": "german", "es": "spanish",
    "it": "italian", "ja": "japanese", "ko": "korean", "pt": "portuguese",
    "ru": "russian", "pl": "polish", "nl": "dutch", "da": "danish",
    "no": "norwegian", "nb": "norwegian", "sv": "swedish", "fi": "finnish",
    "cs": "czech", "hu": "hungarian", "tr": "turkish", "ar": "arabic",
    "th": "thai", "uk": "ukrainian", "el": "greek", "bg": "bulgarian",
    "ro": "romanian", "vi": "vietnamese", "zh": "schinese",
}

LOCALES = {
    "en": {
        "mode_none": "Launch mode: no Steamworks — runs directly, fully without Steam.",
        "mode_optional": "Launch mode: Steamworks present but optional — runs directly with SteamAppId set.",
        "mode_client": "Launch mode: needs the Steam client — Platypus starts the real client hidden.",
        "need_login": "log in to Steam first",
        "need_login_expired": "log in to Steam first (the session expired)",
        "not_installed": "app {app} is not installed",
    },
    "fr": {
        "mode_none": "Mode de lancement : sans Steamworks — fonctionne directement, entièrement sans Steam.",
        "mode_optional": "Mode de lancement : Steamworks présent mais facultatif — fonctionne directement avec SteamAppId défini.",
        "mode_client": "Mode de lancement : nécessite le client Steam — Platypus démarre le vrai client en arrière-plan.",
        "need_login": "connectez-vous à Steam d'abord",
        "need_login_expired": "connectez-vous à Steam d'abord (la session a expiré)",
        "not_installed": "l'application {app} n'est pas installée",
    },
}


def set_locale(tag):
    global LOCALE
    tag = (tag or "").strip() or "en"
    with LOCALE_LOCK:
        LOCALE = tag


def locale_base():
    with LOCALE_LOCK:
        tag = LOCALE
    tag = (tag or "").strip().lower()
    if "-" in tag:
        tag = tag.split("-")[0]
    return tag or "en"


def tr(key, **fmt):
    base = locale_base()
    table = LOCALES.get(base, {})
    s = table.get(key) or LOCALES["en"].get(key) or key
    if fmt:
        try:
            s = s.format(**fmt)
        except (KeyError, IndexError):
            pass
    return s


def steam_lang():
    with LOCALE_LOCK:
        tag = (LOCALE or "").strip().lower()
    if tag in ("pt-br", "pt_br"):
        return "brazilian"
    if tag.startswith("es-") and tag != "es-es":
        return "latam"
    if tag in ("zh-cn", "zh-sg", "zh-my"):
        return "schinese"
    if tag in ("zh-tw", "zh-hk", "zh-mo"):
        return "tchinese"
    base = tag.split("-")[0] if "-" in tag else tag
    return STEAM_LANG_MAP.get(base or "en", "english")
# Access tokens are cached until shortly before their JWT exp; Steam re-issue
# is one CM round trip when this lapses mid-session.
ACCESS_TOKEN_MARGIN = 300

# Steam refresh tokens are JWTs. Note the header segment does NOT necessarily
# start with "eyJ": Steam's JWT JSON contains spaces ("alg": "EdDSA"), so the
# base64 header begins "eyAi…" — anchor on the dot-separated base64url shape
# instead, and validate by decoding. Used only to migrate the pre-Go login
# (DepotDownloader's account.config, a deflated protobuf); new logins land
# in refresh.token directly.
JWT_RE = re.compile(r"[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}")

out_lock = threading.Lock()
jobs_lock = threading.Lock()
jobs = {}  # jobId -> {"proc": Popen, "canceled": bool, ...}
token_lock = threading.RLock()
# Serializes read-modify-write of installed.json across handler/job threads.
installed_lock = threading.RLock()


class RPCError(Exception):
    def __init__(self, message, code=-32000):
        super().__init__(message)
        self.code = code


def send(msg):
    msg["jsonrpc"] = "2.0"
    line = json.dumps(msg, separators=(",", ":"))
    with out_lock:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()


def notify(method, params):
    send({"jsonrpc": "2.0", "method": method, "params": params})


def log(level, message):
    notify("log", {"level": level, "message": message})


def data_dir():
    d = os.environ.get("PLATYPUS_PLUGIN_DATA") or os.path.join(os.path.expanduser("~"), ".platypus-steam-standalone")
    os.makedirs(d, exist_ok=True)
    return d


def tail(text, n=3):
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    return " · ".join(lines[-n:]) if lines else "no output"


# Logins run through platypus-steam-dl (Go, next to this file), never through
# argv-visible credentials: the password travels on the auth subcommand's
# stdin and is never logged. See "QR login" below.


# --- persisted state ------------------------------------------------------

def state_path(name):
    return os.path.join(data_dir(), name)


def load_state(name, default):
    try:
        with open(state_path(name)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_state(name, state):
    """Write via a temp file and rename, so a concurrent reader never sees a
    half-written file (load_state would return the default and a caller could
    then overwrite everything with it)."""
    path = state_path(name)
    tmp = f"{path}.{os.getpid()}.{threading.get_ident()}.new"
    try:
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


# Token-bearing files (refresh.token, token.json, steam-access.json) must
# be 0600: the data dir itself is private, but the tokens are bearer
# credentials and must not be world-readable. os.open/write-then-chmod
# covers both new files (umask) and pre-existing 0644 ones (WriteFile
# keeps the old mode); session.json carries no secret and stays 0644.
def save_secret(name, state):
    # Created 0600 from the start (no window at the umask's mode), then
    # renamed over the old file, which may have been 0644.
    path = state_path(name)
    tmp = f"{path}.{os.getpid()}.{threading.get_ident()}.new"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(state, f)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def tighten(name):
    """chmod an existing state file to 0600; missing files are fine."""
    try:
        os.chmod(state_path(name), 0o600)
    except OSError:
        pass


def account_config():
    """DepotDownloader's persisted credentials file, if a login left one.

    .NET isolated storage has no fixed layout: the real DepotDownloader
    writes `…/.local/share/IsolatedStorage/<id>/<id>/<hash>/AssemFiles/
    account.config` (capital I), while older/dotnet-runtime variants used
    lowercase `isolated-storage` — so don't guess paths, just walk the
    whole plugin HOME looking for the file name."""
    home = os.path.join(data_dir(), "home")
    if not os.path.isdir(home):
        return None
    for dirpath, _dirs, files in os.walk(home):
        if "account.config" in files:
            return os.path.join(dirpath, "account.config")
    return None


def refresh_pairs(text):
    """(account name, refresh token) pairs from account.config's LoginTokens
    entries: a submessage carrying the account name right before the JWT.
    DD keys its stored tokens by account name (-username for later runs)."""
    out = []
    for token_match in JWT_RE.finditer(text):
        head = text[:token_match.start()]
        # The name is the last printable run before the token's field marks.
        m = re.search(r"[\x21-\x7e]{2,64}(?=[^\x20-\x7e]{0,4}$)", head)
        name = m.group(0) if m else ""
        # Length bytes are printable too (0x21..0x7e); a glued length shows
        # up as a stray leading char, and Steam account names are
        # word-shaped, so trim to the last word-ish chunk.
        tail_name = re.search(r"[A-Za-z0-9][A-Za-z0-9_ -]{1,63}$", name)
        name = tail_name.group(0) if tail_name else name
        out.append((name, token_match.group(0)))
    return out


def _source_matches(src, path, mtime):
    """Whether a persisted token source still tracks the current file.

    JSON turns the stored tuple into a list and may round-trip the mtime
    as int vs float, so normalize both before comparing."""
    try:
        if not isinstance(src, (list, tuple)) or len(src) != 2:
            return False
        if src[0] != path:
            return False
        if src[1] is None or mtime is None:
            return False
        return float(src[1]) == float(mtime)
    except (TypeError, ValueError):
        return False


def refresh_token():
    """The SteamClient refresh token the Go login persisted (refresh.token
    0600, plus token.json/session.json). The pre-Go login (DepotDownloader's
    account.config, a deflated protobuf) is migrated on first read so the
    current login keeps working without logging in again. Used for the CM
    token exchange, which feeds the Web API."""
    # New canonical store: raw JWT, never argv, never logged.
    try:
        with open(state_path("refresh.token")) as f:
            token = f.read().strip()
        if token:
            tighten("refresh.token")
            return token
    except OSError:
        pass
    # Legacy: extract from account.config once, then migrate forward.
    with token_lock:
        st = load_state("token.json", {})
        path = account_config()
        try:
            cur_mtime = os.path.getmtime(path) if path else None
        except OSError:
            cur_mtime = None
        if (st.get("refresh_token") and st.get("account") is not None
                and _source_matches(st.get("source"), path, cur_mtime)):
            migrate_token(st["refresh_token"], st.get("account") or "")
            return st["refresh_token"]
    if not path:
        # A Go login may have written token.json without refresh.token
        # (older shape); trust it and migrate.
        if st.get("refresh_token"):
            with token_lock:
                migrate_token(st["refresh_token"], st.get("account") or "")
            return st["refresh_token"]
        return None
    try:
        with open(path, "rb") as f:
            blob = f.read()
        try:
            blob = zlib.decompress(blob)
        except zlib.error:
            try:
                blob = zlib.decompress(blob, -15)  # .NET raw DeflateStream
            except zlib.error:
                pass  # newer builds may store it uncompressed
        text = blob.decode("utf-8", "ignore")
        matches = JWT_RE.findall(text)
        if not matches:
            return None
        token = matches[-1]  # the newest token
        account = st.get("account", "")
        for name, tok in reversed(refresh_pairs(text)):
            if tok == token and name:
                account = name
                break
        st["refresh_token"] = token
        st["account"] = account
        st["source"] = [path, os.path.getmtime(path)]
        with token_lock:
            save_secret("token.json", st)
            migrate_token(token, account)
        return token
    except OSError:
        return None


def migrate_token(token, account):
    """Copy a legacy-extracted token into the Go login's files (0600).

    Keeps the account.config source stamp so the legacy fast path in
    refresh_token() still matches; overwriting it with the refresh.token
    path would make every later call re-walk home/ and re-extract."""
    with token_lock:
        try:
            with open(state_path("refresh.token"), "w") as f:
                f.write(token + "\n")
            os.chmod(state_path("refresh.token"), 0o600)
        except OSError:
            pass
        try:
            st = load_state("token.json", {})
            st["refresh_token"] = token
            if account:
                st["account"] = account
            # Do not touch st["source"]: it tracks account.config for the
            # legacy fast path. (An older version stored the refresh.token
            # path here, which never matched account_config() again.)
            save_secret("token.json", st)
            if account and not state_user():
                save_state("session.json", {"account": account})
        except OSError:
            pass


# --- QR login ---------------------------------------------------------------
# platypus-steam-dl auth prints the login QR as block-art JSON events on
# stdout (one module = two U+2588 chars wide, "█" = dark module) and waits
# for the Steam mobile app to approve it. Steam periodically expires and
# refreshes the challenge URL, so the binary can emit a NEW qr event while
# running — the plugin keeps the latest art for auth.status, and the dialog
# redraws it. After approval the binary persists the refresh token itself
# (refresh.token 0600, token.json, session.json); we consider the login
# done on its result event.

# QR login background state: the platypus-steam-dl auth process, its latest
# art and its result. qr_start_lock serializes start_qr_login so a
# duplicate auth.begin (React StrictMode sends two back to back) reuses
# the live session instead of killing it; qr_proc["ready"] wakes waiters
# sharing one session.
qr_lock = threading.Lock()
qr_start_lock = threading.Lock()
qr_proc = {"proc": None, "rc": None, "ready": None}
qr_art = {"text": None}                      # latest block-art, for auth.status
qr_state = {"state": "idle", "error": None}  # idle|pending|ok|failed


def _reap(proc):
    """Wait out a helper so it never stays a zombie (<defunct>)."""
    if proc is None:
        return None
    try:
        return proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        try:
            proc.kill()
        except OSError:
            pass
        try:
            return proc.wait(timeout=10)
        except (subprocess.TimeoutExpired, OSError):
            return proc.poll()


def start_qr_login():
    """Starts `platypus-steam-dl auth` (QR mode) in the background, tracking
    its QR art. Returns (art text or None, error or None). A duplicate
    call while a session is pending reuses it and returns the current
    art — it never kills and restarts it."""
    with qr_start_lock:
        with qr_lock:
            cur = qr_proc.get("proc")
            if (qr_state["state"] == "pending" and cur is not None
                    and cur.poll() is None and qr_proc.get("ready") is not None):
                ready = qr_proc["ready"]
            else:
                ready = None
        if ready is not None:
            # Shared session: wait for its first art like the starter.
            if ready.wait(15):
                with qr_lock:
                    if qr_state["state"] == "failed":
                        return None, qr_state["error"]
                    if qr_art["text"]:
                        return qr_art["text"], None
            # Stale (no art in time, or failed without a message):
            # fall through and start a fresh session below.
        stop_qr_login()
        with qr_lock:
            qr_art["text"] = None
            qr_state.update(state="pending", error=None)
            ready = threading.Event()
            qr_proc["ready"] = ready
        try:
            proc = subprocess.Popen(
                [dl_bin(), "auth"], stdin=subprocess.PIPE,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1, env=dict(os.environ))
        except FileNotFoundError:
            with qr_lock:
                qr_state.update(state="failed",
                                error="platypus-steam-dl is missing; reinstall the plugin")
            return None, qr_state["error"]
        try:
            proc.stdin.write(json.dumps({"mode": "qr"}) + "\n")
            proc.stdin.flush()
        except (BrokenPipeError, OSError):
            pass
        with qr_lock:
            qr_proc["proc"] = proc

        def watch(mine=proc, ready=ready):
            def ours():
                return qr_proc.get("proc") is mine

            for line in mine.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(msg, dict):
                    continue
                t = msg.get("type")
                if t == "qr" and msg.get("qr_art"):
                    if ours():
                        with qr_lock:
                            qr_art["text"] = msg["qr_art"]
                        ready.set()
                elif t == "result":
                    rc = _reap(mine)
                    if ours():
                        with qr_lock:
                            qr_proc["rc"] = rc
                            qr_state.update(state="ok", error=None)
                            qr_proc["proc"] = None
                        ready.set()
                    try:
                        mine.stdin.close()
                    except (BrokenPipeError, OSError):
                        pass
                    return
                elif t == "error":
                    rc = _reap(mine)
                    if ours():
                        with qr_lock:
                            qr_proc["rc"] = rc
                            qr_state.update(state="failed", error=msg.get("message") or "login failed")
                            qr_proc["proc"] = None
                        ready.set()
                    return
                # code-needed/waiting never appear for QR; ignore anything else.
            # EOF without a result: the binary died. Reap it, and only
            # fail the shared state when this helper is still the owner —
            # a superseded helper must never touch it.
            rc = _reap(mine)
            if ours():
                with qr_lock:
                    qr_proc["rc"] = rc
                    if qr_state["state"] == "pending":
                        qr_state.update(state="failed",
                                        error="the login helper ended without logging in")
                        qr_proc["proc"] = None
                ready.set()

        threading.Thread(target=watch, daemon=True).start()
        # The first QR prints within a few seconds; wait for it here so auth.begin
        # can hand the dialog a complete prompt.
        if not ready.wait(15):
            with qr_lock:
                err = qr_state.get("error")
            if err:
                return None, err
            stop_qr_login()
            return None, "QR code didn't appear in time; try the password login below"
        with qr_lock:
            # The watcher sets ready on error too; surface it instead of art.
            if qr_state["state"] == "failed":
                return None, qr_state["error"]
            return qr_art["text"], None


def stop_qr_login():
    with qr_lock:
        proc = qr_proc.pop("proc", None)
        qr_proc["rc"] = None
        qr_state.update(state="idle", error=None)
        qr_art["text"] = None
        ready = qr_proc.pop("ready", None)
    # Wake anyone sharing the session so they re-check instead of
    # sleeping out the full wait.
    if ready is not None:
        ready.set()
    _reap(proc)


def logged_in():
    # session.json is written only after a login succeeded; the refresh
    # token may live in refresh.token (Go login) or, for the pre-Go login,
    # in account.config — don't couple the reported login to one file.
    if state_user():
        return True
    try:
        with open(state_path("refresh.token")) as f:
            if f.read().strip():
                return True
    except OSError:
        pass
    return account_config() is not None


def state_user():
    return load_state("session.json", {}).get("account") or ""


# --- Steam Web API --------------------------------------------------------

def api_get(url, token=None):
    # Test hook: tests point this at a file with the responses, so nothing
    # reaches the network. Not set in normal runs. The file may carry
    # "_routes": {substring: response} so different endpoints can answer
    # differently; without it the file answers every call (older tests).
    hook = os.environ.get("PLATYPUS_STEAM_API_FILE")
    if hook:
        with open(hook) as f:
            data = json.load(f)
        for frag, resp in (data.get("_routes") or {}).items():
            if frag in url:
                return resp
        return data
    # Access tokens go as the access_token query parameter (like the Steam
    # client does); a refresh token was never accepted there.
    if token:
        sep = "&" if "?" in url else "?"
        url = f"{url}{sep}access_token={token}"
    req = urllib.request.Request(url)
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read().decode())


STORE_TTL = 30 * 86400  # names and types of released apps rarely change
STORE_BUDGET = 20  # seconds of Store lookups per library.list; the rest waits for the next rescan
store_lock = threading.Lock()
store_cache = None  # app id -> {"name", "type", "at"}, mirrors store-apps.json
store_inflight = {}  # app id -> threading.Event for a fetch in progress


def store_cached(app_id):
    """The cached Store details for an app, {} when missing or stale."""
    global store_cache
    with store_lock:
        if store_cache is None:
            store_cache = load_state("store-apps.json", {})
        entry = store_cache.get(str(app_id)) or {}
    return entry if time.time() - entry.get("at", 0) < STORE_TTL else {}


def store_app(app_id, fetch=True):
    """Public app details (name, type) from the Steam Store API, cached on
    disk: a library scan asks about every owned game, one request each. No
    login needed; {} when the app isn't listed (bad id, region lock) or, with
    fetch=False, not cached yet. Misses aren't cached. Concurrent callers
    share one fetch per app (singleflight)."""
    entry = store_cached(app_id)
    if entry or not fetch:
        return entry
    key = str(app_id)
    with store_lock:
        # Recheck under the lock: another thread may have filled it.
        if store_cache is not None:
            entry = store_cache.get(key) or {}
            if time.time() - entry.get("at", 0) < STORE_TTL:
                return entry
        ev = store_inflight.get(key)
        if ev is None:
            ev = threading.Event()
            store_inflight[key] = ev
            owner = True
        else:
            owner = False
    if not owner:
        ev.wait(60)
        return store_cached(app_id)
    try:
        data = api_get(f"https://store.steampowered.com/api/appdetails?appids={app_id}&filters=basic")
    except Exception:
        with store_lock:
            store_inflight.pop(key, None)
            ev.set()
        return {}
    if isinstance(data, dict) and data.get("_test"):
        data = data["_test"]
    entry = (data or {}).get(str(app_id))
    if not entry or not entry.get("success"):
        with store_lock:
            store_inflight.pop(key, None)
            ev.set()
        return {}
    details = entry.get("data") or {}
    keep = {"name": details.get("name") or "", "type": details.get("type") or "", "at": time.time()}
    with store_lock:
        store_cache[str(app_id)] = keep
        store_inflight.pop(key, None)
        ev.set()
    return keep


def save_store_cache():
    with store_lock:
        if store_cache is not None:
            save_state("store-apps.json", store_cache)


def auth_status(_params=None):
    if logged_in():
        # The persona name when known, else the login's account name. The
        # login dialog closes on the first loggedIn status without calling
        # auth.complete (QR path), so resolve the persona here too.
        persona = load_state("session.json", {}).get("persona")
        if not persona:
            persona = status_persona()
        user = persona or state_user()
        out = {"loggedIn": True, "user": user} if user else {"loggedIn": True}
        return out
    out = {"loggedIn": False}
    with qr_lock:
        if qr_state["state"] == "pending" and qr_art["text"]:
            out["qr"] = qr_art["text"]  # the dialog redraws it when it changes
    return out


def auth_begin(_params):
    qr, err = start_qr_login()
    instructions = ("Scan the QR code with the Steam mobile app (Steam Guard → scan) "
                    "and just wait — the dialog closes by itself. The code refreshes "
                    "by itself when it expires. Or log in below; your password and "
                    "the Steam Guard code go to platypus-steam-dl only and are never "
                    "stored, and the login key Steam issues stays in this plugin's "
                    "private data folder.")
    if err and not qr:
        instructions = f"QR login unavailable: {err}\n\n{instructions}"
    return {
        "instructions": instructions,
        "qr": qr,
        "fields": [
            {"id": "username", "label": "Steam account name (empty = I scanned the QR)",
             "placeholder": "your Steam login, or empty for QR login"},
            {"id": "password", "label": "password", "secret": True},
            {"id": "guard", "label": "Steam Guard code — only if your account asks for one",
             "secret": True, "placeholder": "5 characters, or leave empty"},
        ],
    }


def run_auth_password(username, password, guard, timeout=300):
    """Password login across one or two dialog submits sharing a SINGLE
    auth session (one BeginAuthSessionViaCredentials, one CM socket).

    First submit carries no guard code yet: when Steam asks for an
    email/authenticator code, the session stays alive and the dialog
    error names the kind, so the second submit feeds the code into the
    SAME session via UpdateAuthSessionWithSteamGuardCode. Restarting the
    session instead would send a NEW email and invalidate the code the
    user just typed — a loop they can't win. A wrong/expired code fails
    fast; mobile confirmation just waits on the same session until the
    phone approves. The password travels on stdin (never argv, never
    logged) and the binary persists the refresh token itself."""
    deadline = time.time() + timeout
    import hashlib as _hashlib
    pw_hash = _hashlib.sha256(password.encode()).hexdigest()
    with pw_lock:
        sess = pw_sessions.get(username)
        if sess is None or not sess.alive():
            if sess is not None:
                pw_sessions.pop(username, None)
            sess = PWSession(username, password, guard)
            sess.pw_hash = pw_hash
            pw_sessions[username] = sess
            sent_code = False
        elif getattr(sess, "pw_hash", None) != pw_hash:
            # Corrected password on retry: the old session baked in the
            # first password, so stop it and start fresh instead of
            # failing against the wrong secret.
            try:
                sess.stop()
            except Exception:
                pass
            pw_sessions.pop(username, None)
            sess = PWSession(username, password, guard)
            sess.pw_hash = pw_hash
            pw_sessions[username] = sess
            sent_code = False
        else:
            # Resuming the code-waiting session from the first submit.
            sent_code = True
            if guard:
                sess.send_code(guard)
            elif sess.need is not None:
                raise RPCError(_need_code_message(sess.need))
    try:
        while time.time() < deadline:
            try:
                msg = sess.events.get(timeout=5)
            except queue.Empty:
                if not sess.alive():
                    break
                continue
            t = msg.get("type")
            if t == "code-needed":
                sess.need = msg
                if sent_code:
                    # A code was already tried on this session and Steam
                    # still asks: wrong or expired — fail fast on a dead
                    # session so the retry starts fresh with a new code.
                    sess.stop()
                    with pw_lock:
                        if pw_sessions.get(username) is sess:
                            pw_sessions.pop(username, None)
                    raise RPCError("Steam rejected the code: wrong Steam Guard code")
                # Keep the session (same Begin, same email) and ask the
                # dialog for the right kind of code.
                raise RPCError(_need_code_message(msg))
            elif t == "waiting":
                continue  # mobile confirmation: the poll continues server-side
            elif t == "result":
                with pw_lock:
                    if pw_sessions.get(username) is sess:
                        pw_sessions.pop(username, None)
                return None
            elif t == "error":
                with pw_lock:
                    if pw_sessions.get(username) is sess:
                        pw_sessions.pop(username, None)
                raise RPCError(msg.get("message") or "login failed")
        sess.stop()
        with pw_lock:
            if pw_sessions.get(username) is sess:
                pw_sessions.pop(username, None)
        raise RPCError("login timed out")
    except RPCError:
        raise


# Password-login sessions that survive across auth.complete calls: the
# first attempt (no guard code yet) keeps its BeginAuthSessionViaCredentials
# session — same client_id, same CM socket — while the dialog waits.
pw_lock = threading.Lock()
pw_sessions = {}  # account -> PWSession waiting for a code


class PWSession:
    """One live `platypus-steam-dl auth` password run, read by a single
    background thread into a queue. The password travels on stdin (never
    argv, never logged)."""

    def __init__(self, username, password, code=""):
        try:
            proc = subprocess.Popen(
                [dl_bin(), "auth"], stdin=subprocess.PIPE,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1, env=dict(os.environ))
        except FileNotFoundError:
            raise RPCError("platypus-steam-dl is missing; reinstall the plugin")
        self.proc, self.account = proc, username
        self.events = queue.Queue()
        self.ended = threading.Event()
        self.need = None  # the last code-needed event, while waiting
        req = {"mode": "password", "account": username, "password": password}
        if code:
            req["code"] = code
        try:
            proc.stdin.write(json.dumps(req) + "\n")
            proc.stdin.flush()
        except (BrokenPipeError, OSError):
            pass
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self):
        try:
            for line in self.proc.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if isinstance(msg, dict) and msg.get("type"):
                    self.events.put(msg)
                    if msg["type"] in ("result", "error"):
                        return
        finally:
            self.ended.set()
            _reap(self.proc)

    def send_code(self, code):
        try:
            self.proc.stdin.write(json.dumps({"code": code}) + "\n")
            self.proc.stdin.flush()
        except (BrokenPipeError, OSError):
            pass

    def alive(self):
        return self.proc.poll() is None and not self.ended.is_set()

    def stop(self):
        try:
            self.proc.kill()
        except OSError:
            pass
        _reap(self.proc)
        try:
            self.proc.stdin.close()
        except (BrokenPipeError, OSError):
            pass


def _need_code_message(msg):
    """Which kind of code the helper asks for, in dialog words."""
    guard = (msg.get("guard_type") or "").strip()
    detail = (msg.get("message") or "").strip()
    if guard == "device":
        want = "the code from your authenticator app"
    elif guard == "email":
        want = "the code Steam emailed you"
    else:
        want = "your Steam Guard code"
    if detail:
        return (f"Steam needs {want} ({detail}); enter it in the Steam Guard "
                f"field and submit again")
    return f"Steam needs {want}; enter it in the Steam Guard field and submit again"


def auth_complete(params):
    fields = ((params or {}).get("fields") or {})
    username = (fields.get("username") or "").strip()
    password = fields.get("password") or ""
    guard = (fields.get("guard") or "").strip()
    if not username and not password:
        # Empty form = "I scanned the QR code": wait for the background
        # platypus-steam-dl auth to be approved by the phone and finish.
        return wait_qr_login()
    if not username or not password:
        raise RPCError("enter your Steam account name and password")
    stop_qr_login()
    run_auth_password(username, password, guard)
    if not refresh_token():
        raise RPCError("login failed: the helper didn't persist a login key. "
                       "Check the account name and password, and try again with a fresh "
                       "Steam Guard code.")
    ensure_persona()
    return auth_status()


def ensure_persona():
    """Resolve and store the display (persona) name right after a login,
    so the first auth.status already shows it instead of the account
    name. Best effort: failures keep the account name (persona_name
    returns "" then), and a cached persona is never refetched."""
    try:
        if load_state("session.json", {}).get("persona"):
            return
        token = refresh_token()
        if not token:
            return
        steamid = steam_cm.jwt_payload(token).get("sub")
        if not steamid:
            return
        persona_name(steamid)
    except Exception:
        pass


# auth.status is polled; a failed persona lookup (offline, private profile)
# must not open a CM session on every poll.
PERSONA_RETRY = 60
persona_tried = {"at": 0.0}


def status_persona():
    if time.time() - persona_tried["at"] < PERSONA_RETRY:
        return ""
    persona_tried["at"] = time.time()
    ensure_persona()
    return load_state("session.json", {}).get("persona") or ""


def wait_qr_login(timeout=300):
    """Waits for the background platypus-steam-dl auth (QR) to be approved
    (the phone confirmed) and reports the result, like a password login."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        with qr_lock:
            state, err = qr_state["state"], qr_state["error"]
        if state == "ok":
            stop_qr_login()
            ensure_persona()
            return auth_status()
        if state == "failed":
            stop_qr_login()
            raise RPCError("the QR login was rejected or failed: " + err)
        time.sleep(0.5)
    stop_qr_login()
    raise RPCError("nobody scanned the QR code in time; try again")


def auth_logout(_params):
    stop_qr_login()
    with pw_lock:
        sessions = list(pw_sessions.values())
        pw_sessions.clear()
    for sess in sessions:
        sess.stop()
    # Wipe the whole private data folder so no login key, guard data or
    # cached token survives.
    shutil.rmtree(data_dir(), ignore_errors=True)
    os.makedirs(data_dir(), exist_ok=True)
    persona_tried["at"] = 0.0
    return {"loggedIn": False}


# --- access token (CM exchange) ---------------------------------------------
#
# The refresh token the Go login persists is a SteamClient token: the Web
# API rejects it with 401, and GenerateAccessTokenForApp refuses it over
# plain REST (AccessDenied, since 2025-04-30). It only works from an
# authenticated CM session, so the plugin logs on to a CM itself
# (steam_cm.py) once per access-token lifetime and calls the Web API with
# the derived access token afterwards.

cm_lock = threading.Lock()


def jwt_exp(token):
    try:
        return int(steam_cm.jwt_payload(token).get("exp") or 0)
    except (ValueError, KeyError, IndexError):
        return 0


def access_token():
    """The access token for the Web API, from the cache while it lasts, else
    from a fresh CM logon with the persisted refresh token.

    CODE_AUTH_REQUIRED is raised only when there's no refresh token at all or
    Steam says it's invalid/expired/revoked — every other failure is a normal
    error that surfaces its real message, so the Library never shows "logged
    out" for a network hiccup."""
    st = load_state("steam-access.json", {})
    token = st.get("access_token") or ""
    if token and jwt_exp(token) - ACCESS_TOKEN_MARGIN > time.time():
        tighten("steam-access.json")
        return token
    refresh = refresh_token()
    if not refresh:
        raise RPCError("no Steam session available; log in again", CODE_AUTH_REQUIRED)
    with cm_lock:
        # Re-check inside the lock: a concurrent library.list may have
        # exchanged already.
        st = load_state("steam-access.json", {})
        token = st.get("access_token") or ""
        if token and jwt_exp(token) - ACCESS_TOKEN_MARGIN > time.time():
            tighten("steam-access.json")
            return token
        try:
            token = steam_cm.exchange(refresh)
        except steam_cm.CMError as e:
            if e.auth:
                raise RPCError(f"Steam rejected the stored login key ({e}); log in again",
                               CODE_AUTH_REQUIRED)
            raise RPCError(str(e))
        save_secret("steam-access.json", {"access_token": token,
                                         "exp": jwt_exp(token)})
        return token


# Library calls run in threads; persona lookups must not repeat per call.
persona_lock = threading.Lock()


def persona_name(steamid):
    """The account's public persona name, for auth.status — from the CM
    session itself (Player.GetPlayerLinkDetails#1), since the Web API's
    GetPlayerSummaries now demands an API key. Saved in session.json; an
    empty result is a non-fatal miss (profiles can be private)."""
    with persona_lock:
        st = load_state("session.json", {})
        if st.get("persona"):
            return st["persona"]
    try:
        token = access_token()  # cached; opens one CM session if needed
        session = steam_cm.CMSession(int(steamid), refresh_token())
        try:
            body = session.call("Player.GetPlayerLinkDetails#1",
                                steam_cm.pb_msg(1, steam_cm.pb_int(1, int(steamid))))
        finally:
            session.logoff()
        link = steam_cm.pb_parse(steam_cm.pb_parse(body).get(1, [b""])[0])
        pub = steam_cm.pb_parse(link.get(1, [b""])[0])
        name = pub.get(10, [b""])[0].decode("utf-8", "replace")  # persona_name
    except Exception:
        return ""
    if name:
        with persona_lock:
            st = load_state("session.json", {})
            st["persona"] = name
            save_state("session.json", st)
    return name



def art_urls(app):
    """CDN art for an app id, without any Store lookup: the portrait, the
    wide hero and the landscape header. Older titles 404 on the portrait;
    the UI falls back to the header (cropped into the portrait card) and
    remembers the miss, so the 404 isn't requested on every render."""
    base = f"https://cdn.cloudflare.steamstatic.com/steam/apps/{app}"
    return {
        "coverUrl": f"{base}/library_600x900.jpg",
        "heroUrl": f"{base}/library_hero_2x.jpg",
        "bannerUrl": f"{base}/header.jpg",
    }


# --- hashed art assets (IStoreBrowseService/GetItems) ----------------------
# Newer apps (e.g. Aniimo 4126040) keep their art under hashed asset paths,
# so the fixed CDN names above all 404 for them. The keyless store-browse
# API names the real paths, many ids per request; the full URL is the CDN
# base + "/store_item_assets/" + asset_url_format with ${FILENAME} replaced.
ART_TTL = 7 * 86400  # resolved asset URLs are refreshed weekly
ART_BATCH = 200  # app ids per GetItems request (the API accepts this many)
ART_BUDGET = 15  # seconds of GetItems calls per library.list, separate from STORE_BUDGET
ART_CDN_BASE = "https://shared.steamstatic.com"
art_lock = threading.Lock()
art_cache = None  # app id -> {"cover","hero","banner","at"}, mirrors art-assets.json


def getitems_base():
    """The store-browse API base. Overridable via the environment so tests
    can point it at a fake endpoint; production is the keyless live API."""
    return os.environ.get("PLATYPUS_STEAM_GETITEMS_BASE") or "https://api.steampowered.com"


def save_art_cache():
    with art_lock:
        if art_cache is not None:
            save_state("art-assets.json", art_cache)


def parse_getitems(data):
    """Real art URLs out of a GetItems response: {appid: {coverUrl,
    heroUrl, bannerUrl}}. Reads only the string asset values, so numeric
    fields the API also carries (last_modified etc.) can never break the
    parse; apps without usable art are simply absent (caller keeps the
    fixed CDN fallback). Mapping, like internal/onlineart's GetItemAssets:
    cover library_capsule_2x else library_capsule, hero library_hero_2x
    else library_hero, banner header_2x else header."""
    out = {}
    try:
        items = (data.get("response") or {}).get("store_items") or []
    except AttributeError:
        return {}
    if not isinstance(items, list):
        return {}
    for item in items:
        if not isinstance(item, dict):
            continue
        appid = str(item.get("appid") or "")
        if not appid:
            continue
        assets = item.get("assets") or {}
        if not isinstance(assets, dict):
            continue
        strs = {k: v.strip() for k, v in assets.items()
                if isinstance(v, str) and v.strip()}
        fmt = strs.get("asset_url_format") or ""
        if "${FILENAME}" not in fmt:
            continue

        def pick(*keys):
            for k in keys:
                if strs.get(k):
                    return strs[k]
            return ""

        def resolve(name):
            if not name:
                return ""
            return ART_CDN_BASE + "/store_item_assets/" + fmt.replace("${FILENAME}", name)
        urls = {}
        cover = resolve(pick("library_capsule_2x", "library_capsule"))
        hero = resolve(pick("library_hero_2x", "library_hero"))
        banner = resolve(pick("header_2x", "header"))
        if cover:
            urls["coverUrl"] = cover
        if hero:
            urls["heroUrl"] = hero
        if banner:
            urls["bannerUrl"] = banner
        if urls:
            out[appid] = urls
    return out


def fetch_getitems_batch(ids):
    """One GetItems call for ids (numeric strings) -> parse_getitems's
    mapping. Keyless: no token is sent. May raise; the caller treats any
    failure as "keep the cache/fallback"."""
    payload = {"ids": [{"appid": int(a)} for a in ids],
               "context": {"language": "english", "country_code": "US"},
               "data_request": {"include_assets": True}}
    q = urllib.parse.urlencode({"input_json": json.dumps(payload, separators=(",", ":"))})
    return parse_getitems(api_get(getitems_base() + "/IStoreBrowseService/GetItems/v1/?" + q))


def resolve_art_assets(app_ids, deadline=None):
    """Hashed art URLs for app ids: fresh cache first, then batched
    GetItems for the rest (at most ART_BATCH ids per request), cached in
    art-assets.json with a fetched-at time and refreshed after ART_TTL.
    Stale cache entries stay usable when the request fails or the time
    budget (deadline, like STORE_BUDGET) is spent; unknown apps are
    absent so the caller keeps the fixed CDN fallback. Never raises."""
    global art_cache
    ids = []
    for a in app_ids:
        a = str(a or "")
        if a.isdigit() and a not in ids:
            ids.append(a)
    if not ids:
        return {}
    with art_lock:
        if art_cache is None:
            art_cache = load_state("art-assets.json", {})
        cached = art_cache
    now = time.time()
    out = {}
    need = []
    fetched = False
    for a in ids:
        entry = cached.get(a) or {}
        if entry and now - entry.get("at", 0) < ART_TTL:
            # Fresh: whatever was recorded (URLs, or a miss with none).
            urls = {}
            if entry.get("cover"):
                urls["coverUrl"] = entry["cover"]
            if entry.get("hero"):
                urls["heroUrl"] = entry["hero"]
            if entry.get("banner"):
                urls["bannerUrl"] = entry["banner"]
            if urls:
                out[a] = urls
        else:
            need.append(a)
    for i in range(0, len(need), ART_BATCH):
        if deadline is not None and time.time() >= deadline:
            break  # budget spent: the rest keep cache/fallback this listing
        batch = need[i:i + ART_BATCH]
        try:
            found = fetch_getitems_batch(batch)
        except Exception:
            break  # unreachable: keep cache/fallback, don't fail the listing
        fetched = True
        with art_lock:
            for a in batch:
                if a in found:
                    cached[a] = {"cover": found[a].get("coverUrl") or "",
                                 "hero": found[a].get("heroUrl") or "",
                                 "banner": found[a].get("bannerUrl") or "",
                                 "at": now}
                    out[a] = found[a]
                else:
                    # A recorded miss so the app isn't refetched every
                    # listing; stale URLs are kept (content-addressed art
                    # usually still serves) and stay usable below.
                    stale = cached.get(a) or {}
                    cached[a] = {"cover": stale.get("cover") or "",
                                 "hero": stale.get("hero") or "",
                                 "banner": stale.get("banner") or "",
                                 "at": now}
            art_cache = cached
    if fetched:
        save_art_cache()
    for a in need:  # stale cache covers failures and timeouts
        if a not in out:
            entry = cached.get(a) or {}
            urls = {}
            if entry.get("cover"):
                urls["coverUrl"] = entry["cover"]
            if entry.get("hero"):
                urls["heroUrl"] = entry["hero"]
            if entry.get("banner"):
                urls["bannerUrl"] = entry["banner"]
            if urls:
                out[a] = urls
    return out


def library_list(_params):
    if not logged_in():
        raise RPCError(tr("need_login"), CODE_AUTH_REQUIRED)
    token = access_token()
    steamid = steam_cm.jwt_payload(token).get("sub")
    try:
        # steamid is a routing parameter: without it the Web API answers
        # 400 "missing required routing parameter" for token auth.
        data = api_get("https://api.steampowered.com/IPlayerService/GetOwnedGames/v0001/"
                       f"?include_appinfo=1&include_played_free_games=1&steamid={steamid}", token)
    except Exception as e:
        raise RPCError(f"Steam Web API is unreachable: {e}")
    games = (data.get("response") or {}).get("games") or []
    persona_name(steamid)  # best effort, for auth.status
    installed = load_state("installed.json", {})
    out = []
    deadline = time.time() + STORE_BUDGET
    for g in games:
        app = str(g.get("appid") or "")
        if not app:
            continue
        store = store_app(app, fetch=time.time() < deadline)
        entry = {
            "id": app,
            "title": store.get("name") or g.get("name") or f"App {app}",
            "installed": app in installed,
            "installable": True,
        }
        if app in installed:
            ig = installed[app]
            entry["installPath"] = ig.get("path", "")
            entry["version"] = ig.get("version", "")
            if ig.get("native"):
                entry["native"] = True
            entry["note"] = mode_note(ig.get("mode") or "none")
        # Art needs no Store lookup: always set it, so games past the Store
        # budget (or with no Store entry at all) still show covers.
        entry.update(art_urls(app))
        # Tools, movies, music etc. aren't depot installs Platypus can run.
        app_type = (store.get("type") or "").lower()
        if app_type and app_type not in ("game", "demo", "beta", "application"):
            entry["installable"] = False
            entry["note"] = f"This entry is a {app_type}, not a game."
        out.append(entry)
    save_store_cache()
    for app, ig in installed.items():  # installed but missing from the owned list
        if not any(e["id"] == app for e in out):
            missing = {
                "id": app, "title": ig.get("title") or f"App {app}",
                "installable": False, "installed": True,
                "installPath": ig.get("path", ""),
                "native": True if ig.get("native") else False,
                "note": mode_note(ig.get("mode") or "none"),
            }
            missing.update(art_urls(app))
            out.append(missing)
    # Newer apps only have hashed asset paths: resolve the real cover/hero/
    # banner URLs for every listed app (owned and installed-missing alike)
    # within a budget of its own (Store lookups may have spent theirs on a
    # big first listing; one GetItems call covers 200 apps). Failures and timeouts
    # keep the fixed CDN fallback above, never fail the listing.
    try:
        overrides = resolve_art_assets([e["id"] for e in out], time.time() + ART_BUDGET)
    except Exception:
        overrides = {}
    for entry in out:
        if entry["id"] in overrides:
            entry.update(overrides[entry["id"]])
    return {"games": out}


def mode_note(mode):
    """What the game page says about how the game launches, in the user's locale."""
    return {
        "none": tr("mode_none"),
        "optional": tr("mode_optional"),
        "client": tr("mode_client"),
    }.get(mode, "")


def dl_bin():
    """The Go downloader: bin/platypus-steam-dl next to this file (built by
    install.sh), falling back to PATH (tests put a built copy there)."""
    sibling = os.path.join(os.path.dirname(os.path.abspath(__file__)), "platypus-steam-dl")
    if os.path.isfile(sibling) and os.access(sibling, os.X_OK):
        return sibling
    found = shutil.which("platypus-steam-dl")
    if found:
        return found
    return sibling  # missing: the run surfaces it as an error


def dl_request(params, extra=None):
    """The stdin request for platypus-steam-dl: ids plus the refresh token.
    The token travels on stdin, never argv, and is never logged."""
    token = refresh_token()
    if not token:
        raise RPCError(tr("need_login"), CODE_AUTH_REQUIRED)
    req = {"refresh_token": token, "app_id": int(params["id"]),
           "branch": params.get("branch") or "public"}
    # A password-protected beta branch. Stdin only, like the token: never
    # argv, never logged.
    pw = params.get("branchPassword") or params.get("branch_password")
    if pw:
        req["branch_password"] = pw
    if extra:
        req.update(extra)
    return req


def dl_run(subcommand, req, job_id=None, game_dir=None):
    """Runs platypus-steam-dl and follows its JSON lines: progress
    notifications until a result or error line. Returns the result dict."""
    try:
        proc = subprocess.Popen([dl_bin(), subcommand], stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, bufsize=1, env=dict(os.environ))
    except FileNotFoundError:
        raise RPCError("platypus-steam-dl is missing; reinstall the plugin")
    if job_id is not None:
        with jobs_lock:
            job = jobs.get(job_id) or {}
            job.update({"id": req.get("app_id"), "dir": game_dir, "proc": proc})
            jobs[job_id] = job
    try:
        proc.stdin.write(json.dumps(req) + "\n")
        proc.stdin.close()
    except (BrokenPipeError, OSError):
        pass
    state = {"jobId": job_id, "phase": "downloading", "percent": 0} if job_id else None
    import collections as _collections
    text = _collections.deque(maxlen=20)
    result = None
    for line in proc.stdout:
        line = line.rstrip()
        text.append(line)
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if not isinstance(msg, dict):
            continue
        if msg.get("type") == "progress" and state is not None:
            total = msg.get("total") or 0
            done = msg.get("bytes") or 0
            state["percent"] = (100.0 * done / total) if total else 0
            state["bytes"] = done
            state["total"] = total
            if msg.get("speed"):
                state["speed"] = msg["speed"]
            if msg.get("connections"):
                state["connections"] = msg["connections"]
            if msg.get("hosts"):
                state["hosts"] = msg["hosts"]
            notify("job.progress", dict(state))
        elif msg.get("type") == "result":
            result = msg
        elif msg.get("type") == "error":
            if msg.get("code") == "auth-required":
                raise RPCError(tr("need_login_expired"), CODE_AUTH_REQUIRED)
            raise RPCError("download failed: {}".format(msg.get("message") or tail(line)))
    rc = proc.wait()
    if result is None:
        raise RPCError("download failed: {}".format(tail("\n".join(text))))
    if rc != 0:
        raise RPCError("download failed: {}".format(tail("\n".join(text))))
    return result


def install_size(params):
    """Depot sizes from platypus-steam-dl: it resolves the app's depots over
    the CM and sums the manifests (Linux depots first, Windows fallback —
    the same order an install uses)."""
    try:
        result = dl_run("size", dl_request(params))
    except RPCError:
        raise
    except Exception as e:
        raise RPCError("couldn't get the size for app {}: {}".format(params["id"], e))
    disk, compressed = int(result.get("disk_bytes") or 0), int(result.get("download_bytes") or 0)
    if disk == 0:
        raise RPCError("platypus-steam-dl produced no manifest sizes for app {}".format(params["id"]))
    return {"downloadBytes": compressed, "diskBytes": disk}


# --- jobs ------------------------------------------------------------------

def start_job(params, kind):
    app, job_id = str(params["id"]), params["jobId"]
    if kind == "uninstall":
        if app not in load_state("installed.json", {}):
            raise RPCError(tr("not_installed", app=app))
        ev = threading.Event()
        if not claim_job(job_id, {"canceled": False, "id": app, "proc": None, "event": ev}):
            return {}
        threading.Thread(target=follow_uninstall, args=(job_id, app, ev), daemon=True).start()
        return {}
    install_dir = params.get("installDir") or ""
    if not os.path.isabs(install_dir):
        raise RPCError("installDir is missing or relative; Platypus always sends one")
    # One folder per game under Platypus's install dir, like steamapps/common/<name>.
    game_dir = os.path.join(install_dir, game_dir_name(app))
    # Platypus resends a job with the same jobId after a crash: run it once. A
    # job that was just paused or canceled is still winding down: wait for it,
    # then start again from what it left on disk.
    if not claim_job(job_id, {"canceled": False, "id": app, "dir": game_dir, "proc": None}):
        return {}
    write_job_meta(job_id, {"app": app, "kind": kind, "dir": game_dir, "installDir": install_dir})
    os.makedirs(game_dir, exist_ok=True)
    dl_kind = "update" if kind == "update" else "install"
    branch = {k: params[k] for k in ("branch", "branchPassword", "branch_password") if params.get(k)}
    threading.Thread(target=follow_install, args=(job_id, app, game_dir, dl_kind, branch), daemon=True).start()
    return {}


def claim_job(job_id, entry, timeout=90):
    """Registers entry as the run of job_id and returns True. False when the
    job is already running (a repeated start). A job that job.cancel just
    stopped is still shutting down its downloader: wait for it to go, so a
    resume with the same jobId doesn't lose to the old run and report
    nothing."""
    deadline = time.monotonic() + timeout
    while True:
        with jobs_lock:
            job = jobs.get(job_id)
            if job is None:
                jobs[job_id] = entry
                return True
            if not job.get("canceled"):
                return False
        if time.monotonic() > deadline:
            raise RPCError("the previous run of this download is still stopping; try again in a moment")
        time.sleep(0.05)


def game_dir_name(app):
    installed = load_state("installed.json", {})
    if app in installed and installed[app].get("dir_name"):
        return installed[app]["dir_name"]
    name = store_app(app).get("name") or f"app_{app}"
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", name).strip("_") or f"app_{app}"
    # Suffix the app id: two store names can sanitize identically
    # ("A/B" and "A_B" both become "A_B"). Existing installs keep their
    # stored dir_name above.
    if not safe.endswith(f"_{app}"):
        safe = f"{safe}_{app}"
    return safe


def follow_install(job_id, app, game_dir, dl_kind="install", branch=None):
    """platypus-steam-dl install/update with progress. The binary resolves the
    depots itself (Linux first, Windows fallback — the platform used
    decides `native`); downloads are resumable and verified."""
    with jobs_lock:
        jobs.setdefault(job_id, {"canceled": False, "id": app, "dir": game_dir})
    try:
        req = dl_request({"id": app, **(branch or {})}, {"install_dir": game_dir, "job_id": job_id})
        result = dl_run(dl_kind, req, job_id, game_dir)
    except RPCError as e:
        with jobs_lock:
            job = jobs.pop(job_id, {})
        if job.get("canceled"):
            return
        if e.code == CODE_AUTH_REQUIRED:
            notify("job.failed", {"jobId": job_id, "error": tr("need_login_expired")})
        else:
            notify("job.failed", {"jobId": job_id, "error": str(e)})
        return
    with jobs_lock:
        job = jobs.pop(job_id, {})
    if job.get("canceled"):
        return
    record_install(app, game_dir, result.get("os_used") or "linux")
    drop_job_meta(job_id)
    notify("job.done", {"jobId": job_id})


def record_install(app, game_dir, os_used):
    """Remember the install: where it is, what runs it and which launch mode
    applies (see launch modes below)."""
    exe = find_executable(game_dir, native=os_used == "linux")
    entry = {
        "path": game_dir,
        "dir_name": os.path.basename(game_dir),
        "executable": exe,
        "native": os_used == "linux",
        "mode": detect_mode(game_dir),
        "version": "",
        "title": store_app(app).get("name") or "",
    }
    with installed_lock:
        installed = load_state("installed.json", {})
        installed[app] = entry
        save_state("installed.json", installed)


def is_elf(path):
    try:
        with open(path, "rb") as f:
            return f.read(4) == b"\x7fELF"
    except OSError:
        return False


EXE_SKIP_DIRS = ("redist", "directx", "dotnet", "__installer")
EXE_SKIP_SUFFIXES = ("_data",)


def _walk_limited(game_dir, max_depth=3):
    """(dirpath, depth, entries) up to max_depth, skipping redist/data dirs."""
    try:
        base = os.path.abspath(game_dir)
    except OSError:
        return
    stack = [(base, 0)]
    while stack:
        cur, depth = stack.pop(0)
        try:
            with os.scandir(cur) as it:
                entries = list(it)
        except OSError:
            continue
        yield cur, depth, entries
        if depth >= max_depth:
            continue
        for e in entries:
            try:
                is_dir = e.is_dir()
            except OSError:
                continue
            if not is_dir:
                continue
            low = e.name.lower()
            if low in EXE_SKIP_DIRS or low.endswith(EXE_SKIP_SUFFIXES):
                continue
            stack.append((e.path, depth + 1))


def find_executable(game_dir, native=False):
    """The game's entry point: a Linux binary/script (native builds), or the
    biggest .exe (Steam Windows builds ship many helper exes). Searches the
    install root and subdirs (bounded depth, redist/data dirs skipped).
    Depots don't always mark the Linux binary executable, so a pick that
    isn't gets its owner exec bit here."""
    if native:
        exe = find_native_executable(game_dir)
        if exe:
            return exe
    best, size, best_depth = "", 0, 99
    script = ""
    try:
        for _dir, depth, entries in _walk_limited(game_dir):
            for entry in entries:
                try:
                    if not entry.is_file():
                        continue
                except OSError:
                    continue
                name = entry.name
                lower = name.lower()
                if lower.endswith((".exe",)) and not lower.startswith(
                        ("uninst", "setup", "redist", "dxsetup", "vcredist", "dotnet")):
                    try:
                        s = entry.stat().st_size
                    except OSError:
                        continue
                    if s > size or (s == size and depth < best_depth):
                        best, size, best_depth = entry.path, s, depth
                elif lower.endswith(".sh") and not script:
                    try:
                        if os.access(entry.path, os.X_OK):
                            script = entry.path
                    except OSError:
                        pass
    except OSError:
        pass
    return best or script


def find_native_executable(game_dir):
    """The native entry point. Unity builds pair <name>.x86_64
    with a <name>_Data folder (other binaries next to it can be launchers or
    helpers, even bigger ones); otherwise a start script (.sh), else the
    biggest ELF binary (shared libraries and installers excluded).
    Searches the root and subdirs (bounded depth, *_Data/redist skipped)."""
    unity, script, elf, size = "", "", "", 0
    try:
        for _dir, _depth, entries in _walk_limited(game_dir):
            names = sorted(entries, key=lambda e: e.name)
            dirs = set()
            for e in names:
                try:
                    if e.is_dir():
                        dirs.add(e.name)
                except OSError:
                    pass
            for entry in names:
                try:
                    if not entry.is_file():
                        continue
                except OSError:
                    continue
                lower = entry.name.lower()
                stem, ext = os.path.splitext(entry.name)
                if ext.lower() in (".x86_64", ".x86") and stem + "_Data" in dirs and is_elf(entry.path):
                    unity = unity or entry.path
                elif lower.endswith(".sh") and not script:
                    script = script or entry.path
                elif not re.search(r"\.so(\.\d+)*$", lower) and not lower.startswith(("unins", "setup", "install")):
                    try:
                        s = entry.stat().st_size
                    except OSError:
                        continue
                    if s > size and is_elf(entry.path):
                        elf, size = entry.path, s
            if unity:
                break
    except OSError:
        return ""
    best = unity or script or elf
    if best and not os.access(best, os.X_OK):
        try:
            os.chmod(best, os.stat(best).st_mode | 0o100)
        except OSError:
            return ""
    return best


# --- launch modes ----------------------------------------------------------
#
# 1. "none"    No Steamworks dependency (no steam_api*.dll / libsteam_api.so
#              anywhere in the install): launch directly. Fully launcher-free.
# 2. "optional" Steamworks files exist, but most such games only use them for
#              achievements or overlay and run fine when SteamAPI_Init fails:
#              launch directly with SteamAppId/SteamGameId set so the game
#              doesn't try to relaunch itself through Steam.
# 3. "client"  The game needs the real client (fatal SteamAPI_Init failure or
#              Steam's DRM wrapper): Platypus starts the real Steam client
#              hidden (`steam -silent`) and asks it to start the game; the
#              game runs against the live client for its licence check and
#              achievements. No Steam API emulators, ever.
#
# 2 vs 3 can't be told apart reliably by inspection. The plugin tries direct
# first; if the game dies within seconds with a Steamworks init error
# (Platypus's session tracker reports it), retrying on the game page marks it
# "needs client" and mode 3 is used from then on. Community data plugins can
# pre-seed that flag.

STEAMWORKS_RE = re.compile(r"^(steam_api(64)?\.dll|libsteam_api\.so(\.\d+)*)$", re.IGNORECASE)


def has_steamworks(game_dir):
    try:
        for _root, _dirs, files in os.walk(game_dir):
            for f in files:
                if STEAMWORKS_RE.match(f):
                    return True
    except OSError:
        pass
    return False


def detect_mode(game_dir):
    if not has_steamworks(game_dir):
        return "none"
    return "optional"


def launch_spec(params):
    app = str(params["id"])
    installed = load_state("installed.json", {})
    ig = installed.get(app)
    if not ig:
        raise RPCError(tr("not_installed", app=app))
    path, exe = ig.get("path") or "", ig.get("executable") or ""
    if not exe or not os.path.isfile(exe):
        exe = find_executable(path, native=bool(ig.get("native")))
        if not exe:
            raise RPCError(f"couldn't find a game executable in {path or 'the install folder'}")
        with installed_lock:  # re-read: only this field changes
            fresh = load_state("installed.json", {})
            if app in fresh:
                fresh[app]["executable"] = exe
                save_state("installed.json", fresh)
        ig["executable"] = exe
    mode = ig.get("mode") or "none"
    native = bool(ig.get("native"))
    if mode in ("none", "optional"):
        spec = {
            "exe": exe,
            "args": [],
            "cwd": os.path.dirname(exe),
            "env": {},
            "needsWine": not native,
        }
        if mode == "optional":
            # Tell the game which app it is so SteamAPI_Init-less runs don't
            # try to relaunch through Steam. SteamAppId/SteamGameId are not
            # on Platypus's launch-env denylist (only STEAM_COMPAT_* are).
            spec["env"]["SteamAppId"] = app
            spec["env"]["SteamGameId"] = app
        return spec
    # mode == "client": the real client, started hidden. Platypus runs the
    # command and follows the game through find.cmdline (Steam's reaper marks
    # the game process with AppId=<id>), so session tracking works.
    return {
        "delegate": "store-client",
        "client": "Steam",
        "command": ["steam", "-silent", "-applaunch", app],
        "find": {"cmdline": [f"AppId={app}"]},
        "startTimeout": 300,
    }


def _languages(raw):
    """Supported languages HTML ("English<strong>*</strong>, French, ...") to plain names."""
    if not raw:
        return []
    text = re.sub(r"<br\s*/?>", ",", raw, flags=re.I)
    text = re.sub(r"<[^>]+>", " ", text)
    out = []
    for part in text.replace("*", " ").split(","):
        name = " ".join(part.split())
        if name and name not in out and len(out) < 100 and len(name) <= 60:
            out.append(name)
    return out


def _requirement_side(v):
    if not isinstance(v, dict):
        return "", ""
    lo, hi = "", ""
    if isinstance(v.get("minimum"), str) and v["minimum"]:
        lo = v["minimum"][:50000]
    if isinstance(v.get("recommended"), str) and v["recommended"]:
        hi = v["recommended"][:50000]
    return lo, hi


def _movie_url(movie):
    """Prefer mp4 480/max or webm; HLS-only entries are skipped."""
    for key in ("mp4", "webm"):
        clips = movie.get(key) or {}
        if not isinstance(clips, dict):
            continue
        for quality in ("480", "max"):
            if clips.get(quality):
                return clips[quality], "video/mp4" if key == "mp4" else "video/webm"
        for u in clips.values():
            if u:
                return u, "video/mp4" if key == "mp4" else "video/webm"
    return "", ""


def game_details(params):
    """Public store metadata, no login needed (same API the built-in Steam
    store uses). Richer facts are protocol 1.12; core sanitizes the HTML."""
    app = str(params["id"])
    try:
        data = api_get(f"https://store.steampowered.com/api/appdetails?appids={app}&l={steam_lang()}")
    except Exception:
        return {}
    if isinstance(data, dict) and data.get("_test"):
        data = data["_test"]
    entry = (data or {}).get(app)
    if not entry or not entry.get("success"):
        return {}
    d = entry.get("data") or {}
    out = {}
    if d.get("short_description"):
        out["summary"] = re.sub(r"<[^>]+>", " ", d["short_description"]).strip()
    if d.get("screenshots"):
        out["screenshots"] = [s.get("path_full") or s.get("path_thumbnail")
                              for s in d["screenshots"][:6] if isinstance(s, dict)]
    if d.get("genres"):
        out["genres"] = [g.get("description") for g in d["genres"][:4] if g.get("description")]
    if d.get("developers"):
        out["developers"] = d["developers"][:4]
    if d.get("publishers"):
        out["publishers"] = d["publishers"][:4]
    date = (d.get("release_date") or {}).get("date") or ""
    if date:
        out["releaseDate"] = date
    out["heroUrl"] = f"https://cdn.cloudflare.steamstatic.com/steam/apps/{app}/library_hero_2x.jpg"
    # Newer apps only have hashed asset paths: prefer the real hero URL
    # when GetItems names one. Best effort, never fails the details.
    try:
        art = resolve_art_assets([app], time.time() + 15)
        if art.get(app, {}).get("heroUrl"):
            out["heroUrl"] = art[app]["heroUrl"]
    except Exception:
        pass
    # Richer facts (protocol 1.12): raw store HTML/URLs; core validates.
    desc = d.get("detailed_description") or ""
    if d.get("about_the_game") and len(d["about_the_game"]) > len(desc):
        desc = d["about_the_game"]
    if desc:
        out["descriptionHtml"] = desc[:200000]
    if d.get("website"):
        out["website"] = d["website"]
    out["storeUrl"] = f"https://store.steampowered.com/app/{app}/"
    langs = _languages(d.get("supported_languages") or "")
    if langs:
        out["languages"] = langs
    if str(d.get("controller_support") or "").lower() in ("full", "partial"):
        out["controller"] = str(d["controller_support"]).lower()
    pc_min, pc_rec = _requirement_side(d.get("pc_requirements"))
    lx_min, lx_rec = _requirement_side(d.get("linux_requirements"))
    minimum, recommended = pc_min or lx_min, pc_rec or lx_rec
    if minimum or recommended:
        out["requirements"] = {k: v for k, v in (("minimum", minimum), ("recommended", recommended)) if v}
    try:
        age = int(str(d.get("required_age") or "0").strip())
    except ValueError:
        age = 0
    if age > 0:
        out["ageRating"] = f"{min(age, 21)}+"
    tags = [c.get("description") for c in (d.get("categories") or []) if isinstance(c, dict) and c.get("description")]
    if tags:
        out["tags"] = tags[:100]
    videos = []
    for m in (d.get("movies") or [])[:20]:
        if not isinstance(m, dict):
            continue
        url, mime = _movie_url(m)
        if not url:
            continue
        videos.append({k: v for k, v in (
            ("url", url), ("thumbnail", m.get("thumbnail") or ""),
            ("title", (m.get("name") or "")[:200]), ("mime", mime)) if v})
    if videos:
        out["videos"] = videos
    return {k: v for k, v in out.items() if v}


# --- uninstall -------------------------------------------------------------

def follow_uninstall(job_id, app, ev=None):
    if ev is not None:
        ev.wait(0.5)
    else:
        time.sleep(0.1)
    with jobs_lock:
        job = jobs.get(job_id, {})
        if job.get("canceled"):
            jobs.pop(job_id, None)
            return
    with installed_lock:
        installed = load_state("installed.json", {})
        ig = installed.pop(app, None)
        with jobs_lock:
            if jobs.get(job_id, {}).get("canceled"):
                jobs.pop(job_id, None)
                return
            jobs.pop(job_id, None)
        if ig and ig.get("path") and os.path.isdir(ig["path"]):
            shutil.rmtree(ig["path"], ignore_errors=True)
        save_state("installed.json", installed)
    notify("job.done", {"jobId": job_id})


def stop_proc(proc, grace=15):
    if proc is None:
        return
    try:
        proc.send_signal(signal.SIGINT)
        proc.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        proc.kill()
    except ProcessLookupError:
        pass


def job_cancel(params):
    with jobs_lock:
        job = jobs.get(params.get("jobId"))
        if job:
            job["canceled"] = True
            proc = job.get("proc")
            ev = job.get("event")
        else:
            proc, ev = None, None
    if ev is not None:
        ev.set()
    if proc:
        threading.Thread(target=stop_proc, args=(proc,), daemon=True).start()
    return {}


# --- discarding a canceled job's data ---------------------------------------
# Staging lives under $PLATYPUS_PLUGIN_DATA/jobs/<jobId>.{json,chunks} (written by
# platypus-steam-dl); start_job also leaves <jobId>.meta.json with the folder the
# job installs into, so job.discard knows what to delete after a restart.

JOB_ID_RE = re.compile(r"[A-Za-z0-9_-]{1,64}")


def jobs_dir():
    return os.path.join(data_dir(), "jobs")


def meta_file(job_id):
    return os.path.join(jobs_dir(), job_id + ".meta.json")


def write_job_meta(job_id, meta):
    try:
        os.makedirs(jobs_dir(), exist_ok=True)
        save_state(os.path.join("jobs", job_id + ".meta.json"), meta)
    except OSError as e:
        log("warn", f"couldn't record job {job_id}: {e}")


def drop_job_meta(job_id):
    try:
        os.unlink(meta_file(job_id))
    except OSError:
        pass


def inside(path, parent):
    """path is strictly below parent, links resolved."""
    path, parent = os.path.realpath(path), os.path.realpath(parent)
    return path != parent and path.startswith(parent + os.sep)


def installed_paths():
    out = []
    for entry in load_state("installed.json", {}).values():
        if entry.get("path"):
            out.append(os.path.realpath(entry["path"]))
    return out


def job_discard(params):
    """Deletes what a canceled job left: staged chunks and checkpoints, and,
    for an install that never finished, its half-written game folder. Never
    an installed game's folder, and never anything for an update: the game it
    updates stays."""
    job_id = params.get("jobId")
    if not isinstance(job_id, str) or not JOB_ID_RE.fullmatch(job_id):
        raise RPCError("invalid jobId", -32602)
    # The job may still be shutting down (discarding right after a cancel).
    job_cancel({"jobId": job_id})
    deadline = time.monotonic() + 90
    while True:
        with jobs_lock:
            running = job_id in jobs
        if not running:
            break
        if time.monotonic() > deadline:
            raise RPCError("the download is still stopping; try again in a moment")
        time.sleep(0.05)

    meta = load_state(os.path.join("jobs", job_id + ".meta.json"), {})
    kind = params.get("kind") or meta.get("kind") or "install"
    install_dir = params.get("installDir") or ""
    if kind == "install" and meta.get("dir"):
        game_dir = meta["dir"]
        # The recorded folder must be a subfolder of the install folder Platypus
        # named for this job, and not something that is installed.
        if (os.path.isabs(install_dir) and os.path.isabs(game_dir)
                and inside(game_dir, install_dir)
                and os.path.isdir(game_dir) and not os.path.islink(game_dir)
                and str(params.get("id", meta.get("app"))) not in load_state("installed.json", {})):
            real = os.path.realpath(game_dir)
            clash = [p for p in installed_paths() if p == real or p.startswith(real + os.sep) or real.startswith(p + os.sep)]
            if clash:
                log("warn", f"not deleting {game_dir}: it holds an installed game")
            else:
                shutil.rmtree(game_dir, ignore_errors=True)
    # Staging: only these three names under jobs/, built from the validated id.
    base = jobs_dir()
    shutil.rmtree(os.path.join(base, job_id + ".chunks"), ignore_errors=True)
    for suffix in (".json", ".json.new", ".meta.json"):
        try:
            os.unlink(os.path.join(base, job_id + suffix))
        except OSError:
            pass
    return {}


# --- dispatch --------------------------------------------------------------

def initialize(params):
    set_locale((params or {}).get("locale") or "en")
    return {"name": "Steam (standalone)", "version": "0.3.0", "api": API,
            "protocol": "1.14",
            "capabilities": ["library", "install", "launch", "auth", "discard"], "missing": []}


METHODS = {
    "initialize": initialize,
    "auth.status": auth_status,
    "auth.begin": auth_begin,
    "auth.complete": auth_complete,
    "auth.logout": auth_logout,
    "library.list": library_list,
    "game.details": game_details,
    "game.installSize": install_size,
    "game.install": lambda p: start_job(p, "install"),
    "game.update": lambda p: start_job(p, "update"),
    "game.uninstall": lambda p: start_job(p, "uninstall"),
    "job.cancel": job_cancel,
    "job.discard": job_discard,
    "game.launchSpec": launch_spec,
}


def handle(msg):
    fn = METHODS.get(msg.get("method"))
    resp = {"id": msg["id"]}
    if fn is None:
        resp["error"] = {"code": -32601, "message": f"method not found: {msg.get('method')}"}
    else:
        try:
            result = fn(msg.get("params") or {})
            resp["result"] = result if result is not None else {}
        except RPCError as e:
            resp["error"] = {"code": e.code, "message": str(e)}
        except (KeyError, TypeError) as e:
            resp["error"] = {"code": -32602, "message": f"invalid params: {e}"}
        except Exception as e:  # report, never crash the plugin
            resp["error"] = {"code": -32000, "message": f"{type(e).__name__}: {e}"}
    send(resp)


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError as e:
            send({"error": {"code": -32700, "message": str(e)}})
            continue
        if "id" not in msg:
            # Core→plugin notifications need no answer. locale.changed
            # (protocol 1.14) keeps texts in the user's language.
            if msg.get("method") == "locale.changed":
                set_locale((msg.get("params") or {}).get("locale") or "en")
            continue
        # Library listing and logins can take seconds; keep reading so
        # job.cancel stays responsive.
        threading.Thread(target=handle, args=(msg,), daemon=True).start()
    with jobs_lock:
        procs = [j.get("proc") for j in jobs.values()]
    for p in procs:
        stop_proc(p, grace=5)


if __name__ == "__main__":
    main()
