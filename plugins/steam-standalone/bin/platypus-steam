#!/usr/bin/env python3
"""Platypus store plugin for Steam without the Steam client.

Speaks Platypus's plugin protocol (api 1, docs/plugins/protocol.md): JSON-RPC 2.0
over stdin/stdout, one object per line. Logins are done by platypus-steam-dl
(Go, next to this file), which logs into Steam with the user's own account
and Steam Guard over the CM (QR via BeginAuthSessionViaQR + Poll, password
via GetPasswordRSAPublicKey + BeginAuthSessionViaCredentials + Steam Guard
code or mobile confirmation); the plugin never stores the password — it
feeds it to one platypus-steam-dl auth run on stdin, and the refresh token
Steam issues afterwards stays in $PLATYPUS_PLUGIN_DATA (refresh.token 0600,
plus token.json/session.json). Downloads are done by the same binary,
which logs on to a CM with the stored refresh token and spreads chunk
fetches over many CDN hosts like the Steam client does.

Only what the logged-in account owns is installed, through Steam's own CDN,
with the account's own licence. No DRM or licence circumvention, and no Steam
API emulators: games that need the Steam client at runtime get the real
client, started hidden (`steam -silent`), and the game runs against it.
"""

import json
import os
import queue
import re
import shutil
import signal
import subprocess
import struct
import sys
import threading
import time
import urllib.parse
import urllib.request
import zlib

import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import steam_cm  # the CM session module, next to this file

API = 1
CODE_AUTH_REQUIRED = -32001

# The user's BCP 47 locale from initialize {locale} (protocol 1.14), kept
# current through locale.changed {locale}. Plugin UI text is returned
# already-localized for it (issue #39, phase 4): mode notes and a few
# user-facing errors via the small LOCALES dict below, falling back to
# English. Store lookups pass the Steam language (l=<steam_lang>).
LOCALE = "en"
LOCALE_LOCK = threading.Lock()

STEAM_LANG_MAP = {
    "en": "english", "fr": "french", "de": "german", "es": "spanish",
    "it": "italian", "ja": "japanese", "ko": "korean", "pt": "portuguese",
    "ru": "russian", "pl": "polish", "nl": "dutch", "da": "danish",
    "no": "norwegian", "nb": "norwegian", "sv": "swedish", "fi": "finnish",
    "cs": "czech", "hu": "hungarian", "tr": "turkish", "ar": "arabic",
    "th": "thai", "uk": "ukrainian", "el": "greek", "bg": "bulgarian",
    "ro": "romanian", "vi": "vietnamese", "zh": "schinese",
}

LOCALES = {
    "en": {
        "mode_none": "Launch mode: no Steamworks — runs directly, fully without Steam.",
        "mode_optional": "Launch mode: Steamworks present but optional — runs directly with SteamAppId set.",
        "mode_client": "Launch mode: needs the Steam client — Platypus starts the real client hidden.",
        "need_login": "log in to Steam first",
        "need_login_expired": "log in to Steam first (the session expired)",
        "not_installed": "app {app} is not installed",
        "settings_downloads": "Downloads",
        "settings_downloads_desc": "Where installs, updates and verify fetch their chunks from.",
        "settings_region": "Download region",
        "settings_region_desc": "Automatic uses the Steam client's own region when it has one, else Steam's geolocation.",
        "region_auto": "Automatic",
    },
    "fr": {
        "mode_none": "Mode de lancement : sans Steamworks — fonctionne directement, entièrement sans Steam.",
        "mode_optional": "Mode de lancement : Steamworks présent mais facultatif — fonctionne directement avec SteamAppId défini.",
        "mode_client": "Mode de lancement : nécessite le client Steam — Platypus démarre le vrai client en arrière-plan.",
        "need_login": "connectez-vous à Steam d'abord",
        "need_login_expired": "connectez-vous à Steam d'abord (la session a expiré)",
        "not_installed": "l'application {app} n'est pas installée",
        "settings_downloads": "Téléchargements",
        "settings_downloads_desc": "La provenance des morceaux des installations, mises à jour et vérifications.",
        "settings_region": "Région de téléchargement",
        "settings_region_desc": "Automatique utilise la région du client Steam s'il en a une, sinon la géolocalisation de Steam.",
        "region_auto": "Automatique",
    },
}


def set_locale(tag):
    global LOCALE
    tag = (tag or "").strip() or "en"
    with LOCALE_LOCK:
        LOCALE = tag


def locale_base():
    with LOCALE_LOCK:
        tag = LOCALE
    tag = (tag or "").strip().lower()
    if "-" in tag:
        tag = tag.split("-")[0]
    return tag or "en"


def tr(key, **fmt):
    base = locale_base()
    table = LOCALES.get(base, {})
    s = table.get(key) or LOCALES["en"].get(key) or key
    if fmt:
        try:
            s = s.format(**fmt)
        except (KeyError, IndexError):
            pass
    return s


def steam_lang():
    with LOCALE_LOCK:
        tag = (LOCALE or "").strip().lower()
    if tag in ("pt-br", "pt_br"):
        return "brazilian"
    if tag.startswith("es-") and tag != "es-es":
        return "latam"
    if tag in ("zh-cn", "zh-sg", "zh-my"):
        return "schinese"
    if tag in ("zh-tw", "zh-hk", "zh-mo"):
        return "tchinese"
    base = tag.split("-")[0] if "-" in tag else tag
    return STEAM_LANG_MAP.get(base or "en", "english")
# Access tokens are cached until shortly before their JWT exp; Steam re-issue
# is one CM round trip when this lapses mid-session.
ACCESS_TOKEN_MARGIN = 300

# Steam refresh tokens are JWTs. Note the header segment does NOT necessarily
# start with "eyJ": Steam's JWT JSON contains spaces ("alg": "EdDSA"), so the
# base64 header begins "eyAi…" — anchor on the dot-separated base64url shape
# instead, and validate by decoding. Used only to migrate the pre-Go login
# (DepotDownloader's account.config, a deflated protobuf); new logins land
# in refresh.token directly.
JWT_RE = re.compile(r"[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}")

out_lock = threading.Lock()
jobs_lock = threading.Lock()
jobs = {}  # jobId -> {"proc": Popen, "canceled": bool, ...}
token_lock = threading.RLock()
# Serializes read-modify-write of installed.json across handler/job threads.
installed_lock = threading.RLock()


class RPCError(Exception):
    def __init__(self, message, code=-32000):
        super().__init__(message)
        self.code = code


class WrongBranchPassword(RPCError):
    """Steam refused the tried beta password (helper code wrong-password).
    Carries the branch so the stored secret for it can be dropped."""
    def __init__(self, message, code=-32000, branch=""):
        super().__init__(message, code)
        self.branch = branch


def send(msg):
    msg["jsonrpc"] = "2.0"
    line = json.dumps(msg, separators=(",", ":"))
    with out_lock:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()


def notify(method, params):
    send({"jsonrpc": "2.0", "method": method, "params": params})


def log(level, message):
    notify("log", {"level": level, "message": message})


def data_dir():
    d = os.environ.get("PLATYPUS_PLUGIN_DATA")
    if not d:
        # Standalone runs have no core to make the folder private: create it
        # 0700 (and tighten a pre-fix 0755 one), so the state and tokens
        # inside are not readable by other local users (issue #181).
        d = os.path.join(os.path.expanduser("~"), ".platypus-steam-standalone")
        os.makedirs(d, mode=0o700, exist_ok=True)
        try:
            os.chmod(d, 0o700)
        except OSError:
            pass
        return d
    os.makedirs(d, exist_ok=True)
    return d


def tail(text, n=3):
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    return " · ".join(lines[-n:]) if lines else "no output"


# Logins run through platypus-steam-dl (Go, next to this file), never through
# argv-visible credentials: the password travels on the auth subcommand's
# stdin and is never logged. See "QR login" below.


# --- persisted state ------------------------------------------------------

def state_path(name):
    return os.path.join(data_dir(), name)


def load_state(name, default):
    try:
        with open(state_path(name)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_state(name, state):
    """Write via a temp file and rename, so a concurrent reader never sees a
    half-written file (load_state would return the default and a caller could
    then overwrite everything with it).

    The file is 0600 from creation (issue #181): the same writer persists
    token-bearing files (token.json, steam-access.json, family-names.json) and
    plain state (session.json, installed.json), and os.open keeps the mode
    independent of the umask. The rename replaces a pre-fix 0644 file, mode
    and all."""
    path = state_path(name)
    tmp = f"{path}.{os.getpid()}.{threading.get_ident()}.new"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(state, f)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def tighten(name):
    """chmod an existing state file to 0600; missing files are fine."""
    try:
        os.chmod(state_path(name), 0o600)
    except OSError:
        pass


# --- settings (protocol 1.8) ----------------------------------------------
#
# One choice today: the CDN region downloads ask Steam for servers in.
# ContentServerDirectory.GetServersForSteamPipe takes a cell id; Automatic
# leaves it to Steam (the client's CellIDServerOverride when there is one,
# else geolocation). The cell ids are the regions Steam's Content Server
# Directory Service answers for
# (tpill90.github.io/steam-lancache-prefill/steam-docs/CDN-Regions/).
REGIONS = [
    ("auto", "Automatic"),
    ("1", "Chicago"),
    ("4", "London"),
    ("5", "Frankfurt"),
    ("14", "Paris"),
    ("15", "Amsterdam"),
    ("25", "Sao Paulo"),
    ("31", "Seattle"),
    ("32", "Tokyo"),
    ("33", "Hong Kong"),
    ("35", "Singapore"),
    ("38", "Warsaw"),
    ("40", "Madrid"),
    ("50", "Atlanta"),
    ("52", "Sydney"),
    ("63", "Washington DC"),
    ("64", "Los Angeles"),
    ("65", "Dallas Fort-Worth"),
    ("66", "Stockholm"),
    ("92", "Vienna"),
]
REGION_IDS = set(rid for rid, _ in REGIONS)


def settings_values():
    """The applied settings, persisted in the plugin data folder. Core sends
    the whole set on every change and when the plugin starts, so the file is
    only what a standalone run (no core) falls back to."""
    values = load_state("settings.json", {})
    if not isinstance(values, dict):
        values = {}
    region = values.get("region")
    return {"region": region if region in REGION_IDS else "auto"}


def download_env():
    """The helper's environment: a chosen region rides PLATYPUS_STEAM_CELLID,
    which platypus-steam-dl reads before the Steam client's config. Automatic
    leaves it alone (an inherited override, or Steam's own choice)."""
    env = dict(os.environ)
    region = settings_values()["region"]
    if region != "auto":
        env["PLATYPUS_STEAM_CELLID"] = region
    return env


def settings_schema(_params):
    return {"groups": [{
        "id": "downloads",
        "label": tr("settings_downloads"),
        "description": tr("settings_downloads_desc"),
        "fields": [{
            "id": "region",
            "kind": "select",
            "label": tr("settings_region"),
            "description": tr("settings_region_desc"),
            "default": "auto",
            "options": [{"id": rid, "label": tr("region_auto") if rid == "auto" else label}
                        for rid, label in REGIONS],
        }],
    }]}


def settings_apply(params):
    values = (params or {}).get("values")
    if not isinstance(values, dict):
        raise RPCError("invalid params: values is required", -32602)
    region = values.get("region") or "auto"
    if region not in REGION_IDS:
        raise RPCError("invalid params: unknown download region", -32602)
    save_state("settings.json", {"region": region})
    return {}


def account_config():
    """DepotDownloader's persisted credentials file, if a login left one.

    .NET isolated storage has no fixed layout: the real DepotDownloader
    writes `…/.local/share/IsolatedStorage/<id>/<id>/<hash>/AssemFiles/
    account.config` (capital I), while older/dotnet-runtime variants used
    lowercase `isolated-storage` — so don't guess paths, just walk the
    whole plugin HOME looking for the file name."""
    home = os.path.join(data_dir(), "home")
    if not os.path.isdir(home):
        return None
    for dirpath, _dirs, files in os.walk(home):
        if "account.config" in files:
            return os.path.join(dirpath, "account.config")
    return None


def refresh_pairs(text):
    """(account name, refresh token) pairs from account.config's LoginTokens
    entries: a submessage carrying the account name right before the JWT.
    DD keys its stored tokens by account name (-username for later runs)."""
    out = []
    for token_match in JWT_RE.finditer(text):
        head = text[:token_match.start()]
        # The name is the last printable run before the token's field marks.
        m = re.search(r"[\x21-\x7e]{2,64}(?=[^\x20-\x7e]{0,4}$)", head)
        name = m.group(0) if m else ""
        # Length bytes are printable too (0x21..0x7e); a glued length shows
        # up as a stray leading char, and Steam account names are
        # word-shaped, so trim to the last word-ish chunk.
        tail_name = re.search(r"[A-Za-z0-9][A-Za-z0-9_ -]{1,63}$", name)
        name = tail_name.group(0) if tail_name else name
        out.append((name, token_match.group(0)))
    return out


def _source_matches(src, path, mtime):
    """Whether a persisted token source still tracks the current file.

    JSON turns the stored tuple into a list and may round-trip the mtime
    as int vs float, so normalize both before comparing."""
    try:
        if not isinstance(src, (list, tuple)) or len(src) != 2:
            return False
        if src[0] != path:
            return False
        if src[1] is None or mtime is None:
            return False
        return float(src[1]) == float(mtime)
    except (TypeError, ValueError):
        return False


def refresh_token():
    """The SteamClient refresh token the Go login persisted (refresh.token
    0600, plus token.json/session.json). The pre-Go login (DepotDownloader's
    account.config, a deflated protobuf) is migrated on first read so the
    current login keeps working without logging in again. Used for the CM
    token exchange, which feeds the Web API."""
    # New canonical store: raw JWT, never argv, never logged.
    try:
        with open(state_path("refresh.token")) as f:
            token = f.read().strip()
        if token:
            tighten("refresh.token")
            return token
    except OSError:
        pass
    # Legacy: extract from account.config once, then migrate forward.
    with token_lock:
        st = load_state("token.json", {})
        path = account_config()
        try:
            cur_mtime = os.path.getmtime(path) if path else None
        except OSError:
            cur_mtime = None
        if (st.get("refresh_token") and st.get("account") is not None
                and _source_matches(st.get("source"), path, cur_mtime)):
            migrate_token(st["refresh_token"], st.get("account") or "")
            return st["refresh_token"]
    if not path:
        # A Go login may have written token.json without refresh.token
        # (older shape); trust it and migrate.
        if st.get("refresh_token"):
            with token_lock:
                migrate_token(st["refresh_token"], st.get("account") or "")
            return st["refresh_token"]
        return None
    try:
        with open(path, "rb") as f:
            blob = f.read()
        try:
            blob = zlib.decompress(blob)
        except zlib.error:
            try:
                blob = zlib.decompress(blob, -15)  # .NET raw DeflateStream
            except zlib.error:
                pass  # newer builds may store it uncompressed
        text = blob.decode("utf-8", "ignore")
        matches = JWT_RE.findall(text)
        if not matches:
            return None
        token = matches[-1]  # the newest token
        account = st.get("account", "")
        for name, tok in reversed(refresh_pairs(text)):
            if tok == token and name:
                account = name
                break
        st["refresh_token"] = token
        st["account"] = account
        st["source"] = [path, os.path.getmtime(path)]
        with token_lock:
            save_state("token.json", st)
            migrate_token(token, account)
        return token
    except OSError:
        return None


def migrate_token(token, account):
    """Copy a legacy-extracted token into the Go login's files (0600).

    Keeps the account.config source stamp so the legacy fast path in
    refresh_token() still matches; overwriting it with the refresh.token
    path would make every later call re-walk home/ and re-extract."""
    with token_lock:
        try:
            with open(state_path("refresh.token"), "w") as f:
                f.write(token + "\n")
            os.chmod(state_path("refresh.token"), 0o600)
        except OSError:
            pass
        try:
            st = load_state("token.json", {})
            st["refresh_token"] = token
            if account:
                st["account"] = account
            # Do not touch st["source"]: it tracks account.config for the
            # legacy fast path. (An older version stored the refresh.token
            # path here, which never matched account_config() again.)
            save_state("token.json", st)
            if account and not state_user():
                save_state("session.json", {"account": account})
        except OSError:
            pass


# --- QR login ---------------------------------------------------------------
# platypus-steam-dl auth prints the login QR as block-art JSON events on
# stdout (one module = two U+2588 chars wide, "█" = dark module) and waits
# for the Steam mobile app to approve it. Steam periodically expires and
# refreshes the challenge URL, so the binary can emit a NEW qr event while
# running — the plugin keeps the latest art for auth.status, and the dialog
# redraws it. After approval the binary persists the refresh token itself
# (refresh.token 0600, token.json, session.json); we consider the login
# done on its result event.

# QR login background state: the platypus-steam-dl auth process, its latest
# art and its result. qr_start_lock serializes start_qr_login so a
# duplicate auth.begin (React StrictMode sends two back to back) reuses
# the live session instead of killing it; qr_proc["ready"] wakes waiters
# sharing one session.
qr_lock = threading.Lock()
qr_start_lock = threading.Lock()
qr_proc = {"proc": None, "rc": None, "ready": None}
qr_art = {"text": None}                      # latest block-art, for auth.status
qr_state = {"state": "idle", "error": None}  # idle|pending|ok|failed


def _reap(proc):
    """Wait out a helper so it never stays a zombie (<defunct>)."""
    if proc is None:
        return None
    try:
        return proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        try:
            proc.kill()
        except OSError:
            pass
        try:
            return proc.wait(timeout=10)
        except (subprocess.TimeoutExpired, OSError):
            return proc.poll()


def start_qr_login():
    """Starts `platypus-steam-dl auth` (QR mode) in the background, tracking
    its QR art. Returns (art text or None, error or None). A duplicate
    call while a session is pending reuses it and returns the current
    art — it never kills and restarts it."""
    with qr_start_lock:
        with qr_lock:
            cur = qr_proc.get("proc")
            if (qr_state["state"] == "pending" and cur is not None
                    and cur.poll() is None and qr_proc.get("ready") is not None):
                ready = qr_proc["ready"]
            else:
                ready = None
        if ready is not None:
            # Shared session: wait for its first art like the starter.
            if ready.wait(15):
                with qr_lock:
                    if qr_state["state"] == "failed":
                        return None, qr_state["error"]
                    if qr_art["text"]:
                        return qr_art["text"], None
            # Stale (no art in time, or failed without a message):
            # fall through and start a fresh session below.
        stop_qr_login()
        with qr_lock:
            qr_art["text"] = None
            qr_state.update(state="pending", error=None)
            ready = threading.Event()
            qr_proc["ready"] = ready
        try:
            proc = subprocess.Popen(
                [dl_bin(), "auth"], stdin=subprocess.PIPE,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1, env=dict(os.environ))
        except FileNotFoundError:
            with qr_lock:
                qr_state.update(state="failed",
                                error="platypus-steam-dl is missing; reinstall the plugin")
            return None, qr_state["error"]
        try:
            proc.stdin.write(json.dumps({"mode": "qr"}) + "\n")
            proc.stdin.flush()
        except (BrokenPipeError, OSError):
            pass
        with qr_lock:
            qr_proc["proc"] = proc

        def watch(mine=proc, ready=ready):
            def ours():
                return qr_proc.get("proc") is mine

            for line in mine.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(msg, dict):
                    continue
                t = msg.get("type")
                if t == "qr" and msg.get("qr_art"):
                    if ours():
                        with qr_lock:
                            qr_art["text"] = msg["qr_art"]
                        ready.set()
                elif t == "result":
                    rc = _reap(mine)
                    if ours():
                        with qr_lock:
                            qr_proc["rc"] = rc
                            qr_state.update(state="ok", error=None)
                            qr_proc["proc"] = None
                        ready.set()
                    try:
                        mine.stdin.close()
                    except (BrokenPipeError, OSError):
                        pass
                    return
                elif t == "error":
                    rc = _reap(mine)
                    if ours():
                        with qr_lock:
                            qr_proc["rc"] = rc
                            qr_state.update(state="failed", error=msg.get("message") or "login failed")
                            qr_proc["proc"] = None
                        ready.set()
                    return
                # code-needed/waiting never appear for QR; ignore anything else.
            # EOF without a result: the binary died. Reap it, and only
            # fail the shared state when this helper is still the owner —
            # a superseded helper must never touch it.
            rc = _reap(mine)
            if ours():
                with qr_lock:
                    qr_proc["rc"] = rc
                    if qr_state["state"] == "pending":
                        qr_state.update(state="failed",
                                        error="the login helper ended without logging in")
                        qr_proc["proc"] = None
                ready.set()

        threading.Thread(target=watch, daemon=True).start()
        # The first QR prints within a few seconds; wait for it here so auth.begin
        # can hand the dialog a complete prompt.
        if not ready.wait(15):
            with qr_lock:
                err = qr_state.get("error")
            if err:
                return None, err
            stop_qr_login()
            return None, "QR code didn't appear in time; try the password login below"
        with qr_lock:
            # The watcher sets ready on error too; surface it instead of art.
            if qr_state["state"] == "failed":
                return None, qr_state["error"]
            return qr_art["text"], None


def stop_qr_login():
    with qr_lock:
        proc = qr_proc.pop("proc", None)
        qr_proc["rc"] = None
        qr_state.update(state="idle", error=None)
        qr_art["text"] = None
        ready = qr_proc.pop("ready", None)
    # Wake anyone sharing the session so they re-check instead of
    # sleeping out the full wait.
    if ready is not None:
        ready.set()
    _reap(proc)


def logged_in():
    # session.json is written only after a login succeeded; the refresh
    # token may live in refresh.token (Go login) or, for the pre-Go login,
    # in account.config — don't couple the reported login to one file.
    if state_user():
        return True
    try:
        with open(state_path("refresh.token")) as f:
            if f.read().strip():
                return True
    except OSError:
        pass
    return account_config() is not None


def state_user():
    return load_state("session.json", {}).get("account") or ""


# --- Steam Web API --------------------------------------------------------

def api_get(url, token=None, timeout=60):
    # Test hook: tests point this at a file with the responses, so nothing
    # reaches the network. Not set in normal runs. The file may carry
    # "_routes": {substring: response} so different endpoints can answer
    # differently; without it the file answers every call (older tests).
    hook = os.environ.get("PLATYPUS_STEAM_API_FILE")
    if hook:
        with open(hook) as f:
            data = json.load(f)
        for frag, resp in (data.get("_routes") or {}).items():
            if frag in url:
                return resp
        return data
    # Access tokens go as the access_token query parameter (like the Steam
    # client does); a refresh token was never accepted there.
    if token:
        sep = "&" if "?" in url else "?"
        url = f"{url}{sep}access_token={token}"
    req = urllib.request.Request(url)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())


def api_post(url, params, token=None):
    """POST form params to the Steam Web API (state-changing calls like
    SetPreferredLender refuse GET). Same test hook as api_get: tests point
    it at a file whose `_routes` answer per endpoint, so nothing reaches
    the network. Raises on HTTP errors; the caller maps them."""
    hook = os.environ.get("PLATYPUS_STEAM_API_FILE")
    if hook:
        with open(hook) as f:
            data = json.load(f)
        # Test-only record of state-changing calls, so tests can assert the
        # request shape (endpoint + params) without touching Valve.
        try:
            with open(hook + ".posted", "a") as f:
                f.write(json.dumps({"url": url, "params": params}) + "\n")
        except OSError:
            pass
        for frag, resp in (data.get("_routes") or {}).items():
            if frag in url:
                return resp
        return data
    body = urllib.parse.urlencode(params).encode()
    if token:
        sep = "&" if "?" in url else "?"
        url = f"{url}{sep}access_token={token}"
    req = urllib.request.Request(url, data=body)
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read().decode())


STORE_TTL = 30 * 86400  # names and types of released apps rarely change
STORE_BUDGET = 20  # seconds of Store lookups per library.list; the rest waits for the next rescan
store_lock = threading.Lock()
store_cache = None  # app id -> {"name", "type", "at"}, mirrors store-apps.json
store_inflight = {}  # app id -> threading.Event for a fetch in progress


def store_cached(app_id):
    """The cached Store details for an app, {} when missing or stale."""
    global store_cache
    with store_lock:
        if store_cache is None:
            store_cache = load_state("store-apps.json", {})
        entry = store_cache.get(str(app_id)) or {}
    return entry if time.time() - entry.get("at", 0) < STORE_TTL else {}


def store_app(app_id, fetch=True):
    """Public app details (name, type) from the Steam Store API, cached on
    disk: a library scan asks about every owned game, one request each. No
    login needed; {} when the app isn't listed (bad id, region lock) or, with
    fetch=False, not cached yet. Misses aren't cached. Concurrent callers
    share one fetch per app (singleflight)."""
    entry = store_cached(app_id)
    if entry or not fetch:
        return entry
    key = str(app_id)
    with store_lock:
        # Recheck under the lock: another thread may have filled it.
        if store_cache is not None:
            entry = store_cache.get(key) or {}
            if time.time() - entry.get("at", 0) < STORE_TTL:
                return entry
        ev = store_inflight.get(key)
        if ev is None:
            ev = threading.Event()
            store_inflight[key] = ev
            owner = True
        else:
            owner = False
    if not owner:
        ev.wait(60)
        return store_cached(app_id)
    try:
        data = api_get(f"https://store.steampowered.com/api/appdetails?appids={app_id}&filters=basic")
    except Exception:
        with store_lock:
            store_inflight.pop(key, None)
            ev.set()
        return {}
    if isinstance(data, dict) and data.get("_test"):
        data = data["_test"]
    entry = (data or {}).get(str(app_id))
    if not entry or not entry.get("success"):
        with store_lock:
            store_inflight.pop(key, None)
            ev.set()
        return {}
    details = entry.get("data") or {}
    keep = {"name": details.get("name") or "", "type": details.get("type") or "", "at": time.time()}
    with store_lock:
        store_cache[str(app_id)] = keep
        store_inflight.pop(key, None)
        ev.set()
    return keep


def save_store_cache():
    with store_lock:
        if store_cache is not None:
            save_state("store-apps.json", store_cache)


def auth_status(_params=None):
    if logged_in():
        # The persona name when known, else the login's account name. The
        # login dialog closes on the first loggedIn status without calling
        # auth.complete (QR path), so resolve the persona here too.
        persona = load_state("session.json", {}).get("persona")
        if not persona:
            persona = status_persona()
        user = persona or state_user()
        out = {"loggedIn": True, "user": user} if user else {"loggedIn": True}
        return out
    out = {"loggedIn": False}
    with qr_lock:
        if qr_state["state"] == "pending" and qr_art["text"]:
            out["qr"] = qr_art["text"]  # the dialog redraws it when it changes
    return out


def auth_begin(_params):
    qr, err = start_qr_login()
    instructions = ("Scan the QR code with the Steam mobile app (Steam Guard → scan) "
                    "and just wait — the dialog closes by itself. The code refreshes "
                    "by itself when it expires. Or log in below; your password and "
                    "the Steam Guard code go to platypus-steam-dl only and are never "
                    "stored, and the login key Steam issues stays in this plugin's "
                    "private data folder.")
    if err and not qr:
        instructions = f"QR login unavailable: {err}\n\n{instructions}"
    return {
        "instructions": instructions,
        "qr": qr,
        "fields": [
            {"id": "username", "label": "Steam account name (empty = I scanned the QR)",
             "placeholder": "your Steam login, or empty for QR login"},
            {"id": "password", "label": "password", "secret": True},
            {"id": "guard", "label": "Steam Guard code — only if your account asks for one",
             "secret": True, "placeholder": "5 characters, or leave empty"},
        ],
    }


def run_auth_password(username, password, guard, timeout=300):
    """Password login across one or two dialog submits sharing a SINGLE
    auth session (one BeginAuthSessionViaCredentials, one CM socket).

    First submit carries no guard code yet: when Steam asks for an
    email/authenticator code, the session stays alive and the dialog
    error names the kind, so the second submit feeds the code into the
    SAME session via UpdateAuthSessionWithSteamGuardCode. Restarting the
    session instead would send a NEW email and invalidate the code the
    user just typed — a loop they can't win. A wrong/expired code fails
    fast; mobile confirmation just waits on the same session until the
    phone approves. The password travels on stdin (never argv, never
    logged) and the binary persists the refresh token itself."""
    deadline = time.time() + timeout
    import hashlib as _hashlib
    pw_hash = _hashlib.sha256(password.encode()).hexdigest()
    with pw_lock:
        sess = pw_sessions.get(username)
        if sess is None or not sess.alive():
            if sess is not None:
                pw_sessions.pop(username, None)
            sess = PWSession(username, password, guard)
            sess.pw_hash = pw_hash
            pw_sessions[username] = sess
            sent_code = False
        elif getattr(sess, "pw_hash", None) != pw_hash:
            # Corrected password on retry: the old session baked in the
            # first password, so stop it and start fresh instead of
            # failing against the wrong secret.
            try:
                sess.stop()
            except Exception:
                pass
            pw_sessions.pop(username, None)
            sess = PWSession(username, password, guard)
            sess.pw_hash = pw_hash
            pw_sessions[username] = sess
            sent_code = False
        else:
            # Resuming the code-waiting session from the first submit.
            sent_code = True
            if guard:
                sess.send_code(guard)
            elif sess.need is not None:
                raise RPCError(_need_code_message(sess.need))
    try:
        while time.time() < deadline:
            try:
                msg = sess.events.get(timeout=5)
            except queue.Empty:
                if not sess.alive():
                    break
                continue
            t = msg.get("type")
            if t == "code-needed":
                sess.need = msg
                if sent_code:
                    # A code was already tried on this session and Steam
                    # still asks: wrong or expired — fail fast on a dead
                    # session so the retry starts fresh with a new code.
                    sess.stop()
                    with pw_lock:
                        if pw_sessions.get(username) is sess:
                            pw_sessions.pop(username, None)
                    raise RPCError("Steam rejected the code: wrong Steam Guard code")
                # Keep the session (same Begin, same email) and ask the
                # dialog for the right kind of code.
                raise RPCError(_need_code_message(msg))
            elif t == "waiting":
                continue  # mobile confirmation: the poll continues server-side
            elif t == "result":
                with pw_lock:
                    if pw_sessions.get(username) is sess:
                        pw_sessions.pop(username, None)
                return None
            elif t == "error":
                with pw_lock:
                    if pw_sessions.get(username) is sess:
                        pw_sessions.pop(username, None)
                raise RPCError(msg.get("message") or "login failed")
        sess.stop()
        with pw_lock:
            if pw_sessions.get(username) is sess:
                pw_sessions.pop(username, None)
        raise RPCError("login timed out")
    except RPCError:
        raise


# Password-login sessions that survive across auth.complete calls: the
# first attempt (no guard code yet) keeps its BeginAuthSessionViaCredentials
# session — same client_id, same CM socket — while the dialog waits.
pw_lock = threading.Lock()
pw_sessions = {}  # account -> PWSession waiting for a code


class PWSession:
    """One live `platypus-steam-dl auth` password run, read by a single
    background thread into a queue. The password travels on stdin (never
    argv, never logged)."""

    def __init__(self, username, password, code=""):
        try:
            proc = subprocess.Popen(
                [dl_bin(), "auth"], stdin=subprocess.PIPE,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1, env=dict(os.environ))
        except FileNotFoundError:
            raise RPCError("platypus-steam-dl is missing; reinstall the plugin")
        self.proc, self.account = proc, username
        self.events = queue.Queue()
        self.ended = threading.Event()
        self.need = None  # the last code-needed event, while waiting
        req = {"mode": "password", "account": username, "password": password}
        if code:
            req["code"] = code
        try:
            proc.stdin.write(json.dumps(req) + "\n")
            proc.stdin.flush()
        except (BrokenPipeError, OSError):
            pass
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self):
        try:
            for line in self.proc.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if isinstance(msg, dict) and msg.get("type"):
                    self.events.put(msg)
                    if msg["type"] in ("result", "error"):
                        return
        finally:
            self.ended.set()
            _reap(self.proc)

    def send_code(self, code):
        try:
            self.proc.stdin.write(json.dumps({"code": code}) + "\n")
            self.proc.stdin.flush()
        except (BrokenPipeError, OSError):
            pass

    def alive(self):
        return self.proc.poll() is None and not self.ended.is_set()

    def stop(self):
        try:
            self.proc.kill()
        except OSError:
            pass
        _reap(self.proc)
        try:
            self.proc.stdin.close()
        except (BrokenPipeError, OSError):
            pass


def _need_code_message(msg):
    """Which kind of code the helper asks for, in dialog words."""
    guard = (msg.get("guard_type") or "").strip()
    detail = (msg.get("message") or "").strip()
    if guard == "device":
        want = "the code from your authenticator app"
    elif guard == "email":
        want = "the code Steam emailed you"
    else:
        want = "your Steam Guard code"
    if detail:
        return (f"Steam needs {want} ({detail}); enter it in the Steam Guard "
                f"field and submit again")
    return f"Steam needs {want}; enter it in the Steam Guard field and submit again"


def auth_complete(params):
    fields = ((params or {}).get("fields") or {})
    username = (fields.get("username") or "").strip()
    password = fields.get("password") or ""
    guard = (fields.get("guard") or "").strip()
    if not username and not password:
        # Empty form = "I scanned the QR code": wait for the background
        # platypus-steam-dl auth to be approved by the phone and finish.
        return wait_qr_login()
    if not username or not password:
        raise RPCError("enter your Steam account name and password")
    stop_qr_login()
    run_auth_password(username, password, guard)
    if not refresh_token():
        raise RPCError("login failed: the helper didn't persist a login key. "
                       "Check the account name and password, and try again with a fresh "
                       "Steam Guard code.")
    ensure_persona()
    # A new account takes over the process: one account's in-use list and
    # take-back memory must not leak into another's (issue #189).
    family_reset_account()
    return auth_status()


def ensure_persona():
    """Resolve and store the display (persona) name right after a login,
    so the first auth.status already shows it instead of the account
    name. Best effort: failures keep the account name (persona_name
    returns "" then), and a cached persona is never refetched."""
    try:
        if load_state("session.json", {}).get("persona"):
            return
        token = refresh_token()
        if not token:
            return
        steamid = steam_cm.jwt_payload(token).get("sub")
        if not steamid:
            return
        persona_name(steamid)
    except Exception:
        pass


# auth.status is polled; a failed persona lookup (offline, private profile)
# must not open a CM session on every poll.
PERSONA_RETRY = 60
persona_tried = {"at": 0.0}


def status_persona():
    if time.time() - persona_tried["at"] < PERSONA_RETRY:
        return ""
    persona_tried["at"] = time.time()
    ensure_persona()
    return load_state("session.json", {}).get("persona") or ""


def wait_qr_login(timeout=300):
    """Waits for the background platypus-steam-dl auth (QR) to be approved
    (the phone confirmed) and reports the result, like a password login."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        with qr_lock:
            state, err = qr_state["state"], qr_state["error"]
        if state == "ok":
            stop_qr_login()
            ensure_persona()
            family_reset_account()
            return auth_status()
        if state == "failed":
            stop_qr_login()
            raise RPCError("the QR login was rejected or failed: " + err)
        time.sleep(0.5)
    stop_qr_login()
    raise RPCError("nobody scanned the QR code in time; try again")


def auth_logout(_params):
    stop_qr_login()
    with pw_lock:
        sessions = list(pw_sessions.values())
        pw_sessions.clear()
    for sess in sessions:
        sess.stop()
    # Wipe the whole private data folder so no login key, guard data or
    # cached token survives.
    shutil.rmtree(data_dir(), ignore_errors=True)
    os.makedirs(data_dir(), exist_ok=True)
    persona_tried["at"] = 0.0
    # The login's in-use list and take-back memory die with it (issue #189).
    family_reset_account()
    return {"loggedIn": False}


# --- access token (CM exchange) ---------------------------------------------
#
# The refresh token the Go login persists is a SteamClient token: the Web
# API rejects it with 401, and GenerateAccessTokenForApp refuses it over
# plain REST (AccessDenied, since 2025-04-30). It only works from an
# authenticated CM session, so the plugin logs on to a CM itself
# (steam_cm.py) once per access-token lifetime and calls the Web API with
# the derived access token afterwards.

cm_lock = threading.Lock()


def jwt_exp(token):
    try:
        return int(steam_cm.jwt_payload(token).get("exp") or 0)
    except (ValueError, KeyError, IndexError):
        return 0


def access_token():
    """The access token for the Web API, from the cache while it lasts, else
    from a fresh CM logon with the persisted refresh token.

    CODE_AUTH_REQUIRED is raised only when there's no refresh token at all or
    Steam says it's invalid/expired/revoked — every other failure is a normal
    error that surfaces its real message, so the Library never shows "logged
    out" for a network hiccup."""
    st = load_state("steam-access.json", {})
    token = st.get("access_token") or ""
    if token and jwt_exp(token) - ACCESS_TOKEN_MARGIN > time.time():
        tighten("steam-access.json")
        return token
    refresh = refresh_token()
    if not refresh:
        raise RPCError("no Steam session available; log in again", CODE_AUTH_REQUIRED)
    with cm_lock:
        # Re-check inside the lock: a concurrent library.list may have
        # exchanged already.
        st = load_state("steam-access.json", {})
        token = st.get("access_token") or ""
        if token and jwt_exp(token) - ACCESS_TOKEN_MARGIN > time.time():
            tighten("steam-access.json")
            return token
        try:
            token = steam_cm.exchange(refresh)
        except steam_cm.CMError as e:
            if e.auth:
                raise RPCError(f"Steam rejected the stored login key ({e}); log in again",
                               CODE_AUTH_REQUIRED)
            raise RPCError(str(e))
        save_state("steam-access.json", {"access_token": token,
                                         "exp": jwt_exp(token)})
        return token


# Library calls run in threads; persona lookups must not repeat per call.
persona_lock = threading.Lock()


def persona_name(steamid):
    """The account's public persona name, for auth.status — from the CM
    session itself (Player.GetPlayerLinkDetails#1), since the Web API's
    GetPlayerSummaries now demands an API key. Saved in session.json; an
    empty result is a non-fatal miss (profiles can be private)."""
    with persona_lock:
        st = load_state("session.json", {})
        if st.get("persona"):
            return st["persona"]
    try:
        token = access_token()  # cached; opens one CM session if needed
        session = steam_cm.CMSession(int(steamid), refresh_token())
        try:
            # `repeated uint64 steamids = 1`: one plain varint per id, like
            # the family name lookup. A nested message here packs to bytes
            # Steam reads as [8, ...] and the reply order is not ours to
            # assume, so match the account by its steamid.
            body = session.call("Player.GetPlayerLinkDetails#1",
                                steam_cm.pb_int(1, int(steamid)))
        finally:
            session.logoff()
        name = ""
        want = int(steamid)
        for raw in steam_cm.pb_parse(body).get(1, []):
            try:
                pub = steam_cm.pb_parse(
                    steam_cm.pb_parse(raw).get(1, [b""])[0])
            except Exception:
                continue
            if pub.get(1, [0])[0] != want:
                continue
            name = pub.get(10, [b""])[0].decode("utf-8", "replace")  # persona_name
            break
    except Exception:
        return ""
    if name:
        with persona_lock:
            st = load_state("session.json", {})
            st["persona"] = name
            save_state("session.json", st)
    return name



def art_urls(app):
    """CDN art for an app id, without any Store lookup: the portrait, the
    wide hero and the landscape header. Older titles 404 on the portrait;
    the UI falls back to the header (cropped into the portrait card) and
    remembers the miss, so the 404 isn't requested on every render."""
    base = f"https://cdn.cloudflare.steamstatic.com/steam/apps/{app}"
    return {
        "coverUrl": f"{base}/library_600x900.jpg",
        "heroUrl": f"{base}/library_hero_2x.jpg",
        "bannerUrl": f"{base}/header.jpg",
    }


# --- hashed art assets (IStoreBrowseService/GetItems) ----------------------
# Newer apps (e.g. Aniimo 4126040) keep their art under hashed asset paths,
# so the fixed CDN names above all 404 for them. The keyless store-browse
# API names the real paths, many ids per request; the full URL is the CDN
# base + "/store_item_assets/" + asset_url_format with ${FILENAME} replaced.
ART_TTL = 7 * 86400  # resolved asset URLs are refreshed weekly
ART_BATCH = 200  # app ids per GetItems request (the API accepts this many)
ART_BUDGET = 15  # seconds of GetItems calls per library.list, separate from STORE_BUDGET
ART_CDN_BASE = "https://shared.steamstatic.com"
art_lock = threading.Lock()
art_cache = None  # app id -> {"cover","hero","banner","at"}, mirrors art-assets.json


def getitems_base():
    """The store-browse API base. Overridable via the environment so tests
    can point it at a fake endpoint; production is the keyless live API."""
    return os.environ.get("PLATYPUS_STEAM_GETITEMS_BASE") or "https://api.steampowered.com"


def save_art_cache():
    with art_lock:
        if art_cache is not None:
            save_state("art-assets.json", art_cache)


def parse_getitems(data):
    """Real art URLs out of a GetItems response: {appid: {coverUrl,
    heroUrl, bannerUrl}}. Reads only the string asset values, so numeric
    fields the API also carries (last_modified etc.) can never break the
    parse; apps without usable art are simply absent (caller keeps the
    fixed CDN fallback). Mapping, like internal/onlineart's GetItemAssets:
    cover library_capsule_2x else library_capsule, hero library_hero_2x
    else library_hero, banner header_2x else header."""
    out = {}
    try:
        items = (data.get("response") or {}).get("store_items") or []
    except AttributeError:
        return {}
    if not isinstance(items, list):
        return {}
    for item in items:
        if not isinstance(item, dict):
            continue
        appid = str(item.get("appid") or "")
        if not appid:
            continue
        assets = item.get("assets") or {}
        if not isinstance(assets, dict):
            continue
        strs = {k: v.strip() for k, v in assets.items()
                if isinstance(v, str) and v.strip()}
        fmt = strs.get("asset_url_format") or ""
        if "${FILENAME}" not in fmt:
            continue

        def pick(*keys):
            for k in keys:
                if strs.get(k):
                    return strs[k]
            return ""

        def resolve(name):
            if not name:
                return ""
            return ART_CDN_BASE + "/store_item_assets/" + fmt.replace("${FILENAME}", name)
        urls = {}
        cover = resolve(pick("library_capsule_2x", "library_capsule"))
        hero = resolve(pick("library_hero_2x", "library_hero"))
        banner = resolve(pick("header_2x", "header"))
        if cover:
            urls["coverUrl"] = cover
        if hero:
            urls["heroUrl"] = hero
        if banner:
            urls["bannerUrl"] = banner
        if urls:
            out[appid] = urls
    return out


def fetch_getitems_batch(ids):
    """One GetItems call for ids (numeric strings) -> parse_getitems's
    mapping. Keyless: no token is sent. May raise; the caller treats any
    failure as "keep the cache/fallback"."""
    payload = {"ids": [{"appid": int(a)} for a in ids],
               "context": {"language": "english", "country_code": "US"},
               "data_request": {"include_assets": True}}
    q = urllib.parse.urlencode({"input_json": json.dumps(payload, separators=(",", ":"))})
    return parse_getitems(api_get(getitems_base() + "/IStoreBrowseService/GetItems/v1/?" + q))


def resolve_art_assets(app_ids, deadline=None):
    """Hashed art URLs for app ids: fresh cache first, then batched
    GetItems for the rest (at most ART_BATCH ids per request), cached in
    art-assets.json with a fetched-at time and refreshed after ART_TTL.
    Stale cache entries stay usable when the request fails or the time
    budget (deadline, like STORE_BUDGET) is spent; unknown apps are
    absent so the caller keeps the fixed CDN fallback. Never raises."""
    global art_cache
    ids = []
    for a in app_ids:
        a = str(a or "")
        if a.isdigit() and a not in ids:
            ids.append(a)
    if not ids:
        return {}
    with art_lock:
        if art_cache is None:
            art_cache = load_state("art-assets.json", {})
        cached = art_cache
    now = time.time()
    out = {}
    need = []
    fetched = False
    for a in ids:
        entry = cached.get(a) or {}
        if entry and now - entry.get("at", 0) < ART_TTL:
            # Fresh: whatever was recorded (URLs, or a miss with none).
            urls = {}
            if entry.get("cover"):
                urls["coverUrl"] = entry["cover"]
            if entry.get("hero"):
                urls["heroUrl"] = entry["hero"]
            if entry.get("banner"):
                urls["bannerUrl"] = entry["banner"]
            if urls:
                out[a] = urls
        else:
            need.append(a)
    for i in range(0, len(need), ART_BATCH):
        if deadline is not None and time.time() >= deadline:
            break  # budget spent: the rest keep cache/fallback this listing
        batch = need[i:i + ART_BATCH]
        try:
            found = fetch_getitems_batch(batch)
        except Exception:
            break  # unreachable: keep cache/fallback, don't fail the listing
        fetched = True
        with art_lock:
            for a in batch:
                if a in found:
                    cached[a] = {"cover": found[a].get("coverUrl") or "",
                                 "hero": found[a].get("heroUrl") or "",
                                 "banner": found[a].get("bannerUrl") or "",
                                 "at": now}
                    out[a] = found[a]
                else:
                    # A recorded miss so the app isn't refetched every
                    # listing; stale URLs are kept (content-addressed art
                    # usually still serves) and stay usable below.
                    stale = cached.get(a) or {}
                    cached[a] = {"cover": stale.get("cover") or "",
                                 "hero": stale.get("hero") or "",
                                 "banner": stale.get("banner") or "",
                                 "at": now}
            art_cache = cached
    if fetched:
        save_art_cache()
    for a in need:  # stale cache covers failures and timeouts
        if a not in out:
            entry = cached.get(a) or {}
            urls = {}
            if entry.get("cover"):
                urls["coverUrl"] = entry["cover"]
            if entry.get("hero"):
                urls["heroUrl"] = entry["hero"]
            if entry.get("banner"):
                urls["bannerUrl"] = entry["banner"]
            if urls:
                out[a] = urls
    return out


def launch_hints(app, installed):
    """Protocol 1.15 library hints, from what the plugin already knows: a
    client-mode install needs Steam (and so a connection), any other install
    runs the game directly, and only an install record names its launch mode.
    Platypus owns this store's cloud saves, so the store never syncs them."""
    mode = (installed.get(app) or {}).get("mode") or ""
    hints = {"cloudSync": False}
    if mode == "client":
        hints["offline"] = "network"
    elif app in installed:
        hints["offline"] = "ok"
    return hints


def library_list(_params):
    data = owned_games()
    token = access_token()
    steamid = steam_cm.jwt_payload(token).get("sub")
    games = (data.get("response") or {}).get("games") or []
    persona_name(steamid)  # best effort, for auth.status
    installed = load_state("installed.json", {})
    out = []
    deadline = time.time() + STORE_BUDGET
    for g in games:
        app = str(g.get("appid") or "")
        if not app:
            continue
        store = store_app(app, fetch=time.time() < deadline)
        entry = {
            "id": app,
            "title": store.get("name") or g.get("name") or f"App {app}",
            "installed": app in installed,
            "installable": True,
        }
        if app in installed:
            ig = installed[app]
            entry["installPath"] = ig.get("path", "")
            entry["version"] = ig.get("version", "")
            if ig.get("native"):
                entry["native"] = True
            entry["note"] = mode_note(ig.get("mode") or "none")
            if ig.get("mode") == "client":
                entry["clientLaunch"] = True
        entry.update(launch_hints(app, installed))
        try:
            last = int(g.get("rtime_last_played") or 0)
        except (TypeError, ValueError):
            last = 0
        if last > 0:
            entry["lastPlayed"] = last
        # Art needs no Store lookup: always set it, so games past the Store
        # budget (or with no Store entry at all) still show covers.
        entry.update(art_urls(app))
        # Tools, movies, music etc. aren't depot installs Platypus can run.
        app_type = (store.get("type") or "").lower()
        if app_type and app_type not in ("game", "demo", "beta", "application"):
            entry["installable"] = False
            entry["note"] = f"This entry is a {app_type}, not a game."
        out.append(entry)
    save_store_cache()
    try:
        fam = family_snapshot(token, str(steamid))
    except Exception:
        # Supplementary: when the family calls fail, library.list still
        # returns the user's own games. The warning names no ids or tokens.
        log("warning", "Steam family lookup failed; listing owned games only")
        fam = None
    if fam:
        merge_family_games(out, fam, installed, deadline, str(steamid))
    for app, ig in installed.items():  # installed but missing from the owned list
        if not any(e["id"] == app for e in out):
            missing = {
                "id": app, "title": ig.get("title") or f"App {app}",
                "installable": False, "installed": True,
                "installPath": ig.get("path", ""),
                "native": True if ig.get("native") else False,
                "note": mode_note(ig.get("mode") or "none"),
            }
            if ig.get("mode") == "client":
                missing["clientLaunch"] = True
            missing.update(launch_hints(app, installed))
            missing.update(art_urls(app))
            out.append(missing)
    # Newer apps only have hashed asset paths: resolve the real cover/hero/
    # banner URLs for every listed app (owned and installed-missing alike)
    # within a budget of its own (Store lookups may have spent theirs on a
    # big first listing; one GetItems call covers 200 apps). Failures and timeouts
    # keep the fixed CDN fallback above, never fail the listing.
    try:
        overrides = resolve_art_assets([e["id"] for e in out], time.time() + ART_BUDGET)
    except Exception:
        overrides = {}
    for entry in out:
        if entry["id"] in overrides:
            entry.update(overrides[entry["id"]])
    # The friends list links a game the friend plays when it is in this
    # library (protocol 1.6); refreshed on every listing.
    LIBRARY_IDS.clear()
    LIBRARY_IDS.update(e["id"] for e in out)
    return {"games": out}


# --- family (protocol 1.8) -----------------------------------------------------
# Steam Families: the user's family group, the games members lend, which
# borrowed copies are in use, and the lender pick Steam stores server-side.
# Reads go through the FamilyGroups Web API (IFamilyGroupsService); member
# names come from the CM (Player.GetPlayerLinkDetails#1), one session for all
# misses, persisted in family-names.json; the in-use list comes from one
# platypus-steam-dl family-running run per fetch (NotifyRunningApps).
# No new round trips happen in game.details or other
# game-page calls: library.list makes the family lookup, launchSpec reuses
# the cached snapshot, and family.members reuses it too. The snapshot is
# supplementary: a slow or failed fetch serves the last good one, and only
# when no fetch ever succeeded does library.list return the user's own
# games (with a warning).
FAMILY_GROUP_URL = "https://api.steampowered.com/IFamilyGroupsService/"
FAMILY_TTL = 300  # seconds; one snapshot serves library.list + family.members
FAMILY_BUDGET = 8  # seconds for one family fetch; a slow fetch serves the last good snapshot
NAMES_NEGATIVE_TTL = 6 * 3600  # a member name that never resolved isn't re-asked for 6 h
family_lock = threading.Lock()
family_cache = None  # [steamid, fetched_at, snapshot], or None
family_last_good = {}  # steamid -> snapshot: served when a fetch fails or times out
family_worker = None  # [steamid, generation, thread, box]: the fetch in progress, shared by concurrent callers
family_generation = 0  # bumped by family_invalidate; an older fetch doesn't write
family_borrowed = {}  # steamid -> [merged_at, {appid}]: borrowed games library.list merged
names_lock = threading.Lock()
names_negative = {}  # steamid -> epoch of the attempt that resolved nothing

# EFamilyGroupRole (steammessages_familygroups.steamclient.proto): the only
# roles the protocol's member `role` knows are adult and child.
FAMILY_ROLES = {1: "adult", 2: "child"}

# ESharedLibraryExcludeReason: GetSharedLibraryApps reports one reason per
# app (exclude_reason, 0 = included); there is no per-copy DLC signal in
# it, so copies carry no dlc. The in-use signal isn't in it either: inUse
# comes from the helper's NotifyRunningApps read, False when unknown.
# Reasons without an entry here (5, 11-15, …) use the generic fallback.
FAMILY_EXCLUDE = {
    1: "The publisher doesn't allow family sharing",
    2: "This licence can't be shared",
    3: "Free to play",
    4: "The owner's copy is private",
    6: "Not a type Steam lends",
    7: "DLC excluded from sharing",
    8: "Not released yet",
    9: "The base game isn't shared",
    10: "The publisher doesn't allow family sharing",
}

# EProtoAppType (steammessages_appoverview.proto) is flags: Game = 1,
# Application = 2, Tool = 4, Demo = 8, Music = 8192, …; Invalid = 0.
# The field is omitted when 0, so a missing app_type means Invalid, not a
# game — but live data shows 1 for games, and the check stays lenient: a
# missing app_type still counts as a game. Demo and application install
# like the owned path's store types do; anything else is not a game
# Platypus runs.
FAMILY_GAME_TYPES = frozenset((1, 2, 8))


def family_is_game(app):
    atype = (app or {}).get("app_type")
    if atype is None:
        return True
    try:
        atype = int(atype)
    except (TypeError, ValueError):
        return False
    return atype in FAMILY_GAME_TYPES or bool(atype & 1)


def family_error(e, action="read the Steam family group"):
    """An RPCError for a failed family call: -32001 when Steam says the
    login is no good, else -32002 (the family can't be read right now). The
    message names no tokens or ids: Web API URLs carry the access token."""
    if isinstance(e, RPCError):
        return e
    code = getattr(e, "code", None)
    if code in (401, 403):
        return RPCError(tr("need_login_expired"), CODE_AUTH_REQUIRED)
    detail = f"HTTP {code}" if isinstance(code, int) else type(e).__name__
    return RPCError(f"couldn't {action} ({detail})", -32002)


def family_fetch_group(token, steamid):
    """The user's family group: id, name and raw members, or None when the
    user is in no group. Raises when the lookup itself fails."""
    data = api_get(FAMILY_GROUP_URL + "GetFamilyGroupForUser/v1/"
                   f"?steamid={steamid}&include_family_group_response=true", token)
    resp = data.get("response") or {}
    if resp.get("is_not_member_of_any_group"):
        return None
    group_id = resp.get("family_groupid") or 0
    if not group_id:
        return None
    group = resp.get("family_group") or {}
    members = group.get("members") or []
    if not members:
        # The group response wasn't included: read it directly.
        data = api_get(FAMILY_GROUP_URL + "GetFamilyGroup/v1/"
                       f"?family_groupid={group_id}", token)
        members = (data.get("response") or {}).get("members") or []
        group = data.get("response") or group
    return {"id": str(group_id), "name": group.get("name") or "",
            "members": members if isinstance(members, list) else []}


def family_fetch_apps(token, group_id):
    """Apps the family lends (include_own=false: the user's own games come
    from GetOwnedGames; include_excluded=true: withheld apps stay visible
    with their reason). Raises when the lookup fails."""
    data = api_get(FAMILY_GROUP_URL + "GetSharedLibraryApps/v1/"
                   f"?family_groupid={group_id}&include_own=false&include_excluded=true"
                   "&include_non_games=true&max_apps=5000&language=english",
                   token)
    apps = (data.get("response") or {}).get("apps") or []
    return apps if isinstance(apps, list) else []


def family_fetch_preferred(token, group_id):
    """{appid: lender_steamid} from GetPreferredLenders: the response is an
    inverted index (each member lists the apps they are someone's preferred
    lender for), so the member naming an app IS its lender. First listing
    wins when several members name the same app. Supplementary within
    supplementary: {} on any failure."""
    try:
        data = api_get(FAMILY_GROUP_URL + "GetPreferredLenders/v1/"
                       f"?family_groupid={group_id}", token)
    except Exception:
        return {}
    out = {}
    members = (data.get("response") or {}).get("members") or []
    for m in members:
        if not isinstance(m, dict):
            continue
        lender = str(m.get("steamid") or "")
        if not lender:
            continue
        for appid in m.get("preferred_appids") or []:
            out.setdefault(str(appid), lender)
    return out


_running_logged = set()  # running-read log lines already emitted once per process


def family_fetch_running(timeout=None, group_id=0):
    """Borrowed games played right now, over the CM: one platypus-steam-dl
    family-running run ([{appid, player, owner}], all strings). Returns
    (entries, read_at): read_at is the helper run's epoch, 0 when the
    helper never answered (no token, skipped, failure) — [] then, so a
    silent helper or CM never breaks the snapshot (copies stay inUse
    False). `timeout` bounds the run (the helper is killed at the
    deadline); `group_id` skips the helper's own group lookup when the
    caller knows it. The helper gets the refresh token (like dl_request);
    the Web API access token is never sent to a subprocess. The refresh
    token travels on stdin, never argv, and is never logged."""
    try:
        rt = refresh_token()
    except Exception:
        rt = ""
    if not rt:
        return [], 0
    req = {"refresh_token": rt}
    try:
        if int(group_id or 0):
            req["family_group_id"] = int(group_id)
    except (TypeError, ValueError):
        pass
    # The read's time is when the helper STARTED, not when it answered: a
    # background refresh must never overwrite a fresher NotifyRunningApps
    # push that lands while it is in flight (issue #189).
    start = time.time()
    try:
        result = dl_run("family-running", req, timeout=timeout,
                        label="Steam family running apps", err_code=-32002)
    except Exception:
        # Never surface helper stdout (player/owner steamids) in errors:
        # fixed text only, once per process.
        if "failed" not in _running_logged:
            _running_logged.add("failed")
            log("warning", "Steam running-apps read failed; borrowed copies list as free")
        return [], 0
    out = []
    for e in result.get("running") or []:
        if not isinstance(e, dict):
            continue
        appid = str(e.get("appid") or "")
        player = str(e.get("player") or "")
        owner = str(e.get("owner") or "")
        if appid and player and owner:
            out.append({"appid": appid, "player": player, "owner": owner})
    if not result.get("pushed", True) and "nopush" not in _running_logged:
        _running_logged.add("nopush")
        log("info", "Steam sent no running-apps push; borrowed copies list as free")
    return out, start


def family_in_use_message(player_name):
    """The user-facing text for a borrowed game in use (launchSpec -32002,
    protocol 1.8): the player by name, or a generic fallback when the CM
    stayed silent about names."""
    if player_name:
        return f"Family member {player_name} is playing this game"
    return "A family member is playing this game"


def family_member_names(ids, token, steamid, timeout=30):
    """Display names for member steamids: the persisted map first, one CM
    session for the misses (a single GetPlayerLinkDetails#1 with
    `repeated uint64 steamids = 1`, best effort). Unknown ids stay absent;
    the caller omits the name then. The CM session runs in a thread bounded
    by timeout, so a silent CM can't stall the fetch; ids an answered lookup
    left nameless aren't re-asked for NAMES_NEGATIVE_TTL."""
    want = []
    for i in ids:
        i = str(i or "")
        if i and i not in want:
            want.append(i)
    if not want:
        return {}
    with names_lock:
        known = load_state("family-names.json", {})
        now = time.time()
        missing = [i for i in want if not known.get(i)
                   and now - names_negative.get(i, 0) >= NAMES_NEGATIVE_TTL]
    if missing:
        box = {}
        t = threading.Thread(target=_family_names_lookup,
                             args=(missing, steamid, box), daemon=True)
        t.start()
        t.join(timeout)
        found = box.get("found") or {}
        if found or box.get("answered"):
            with names_lock:
                moment = time.time()
                for i in missing:
                    if not found.get(i):
                        names_negative[i] = moment
        if found:
            with names_lock:
                known = load_state("family-names.json", {})
                known.update(found)
                save_state("family-names.json", known)
    with names_lock:
        known = load_state("family-names.json", {})
    return {i: known[i] for i in want if known.get(i)}


def _family_names_lookup(ids, steamid, box):
    """One CM session resolving member names into box["found"]; box gets
    "answered" when the CM replied, even if some ids stayed nameless.
    Exceptions stay silent: names are supplementary."""
    try:
        rt = refresh_token()
        if not rt:
            return
        session = steam_cm.CMSession(int(steamid), rt)
        try:
            req = b"".join(steam_cm.pb_int(1, int(mid)) for mid in ids)
            body = session.call("Player.GetPlayerLinkDetails#1", req)
        finally:
            session.logoff()
    except Exception:
        return
    box["answered"] = True
    found = {}
    for raw in steam_cm.pb_parse(body).get(1, []):
        try:
            pub = steam_cm.pb_parse(
                steam_cm.pb_parse(raw).get(1, [b""])[0])
            sid = str(pub.get(1, [0])[0])
            name = pub.get(10, [b""])[0].decode("utf-8", "replace")
        except Exception:
            continue
        if sid in ids and name:
            found[sid] = name
    box["found"] = found


def _family_names_into(ids, token, steamid, timeout, box):
    """family_member_names into box["names"]; thread death is a fallback to
    {} (names are supplementary)."""
    box["names"] = family_member_names(ids, token, steamid, timeout=timeout)


def _family_running_into(group_id, timeout, box):
    """family_fetch_running into box["running"]/box["at"]; thread death is
    a fallback to ([], 0)."""
    running, at = family_fetch_running(timeout=timeout, group_id=group_id)
    box["running"] = running
    box["at"] = at


def _family_fetch(token, steamid, deadline):
    """The whole fetch — group, apps, preferred, names, running — for one
    worker thread. Raises on failure; the worker decides what the failure means."""
    group = family_fetch_group(token, steamid)
    if group is None:
        return {"group_id": "", "members": [], "apps": [], "preferred": {},
                "running": [], "running_at": 0}
    members = []
    for m in group["members"]:
        if not isinstance(m, dict):
            continue
        mid = str(m.get("steamid") or "")
        if not mid:
            continue
        entry = {"id": mid}
        role = FAMILY_ROLES.get(m.get("role"))
        if role:
            entry["role"] = role
        members.append(entry)
    apps = family_fetch_apps(token, group["id"])
    preferred = family_fetch_preferred(token, group["id"])
    # Names and the running read run side by side in threads; the fetch
    # waits only for the remaining budget, then falls back to running [].
    # The running read is skipped when the group lends nothing: there is
    # no copy to mark in use.
    name_box, run_box = {}, {}
    tn = threading.Thread(target=_family_names_into,
                          args=([m["id"] for m in members], token, steamid,
                                max(1.0, deadline - time.time() - 1.0), name_box),
                          daemon=True)
    tn.start()
    tr = None
    if apps:
        tr = threading.Thread(target=_family_running_into,
                              args=(group["id"], max(1.0, deadline - time.time() - 1.0),
                                    run_box),
                              daemon=True)
        tr.start()
    tn.join(max(1.0, deadline - time.time()))
    if tr is not None:
        tr.join(max(0.5, deadline - time.time()))
    names = name_box.get("names") or {}
    for m in members:
        if names.get(m["id"]):
            m["name"] = names[m["id"]]
    return {"group_id": group["id"], "members": members, "apps": apps,
            "preferred": preferred, "running": run_box.get("running") or [],
            "running_at": run_box.get("at") or 0}


def _family_fetch_worker(token, steamid, gen, box, deadline):
    """Run _family_fetch off the caller's thread; on timeout the caller serves
    the last good snapshot while this still writes the cache when it
    finishes. A fetch started under an older generation (a pick stored since)
    writes nothing."""
    try:
        snap = _family_fetch(token, steamid, deadline)
    except Exception as e:
        box["error"] = e
    else:
        box["snap"] = snap
    finally:
        box["done"] = True
        with family_lock:
            global family_cache, family_worker
            if gen == family_generation and "snap" in box:
                snap = box["snap"]
                # A NotifyRunningApps push that landed while this fetch was
                # in flight is fresher than the fetch's own read (stamped
                # when the helper started): keep the cache's running list.
                prev = (family_cache[2] if (family_cache and
                                            family_cache[0] == str(steamid))
                        else None)
                if (prev is not None and (prev.get("running_at") or 0) >
                        (snap.get("running_at") or 0)):
                    snap["running"] = prev.get("running") or []
                    snap["running_at"] = prev.get("running_at") or 0
                family_cache = [str(steamid), time.time(), snap]
                family_last_good[str(steamid)] = snap
                box["written"] = True
            if family_worker is not None and family_worker[3] is box:
                family_worker = None


def family_snapshot(token, steamid):
    """The family's members, shared apps and lender picks, cached FAMILY_TTL
    seconds and shared by library.list and family.members. The fetch runs in
    one worker thread joined after FAMILY_BUDGET seconds, so a silent Steam
    never stalls a listing; concurrent callers share the running worker
    (single-flight). On failure or timeout the last good snapshot for this
    user is served — a listing that succeeds without the shared games would
    make core prune the per-game settings of every uninstalled borrowed
    game — and only when no fetch ever succeeded does it raise, so the
    caller lists the owned games instead."""
    global family_worker
    steamid = str(steamid)
    with family_lock:
        if (family_cache and family_cache[0] == steamid
                and time.time() - family_cache[1] < FAMILY_TTL):
            return family_cache[2]
        w = family_worker
        if (w is not None and w[0] == steamid and w[1] == family_generation
                and not w[3].get("done")):
            t, box = w[2], w[3]
        else:
            box = {}
            deadline = time.time() + FAMILY_BUDGET
            t = threading.Thread(target=_family_fetch_worker,
                                 args=(token, steamid, family_generation,
                                       box, deadline), daemon=True)
            family_worker = [steamid, family_generation, t, box]
            t.start()
    t.join(FAMILY_BUDGET)
    with family_lock:
        if box.get("written"):
            return box["snap"]
        last = family_last_good.get(steamid)
        if last is not None:
            return last
    if box.get("done"):
        raise box.get("error") or RuntimeError("the Steam family lookup failed")
    raise TimeoutError("the Steam family lookup timed out")


def family_invalidate():
    """Drop the cached snapshot, so the next listing reads a stored pick.
    Bumps the generation: a fetch started before the pick doesn't write the
    cache. The last good snapshot stays: a failed refetch still lists the
    shared games."""
    global family_cache, family_generation
    with family_lock:
        family_cache = None
        family_generation += 1


def family_reset_account():
    """Drop all per-account family state: the cached and last-good
    snapshots, the borrowed set, and the take-back warning memory. Called
    on logout and when a new account logs in, so one account's in-use
    list or warnings never leak into another's. Bumps the generation: a
    fetch started before the switch doesn't write the cache."""
    global family_cache, family_generation, family_warned, family_borrow_seen
    with family_lock:
        family_cache = None
        family_generation += 1
        family_last_good.clear()
        family_borrowed.clear()
        family_warned.clear()
        family_borrow_seen.clear()


def family_snapshot_cached(steamid):
    """The cached snapshot (or last good) without fetching: for launchSpec,
    where in-use is advisory and a fetch would stall the launch. None when
    no fetch ever succeeded."""
    steamid = str(steamid)
    with family_lock:
        if (family_cache and family_cache[0] == steamid
                and time.time() - family_cache[1] < FAMILY_TTL):
            return family_cache[2]
        return family_last_good.get(steamid)


def family_borrowed_cached(steamid):
    """The borrowed games library.list last merged, without fetching: the
    set the launchSpec refusal reads instead of its own owned-games lookup.
    None when no listing merged one within FAMILY_TTL."""
    steamid = str(steamid)
    with family_lock:
        entry = family_borrowed.get(steamid)
    if not entry:
        return None
    if time.time() - entry[0] >= FAMILY_TTL:
        return None
    return entry[1]


def merge_family_games(out, fam, installed, deadline, steamid=""):
    """Fold the snapshot's shared apps into the library entries. Owned games
    carry no sharedBy (protocol 1.8): an app the user also owns stays a
    plain entry. A shared app with several owners carries copies (one per
    owner; the store reports one availability per app, so all copies share
    it) and the stored preferredCopy; an excluded app does too, so the
    withheld state shows instead of silently vanishing. A copy someone other
    than the user is playing carries inUse (copies appear for it even when
    it is the only one); in-use is carried here and in the launchSpec
    refusal, never in a listing warning (family.warning is the owner taking
    a borrowed game back). The user's own play is not marked in use."""
    names = {m["id"]: m.get("name") or "" for m in fam.get("members") or []}
    owned_ids = {e["id"] for e in out}
    preferred = fam.get("preferred") or {}
    borrowed = set()  # appids merged as borrowed: the launchSpec refusal's set
    # (appid, owner) copies someone other than the user is playing, with
    # the player behind each one. A member playing their own copy counts as
    # in use too; only the user's own play is left out (and out of the
    # refusal): they are the one playing, not blocked by it.
    playing = {}
    for r in fam.get("running") or []:
        if not isinstance(r, dict):
            continue
        if str(r.get("player") or "") in ("", steamid):
            continue
        appid, owner = str(r.get("appid") or ""), str(r.get("owner") or "")
        if appid and owner:
            playing.setdefault((appid, owner), str(r.get("player") or ""))
    for app in fam.get("apps") or []:
        if not isinstance(app, dict):
            continue
        appid = str(app.get("appid") or "")
        if not appid or appid in owned_ids:
            continue
        owners = []
        for o in app.get("owner_steamids") or []:
            o = str(o or "")
            if o and o not in owners:
                owners.append(o)
        if not owners:
            continue
        store = store_app(appid, fetch=time.time() < deadline)
        entry = {
            "id": appid,
            "title": app.get("name") or store.get("name") or f"App {appid}",
            "installed": appid in installed,
            "installable": True,
        }
        if appid in installed:
            ig = installed[appid]
            entry["installPath"] = ig.get("path", "")
            entry["version"] = ig.get("version", "")
            if ig.get("native"):
                entry["native"] = True
            entry["note"] = mode_note(ig.get("mode") or "none")
            if ig.get("mode") == "client":
                entry["clientLaunch"] = True
        entry.update(launch_hints(appid, installed))
        entry.update(art_urls(appid))
        app_type = (store.get("type") or "").lower()
        if app_type and app_type not in ("game", "demo", "beta", "application"):
            entry["installable"] = False
            entry["note"] = f"This entry is a {app_type}, not a game."
        elif not app_type and not family_is_game(app):
            entry["installable"] = False
            entry["note"] = "This entry is not a game."
        reason = app.get("exclude_reason", 0)
        try:
            reason = int(reason)
        except (TypeError, ValueError):
            reason = 0
        if reason != 0:
            # Withheld from sharing: core's install gate refuses these before
            # the downloader, so they list installable: False with the reason.
            entry["installable"] = False
            entry["note"] = FAMILY_EXCLUDE.get(
                reason, "Not available for family sharing")
        lender = preferred.get(appid) if preferred.get(appid) in owners else owners[0]
        shared = {"id": lender}
        if names.get(lender):
            shared["name"] = names[lender]
        entry["sharedBy"] = shared
        in_use = {o for o in owners if (appid, o) in playing}
        if len(owners) > 1 or reason != 0 or in_use:
            copies = []
            for o in owners:
                copy = {"ownerId": o, "available": reason == 0,
                        "inUse": o in in_use}
                if names.get(o):
                    copy["ownerName"] = names[o]
                if reason != 0:
                    copy["exclude"] = FAMILY_EXCLUDE.get(
                        reason, "Not available for family sharing")
                copies.append(copy)
            entry["copies"] = copies
            if preferred.get(appid) in owners:
                entry["preferredCopy"] = preferred[appid]
        borrowed.add(appid)
        out.append(entry)
    # The borrowed set serves the launchSpec refusal, so a launch never
    # starts its own fetch or owned-games lookup.
    with family_lock:
        family_borrowed[str(steamid)] = [time.time(), borrowed]


def family_members(_params):
    """The family group's members (protocol 1.8). Like the library, it needs
    a login; -32002 when the family can't be read right now."""
    if not logged_in():
        raise RPCError(tr("need_login"), CODE_AUTH_REQUIRED)
    token = access_token()
    steamid = steam_cm.jwt_payload(token).get("sub")
    try:
        snap = family_snapshot(token, str(steamid))
    except Exception as e:
        raise family_error(e)
    return snap["members"]


def family_set_preferred_copy(params):
    """The copy of a borrowed game the user picks (protocol 1.8, optional).
    Checked against the current listing: an unknown app or owner is -32602,
    a withheld copy is -32002. The pick is stored server-side through
    SetPreferredLender; the snapshot is dropped so the next library.list
    reads it back."""
    app = str((params or {}).get("id") or "")
    owner = str((params or {}).get("ownerId") or "")
    if not app or not owner:
        raise RPCError("invalid params: id and ownerId are required", -32602)
    if not logged_in():
        raise RPCError(tr("need_login"), CODE_AUTH_REQUIRED)
    token = access_token()
    steamid = str(steam_cm.jwt_payload(token).get("sub"))
    try:
        snap = family_snapshot(token, steamid)
    except Exception as e:
        raise family_error(e)
    if not snap.get("group_id"):
        raise RPCError("no Steam family group to pick a copy from", -32002)
    # Owned games carry no sharedBy and no picker (protocol 1.8): an app in
    # the user's own library is rejected even when a member also lends it.
    # One explicit user action, so one extra lookup outside game-page calls
    # is fine; when it fails, core's own library gate still refuses the pick.
    try:
        data = api_get("https://api.steampowered.com/IPlayerService/GetOwnedGames/v0001/"
                       f"?include_appinfo=0&include_played_free_games=0&steamid={steamid}", token)
        owned = {str(g.get("appid") or "")
                 for g in (data.get("response") or {}).get("games") or []}
    except Exception:
        owned = set()
    if app in owned:
        raise RPCError("this game is in your own library; there is no shared copy to pick", -32602)
    owners = []
    reason = 0
    for a in snap.get("apps") or []:
        if isinstance(a, dict) and str(a.get("appid") or "") == app:
            owners = [str(o or "") for o in a.get("owner_steamids") or []]
            reason = a.get("exclude_reason", 0)
            break
    if not owners or owner not in owners:
        raise RPCError("this game has no shared copy from that member", -32602)
    try:
        reason = int(reason)
    except (TypeError, ValueError):
        reason = 0
    if reason != 0:
        raise RPCError("that copy isn't available right now", -32002)
    try:
        api_post(FAMILY_GROUP_URL + "SetPreferredLender/v1/",
                 {"family_groupid": snap["group_id"], "appid": app,
                  "lender_steamid": owner}, token)
    except Exception as e:
        raise family_error(e, "save the family pick")
    family_invalidate()
    return {}


def mode_note(mode):
    """What the game page says about how the game launches, in the user's locale."""
    return {
        "none": tr("mode_none"),
        "optional": tr("mode_optional"),
        "client": tr("mode_client"),
    }.get(mode, "")


def dl_bin():
    """The Go downloader: bin/platypus-steam-dl next to this file (built by
    install.sh), falling back to PATH (tests put a built copy there)."""
    sibling = os.path.join(os.path.dirname(os.path.abspath(__file__)), "platypus-steam-dl")
    if os.path.isfile(sibling) and os.access(sibling, os.X_OK):
        return sibling
    found = shutil.which("platypus-steam-dl")
    if found:
        return found
    return sibling  # missing: the run surfaces it as an error


def beta_passwords():
    """Unlocked beta passwords by app and branch, from PLATYPUS_PLUGIN_DATA.
    Never logged, never returned: only sent back to platypus-steam-dl over
    stdin for the install it unlocks (see the protocol's Passwords rules)."""
    return load_state("beta_passwords.json", {})


def save_beta_password(app, channel, password):
    with installed_lock:
        pws = load_state("beta_passwords.json", {})
        app_pws = pws.get(app) or {}
        app_pws[channel] = password
        pws[app] = app_pws
        save_state("beta_passwords.json", pws)


def drop_beta_password(app, channel):
    """Forget the stored password Steam just refused, so the unlock form
    comes back instead of failing every later install behind a stale
    secret. Only call after Steam refused that password (a wrong-password
    error), never after a transport failure."""
    with installed_lock:
        pws = load_state("beta_passwords.json", {})
        app_pws = pws.get(app) or {}
        if channel in app_pws:
            del app_pws[channel]
            if app_pws:
                pws[app] = app_pws
            else:
                del pws[app]
            save_state("beta_passwords.json", pws)


def drop_refused_password(app, req, branch=""):
    """Drop the stored beta password when Steam refused the one this
    install tried: the explicit branch_password when set, else the stored
    one for the channel. An explicitly typed password that failed leaves
    the store alone, and so does a channel that sent nothing. The compare
    and the delete hold installed_lock together, so a concurrent unlock
    can't slip a new secret between them."""
    channel = branch
    if not channel:
        target = req.get("target") or {}
        if isinstance(target, dict) and target.get("channel"):
            channel = target["channel"]
        else:
            channel = req.get("branch") or ""
    if not channel or channel == "public":
        return
    sent = req.get("branch_passwords") or {}
    tried = req.get("branch_password") or sent.get(channel)
    if tried is None:
        return
    with installed_lock:
        pws = load_state("beta_passwords.json", {})
        if (pws.get(app) or {}).get(channel) == tried:
            app_pws = pws[app]
            del app_pws[channel]
            if app_pws:
                pws[app] = app_pws
            else:
                del pws[app]
            save_state("beta_passwords.json", pws)


def dl_request(params, extra=None):
    """The stdin request for platypus-steam-dl: ids plus the refresh token.
    The token travels on stdin, never argv, and is never logged."""
    token = refresh_token()
    if not token:
        raise RPCError(tr("need_login"), CODE_AUTH_REQUIRED)
    req = {"refresh_token": token, "app_id": int(params["id"]),
           "branch": params.get("branch") or "public"}
    # A password-protected beta branch. Stdin only, like the token: never
    # argv, never logged.
    pw = params.get("branchPassword") or params.get("branch_password")
    if pw:
        req["branch_password"] = pw
    # A version target (protocol 1.3): the channel, build, typed manifests
    # or install-history reference the downloader resolves against PICS.
    # Stored beta passwords ride along keyed by branch; the downloader uses
    # the resolved branch's. Never logged. A target naming its channel only
    # needs that channel's password.
    if params.get("target"):
        req["target"] = params["target"]
        stored = (beta_passwords().get(str(params["id"])) or {})
        channel = params["target"].get("channel") if isinstance(params["target"], dict) else ""
        if channel and channel in stored:
            req["branch_passwords"] = {channel: stored[channel]}
        elif stored and not channel:
            req["branch_passwords"] = dict(stored)
    # The user's download speed cap (protocol 1.21, issue #207), bytes per
    # second; the downloader turns it into its token bucket. Absent or 0 is
    # unlimited, so nothing is sent.
    if params.get("downloadLimit"):
        req["download_limit"] = int(params["downloadLimit"])
    if extra:
        req.update(extra)
    return req


def dl_run(subcommand, req, job_id=None, game_dir=None, label="download failed",
           err_code=-32000, phase="downloading", timeout=None):
    """Runs platypus-steam-dl and follows its JSON lines: progress
    notifications until a result or error line. Returns the result dict.
    `label` names the run in its error (`Steam app info: ...`): a download
    failing and an app info read failing aren't the same thing to the user.
    `err_code` is the error for a failed run; a login problem stays -32001
    and an unknown app stays -32000. `timeout` bounds the run in seconds:
    the helper is killed at the deadline and the run fails like any other
    failed run."""
    try:
        proc = subprocess.Popen([dl_bin(), subcommand], stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, bufsize=1, env=download_env())
    except FileNotFoundError:
        raise RPCError("platypus-steam-dl is missing; reinstall the plugin")
    if timeout is not None:
        # Bound the run: kill the helper at the deadline; the read loop
        # below then sees EOF and the run fails. Daemon, so an early exit
        # below never hangs on it; the kill itself is guarded.
        def _kill():
            try:
                if proc.poll() is None:
                    proc.kill()
            except OSError:
                pass
        timer = threading.Timer(timeout, _kill)
        timer.daemon = True
        timer.start()
    if job_id is not None:
        with jobs_lock:
            job = jobs.get(job_id) or {}
            job.update({"id": req.get("app_id"), "dir": game_dir, "proc": proc})
            jobs[job_id] = job
    try:
        proc.stdin.write(json.dumps(req) + "\n")
        proc.stdin.close()
    except (BrokenPipeError, OSError):
        pass
    state = {"jobId": job_id, "phase": phase, "percent": 0} if job_id else None
    import collections as _collections
    text = _collections.deque(maxlen=20)
    result = None
    for line in proc.stdout:
        line = line.rstrip()
        text.append(line)
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if not isinstance(msg, dict):
            continue
        if msg.get("type") == "progress" and state is not None:
            total = msg.get("total") or 0
            done = msg.get("bytes") or 0
            state["percent"] = (100.0 * done / total) if total else 0
            state["bytes"] = done
            state["total"] = total
            if msg.get("speed"):
                state["speed"] = msg["speed"]
            if msg.get("connections"):
                state["connections"] = msg["connections"]
            if msg.get("hosts"):
                state["hosts"] = msg["hosts"]
            notify("job.progress", dict(state))
        elif msg.get("type") == "result":
            result = msg
        elif msg.get("type") == "error":
            if msg.get("code") == "auth-required":
                raise RPCError(tr("need_login_expired"), CODE_AUTH_REQUIRED)
            if msg.get("code") == "not-found":
                raise RPCError(msg.get("message") or tail(line))
            if msg.get("code") == "wrong-password":
                raise WrongBranchPassword("{}: {}".format(label, msg.get("message") or tail(line)),
                                          err_code, msg.get("branch") or "")
            raise RPCError("{}: {}".format(label, msg.get("message") or tail(line)), err_code)
    rc = proc.wait()
    if result is None:
        raise RPCError("{}: {}".format(label, tail("\n".join(text))), err_code)
    if rc != 0:
        raise RPCError("{}: {}".format(label, tail("\n".join(text))), err_code)
    return result


def install_size(params):
    """Depot sizes from platypus-steam-dl: it resolves the app's depots over
    the CM and sums the manifests (Linux depots first, Windows fallback —
    the same order an install uses). A refused stored password is dropped
    here too: the core sizes before it installs."""
    try:
        req = dl_request(params)
        result = dl_run("size", req)
    except WrongBranchPassword as e:
        drop_refused_password(str(params["id"]), req, e.branch)
        raise RPCError(str(e), e.code)
    except RPCError:
        raise
    except Exception as e:
        raise RPCError("couldn't get the size for app {}: {}".format(params["id"], e))
    disk, compressed = int(result.get("disk_bytes") or 0), int(result.get("download_bytes") or 0)
    if disk == 0:
        raise RPCError("platypus-steam-dl produced no manifest sizes for app {}".format(params["id"]))
    return {"downloadBytes": compressed, "diskBytes": disk}


# --- versions (protocol 1.3) -------------------------------------------------
#
# Channels are the PICS branches (public first; password branches unlock
# through versions.unlock). Builds are each channel's current build plus the
# install history's entries. CM work happens here, on demand — never in
# game.details or other calls a game page makes — and a failed read errors
# instead of answering an empty list that could install the wrong build.

def versions_branches(app):
    """PICS branches for the app via platypus-steam-dl, or raise. Stored
    passwords ride along so branches PICS hides come back unlocked. Names
    the helper refused are dropped and come back as locked skeletons, so
    the unlock form and the no-public-fallback rule still see them."""
    req = dl_request({"id": app})
    stored = (beta_passwords().get(app) or {})
    if stored:
        req["branch_passwords"] = dict(stored)
    result = dl_run("versions", req,
                    label="Steam versions", err_code=-32002)
    branches = result.get("branches") or []
    for name in result.get("refused") or []:
        drop_beta_password(app, name)
        if not any(b.get("name") == name for b in branches):
            branches.append({"name": name, "build_id": "", "pwd_required": True, "manifests": {}})
    if not branches:
        raise RPCError("Steam returned no versions for app {}".format(app), -32002)
    return branches


def versions_list(params):
    app = str(params.get("id") or "")
    if not app:
        raise RPCError("invalid params: id is required", -32602)
    try:
        int(app)
    except ValueError:
        raise RPCError("invalid params: id is required", -32602)
    branches = versions_branches(app)
    unlocked = beta_passwords().get(app) or {}
    installed = load_state("installed.json", {}).get(app) or {}
    installed_channel = installed.get("channel") or ""
    installed_build = installed.get("build") or ""
    channels = []
    for b in branches:
        locked = bool(b.get("pwd_required")) and b.get("name") not in unlocked
        channels.append({
            "id": b.get("name"), "name": b.get("name"),
            "description": b.get("description") or "",
            "updatedAt": b.get("time_updated") or "",
            "buildId": str(b.get("build_id") or ""),
            "requires": "password" if b.get("pwd_required") else "none",
            "unlocked": not locked,
            "current": installed_channel == b.get("name"),
        })
    by_build = {}
    for b in branches:
        bid = str(b.get("build_id") or "")
        if bid and bid not in by_build:
            by_build[bid] = b
    builds = []
    for bid, b in by_build.items():
        locked = bool(b.get("pwd_required")) and b.get("name") not in unlocked
        builds.append({
            "id": bid, "name": "build " + bid,
            "publishedAt": b.get("time_updated") or "",
            "channel": b.get("name"), "source": "store",
            "available": not locked,
            "current": installed_build == bid,
        })
    for entry in params.get("ledger") or []:
        if not isinstance(entry, dict):
            continue
        bid = str(entry.get("build") or "")
        if not bid or bid in by_build:
            continue
        by_build[bid] = None
        name = entry.get("versionName") or ("build " + bid)
        published, _, _ = str(entry.get("date") or "").partition("T")
        builds.append({
            "id": bid, "name": name, "publishedAt": published,
            "source": "archive", "available": True,
            "current": installed_build == bid,
        })
    update_available = False
    if installed_build:
        # An unpinned game follows the channel it was installed from, so
        # "update" means that channel moved; public is only the fallback
        # when the recorded channel is gone.
        want = public_build_id(channels)
        if installed_channel:
            ch = find_branch(channels, installed_channel)
            if ch is not None:
                want = ch.get("buildId") or ""
        pinned = params.get("pinned") or {}
        if isinstance(pinned, dict):
            if pinned.get("kind") == "build" and pinned.get("id"):
                want = str(pinned["id"])
            elif pinned.get("kind") == "channel" and pinned.get("id"):
                ch = find_branch(channels, pinned["id"])
                if ch is not None:
                    want = ch.get("buildId") or ""
        # A channel whose tip has no build id (a hidden branch whose
        # section carried no metadata) can't be compared: report no
        # update rather than a permanent one.
        if not want and (not isinstance(pinned, dict) or pinned.get("kind") != "build"):
            want = installed_build
        update_available = installed_build != want
    return {
        "channels": channels, "builds": builds,
        "manual": {
            "label": "Steam manifest ids",
            "hint": ("One manifest id per depot, one per line, like:\n"
                     "11: 1122334455\n12: 6677889900\n"
                     "Find them on the game's Depots page (link below)."),
        },
        "links": [{"label": "Depots on SteamDB",
                   "url": "https://steamdb.info/app/{}/depots/".format(app)}],
        "updateAvailable": update_available,
    }


def find_branch(channels, channel_id):
    for c in channels:
        if c.get("id") == channel_id:
            return c
    return None


def public_build_id(channels):
    public = find_branch(channels, "public")
    if public:
        return public.get("buildId") or ""
    return channels[0].get("buildId") if channels else ""


def versions_unlock(params):
    app = str(params.get("id") or "")
    channel = str(params.get("channel") or "")
    password = params.get("password") or ""
    if not app or not channel or not password:
        raise RPCError("invalid params: id, channel and password are required", -32602)
    token = refresh_token()
    if not token:
        raise RPCError(tr("need_login"), CODE_AUTH_REQUIRED)
    try:
        app_id = int(app)
    except ValueError:
        raise RPCError("invalid params: id is required", -32602)
    # The password travels on stdin, like the token: never argv, never
    # logged, and never written anywhere but the unlock store below.
    result = dl_run("unlock",
                    {"refresh_token": token, "app_id": app_id,
                     "branch": channel, "branch_password": password},
                    label="Steam beta password", err_code=-32002)
    if not result.get("unlocked"):
        return {"unlocked": False}
    save_beta_password(app, channel, password)
    return {"unlocked": True}


# --- achievements and playtime (protocol 1.7) --------------------------------
#
# Achievements come from the CM session (ClientGetUserStats, EMsg 818/819),
# the only read path that needs no publisher key: ISteamUserStats demands
# one even with the user's access token. The reply carries the app's stats
# schema (binary KeyValues: names, descriptions, icons and hidden flags per
# language) plus the unlock times per stats group and bit. A game without
# achievements, or one the account doesn't own, answers eresult 2 with no
# schema: an empty list, like a store with no achievements. Global unlock
# percentages are keyless HTTP and best effort.
USERSTATS_REQ = 818
USERSTATS_RESP = 819


def parse_bin_kv(data):
    """Binary KeyValues (0=subkey, 1=string, 2=int32, 3=float, 7=uint64,
    8=end) to nested dicts; truncation and unknown types are ValueError."""
    pos, stack, cur = 0, [], {}
    get = data.__getitem__
    while True:
        if pos >= len(data):
            raise ValueError("truncated stats schema")
        try:
            kind = get(pos)
            pos += 1
            if kind == 8:
                if not stack:
                    return cur
                cur = stack.pop()
                continue
            end = data.index(b"\x00", pos)
            key = data[pos:end].decode("utf-8", "replace")
            pos = end + 1
            if kind == 0:
                child = {}
                cur[key] = child
                stack.append(cur)
                cur = child
            elif kind == 1:
                end = data.index(b"\x00", pos)
                cur[key] = data[pos:end].decode("utf-8", "replace")
                pos = end + 1
            elif kind == 2:
                cur[key] = struct.unpack_from("<I", data, pos)[0]
                pos += 4
            elif kind == 3:
                cur[key] = struct.unpack_from("<f", data, pos)[0]
                pos += 4
            elif kind == 7:
                cur[key] = struct.unpack_from("<Q", data, pos)[0]
                pos += 8
            else:
                raise ValueError(f"unknown stats value type {kind}")
        except struct.error:
            raise ValueError("truncated stats schema")


def steam_user_stats(app):
    """(schema node, unlock times) for the app over one CM session: the
    stats schema plus the unlock time per (group, bit). (None, {}) when
    Steam reports no stats for it. Transport problems raise CMError."""
    token = access_token()
    steamid = int(steam_cm.jwt_payload(token).get("sub"))
    session = steam_cm.CMSession(steamid, refresh_token())
    try:
        body = steam_cm.pb_fixed64(1, int(app)) + steam_cm.pb_fixed64(4, steamid)
        session.ws.send_binary(steam_cm.pack_emsg(
            USERSTATS_REQ, steam_cm.header(steamid=steamid, sessionid=session.sessionid), body))
        resp = None
        for emsg, _h, b in session._messages(deadline=time.time() + 20):
            if emsg == USERSTATS_RESP:
                resp = b
                break
            session._side_message(emsg)
        if resp is None:
            raise steam_cm.CMError("Steam didn't answer the stats request")
    finally:
        session.logoff()
    m = steam_cm.pb_parse(resp)
    if (m.get(2) or [2])[0] != 1:
        return None, {}
    schema = (m.get(4) or [b""])[0]
    try:
        node = parse_bin_kv(schema).get(str(int(app)), {}) if schema else {}
    except ValueError:
        raise RPCError("Steam sent a stats schema Platypus can't read")
    times = {}
    for blk in m.get(6) or []:
        bm = steam_cm.pb_parse(blk)
        gid = str((bm.get(1) or [0])[0])
        for bit, ts in enumerate(bm.get(2) or []):
            if ts:
                times[(gid, str(bit))] = ts
    return node, times




def schema_defs(app, node):
    """The app's achievement defs in schema order: (api, group, bit, name,
    description, hidden, icon). Unlock state comes from the times map, not
    the schema."""
    lang = steam_lang()
    defs = []
    stats = (node or {}).get("stats") or {}
    for gid in sorted(stats, key=lambda g: (int(g) if g.isdigit() else 1 << 60, g)):
        gval = stats[gid]
        if not isinstance(gval, dict) or (gval.get("type") or "").upper() != "ACHIEVEMENTS":
            continue
        bits = gval.get("bits")
        if not isinstance(bits, dict):
            continue
        for bit in sorted(bits, key=lambda b: (int(b) if b.isdigit() else 1 << 60, b)):
            bval = bits[bit]
            if not isinstance(bval, dict):
                continue
            api = bval.get("name") or ""
            if not api:
                continue
            disp = bval.get("display")
            if not isinstance(disp, dict):
                disp = {}
            names = disp.get("name")
            if not isinstance(names, dict):
                names = {}
            descs = disp.get("desc")
            if not isinstance(descs, dict):
                descs = {}
            # Real schemas mark hidden with ints, but strings appear in the
            # wild: only "", "0" and "false" count as shown.
            icon = disp.get("icon")
            defs.append({
                "api": api, "gid": gid, "bit": bit,
                "name": names.get(lang) or names.get("english") or api,
                "desc": descs.get(lang) or descs.get("english") or "",
                "hidden": str(disp.get("hidden", 0)).strip().lower() not in ("", "0", "false"),
                "icon": icon if isinstance(icon, str) else "",
            })
    return defs




def achievement_percents(app):
    """Global unlock percentages by achievement api name (keyless HTTP).
    Best effort: {} when Steam doesn't answer, never fails the list."""
    try:
        data = api_get("https://api.steampowered.com/ISteamUserStats/"
                       f"GetGlobalAchievementPercentagesForApp/v2/?gameid={app}")
    except Exception:
        return {}
    out = {}
    for a in ((data.get("achievementpercentages") or {}).get("achievements") or []):
        try:
            out[str(a.get("name"))] = float(a.get("percent"))
        except (TypeError, ValueError):
            pass
    return out


def achievements_list(params):
    # The schema comes from the reply of this call: no cache, so a game page
    # never shows another game's list and core's per-game features stay
    # untouched (core intersects them with the plugin's capabilities).
    app = str(params.get("id") or "")
    if not app:
        raise RPCError("invalid params: id is required", -32602)
    try:
        int(app)
    except ValueError:
        raise RPCError("invalid params: id is required", -32602)
    try:
        node, times = steam_user_stats(app)
    except steam_cm.CMError as e:
        raise RPCError(str(e))
    defs = schema_defs(app, node)
    percents = achievement_percents(app)
    out, unlocked = [], 0
    for d in defs:
        e = {"id": d["api"], "name": d["name"], "description": d["desc"], "hidden": d["hidden"]}
        icon = d["icon"]
        if icon and not icon.startswith("http"):
            # Bare schema filenames live under the community art path.
            icon = ("https://cdn.cloudflare.steamstatic.com/steamcommunity/public/images/apps/"
                    f"{app}/{icon}")
        if icon:
            e["icon"] = icon
        ts = times.get((d["gid"], d["bit"]))
        if ts:
            e["unlockedAt"] = ts
            unlocked += 1
        if d["api"] in percents:
            e["globalPercent"] = percents[d["api"]]
        out.append(e)
    return {"total": len(out), "unlocked": unlocked, "list": out}


def owned_games():
    """The owned-apps call library.list and playtime.list share: the login,
    the token and the steamid routing the Web API demands for token auth."""
    if not logged_in():
        raise RPCError(tr("need_login"), CODE_AUTH_REQUIRED)
    token = access_token()
    steamid = steam_cm.jwt_payload(token).get("sub")
    try:
        # steamid is a routing parameter: without it the Web API answers
        # 400 "missing required routing parameter" for token auth.
        return api_get("https://api.steampowered.com/IPlayerService/GetOwnedGames/v0001/"
                       f"?include_appinfo=1&include_played_free_games=1&steamid={steamid}", token)
    except Exception as e:
        raise RPCError(f"Steam Web API is unreachable: {e}")


def playtime_list(_params):
    data = owned_games()
    games = (data.get("response") or {}).get("games") or []
    out = []
    for g in games:
        app = str(g.get("appid") or "")
        if not app:
            continue
        try:
            minutes = max(0, int(g.get("playtime_forever") or 0))
        except (TypeError, ValueError):
            minutes = 0
        try:
            last = int(g.get("rtime_last_played") or 0)
        except (TypeError, ValueError):
            last = 0
        e = {"id": app, "minutes": minutes}
        if last:
            e["lastPlayed"] = last
        out.append(e)
    return {"games": out}


# --- verify (protocol 1.4) ---------------------------------------------------
#
# game.verify runs platypus-steam-dl's verify subcommand as a job, like
# install/update: a check (repair:false) only reads and reports, a repair
# re-downloads what differs. The request pins the installed build (the
# ledger's channel and manifest gids), so a game held on an old build or a
# beta is checked against what is on disk, not today's public branch.
def verify_version(app):
    installed = load_state("installed.json", {}).get(app) or {}
    channel = installed.get("channel") or ""
    if installed.get("archiveRef"):
        target = {"archiveRef": installed["archiveRef"]}
        if channel:
            target["channel"] = channel
        if installed.get("build"):
            target["build"] = installed["build"]
        # dl_request adds the stored password for the target's channel.
        return {"target": target}
    if channel:
        version = {"branch": channel}
        stored = (beta_passwords().get(app) or {})
        if channel in stored:
            version["branchPassword"] = stored[channel]
        return version
    return {}


def start_verify(params):
    app, job_id = str(params["id"]), params["jobId"]
    install_dir = params.get("installDir") or ""
    if not os.path.isabs(install_dir):
        raise RPCError("installDir is missing or relative; Platypus always sends one")
    installed = load_state("installed.json", {}).get(app)
    if installed is None:
        raise RPCError(tr("not_installed", app=app))
    repair = bool(params.get("repair"))
    if repair and not installed.get("archiveRef"):
        # Without the ledger's manifest pins a repair would restore the
        # wrong build's files; a check still reads what is there.
        raise RPCError("Update the game once to enable repair")
    # No job meta: a verify writes no staging a discard must clean, and the
    # game folder itself is never discarded.
    if not claim_job(job_id, {"canceled": False, "id": app, "dir": install_dir, "proc": None}):
        return {}
    threading.Thread(target=follow_verify, args=(job_id, app, install_dir, repair), daemon=True).start()
    return {}


def follow_verify(job_id, app, install_dir, repair=False):
    notify("job.progress", {"jobId": job_id, "phase": "checking"})
    with jobs_lock:
        jobs.setdefault(job_id, {"canceled": False, "id": app, "dir": install_dir})
    try:
        req = dl_request({"id": app, **verify_version(app)},
                         {"install_dir": install_dir, "job_id": job_id})
        req["repair"] = bool(repair)
        result = dl_run("verify", req, job_id, install_dir,
                        label="Steam verify", phase="checking")
    except RPCError as e:
        with jobs_lock:
            job = jobs.pop(job_id, {})
        if job.get("canceled"):
            return
        if e.code == CODE_AUTH_REQUIRED:
            notify("job.failed", {"jobId": job_id, "error": tr("need_login_expired")})
        else:
            notify("job.failed", {"jobId": job_id, "error": str(e)})
        return
    with jobs_lock:
        job = jobs.pop(job_id, {})
    if job.get("canceled"):
        return
    if not isinstance(result, dict) or not any(k in result for k in ("checked", "damaged", "missing", "repaired")):
        notify("job.failed", {"jobId": job_id, "error": "Steam verify returned a bad report"})
        return
    try:
        verify = {k: int(result.get(k) or 0) for k in ("checked", "damaged", "missing", "repaired")}
    except (TypeError, ValueError):
        notify("job.failed", {"jobId": job_id, "error": "Steam verify returned a bad report"})
        return
    notify("job.done", {"jobId": job_id, "verify": verify})


def game_relocated(params):
    """Platypus moved the game's folder itself (protocol 1.4, no
    capability): rebase the install record from `from` to `to`. -32602 when
    the record doesn't point at `from`."""
    app = str(params.get("id") or "")
    src, dst = params.get("from") or "", params.get("to") or ""
    if not app or not src or not dst:
        raise RPCError("invalid params: id, from and to are required", -32602)
    if not os.path.isabs(dst):
        raise RPCError("invalid params: to must be an absolute path", -32602)
    nsrc, ndst = os.path.normpath(src), os.path.normpath(dst)
    with installed_lock:
        installed = load_state("installed.json", {})
        entry = installed.get(app)
        if entry is None or os.path.normpath(entry.get("path") or "") != nsrc:
            raise RPCError(f"no install record at {src}", -32602)
        entry["path"] = dst
        entry["dir_name"] = os.path.basename(dst.rstrip("/")) or entry.get("dir_name")
        exe = os.path.normpath(entry.get("executable") or "")
        if exe == nsrc or exe.startswith(nsrc + os.sep):
            entry["executable"] = ndst + exe[len(nsrc):]
        installed[app] = entry
        save_state("installed.json", installed)
    return {}


# --- jobs ------------------------------------------------------------------

def start_job(params, kind):
    app, job_id = str(params["id"]), params["jobId"]
    if kind == "uninstall":
        if app not in load_state("installed.json", {}):
            raise RPCError(tr("not_installed", app=app))
        ev = threading.Event()
        if not claim_job(job_id, {"canceled": False, "id": app, "proc": None, "event": ev}):
            return {}
        threading.Thread(target=follow_uninstall, args=(job_id, app, ev), daemon=True).start()
        return {}
    install_dir = params.get("installDir") or ""
    if not os.path.isabs(install_dir):
        raise RPCError("installDir is missing or relative; Platypus always sends one")
    # One folder per game under Platypus's install dir, like steamapps/common/<name>.
    # An update runs on an existing install and Platypus names that game's own
    # folder for it (library.list's installPath), so joining again would nest
    # <game>/<game> on every update. Older cores send the parent folder instead:
    # keep the join for those.
    recorded = (load_state("installed.json", {}).get(app) or {}).get("path") or ""
    if kind != "install" and recorded and os.path.normpath(install_dir) == os.path.normpath(recorded):
        game_dir = install_dir
    else:
        game_dir = os.path.join(install_dir, game_dir_name(app))
    # Platypus resends a job with the same jobId after a crash: run it once. A
    # job that was just paused or canceled is still winding down: wait for it,
    # then start again from what it left on disk.
    if not claim_job(job_id, {"canceled": False, "id": app, "dir": game_dir, "proc": None}):
        return {}
    write_job_meta(job_id, {"app": app, "kind": kind, "dir": game_dir, "installDir": install_dir})
    os.makedirs(game_dir, exist_ok=True)
    dl_kind = "update" if kind == "update" else "install"
    version = {k: params[k] for k in ("branch", "branchPassword", "branch_password", "target") if params.get(k)}
    # The global download speed cap (protocol 1.21, issue #207): the core
    # sends it to plugins that speak 1.21. Absent means unlimited.
    if params.get("downloadLimit"):
        version["downloadLimit"] = int(params["downloadLimit"])
    if kind == "update" and "target" not in version and "branch" not in version:
        # An unpinned game stays on the channel it was installed from
        # (like the Steam client), never silently back to public. The
        # stored password unlocks it; without one the downloader refuses
        # with the locked-branch error.
        channel = (load_state("installed.json", {}).get(app) or {}).get("channel") or ""
        if channel:
            version["branch"] = channel
            stored = (beta_passwords().get(app) or {})
            if channel in stored and "branchPassword" not in version and "branch_password" not in version:
                version["branchPassword"] = stored[channel]
    threading.Thread(target=follow_install, args=(job_id, app, game_dir, dl_kind, version), daemon=True).start()
    return {}


def claim_job(job_id, entry, timeout=90):
    """Registers entry as the run of job_id and returns True. False when the
    job is already running (a repeated start). A job that job.cancel just
    stopped is still shutting down its downloader: wait for it to go, so a
    resume with the same jobId doesn't lose to the old run and report
    nothing."""
    deadline = time.monotonic() + timeout
    while True:
        with jobs_lock:
            job = jobs.get(job_id)
            if job is None:
                jobs[job_id] = entry
                return True
            if not job.get("canceled"):
                return False
        if time.monotonic() > deadline:
            raise RPCError("the previous run of this download is still stopping; try again in a moment")
        time.sleep(0.05)


def game_dir_name(app):
    installed = load_state("installed.json", {})
    if app in installed and installed[app].get("dir_name"):
        return installed[app]["dir_name"]
    name = store_app(app).get("name") or f"app_{app}"
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", name).strip("_") or f"app_{app}"
    # Suffix the app id: two store names can sanitize identically
    # ("A/B" and "A_B" both become "A_B"). Existing installs keep their
    # stored dir_name above.
    if not safe.endswith(f"_{app}"):
        safe = f"{safe}_{app}"
    return safe


def follow_install(job_id, app, game_dir, dl_kind="install", version=None):
    """platypus-steam-dl install/update with progress. The binary resolves the
    depots itself (Linux first, Windows fallback — the platform used
    decides `native`); downloads are resumable and verified."""
    with jobs_lock:
        jobs.setdefault(job_id, {"canceled": False, "id": app, "dir": game_dir})
    req = {}
    try:
        req = dl_request({"id": app, **(version or {})}, {"install_dir": game_dir, "job_id": job_id})
        result = dl_run(dl_kind, req, job_id, game_dir)
    except WrongBranchPassword as e:
        with jobs_lock:
            job = jobs.pop(job_id, {})
        if job.get("canceled"):
            return
        drop_refused_password(app, req, e.branch)
        notify("job.failed", {"jobId": job_id, "error": str(e)})
        return
    except RPCError as e:
        with jobs_lock:
            job = jobs.pop(job_id, {})
        if job.get("canceled"):
            return
        if e.code == CODE_AUTH_REQUIRED:
            notify("job.failed", {"jobId": job_id, "error": tr("need_login_expired")})
        else:
            notify("job.failed", {"jobId": job_id, "error": str(e)})
        return
    with jobs_lock:
        job = jobs.pop(job_id, {})
    if job.get("canceled"):
        return
    installed = record_install(app, game_dir, result.get("os_used") or "linux",
                               version_result(result))
    drop_job_meta(job_id)
    done = {"jobId": job_id}
    if installed:
        done["installed"] = installed
    notify("job.done", done)


def version_result(result):
    """The install ledger entry from an install/update result: the branch's
    build id and the manifest gid per depot that actually went on disk."""
    build = str(result.get("build") or "")
    if not build:
        return None
    manifests = result.get("manifests") or {}
    depots = {str(d): str(g) for d, g in manifests.items()}
    installed = {"build": build, "archiveRef": {"depots": depots}}
    if result.get("branch"):
        installed["channel"] = str(result["branch"])
    if result.get("version_name"):
        installed["versionName"] = str(result["version_name"])
    return installed


def record_install(app, game_dir, os_used, version=None):
    """Remember the install: where it is, what runs it and which launch mode
    applies (see launch modes below). `version` is the ledger entry (build,
    channel, archiveRef) for the versions capability."""
    exe = find_executable(game_dir, native=os_used == "linux")
    entry = {
        "path": game_dir,
        "dir_name": os.path.basename(game_dir),
        "executable": exe,
        "native": os_used == "linux",
        "mode": detect_mode(game_dir),
        "version": "",
        "title": store_app(app).get("name") or "",
    }
    if version:
        entry["channel"] = version.get("channel") or ""
        entry["build"] = version.get("build") or ""
        entry["versionName"] = version.get("versionName") or ""
        entry["archiveRef"] = version.get("archiveRef") or {}
    with installed_lock:
        installed = load_state("installed.json", {})
        installed[app] = entry
        save_state("installed.json", installed)
    return version


def is_elf(path):
    try:
        with open(path, "rb") as f:
            return f.read(4) == b"\x7fELF"
    except OSError:
        return False


EXE_SKIP_DIRS = ("redist", "directx", "dotnet", "__installer")
EXE_SKIP_SUFFIXES = ("_data",)


def _walk_limited(game_dir, max_depth=3):
    """(dirpath, depth, entries) up to max_depth, skipping redist/data dirs."""
    try:
        base = os.path.abspath(game_dir)
    except OSError:
        return
    stack = [(base, 0)]
    while stack:
        cur, depth = stack.pop(0)
        try:
            with os.scandir(cur) as it:
                entries = list(it)
        except OSError:
            continue
        yield cur, depth, entries
        if depth >= max_depth:
            continue
        for e in entries:
            try:
                is_dir = e.is_dir()
            except OSError:
                continue
            if not is_dir:
                continue
            low = e.name.lower()
            if low in EXE_SKIP_DIRS or low.endswith(EXE_SKIP_SUFFIXES):
                continue
            stack.append((e.path, depth + 1))


def find_executable(game_dir, native=False):
    """The game's entry point: a Linux binary/script (native builds), or the
    biggest .exe (Steam Windows builds ship many helper exes). Searches the
    install root and subdirs (bounded depth, redist/data dirs skipped).
    Depots don't always mark the Linux binary executable, so a pick that
    isn't gets its owner exec bit here."""
    if native:
        exe = find_native_executable(game_dir)
        if exe:
            return exe
    best, size, best_depth = "", 0, 99
    script = ""
    try:
        for _dir, depth, entries in _walk_limited(game_dir):
            for entry in entries:
                try:
                    if not entry.is_file():
                        continue
                except OSError:
                    continue
                name = entry.name
                lower = name.lower()
                if lower.endswith((".exe",)) and not lower.startswith(
                        ("uninst", "setup", "redist", "dxsetup", "vcredist", "dotnet")):
                    try:
                        s = entry.stat().st_size
                    except OSError:
                        continue
                    if s > size or (s == size and depth < best_depth):
                        best, size, best_depth = entry.path, s, depth
                elif lower.endswith(".sh") and not script:
                    try:
                        if os.access(entry.path, os.X_OK):
                            script = entry.path
                    except OSError:
                        pass
    except OSError:
        pass
    return best or script


def find_native_executable(game_dir):
    """The native entry point. Unity builds pair <name>.x86_64
    with a <name>_Data folder (other binaries next to it can be launchers or
    helpers, even bigger ones); otherwise a start script (.sh), else the
    biggest ELF binary (shared libraries and installers excluded).
    Searches the root and subdirs (bounded depth, *_Data/redist skipped)."""
    unity, script, elf, size = "", "", "", 0
    try:
        for _dir, _depth, entries in _walk_limited(game_dir):
            names = sorted(entries, key=lambda e: e.name)
            dirs = set()
            for e in names:
                try:
                    if e.is_dir():
                        dirs.add(e.name)
                except OSError:
                    pass
            for entry in names:
                try:
                    if not entry.is_file():
                        continue
                except OSError:
                    continue
                lower = entry.name.lower()
                stem, ext = os.path.splitext(entry.name)
                if ext.lower() in (".x86_64", ".x86") and stem + "_Data" in dirs and is_elf(entry.path):
                    unity = unity or entry.path
                elif lower.endswith(".sh") and not script:
                    script = script or entry.path
                elif not re.search(r"\.so(\.\d+)*$", lower) and not lower.startswith(("unins", "setup", "install")):
                    try:
                        s = entry.stat().st_size
                    except OSError:
                        continue
                    if s > size and is_elf(entry.path):
                        elf, size = entry.path, s
            if unity:
                break
    except OSError:
        return ""
    best = unity or script or elf
    if best and not os.access(best, os.X_OK):
        try:
            os.chmod(best, os.stat(best).st_mode | 0o100)
        except OSError:
            return ""
    return best


# --- launch modes ----------------------------------------------------------
#
# 1. "none"    No Steamworks dependency (no steam_api*.dll / libsteam_api.so
#              anywhere in the install): launch directly. Fully launcher-free.
# 2. "optional" Steamworks files exist, but most such games only use them for
#              achievements or overlay and run fine when SteamAPI_Init fails:
#              launch directly with SteamAppId/SteamGameId set so the game
#              doesn't try to relaunch itself through Steam.
# 3. "client"  The game needs the real client (fatal SteamAPI_Init failure or
#              Steam's DRM wrapper): Platypus starts the real Steam client
#              hidden (`steam -silent`) and asks it to start the game; the
#              game runs against the live client for its licence check and
#              achievements. No Steam API emulators, ever.
#
# 2 vs 3 can't be told apart reliably by inspection. The plugin tries direct
# first; if the game dies within seconds with a Steamworks init error
# (Platypus's session tracker reports it), retrying on the game page marks it
# "needs client" and mode 3 is used from then on. Community data plugins can
# pre-seed that flag.

STEAMWORKS_RE = re.compile(r"^(steam_api(64)?\.dll|libsteam_api\.so(\.\d+)*)$", re.IGNORECASE)


def has_steamworks(game_dir):
    try:
        for _root, _dirs, files in os.walk(game_dir):
            for f in files:
                if STEAMWORKS_RE.match(f):
                    return True
    except OSError:
        pass
    return False


def detect_mode(game_dir):
    if not has_steamworks(game_dir):
        return "none"
    return "optional"


def running_fresh_seconds():
    """How long a running read counts as current for the launch refusal:
    60 s, or PLATYPUS_STEAM_RUNNING_FRESH in tests."""
    try:
        return max(0, int(os.environ.get("PLATYPUS_STEAM_RUNNING_FRESH", "60")))
    except ValueError:
        return 60


def family_local_steamid():
    """The login's steamid without touching the network: the refresh
    token's sub, or the cached snapshot's user. "" when unknown."""
    try:
        rt = refresh_token()
        if rt:
            return str(steam_cm.jwt_payload(rt).get("sub") or "")
    except Exception:
        pass
    with family_lock:
        if family_cache:
            return str(family_cache[0] or "")
    return ""


def family_busy_owners(snap, app, steamid):
    """{owner: player} borrowed copies of app someone other than the user
    is playing, per the snapshot's running list."""
    busy = {}
    for r in snap.get("running") or []:
        if not isinstance(r, dict):
            continue
        if (str(r.get("appid") or "") != app
                or str(r.get("player") or "") in ("", steamid)
                or not str(r.get("owner") or "")):
            continue
        busy[str(r.get("owner") or "")] = str(r.get("player") or "")
    return busy


family_warned = set()  # (appid, owner) a take-back warning already went out for
family_borrow_seen = set()  # (appid, owner) the user was seen playing: the warning's memory


def family_takeback_message(owner_name):
    """The user-facing text for an owner taking a borrowed game back
    (protocol 1.8): the owner by name, like the launchSpec refusal, or a
    generic fallback when the CM stayed silent about names."""
    if owner_name:
        return f"Family member {owner_name} is taking this game back"
    return "The owner started playing this game and is taking it back"


def family_owner_name(owner, steamid):
    """A member's display name from the cached snapshot or the persisted
    names, without any fetch: the event path never does its own lookup."""
    if steamid:
        snap = family_snapshot_cached(steamid)
        if snap:
            for m in snap.get("members") or []:
                if isinstance(m, dict) and str(m.get("id") or "") == owner and m.get("name"):
                    return m["name"]
    try:
        known = load_state("family-names.json", {})
    except Exception:
        known = {}
    if isinstance(known, dict):
        return known.get(owner) or ""
    return ""


def family_running_event(params):
    """One familyRunning push from the social session: the full running
    list, replacing the last. Refreshes the cached in-use list (with a
    timestamp, so launch decisions read fresher data) and warns once per
    take-back: the user is playing a borrowed copy (an entry with
    player == user and owner != user) and the owner of that copy starts
    the same app (an entry with player == owner), or the user's entry
    disappears while the owner's appears. The warning carries no
    secondsLeft: Steam gives no deadline in these messages. Events only
    arrive while the social session runs; with social off there is no
    warning."""
    global family_warned, family_borrow_seen
    entries = []
    for e in (params or {}).get("running") or []:
        if not isinstance(e, dict):
            continue
        appid, player, owner = (str(e.get("appid") or ""), str(e.get("player") or ""),
                                str(e.get("owner") or ""))
        if appid and player and owner:
            entries.append({"appid": appid, "player": player, "owner": owner})
    steamid = family_local_steamid()
    now = time.time()
    with family_lock:
        if steamid:
            if family_cache and family_cache[0] == steamid:
                family_cache[2]["running"] = entries
                family_cache[2]["running_at"] = now
            last = family_last_good.get(steamid)
            if last is not None and (not family_cache or family_cache[2] is not last):
                last["running"] = entries
                last["running_at"] = now
        if not steamid:
            return
        borrowing = {(e["appid"], e["owner"]) for e in entries
                     if e["player"] == steamid and e["owner"] != steamid}
        owners = {(e["appid"], e["owner"]) for e in entries
                  if e["player"] == e["owner"] and e["player"] != steamid}
        family_borrow_seen |= borrowing
        family_borrow_seen &= borrowing | owners
        for key in [k for k in family_warned if k not in owners]:
            family_warned.discard(key)
        # A first push that already shows both the borrowing and the
        # owner's play warns: the user is being kicked either way.
        takebacks = [k for k in owners if k in family_borrow_seen and k not in family_warned]
        family_warned.update(takebacks)
    for appid, owner in sorted(takebacks):
        notify("family.warning", {"id": appid,
                                  "message": family_takeback_message(
                                      family_owner_name(owner, steamid))})


def family_launch_refusal(app):
    """-32002 message when every copy of a borrowed game is in use
    (protocol 1.8): each owner's copy played by someone other than the user.
    A free copy launches: the store picks around the busy one. Reads only
    the cached snapshot and the borrowed set library.list merged — never a
    fetch or an owned-games lookup — plus at most one bounded running read.
    A stale snapshot (running data older than a minute) refuses only after
    one fresh bounded read (≤ 3 s) still shows every copy busy; on any
    failure the launch goes. None when the game isn't borrowed, a copy is
    free, or nothing cached: in-use is advisory, and a silent store must
    not break the launch."""
    if not logged_in():
        return None
    steamid = family_local_steamid()
    if not steamid:
        return None
    snap = family_snapshot_cached(steamid)
    borrowed = family_borrowed_cached(steamid)
    if not snap or not borrowed or app not in borrowed:
        return None
    owners = []
    for a in snap.get("apps") or []:
        if isinstance(a, dict) and str(a.get("appid") or "") == app:
            owners = [str(o or "") for o in a.get("owner_steamids") or []]
            owners = [o for o in owners if o]
            break
    if not owners:
        return None
    names = {m.get("id"): m.get("name") or ""
             for m in snap.get("members") or [] if isinstance(m, dict)}
    preferred = snap.get("preferred") or {}
    lender = preferred.get(app) if preferred.get(app) in owners else owners[0]
    busy = family_busy_owners(snap, app, steamid)
    if not busy or any(o not in busy for o in owners):
        return None
    if time.time() - (snap.get("running_at") or 0) < running_fresh_seconds():
        return family_in_use_message(names.get(busy.get(lender)))
    # Stale running data: one bounded re-read decides; the helper is killed
    # at the deadline and any failure lets the launch go.
    running, _ = family_fetch_running(timeout=3, group_id=snap.get("group_id"))
    fresh = {}
    for r in running:
        if r.get("player") not in ("", steamid) and r.get("owner"):
            fresh[r["owner"]] = r["player"]
    if owners and all(o in fresh for o in owners):
        return family_in_use_message(names.get(fresh.get(lender)))
    return None


def launch_spec(params):
    app = str(params["id"])
    installed = load_state("installed.json", {})
    ig = installed.get(app)
    if not ig:
        raise RPCError(tr("not_installed", app=app))
    path, exe = ig.get("path") or "", ig.get("executable") or ""
    if not exe or not os.path.isfile(exe):
        exe = find_executable(path, native=bool(ig.get("native")))
        if not exe:
            raise RPCError(f"couldn't find a game executable in {path or 'the install folder'}")
        with installed_lock:  # re-read: only this field changes
            fresh = load_state("installed.json", {})
            if app in fresh:
                fresh[app]["executable"] = exe
                save_state("installed.json", fresh)
        ig["executable"] = exe
    mode = ig.get("mode") or "none"
    refusal = family_launch_refusal(app)
    if refusal:
        raise RPCError(refusal, -32002)
    native = bool(ig.get("native"))
    if mode in ("none", "optional"):
        spec = {
            "exe": exe,
            "args": [],
            "cwd": os.path.dirname(exe),
            "env": {},
            "needsWine": not native,
        }
        if mode == "optional":
            # Tell the game which app it is so SteamAPI_Init-less runs don't
            # try to relaunch through Steam. SteamAppId/SteamGameId are not
            # on Platypus's launch-env denylist (only STEAM_COMPAT_* are).
            spec["env"]["SteamAppId"] = app
            spec["env"]["SteamGameId"] = app
        return spec
    # mode == "client": the real client, started hidden. Platypus runs the
    # command and follows the game through find.cmdline (Steam's reaper marks
    # the game process with AppId=<id>), so session tracking works.
    return {
        "delegate": "store-client",
        "client": "Steam",
        "command": ["steam", "-silent", "-applaunch", app],
        "find": {"cmdline": [f"AppId={app}"]},
        "startTimeout": 300,
    }


def _languages(raw):
    """Supported languages HTML ("English<strong>*</strong>, French, ...") to plain names."""
    if not raw:
        return []
    text = re.sub(r"<br\s*/?>", ",", raw, flags=re.I)
    text = re.sub(r"<[^>]+>", " ", text)
    out = []
    for part in text.replace("*", " ").split(","):
        name = " ".join(part.split())
        if name and name not in out and len(out) < 100 and len(name) <= 60:
            out.append(name)
    return out


def _requirement_side(v):
    if not isinstance(v, dict):
        return "", ""
    lo, hi = "", ""
    if isinstance(v.get("minimum"), str) and v["minimum"]:
        lo = v["minimum"][:50000]
    if isinstance(v.get("recommended"), str) and v["recommended"]:
        hi = v["recommended"][:50000]
    return lo, hi


def _platforms(raw):
    """The store's platform flags as the protocol's names (protocol 1.10,
    "Compat"). PICS app info carries the same OS list as common/oslist; the
    store's app details already answer it, so game.details stays public."""
    if not isinstance(raw, dict):
        return []
    return [name for key, name in
            (("windows", "windows"), ("mac", "macos"), ("linux", "linux"))
            if raw.get(key)]


def _movie_url(movie):
    """Prefer mp4 480/max or webm; HLS-only entries are skipped."""
    for key in ("mp4", "webm"):
        clips = movie.get(key) or {}
        if not isinstance(clips, dict):
            continue
        for quality in ("480", "max"):
            if clips.get(quality):
                return clips[quality], "video/mp4" if key == "mp4" else "video/webm"
        for u in clips.values():
            if u:
                return u, "video/mp4" if key == "mp4" else "video/webm"
    return "", ""


def game_terms(app):
    """The EULAs Steam lists for an app, from PICS app info (protocol 1.11,
    docs/plugins/protocol.md "Terms"). Steam keeps the acceptance itself, so
    the plugin has no game.acceptTerms: it only lists. Read it only when
    Platypus asked for terms, and fail when it can't: an empty list would
    read as "no terms to accept" and let the install through."""
    if not refresh_token():
        raise RPCError(tr("need_login"), CODE_AUTH_REQUIRED)
    try:
        result = dl_run("terms", dl_request({"id": app}), label="Steam app info")
    except RPCError as e:
        if e.code == CODE_AUTH_REQUIRED:
            # The session expired, or the token was refused: the install
            # asks for the login rather than installing without the EULA.
            raise
        raise RPCError(f"couldn't read the terms: {e}", e.code)
    terms = []
    for t in result.get("terms") or []:
        # Platypus keys acceptance on id and version; skip anything else, the
        # way the protocol drops terms it can't key on.
        if not isinstance(t, dict) or not t.get("id") or not t.get("version"):
            continue
        terms.append({k: t[k] for k in ("id", "title", "url", "version") if t.get(k)})
    return terms


NEWS_TTL = 6 * 3600  # seconds; a game's announcements change slowly
NEWS_TIMEOUT = 5  # seconds; the game page never waits on news
NEWS_COUNT = 5


def news_for_app(app):
    """The app's Steam announcements (protocol 1.19, "News"), from the
    keyless ISteamNews Web API: no login, no token, nothing about the
    account. Cached in news.json; an unreachable or slow API serves what was
    cached (or nothing) and never fails the game details."""
    cache = load_state("news.json", {})
    entry = cache.get(app) or {}
    cached = [i for i in (entry.get("items") or []) if isinstance(i, dict)][:NEWS_COUNT]
    now = time.time()
    if now - entry.get("at", 0) < NEWS_TTL:
        return cached
    try:
        data = api_get("https://api.steampowered.com/ISteamNews/GetNewsForApp/v2/"
                       f"?appid={app}&count={NEWS_COUNT}&maxlength=0",
                       timeout=NEWS_TIMEOUT)
    except Exception:
        return cached
    items = []
    for n in ((data.get("appnews") or {}).get("newsitems") or [])[:NEWS_COUNT]:
        if not isinstance(n, dict):
            continue
        title = (n.get("title") or "").strip()
        url = n.get("url") or ""
        if not title or not url.startswith("https://"):
            continue
        try:
            date = int(n.get("date") or 0)
        except (TypeError, ValueError):
            date = 0
        item = {"title": title[:200], "url": url}
        if date > 0:
            item["date"] = date
        items.append(item)
    cache[app] = {"at": now, "items": items}
    save_state("news.json", cache)
    return items


def game_details(params):
    """Public store metadata, no login needed (same API the built-in Steam
    store uses). Richer facts are protocol 1.12; core sanitizes the HTML. The
    EULAs (protocol 1.11) come from PICS app info and need the login."""
    app = str(params["id"])
    try:
        data = api_get(f"https://store.steampowered.com/api/appdetails?appids={app}&l={steam_lang()}")
    except Exception:
        return {}
    if isinstance(data, dict) and data.get("_test"):
        data = data["_test"]
    entry = (data or {}).get(app)
    if not entry or not entry.get("success"):
        return {}
    d = entry.get("data") or {}
    out = {}
    if d.get("short_description"):
        out["summary"] = re.sub(r"<[^>]+>", " ", d["short_description"]).strip()
    if d.get("screenshots"):
        out["screenshots"] = [s.get("path_full") or s.get("path_thumbnail")
                              for s in d["screenshots"][:6] if isinstance(s, dict)]
    if d.get("genres"):
        out["genres"] = [g.get("description") for g in d["genres"][:4] if g.get("description")]
    if d.get("developers"):
        out["developers"] = d["developers"][:4]
    if d.get("publishers"):
        out["publishers"] = d["publishers"][:4]
    date = (d.get("release_date") or {}).get("date") or ""
    if date:
        out["releaseDate"] = date
    out["heroUrl"] = f"https://cdn.cloudflare.steamstatic.com/steam/apps/{app}/library_hero_2x.jpg"
    # Newer apps only have hashed asset paths: prefer the real hero URL
    # when GetItems names one. Best effort, never fails the details.
    try:
        art = resolve_art_assets([app], time.time() + 15)
        if art.get(app, {}).get("heroUrl"):
            out["heroUrl"] = art[app]["heroUrl"]
    except Exception:
        pass
    # Richer facts (protocol 1.12): raw store HTML/URLs; core validates.
    desc = d.get("detailed_description") or ""
    if d.get("about_the_game") and len(d["about_the_game"]) > len(desc):
        desc = d["about_the_game"]
    if desc:
        out["descriptionHtml"] = desc[:200000]
    if d.get("website"):
        out["website"] = d["website"]
    out["storeUrl"] = f"https://store.steampowered.com/app/{app}/"
    langs = _languages(d.get("supported_languages") or "")
    if langs:
        out["languages"] = langs
    if str(d.get("controller_support") or "").lower() in ("full", "partial"):
        out["controller"] = str(d["controller_support"]).lower()
    pc_min, pc_rec = _requirement_side(d.get("pc_requirements"))
    lx_min, lx_rec = _requirement_side(d.get("linux_requirements"))
    minimum, recommended = pc_min or lx_min, pc_rec or lx_rec
    if minimum or recommended:
        out["requirements"] = {k: v for k, v in (("minimum", minimum), ("recommended", recommended)) if v}
    try:
        age = int(str(d.get("required_age") or "0").strip())
    except ValueError:
        age = 0
    if age > 0:
        out["ageRating"] = f"{min(age, 21)}+"
    tags = [c.get("description") for c in (d.get("categories") or []) if isinstance(c, dict) and c.get("description")]
    if tags:
        out["tags"] = tags[:100]
    videos = []
    for m in (d.get("movies") or [])[:20]:
        if not isinstance(m, dict):
            continue
        url, mime = _movie_url(m)
        if not url:
            continue
        videos.append({k: v for k, v in (
            ("url", url), ("thumbnail", m.get("thumbnail") or ""),
            ("title", (m.get("name") or "")[:200]), ("mime", mime)) if v})
    if videos:
        out["videos"] = videos
    # Compat facts (protocol 1.10, "Compat"): this store knows the game's own
    # AppID and its platform flags. DRM stays absent: Steam doesn't state it,
    # and Platypus never shows a guessed badge.
    out["steamAppId"] = app
    platforms = _platforms(d.get("platforms"))
    if platforms:
        out["platforms"] = platforms
    # News (protocol 1.19): the game's own announcements, keyless and
    # cached; a failed read simply sends none.
    news = news_for_app(app)
    if news:
        out["news"] = news
    if params.get("terms"):
        terms = game_terms(app)
        if terms:
            out["terms"] = terms
    return {k: v for k, v in out.items() if v}


# --- uninstall -------------------------------------------------------------

def follow_uninstall(job_id, app, ev=None):
    if ev is not None:
        ev.wait(0.5)
    else:
        time.sleep(0.1)
    with jobs_lock:
        job = jobs.get(job_id, {})
        if job.get("canceled"):
            jobs.pop(job_id, None)
            return
    with installed_lock:
        installed = load_state("installed.json", {})
        ig = installed.pop(app, None)
        with jobs_lock:
            if jobs.get(job_id, {}).get("canceled"):
                jobs.pop(job_id, None)
                return
            jobs.pop(job_id, None)
        if ig and ig.get("path") and os.path.isdir(ig["path"]):
            shutil.rmtree(ig["path"], ignore_errors=True)
        save_state("installed.json", installed)
    notify("job.done", {"jobId": job_id})


def stop_proc(proc, grace=15):
    if proc is None:
        return
    try:
        proc.send_signal(signal.SIGINT)
        proc.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        proc.kill()
    except ProcessLookupError:
        pass


def job_cancel(params):
    with jobs_lock:
        job = jobs.get(params.get("jobId"))
        if job:
            job["canceled"] = True
            proc = job.get("proc")
            ev = job.get("event")
        else:
            proc, ev = None, None
    if ev is not None:
        ev.set()
    if proc:
        threading.Thread(target=stop_proc, args=(proc,), daemon=True).start()
    return {}


# --- discarding a canceled job's data ---------------------------------------
# Staging lives under $PLATYPUS_PLUGIN_DATA/jobs/<jobId>.{json,chunks} (written by
# platypus-steam-dl); start_job also leaves <jobId>.meta.json with the folder the
# job installs into, so job.discard knows what to delete after a restart.

JOB_ID_RE = re.compile(r"[A-Za-z0-9_-]{1,64}")


def jobs_dir():
    return os.path.join(data_dir(), "jobs")


def meta_file(job_id):
    return os.path.join(jobs_dir(), job_id + ".meta.json")


def write_job_meta(job_id, meta):
    try:
        os.makedirs(jobs_dir(), exist_ok=True)
        save_state(os.path.join("jobs", job_id + ".meta.json"), meta)
    except OSError as e:
        log("warn", f"couldn't record job {job_id}: {e}")


def drop_job_meta(job_id):
    try:
        os.unlink(meta_file(job_id))
    except OSError:
        pass


def inside(path, parent):
    """path is strictly below parent, links resolved."""
    path, parent = os.path.realpath(path), os.path.realpath(parent)
    return path != parent and path.startswith(parent + os.sep)


def installed_paths():
    out = []
    for entry in load_state("installed.json", {}).values():
        if entry.get("path"):
            out.append(os.path.realpath(entry["path"]))
    return out


def job_discard(params):
    """Deletes what a canceled job left: staged chunks and checkpoints, and,
    for an install that never finished, its half-written game folder. Never
    an installed game's folder, and never anything for an update: the game it
    updates stays."""
    job_id = params.get("jobId")
    if not isinstance(job_id, str) or not JOB_ID_RE.fullmatch(job_id):
        raise RPCError("invalid jobId", -32602)
    # The job may still be shutting down (discarding right after a cancel).
    job_cancel({"jobId": job_id})
    deadline = time.monotonic() + 90
    while True:
        with jobs_lock:
            running = job_id in jobs
        if not running:
            break
        if time.monotonic() > deadline:
            raise RPCError("the download is still stopping; try again in a moment")
        time.sleep(0.05)

    meta = load_state(os.path.join("jobs", job_id + ".meta.json"), {})
    kind = params.get("kind") or meta.get("kind") or "install"
    install_dir = params.get("installDir") or ""
    if kind == "install" and meta.get("dir"):
        game_dir = meta["dir"]
        # The recorded folder must be a subfolder of the install folder Platypus
        # named for this job, and not something that is installed.
        if (os.path.isabs(install_dir) and os.path.isabs(game_dir)
                and inside(game_dir, install_dir)
                and os.path.isdir(game_dir) and not os.path.islink(game_dir)
                and str(params.get("id", meta.get("app"))) not in load_state("installed.json", {})):
            real = os.path.realpath(game_dir)
            clash = [p for p in installed_paths() if p == real or p.startswith(real + os.sep) or real.startswith(p + os.sep)]
            if clash:
                log("warn", f"not deleting {game_dir}: it holds an installed game")
            else:
                shutil.rmtree(game_dir, ignore_errors=True)
    # Staging: only these three names under jobs/, built from the validated id.
    base = jobs_dir()
    shutil.rmtree(os.path.join(base, job_id + ".chunks"), ignore_errors=True)
    for suffix in (".json", ".json.new", ".meta.json"):
        try:
            os.unlink(os.path.join(base, job_id + suffix))
        except OSError:
            pass
    return {}


# --- social and chat (protocol 1.6/1.9) -------------------------------------
# Friends list, own status and one-to-one chat over one long-lived CM
# session. The session lives in platypus-steam-dl (the `social`
# subcommand, plan D1): this file starts it on social.start, stops it on
# social.stop, and turns its stdout lines into the protocol's
# social.*/chat.* notifications. Message text is passed through to core
# and never logged.
SOCIAL_STATES = ("online", "away", "busy", "snooze", "invisible")
# The status a fresh session goes online with, as the Steam client does
# (user decision, issue #7). The user can pick another with social.setStatus.
SOCIAL_DEFAULT_STATUS = "online"

social_lock = threading.Lock()
social_proc = None  # the live helper: {"proc", "pending", "next", "last_conn", "stopping"}
social_pending_playing = None  # setPlaying while the friends are off
social_tombstone = None  # "replaced"/"loggedOut": the store ended the session; only social.start clears it
LIBRARY_IDS = set()  # store ids from the last library.list, for game links


def social_game(g, installed):
    """A helper game {appid, title} to the protocol's {id?, title}."""
    appid = str((g or {}).get("appid") or "")
    title = str((g or {}).get("title") or "")
    if appid and (appid in LIBRARY_IDS or appid in installed):
        ref = {"id": f"p.steam-standalone.{appid}"}
        if title:
            ref["title"] = title
        return ref
    if title:
        return {"title": title}
    if appid:
        return {"title": f"App {appid}"}
    return None


def social_map_friend(f, installed):
    out = {"id": str(f.get("id") or ""), "name": str(f.get("name") or ""),
           "state": str(f.get("state") or "offline")}
    if f.get("avatarUrl"):
        out["avatarUrl"] = f["avatarUrl"]
    g = social_game(f.get("game") or {}, installed)
    if g is not None:
        out["game"] = g
    if f.get("lastSeen"):
        out["lastSeen"] = f["lastSeen"]
    return out


def social_map_friends(fs):
    installed = load_state("installed.json", {})
    return [social_map_friend(f, installed) for f in fs or []]


def social_spawn_locked(status):
    """Start the helper; callers hold social_lock. Needs a login."""
    global social_proc
    if not logged_in():
        raise RPCError(tr("need_login"), CODE_AUTH_REQUIRED)
    token = refresh_token()
    try:
        # stderr stays out of the JSON stream: a helper traceback lands in
        # the plugin's own stderr, which core captures in its logs.
        proc = subprocess.Popen([dl_bin(), "social"], stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE,
                                text=True, bufsize=1, env=dict(os.environ))
    except FileNotFoundError:
        raise RPCError("platypus-steam-dl is missing; reinstall the plugin")
    rec = {"proc": proc, "pending": {}, "next": 1,
           "last_conn": "connecting", "stopping": False, "fatal": None}
    try:
        proc.stdin.write(json.dumps({"refresh_token": token, "status": status}) + "\n")
        proc.stdin.flush()
    except (BrokenPipeError, OSError):
        raise RPCError("the Steam friends session failed to start")
    social_proc = rec
    threading.Thread(target=social_reader, args=(rec,), daemon=True).start()
    return rec


def social_reader(rec):
    """Route the helper's stdout: replies to their waiter, events to core."""
    global social_proc
    for line in rec["proc"].stdout:
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if not isinstance(msg, dict):
            continue
        if "id" in msg:
            if msg["id"] == 0 and msg.get("error"):
                # A startup failure (a rejected token answers -32001):
                # remember it and fail every waiter with it at EOF.
                with social_lock:
                    rec["fatal"] = msg["error"]
                continue
            with social_lock:
                box = rec["pending"].pop(msg["id"], None)
            if box is not None:
                box["reply"] = msg
                box["ev"].set()
        elif msg.get("event"):
            # One bad event never stops the routing: the handler is
            # guarded, and the log names no ids the push may carry.
            try:
                social_notify_event(rec, msg["event"], msg.get("params") or {})
            except Exception:
                log("warning", "a Steam social event couldn't be handled")
    with social_lock:
        global social_tombstone
        dead = social_proc is rec
        stopping = rec["stopping"]
        if dead:
            social_proc = None
        err = rec.get("fatal") or {"code": -32000,
                                    "message": "the Steam friends session ended"}
        pending = rec["pending"]
        rec["pending"] = {}
        if dead and not stopping and rec["last_conn"] in ("replaced", "loggedOut"):
            social_tombstone = rec["last_conn"]
    for box in pending.values():
        box["reply"] = {"error": err}
        box["ev"].set()
    # A helper that died on its own leaves the subscription stale: say
    # offline so the UI reflects it (a replaced/loggedOut session already
    # said so itself, and an explicit stop needs no word).
    if dead and not stopping and rec["last_conn"] not in ("replaced", "loggedOut"):
        notify("social.connection", {"state": "offline"})


def social_notify_event(rec, event, params):
    if event == "connection":
        rec["last_conn"] = params.get("state") or "offline"
        if not rec.get("stopping"):
            notify("social.connection", {"state": rec["last_conn"]})
    elif event == "self":
        notify("social.self", params)
    elif event == "friends":
        notify("social.friends", {"full": bool(params.get("full")),
                                  "friends": social_map_friends(params.get("friends") or [])})
    elif event == "message":
        notify("chat.message", params)
    elif event == "typing":
        notify("chat.typing", params)
    elif event == "unread":
        notify("chat.unread", params)
    elif event == "familyRunning":
        # The take-back signal from the social session's NotifyRunningApps
        # push: refresh the in-use list and warn once per take-back.
        family_running_event(params)


def social_call_rec(rec, op, params=None, timeout=30):
    """One helper round trip on a known-live record."""
    with social_lock:
        if rec.get("fatal"):
            raise RPCError(rec["fatal"].get("message") or "the Steam friends session failed",
                           rec["fatal"].get("code") or -32000)
        if rec["proc"].poll() is not None:
            raise RPCError("the Steam friends session ended", -32000)
        rid = rec["next"]
        rec["next"] += 1
        box = {"ev": threading.Event()}
        rec["pending"][rid] = box
        line = json.dumps({"id": rid, "op": op, "params": params or {}}) + "\n"
        try:
            rec["proc"].stdin.write(line)
            rec["proc"].stdin.flush()
        except (BrokenPipeError, OSError):
            rec["pending"].pop(rid, None)
            raise RPCError("the Steam friends session is not running", -32000)
    if not box["ev"].wait(timeout):
        with social_lock:
            rec["pending"].pop(rid, None)
        raise RPCError("Steam didn't answer in time", -32000)
    reply = box.get("reply") or {}
    err = reply.get("error") or {}
    if err:
        raise RPCError(err.get("message") or "the store refused the request",
                       err.get("code") or -32000)
    return reply.get("result") or {}


def social_ensure():
    """A live, synced session, starting one (with the saved status) when
    needed. Chat and status changes imply the friends are on: opening a
    conversation right after social.stop must work, not fail. The initial
    sync runs here so the friends exist before the chat call does."""
    with social_lock:
        rec = social_proc
        if rec is None or rec["proc"].poll() is not None:
            if social_tombstone in ("replaced", "loggedOut"):
                raise RPCError("the Steam friends session ended (%s)" % social_tombstone, -32000)
            rec = social_spawn_locked(social_default_status())
    social_call_rec(rec, "waitReady", {}, timeout=40)
    return rec


def social_mapped_snapshot(snap):
    return {"connection": snap.get("connection") or {"state": "offline"},
            "self": snap.get("self") or {},
            "friends": social_map_friends(snap.get("friends") or [])}


def social_default_status():
    saved = load_state("social.json", {})
    status = saved.get("status") or SOCIAL_DEFAULT_STATUS
    return status if status in SOCIAL_STATES else SOCIAL_DEFAULT_STATUS


def social_start(_params):
    global social_pending_playing, social_tombstone
    with social_lock:
        rec = social_proc
        if rec is None or rec["proc"].poll() is not None:
            social_tombstone = None
            rec = social_spawn_locked(social_default_status())
        pending = social_pending_playing
    snap = social_call_rec(rec, "waitReady", {}, timeout=45)
    notify("social.connection", (snap.get("connection") or {"state": "online"}))
    if snap.get("self"):
        notify("social.self", snap["self"])
    notify("social.friends", {"full": True,
                              "friends": social_map_friends(snap.get("friends") or [])})
    if pending is not None:
        with social_lock:
            social_pending_playing = None
        try:
            social_call_rec(rec, "setPlaying", {"id": pending}, timeout=20)
        except RPCError:
            pass
    return {}


def social_stop(_params):
    with social_lock:
        global social_proc
        rec = social_proc
        social_proc = None
        if rec is None:
            return {}
        rec["stopping"] = True
    # A clean stop logs the session off; a wedged helper is terminated.
    try:
        social_call_rec(rec, "stop", {}, timeout=10)
    except RPCError:
        pass
    stop_proc(rec["proc"], grace=3)
    return {}


def social_cleanup():
    """Stop the helper at plugin exit, with no notifications."""
    with social_lock:
        global social_proc
        rec = social_proc
        social_proc = None
        if rec is None:
            return
        rec["stopping"] = True
    try:
        social_call_rec(rec, "stop", {}, timeout=5)
    except RPCError:
        pass
    try:
        stop_proc(rec["proc"], grace=2)
    except Exception:
        pass


def social_state(_params):
    with social_lock:
        rec = social_proc
        if rec is None or rec["proc"].poll() is not None:
            return {"connection": {"state": "offline"}, "friends": []}
    return social_mapped_snapshot(social_call_rec(rec, "state", {}, timeout=15))


def social_set_status(params):
    state = ((params or {}).get("state") or "")
    if state not in SOCIAL_STATES:
        raise RPCError(f"invalid params: state {state!r} is not a status", -32602)
    social_call_rec(social_ensure(), "setStatus", {"state": state}, timeout=20)
    save_state("social.json", {"status": state})
    return {}


def social_set_playing(params):
    pid = (params or {}).get("id", None)
    if pid is not None and not isinstance(pid, str):
        raise RPCError("invalid params: id must be a store game id or null", -32602)
    if pid:
        # Client-mode games run under the real client, which reports
        # what they play itself; Platypus stays out of the way.
        ig = load_state("installed.json", {}).get(pid) or {}
        if ig.get("mode") == "client":
            return {}
    with social_lock:
        rec = social_proc
        if rec is None or rec["proc"].poll() is not None:
            # Core replays the running game when the friends turn on.
            global social_pending_playing
            social_pending_playing = pid
            return {}
    social_call_rec(rec, "setPlaying", {"id": pid}, timeout=20)
    return {}


def chat_history(params):
    friend = str((params or {}).get("friendId") or "")
    if not friend:
        raise RPCError("invalid params: friendId is required", -32602)
    return social_call_rec(social_ensure(), "history", {"friendId": friend,
                                   "before": (params or {}).get("before") or "",
                                   "limit": (params or {}).get("limit") or 50},
                       timeout=40)


def chat_send(params):
    friend = str((params or {}).get("friendId") or "")
    text = (params or {}).get("text") or ""
    client_id = (params or {}).get("clientId") or ""
    if not friend or not text or not client_id:
        raise RPCError("invalid params: friendId, text and clientId are required", -32602)
    return social_call_rec(social_ensure(), "send", {"friendId": friend, "text": text, "clientId": client_id},
                       timeout=40)


def chat_mark_read(params):
    friend = str((params or {}).get("friendId") or "")
    up_to = str((params or {}).get("upTo") or "")
    if not friend or not up_to:
        raise RPCError("invalid params: friendId and upTo are required", -32602)
    return social_call_rec(social_ensure(), "markRead", {"friendId": friend, "upTo": up_to}, timeout=20)


def chat_unread_counts(_params):
    # The snapshot only reflects a running session; never start one for
    # badges alone.
    with social_lock:
        rec = social_proc
        if rec is None or rec["proc"].poll() is not None:
            return {"counts": []}
    return social_call_rec(rec, "unreadCounts", {}, timeout=20)


def initialize(params):
    set_locale((params or {}).get("locale") or "en")
    offered = (params or {}).get("protocols") or []
    protocol = "1.21" if "1.21" in offered else ("1.19" if "1.19" in offered else (
        "1.18" if "1.18" in offered else ("1.17" if "1.17" in offered else "1.14")))
    return {"name": "Steam (standalone)", "version": "0.26.0", "api": API,
            "protocol": protocol,
            "capabilities": ["library", "install", "launch", "auth", "discard", "save-context", "terms", "versions", "family",
                             "verify", "achievements", "playtime", "cloud-saves", "social", "chat", "settings"],
            # Password branches unlock through their private-beta section,
            # proven live on real Steam (Valheim public-test, No Man's Sky
            # experimental: unlock, section gids, manifest code + download).
            "features": {"versions": {"channels": True, "builds": True, "password": True, "manual": True}},
            "missing": []}


def game_client_status(params):
    app = str((params or {}).get("id") or "")
    since = int((params or {}).get("since") or 0)
    home = os.path.expanduser("~")
    candidates = [os.path.join(home, ".local/share/Steam"), os.path.join(home, ".steam/steam"), os.path.join(home, ".var/app/com.valvesoftware.Steam/.local/share/Steam")]
    root = next((p for p in candidates if os.path.isdir(os.path.join(p, "steamapps"))), "")
    if not root or not app:
        return {"state": "launching"}
    status = "idle"
    try:
        with open(os.path.join(root, "logs", "console_log.txt"), "rb") as f:
            f.seek(max(0, os.fstat(f.fileno()).st_size - 4 * 1024 * 1024))
            lines = f.read().decode("utf-8", "replace").splitlines()
        for line in lines:
            added = re.search(r"Game process added : AppID ([0-9]+)\b", line)
            if added and added.group(1) == app:
                stamp = re.match(r"^\[([0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2})\]", line)
                if not since or (stamp and int(time.mktime(time.strptime(stamp.group(1), "%Y-%m-%d %H:%M:%S"))) >= since - 1):
                    status = "launching"
                continue
            match = re.search(r"GameAction \[AppID ([0-9]+), ActionID [0-9]+\] : LaunchApp changed task to ([A-Za-z]+)", line)
            if match and match.group(1) == app:
                stamp = re.match(r"^\[([0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2})\]", line)
                if since and (not stamp or int(time.mktime(time.strptime(stamp.group(1), "%Y-%m-%d %H:%M:%S"))) < since - 1):
                    continue
                task = match.group(2)
                status = {"CheckShaderDepotManifest": "shaders", "DownloadingDepots": "downloading", "SiteLicenseSeatCheckout": "launching", "DelayLaunch": "launching", "CreatingProcess": "launching", "WaitingGameWindow": "launching", "Completed": "launching"}.get(task, status)
    except OSError:
        return {"state": "launching"}
    acf = os.path.join(root, "steamapps", "appmanifest_" + app + ".acf")
    try:
        with open(acf, "r", encoding="utf-8", errors="replace") as f:
            data = f.read()
        total = int((re.search(r'"BytesToDownload"\s+"([0-9]+)"', data) or [None, "0"])[1])
        done = int((re.search(r'"BytesDownloaded"\s+"([0-9]+)"', data) or [None, "0"])[1])
        flags = int((re.search(r'"StateFlags"\s+"([0-9]+)"', data) or [None, "0"])[1])
        if flags & 131072:
            return {"state": "validating"}
        if total > 0 and done < total:
            return {"state": "updating", "bytes": done, "total": total, "progress": done / total}
        if status in ("downloading", "updating", "shaders") and flags & 4 and not flags & 2:
            status = "idle"
    except (OSError, ValueError):
        pass
    return {"state": status}

def game_save_context(params):
    app = str((params or {}).get("id") or "")
    home = os.path.expanduser("~")
    candidates = [os.path.join(home, ".local/share/Steam")]
    xdg_data = os.environ.get("XDG_DATA_HOME", "")
    if xdg_data and os.path.isabs(xdg_data):
        candidates.append(os.path.join(xdg_data, "Steam"))
    candidates.extend((os.path.join(home, ".steam/steam"),
                      os.path.join(home, ".var/app/com.valvesoftware.Steam/.local/share/Steam")))
    root = next((p for p in candidates
                 if os.path.isdir(os.path.join(p, "steamapps"))), "")
    result = {"roots": {"steam": root} if root else {}}
    if not root:
        return result
    userdata = os.path.join(root, "userdata")
    try:
        users = [p for p in os.listdir(userdata) if p.isdigit() and os.path.isdir(os.path.join(userdata, p))]
        if len(users) == 1:
            result["storeUserId"] = users[0]
    except OSError:
        pass
    prefix = os.path.join(root, "steamapps", "compatdata", app, "pfx")
    if app and os.path.isdir(prefix):
        result.update({"prefix": prefix, "windows": True, "proton": True, "winUser": "steamuser"})
    return result


# --- cloud saves (protocol 1.2) -------------------------------------------------
#
# Reads compare both sides; pulls download what changed only in the cloud
# (verified, backed up, baseline updated); pushes and `local` resolve choices
# upload what changed only on this device (quota-checked Steam batch flow,
# baseline updated, conflicts never uploaded).

def cloud_check(params, need_job):
    """The app id and CloudContext every cloud.* request carries. The exact
    -32602 shapes before any CM work, the way plugtest drives them."""
    app = str((params or {}).get("id") or "")
    try:
        app_id = int(app)
    except ValueError:
        raise RPCError("invalid params: id is required", -32602)
    if not app or not app_id:
        raise RPCError("invalid params: id is required", -32602)
    ctx = (params or {}).get("ctx")
    if not isinstance(ctx, dict) or ctx.get("os") not in ("linux", "windows"):
        raise RPCError("invalid params: ctx needs os (linux or windows), an absolute installDir and, for windows, an absolute prefixDir", -32602)
    if not isinstance(ctx.get("installDir"), str) or not os.path.isabs(ctx["installDir"]):
        raise RPCError("invalid params: ctx needs os (linux or windows), an absolute installDir and, for windows, an absolute prefixDir", -32602)
    if ctx["os"] == "windows" and (not isinstance(ctx.get("prefixDir"), str) or not os.path.isabs(ctx["prefixDir"])):
        raise RPCError("invalid params: ctx needs os (linux or windows), an absolute installDir and, for windows, an absolute prefixDir", -32602)
    job_id = (params or {}).get("jobId")
    if need_job and not job_id:
        raise RPCError("invalid params: jobId is required", -32602)
    return app, app_id, ctx, job_id


def cloud_unsupported(reason):
    """A cloud answer that runs no helper: the shape plugtest checks."""
    return {"state": "unsupported", "message": reason,
            "counts": {"same": 0, "download": 0, "upload": 0, "conflict": 0, "unmapped": 0},
            "conflicts": [], "checkedAt": int(time.time())}


def installed_mode(app):
    """The launch mode of an installed game (launch_spec reads the same
    record): only client-mode games can start through the real client."""
    return (load_state("installed.json", {}).get(app) or {}).get("mode") or ""


def cloud_run(op, app, app_id, ctx, job_id, choices, label):
    """One platypus-steam-dl cloud run: returns its status dict. Progress
    lines become cloud.progress notifications; the proc is tracked under
    the jobId so job.cancel stops it, and a repeated jobId answers from
    the helper's cached result."""
    mode = installed_mode(app)
    if mode == "client":
        # Steam syncs this game itself when it starts it: Platypus never
        # touches its saves.
        return cloud_unsupported("Steam syncs this game itself when it starts it")
    token = refresh_token()
    if not token:
        raise RPCError(tr("need_login"), CODE_AUTH_REQUIRED)
    req = {"refresh_token": token, "app_id": app_id, "op": op, "ctx": ctx}
    if job_id:
        req["job_id"] = job_id
    if choices is not None:
        req["choices"] = choices
    try:
        proc = subprocess.Popen([dl_bin(), "cloud"], stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, bufsize=1, env=dict(os.environ))
    except FileNotFoundError:
        raise RPCError("platypus-steam-dl is missing; reinstall the plugin")
    if job_id is not None:
        with jobs_lock:
            jobs[job_id] = {"id": app_id, "proc": proc}
    import collections as _collections
    text = _collections.deque(maxlen=20)
    result = None
    try:
        try:
            proc.stdin.write(json.dumps(req) + "\n")
            proc.stdin.close()
        except (BrokenPipeError, OSError):
            pass
        for line in proc.stdout:
            line = line.rstrip()
            text.append(line)
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if not isinstance(msg, dict):
                continue
            if msg.get("type") == "progress":
                notify("cloud.progress", {"id": app, "jobId": job_id,
                                          "phase": msg.get("phase") or "check",
                                          "done": msg.get("done") or 0,
                                          "total": msg.get("total") or 0})
            elif msg.get("type") == "result":
                result = msg.get("status")
            elif msg.get("type") == "error":
                if msg.get("code") == "auth-required":
                    raise RPCError(tr("need_login_expired"), CODE_AUTH_REQUIRED)
                message = msg.get("message") or tail(line)
                if message.startswith("invalid params"):
                    raise RPCError(message, -32602)
                raise RPCError("{}: {}".format(label, message), -32000)
    finally:
        with jobs_lock:
            jobs.pop(job_id, None)
        try:
            proc.wait()
        except Exception:
            pass
    if result is None:
        raise RPCError("{}: {}".format(label, tail("\n".join(text))), -32000)
    # The helper reports the store client running; only a client-mode game
    # can actually start through it.
    if isinstance(result, dict) and isinstance(result.get("client"), dict):
        result["client"]["canLaunch"] = (mode == "client")
    return result


def cloud_status(params):
    app, app_id, ctx, _ = cloud_check(params, False)
    return cloud_run("status", app, app_id, ctx, None, None, "Steam cloud")


def cloud_pull(params):
    app, app_id, ctx, job_id = cloud_check(params, True)
    return cloud_run("pull", app, app_id, ctx, job_id, None, "Steam cloud")


def cloud_push(params):
    app, app_id, ctx, job_id = cloud_check(params, True)
    return cloud_run("push", app, app_id, ctx, job_id, None, "Steam cloud")


def cloud_resolve(params):
    app, app_id, ctx, job_id = cloud_check(params, True)
    choices = (params or {}).get("choices")
    if not isinstance(choices, dict):
        raise RPCError("invalid params: choices are required", -32602)
    for path, side in choices.items():
        if side not in ("local", "remote"):
            raise RPCError("invalid params: choice for {!r} must be local or remote".format(path), -32602)
    return cloud_run("resolve", app, app_id, ctx, job_id, choices, "Steam cloud")


METHODS = {
    "initialize": initialize,
    "auth.status": auth_status,
    "auth.begin": auth_begin,
    "auth.complete": auth_complete,
    "auth.logout": auth_logout,
    "library.list": library_list,
    "game.details": game_details,
    "game.installSize": install_size,
    "game.install": lambda p: start_job(p, "install"),
    "game.update": lambda p: start_job(p, "update"),
    "game.uninstall": lambda p: start_job(p, "uninstall"),
    "game.verify": start_verify,
    "game.relocated": game_relocated,
    "achievements.list": achievements_list,
    "playtime.list": playtime_list,
    "versions.list": versions_list,
    "versions.unlock": versions_unlock,
    "job.cancel": job_cancel,
    "job.discard": job_discard,
    "game.launchSpec": launch_spec,
    "family.members": family_members,
    "family.setPreferredCopy": family_set_preferred_copy,
    "game.saveContext": game_save_context,
    "game.clientStatus": game_client_status,
    "social.start": social_start,
    "social.stop": social_stop,
    "social.state": social_state,
    "social.setStatus": social_set_status,
    "social.setPlaying": social_set_playing,
    "chat.history": chat_history,
    "chat.send": chat_send,
    "chat.markRead": chat_mark_read,
    "chat.unreadCounts": chat_unread_counts,
    "settings.schema": settings_schema,
    "settings.apply": settings_apply,
    "cloud.status": cloud_status,
    "cloud.pull": cloud_pull,
    "cloud.push": cloud_push,
    "cloud.resolve": cloud_resolve,
}


def handle(msg):
    fn = METHODS.get(msg.get("method"))
    resp = {"id": msg["id"]}
    if fn is None:
        resp["error"] = {"code": -32601, "message": f"method not found: {msg.get('method')}"}
    else:
        try:
            result = fn(msg.get("params") or {})
            resp["result"] = result if result is not None else {}
        except RPCError as e:
            resp["error"] = {"code": e.code, "message": str(e)}
        except (KeyError, TypeError) as e:
            resp["error"] = {"code": -32602, "message": f"invalid params: {e}"}
        except Exception as e:  # report, never crash the plugin
            resp["error"] = {"code": -32000, "message": f"{type(e).__name__}: {e}"}
    send(resp)


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError as e:
            send({"error": {"code": -32700, "message": str(e)}})
            continue
        if "id" not in msg:
            # Core→plugin notifications need no answer. locale.changed
            # (protocol 1.14) keeps texts in the user's language.
            if msg.get("method") == "locale.changed":
                set_locale((msg.get("params") or {}).get("locale") or "en")
            continue
        # Library listing and logins can take seconds; keep reading so
        # job.cancel stays responsive.
        threading.Thread(target=handle, args=(msg,), daemon=True).start()
    with jobs_lock:
        procs = [j.get("proc") for j in jobs.values()]
    for p in procs:
        stop_proc(p, grace=5)
    social_cleanup()


if __name__ == "__main__":
    main()
