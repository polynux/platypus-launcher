#!/usr/bin/env python3
"""Hydra store plugin for Steam without the Steam client, wrapping DepotDownloader.

Speaks Hydra's plugin protocol (api 1, docs/plugins/protocol.md): JSON-RPC 2.0
over stdin/stdout, one object per line. Downloads are done by the
`depotdownloader` CLI (SteamRE/DepotDownloader), which logs into Steam with the
user's own account and Steam Guard; the plugin never stores the password — it
feeds it to one DepotDownloader run, and the login key Steam issues afterwards
stays inside $HYDRA_PLUGIN_DATA, where the plugin points DepotDownloader's
profile.

Only what the logged-in account owns is installed, through Steam's own CDN,
with the account's own licence. No DRM or licence circumvention, and no Steam
API emulators: games that need the Steam client at runtime get the real
client, started hidden (`steam -silent`), and the game runs against it.

DepotDownloader facts that shape this plugin:
  - Credentials are prompted interactively ("Enter account password for ...",
    then a Steam Guard code), so the login run is driven through a pipe and
    the plugin feeds the answers Hydra collected.
  - -remember-password makes SteamKit persist the refresh token in .NET
    isolated storage ("account.config", a deflated protobuf). The plugin runs
    DepotDownloader with HOME=$HYDRA_PLUGIN_DATA/home, so that file lands in
    the plugin's private folder. The token is extracted (JWT scan) for the
    Steam Web API library listing, since DepotDownloader itself has no
    "list owned games".
  - Sizes: `-app <id> -manifest-only` dumps a text manifest with
    "Total bytes on disk / compressed" — manifests only, no game data.
  - Progress: per-file lines "  42.12% <path>" while downloading.
  - Installs are resumable: DepotDownloader records installed manifests in
    <dir>/.DepotDownloader/depot.config and skips chunks it already has.
"""

import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.request
import zlib

import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import steam_cm  # the CM session module, next to this file

API = 1
CODE_AUTH_REQUIRED = -32001
# Access tokens are cached until shortly before their JWT exp; Steam re-issue
# is one CM round trip when this lapses mid-session.
ACCESS_TOKEN_MARGIN = 300

PROGRESS_RE = re.compile(r"^\s*(\d{1,3}(?:\.\d+)?)%\s+(\S.*)$")
# -manifest-only dump: "Total bytes on disk : 123" / "Total bytes compressed : 456"
DISK_RE = re.compile(r"Total bytes on disk\s*:\s*(\d+)")
COMPRESSED_RE = re.compile(r"Total bytes compressed\s*:\s*(\d+)")
# SteamKit refresh tokens are JWTs inside account.config. Note the header
# segment does NOT necessarily start with "eyJ": Steam's JWT JSON contains
# spaces ("alg": "EdDSA"), so the base64 header begins "eyAi…" — anchor on
# the dot-separated base64url shape instead, and validate by decoding.
JWT_RE = re.compile(r"[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}")

out_lock = threading.Lock()
jobs_lock = threading.Lock()
jobs = {}  # jobId -> {"proc": Popen, "canceled": bool, ...}


class RPCError(Exception):
    def __init__(self, message, code=-32000):
        super().__init__(message)
        self.code = code


def send(msg):
    msg["jsonrpc"] = "2.0"
    line = json.dumps(msg, separators=(",", ":"))
    with out_lock:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()


def notify(method, params):
    send({"jsonrpc": "2.0", "method": method, "params": params})


def log(level, message):
    notify("log", {"level": level, "message": message})


def data_dir():
    d = os.environ.get("HYDRA_PLUGIN_DATA") or os.path.join(os.path.expanduser("~"), ".hydra-steam-standalone")
    os.makedirs(d, exist_ok=True)
    return d


def tail(text, n=3):
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    return " · ".join(lines[-n:]) if lines else "no output"


# DepotDownloader keeps its login tokens in .NET isolated storage created
# under the current user's profile. Running it with HOME pointed inside the
# plugin's private data folder keeps the login key out of the user's real
# profile (and out of Hydra's view), per the protocol's "credentials stay
# with the plugin or the tool it wraps".
def dd_env():
    env = dict(os.environ)
    home = os.path.join(data_dir(), "home")
    os.makedirs(home, exist_ok=True)
    env["HOME"] = home
    env["DOTNET_CLI_HOME"] = home
    env["XDG_DATA_HOME"] = os.path.join(home, ".local/share")
    env["DOTNET_NOLOGO"] = "1"
    env["DOTNET_CLI_TELEMETRY_OPTOUT"] = "1"
    return env


def depotdownloader_login(args, feed, timeout=600):
    """Runs DepotDownloader with stdin fed: `feed` is [(pattern, answer)]; the
    first pattern matching a prompt line gets the answer, once."""
    try:
        p = subprocess.Popen(["depotdownloader", *args], stdin=subprocess.PIPE,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             text=True, bufsize=1, env=dd_env())
    except FileNotFoundError:
        raise RPCError("depotdownloader is not installed; get the linux-x64 binary from "
                       "github.com/SteamRE/DepotDownloader/releases")
    # The prompts come without a trailing newline, so reading stdout
    # line-wise to decide when to answer would deadlock. Write the answers
    # upfront and close stdin instead: DepotDownloader only reads stdin when
    # it prompts, and an unexpected prompt hits EOF and fails fast instead
    # of hanging.
    try:
        for _pat, answer in feed:
            p.stdin.write(answer + "\n")
        p.stdin.flush()
        p.stdin.close()
    except (BrokenPipeError, OSError):
        pass
    out = []
    for line in p.stdout:
        line = line.rstrip()
        out.append(line)
    try:
        rc = p.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        p.kill()
        raise RPCError("login timed out")
    return rc, "\n".join(out)


def depotdownloader_simple(args, timeout=900):
    try:
        p = subprocess.run(["depotdownloader", *args], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=timeout,
                           env=dd_env())
    except FileNotFoundError:
        raise RPCError("depotdownloader is not installed; get the linux-x64 binary from "
                       "github.com/SteamRE/DepotDownloader/releases")
    except subprocess.TimeoutExpired:
        raise RPCError("depotdownloader timed out")
    return p.returncode, p.stdout, p.stderr


# --- persisted state ------------------------------------------------------

def state_path(name):
    return os.path.join(data_dir(), name)


def load_state(name, default):
    try:
        with open(state_path(name)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_state(name, state):
    with open(state_path(name), "w") as f:
        json.dump(state, f)


def account_config():
    """DepotDownloader's persisted credentials file, if a login left one.

    .NET isolated storage has no fixed layout: the real DepotDownloader
    writes `…/.local/share/IsolatedStorage/<id>/<id>/<hash>/AssemFiles/
    account.config` (capital I), while older/dotnet-runtime variants used
    lowercase `isolated-storage` — so don't guess paths, just walk the
    whole plugin HOME looking for the file name."""
    home = os.path.join(data_dir(), "home")
    if not os.path.isdir(home):
        return None
    for dirpath, _dirs, files in os.walk(home):
        if "account.config" in files:
            return os.path.join(dirpath, "account.config")
    return None


def refresh_pairs(text):
    """(account name, refresh token) pairs from account.config's LoginTokens
    entries: a submessage carrying the account name right before the JWT.
    DD keys its stored tokens by account name (-username for later runs)."""
    out = []
    for token_match in JWT_RE.finditer(text):
        head = text[:token_match.start()]
        # The name is the last printable run before the token's field marks.
        m = re.search(r"[\x21-\x7e]{2,64}(?=[^\x20-\x7e]{0,4}$)", head)
        name = m.group(0) if m else ""
        # Length bytes are printable too (0x21..0x7e); a glued length shows
        # up as a stray leading char, and Steam account names are
        # word-shaped, so trim to the last word-ish chunk.
        tail_name = re.search(r"[A-Za-z0-9][A-Za-z0-9_ -]{1,63}$", name)
        name = tail_name.group(0) if tail_name else name
        out.append((name, token_match.group(0)))
    return out


def refresh_token():
    """The SteamKit refresh token the login persisted, extracted from
    account.config (deflated protobuf; JWTs are readable strings in it) and
    cached. Used for the CM token exchange, which feeds the Web API."""
    st = load_state("token.json", {})
    path = account_config()
    # The cache is only trusted while the store file hasn't changed since
    # it was taken — a fresh login must re-extract even if an older token
    # (or an empty store from an interrupted save) is cached. The account
    # name (DD's -username for later runs) is part of what's extracted:
    # an entry without it is stale (from before the field existed).
    if (st.get("refresh_token") and st.get("account") is not None
            and st.get("source") == (path, os.path.getmtime(path) if path else None)):
        return st["refresh_token"]
    if not path:
        return None
    try:
        with open(path, "rb") as f:
            blob = f.read()
        try:
            blob = zlib.decompress(blob)
        except zlib.error:
            try:
                blob = zlib.decompress(blob, -15)  # .NET raw DeflateStream
            except zlib.error:
                pass  # newer builds may store it uncompressed
        text = blob.decode("utf-8", "ignore")
        matches = JWT_RE.findall(text)
        if not matches:
            return None
        st["refresh_token"] = matches[-1]  # the newest token
        # The LoginTokens key: the account name DD expects in -username for
        # every later run (the phone's QR login stores it there too).
        for name, token in reversed(refresh_pairs(text)):
            if token == st["refresh_token"] and name:
                st["account"] = name
                break
        else:
            st["account"] = st.get("account", "")
        st["source"] = [path, os.path.getmtime(path)]
        save_state("token.json", st)
        return st["refresh_token"]
    except OSError:
        return None


# --- QR login ---------------------------------------------------------------
# DepotDownloader -qr prints the login QR as Unicode block-art on stdout
# (one module = two U+2588 chars wide, one row tall, "█" = dark module) and
# waits for the Steam mobile app to approve it. Steam periodically expires and
# refreshes the challenge URL, so DepotDownloader can print a NEW QR while
# running ("The QR code has changed:") — the plugin keeps reading and always
# exposes the latest art through auth.status, and the dialog redraws it. After
# approval DepotDownloader prints "Success!" and persists the login key into
# its isolated storage; we consider the login done then (not on process exit,
# which is non-zero because -app is a dummy), kill the process and let
# auth.status pick the login up.

LOGINID = "2718281"  # fixed LogonID so logins never kick a running Steam client

# QR login background state: the depotdownloader -qr process, its latest art
# and its result.
qr_lock = threading.Lock()
qr_proc = {"proc": None, "rc": None}
qr_art = {"text": None}                      # latest block-art, for auth.status
qr_state = {"state": "idle", "error": None}  # idle|pending|ok|failed


def art_modules_wide(rows):
    """Module count across a block-art QR block: two chars per module. Rows
    share a leading quiet zone, whose size comes from the most-indented row;
    the width comes from the widest row with trailing spaces trimmed (some
    row always has a dark module at the true right edge, so the trimmed
    maximum is the full art width, as the dialog's renderer also assumes).
    Trailing LIGHT modules don't exist beyond that edge."""
    full = [r for r in rows if r.strip()]
    if not full:
        return 0
    lead = min(len(r) - len(r.lstrip(" ")) for r in full)
    width = max(len(r.rstrip()) for r in full) - lead
    if width % 2:
        width += 1
    return width // 2


def config_stamp():
    """Identity of the persisted credential store, to notice a fresh login."""
    path = account_config()
    if not path:
        return None
    try:
        with open(path, "rb") as f:
            return (path, hash(f.read()))
    except OSError:
        return None


def start_qr_login():
    """Starts `depotdownloader -qr` in the background, tracking its QR art.
    Returns (art text or None, error or None)."""
    stop_qr_login()
    with qr_lock:
        qr_art["text"] = None
        qr_state.update(state="pending", error=None)
    stamp_before = config_stamp()
    try:
        proc = subprocess.Popen(
            ["depotdownloader", "-app", "0", "-qr", "-remember-password",
             "-loginid", LOGINID],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, bufsize=0, env=dd_env())
    except FileNotFoundError:
        with qr_lock:
            qr_state.update(state="failed",
                            error="depotdownloader is not installed; get the linux-x64 binary from github.com/SteamRE/DepotDownloader/releases")
        return None, qr_state["error"]
    qr_proc["proc"] = proc
    ready = threading.Event()
    rows = []   # current block-art lines ("█" = dark module)
    tail = []   # everything else, for error messages
    ok = threading.Event()
    started = time.time()

    def watch():
        # Reads the raw byte pipe and splits on newlines itself: a text-mode
        # iterator stalls until its internal buffer fills, which would
        # swallow the tail of the QR art.
        import select as _select
        fd = proc.stdout  # unbuffered byte pipe (bufsize=0)
        pend = b""

        def handle(text):
            # Both headers open a fresh art block: the first code prints
            # "Use the Steam Mobile App…", a refreshed one (Steam expires
            # the challenge URL) prints "The QR code has changed:" —
            # without clearing here the new rows would be glued onto the
            # old art and nothing scannable would ever be served.
            if "Use the Steam Mobile App to sign in with this QR code:" in text or "The QR code has changed:" in text:
                rows.clear()
            elif "\u2588" in text:
                rows.append(text.rstrip())
                publish_if_complete()
            else:
                if text.startswith("Success!"):
                    ok.set()
                publish_if_complete()  # blank line closes the art block
                tail.append(text)
            if config_stamp() != stamp_before:  # token store changed
                ok.set()
            # A second approval of the SAME code must not fail: if the token
            # store was already updated for this identity (config unchanged
            # since before the scan, but it existed and is newer than this
            # login's start), Steam simply re-issued the stored key.
            if not ok.is_set() and stamp_before is None and account_config() is not None:
                age = max(0, time.time() - os.path.getmtime(account_config()))
                if age < 60:
                    ok.set()

        def publish_if_complete():
            # DepotDownloader prints no terminator after the art (the next
            # thing it prints may be much later, e.g. "Success!"), so don't
            # wait for one: a QR is square, so the block is complete as soon
            # as the row count equals the module count per row (29 for the
            # real Steam code, 21 for the fake). Publishing earlier than
            # that served truncated codes with their bottom rows missing.
            if len(rows) < 21 or len(rows) != art_modules_wide(rows):
                return
            with qr_lock:
                qr_art["text"] = "\n".join(rows)
            ready.set()

        while not ok.is_set():
            r, _, _ = _select.select([fd], [], [], 0.5)
            if r:
                chunk = os.read(fd.fileno(), 65536)
                if not chunk:
                    break  # EOF
                pend += chunk
                while b"\n" in pend:
                    line, pend = pend.split(b"\n", 1)
                    handle(line.decode("utf-8", "replace").rstrip("\r"))
            elif pend:
                handle(pend.decode("utf-8", "replace").rstrip("\r"))
                pend = b""
            elif proc.poll() is not None:
                break

        if ok.is_set():
            # Approved. Don't stop the process before the token store is
            # usable: DepotDownloader prints "Success!" BEFORE it writes
            # the token store (Steam3Session prints, then sets LoginTokens,
            # then calls Save), and .NET's Save() creates account.config
            # EMPTY first and writes the deflated content after — stopping
            # in between leaves a 0-byte file and the library loses its
            # token. So wait until the file exists AND yields a token; DD
            # exits by itself right after saving (non-zero, the dummy app
            # run) — that's expected and not an error.
            for _ in range(120):  # up to 60s
                if refresh_token() or proc.poll() is not None:
                    break
                time.sleep(0.5)
            if proc.poll() is None and not refresh_token():
                # Never got a readable key: stop DD the hard way as a last
                # resort but don't pretend the token exists.
                proc.kill()
            save_state("session.json", {"account": "steam"})
            # QR: the account name is learned by refresh_token() from the
            # LoginTokens key; make sure token.json has it before DD uses it.
            refresh_token()
            with qr_lock:
                qr_state.update(state="ok", error=None)
                qr_proc["proc"] = None
            return
        rc = proc.wait()
        detail = " ".join(t.strip() for t in tail[-4:] if t.strip()) if tail else "no output"
        if config_stamp() != stamp_before:
            ok.set()
            with qr_lock:
                qr_state.update(state="ok", error=None)
                qr_proc["proc"] = None
            return
        # "Failed to authenticate with Steam: …" / "Lost connection to
        # Steam" are CM-side flakiness, not a wrong password — the plugin
        # retries the whole run once so a scan the phone approved isn't
        # wasted on a dropped connection.
        transient = rc != 0 and time.time() - started < 120 and (
            "Failed to authenticate" in detail or "Lost connection" in detail
            or "Unable to get steam3 credentials" in detail)
        with qr_lock:
            if transient and not qr_proc.get("retried"):
                qr_proc["retried"] = True
                qr_proc["proc"] = None
                qr_state.update(state="idle", error=None)
            else:
                qr_proc["rc"] = rc
                qr_state.update(state="failed", error=(
                    f"DepotDownloader QR login exited with {rc}: {detail}"
                    if rc else "DepotDownloader QR login ended without logging in: " + detail))
        if transient and not qr_state.get("error"):
            log("warn", "Steam connection dropped during QR login; retrying once")
            time.sleep(2)
            start_qr_login()

    threading.Thread(target=watch, daemon=True).start()
    # The first QR prints within a few seconds; wait for it here so auth.begin
    # can hand the dialog a complete prompt.
    if not ready.wait(15):
        with qr_lock:
            err = qr_state.get("error")
        if err:
            return None, err
        stop_qr_login()
        return None, "QR code didn't appear in time; try the password login below"
    with qr_lock:
        return qr_art["text"], None


def stop_qr_login():
    with qr_lock:
        proc = qr_proc.pop("proc", None)
        qr_proc["rc"] = None
        qr_state.update(state="idle", error=None)
        qr_art["text"] = None
    if proc and proc.poll() is None:
        proc.kill()


def logged_in():
    # session.json is written only after a login succeeded; account.config
    # may vanish for reasons outside the session (corrupt store, logout in
    # another instance), so don't couple the reported login to the key file.
    return bool(state_user()) or account_config() is not None


def state_user():
    return load_state("session.json", {}).get("account") or ""


# --- Steam Web API --------------------------------------------------------

def api_get(url, token=None):
    # Test hook: tests point this at a file with the responses, so nothing
    # reaches the network. Not set in normal runs. The file may carry
    # "_routes": {substring: response} so different endpoints can answer
    # differently; without it the file answers every call (older tests).
    hook = os.environ.get("HYDRA_STEAM_API_FILE")
    if hook:
        with open(hook) as f:
            data = json.load(f)
        for frag, resp in (data.get("_routes") or {}).items():
            if frag in url:
                return resp
        return data
    # Access tokens go as the access_token query parameter (like the Steam
    # client does); a refresh token was never accepted there.
    if token:
        sep = "&" if "?" in url else "?"
        url = f"{url}{sep}access_token={token}"
    req = urllib.request.Request(url)
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read().decode())


STORE_TTL = 30 * 86400  # names and types of released apps rarely change
STORE_BUDGET = 20  # seconds of Store lookups per library.list; the rest waits for the next rescan
store_lock = threading.Lock()
store_cache = None  # app id -> {"name", "type", "at"}, mirrors store-apps.json


def store_cached(app_id):
    """The cached Store details for an app, {} when missing or stale."""
    global store_cache
    with store_lock:
        if store_cache is None:
            store_cache = load_state("store-apps.json", {})
        entry = store_cache.get(str(app_id)) or {}
    return entry if time.time() - entry.get("at", 0) < STORE_TTL else {}


def store_app(app_id, fetch=True):
    """Public app details (name, type) from the Steam Store API, cached on
    disk: a library scan asks about every owned game, one request each. No
    login needed; {} when the app isn't listed (bad id, region lock) or, with
    fetch=False, not cached yet. Misses aren't cached."""
    entry = store_cached(app_id)
    if entry or not fetch:
        return entry
    try:
        data = api_get(f"https://store.steampowered.com/api/appdetails?appids={app_id}&filters=basic")
    except Exception:
        return {}
    if isinstance(data, dict) and data.get("_test"):
        data = data["_test"]
    entry = (data or {}).get(str(app_id))
    if not entry or not entry.get("success"):
        return {}
    details = entry.get("data") or {}
    keep = {"name": details.get("name") or "", "type": details.get("type") or "", "at": time.time()}
    with store_lock:
        store_cache[str(app_id)] = keep
    return keep


def save_store_cache():
    with store_lock:
        if store_cache is not None:
            save_state("store-apps.json", store_cache)


def auth_status(_params=None):
    if logged_in():
        # The persona name (from GetPlayerSummaries, saved by library.list)
        # when known, else the login's account name ("steam" for QR logins).
        user = load_state("session.json", {}).get("persona") or state_user()
        out = {"loggedIn": True, "user": user} if user else {"loggedIn": True}
        return out
    out = {"loggedIn": False}
    with qr_lock:
        if qr_state["state"] == "pending" and qr_art["text"]:
            out["qr"] = qr_art["text"]  # the dialog redraws it when it changes
    return out


def auth_begin(_params):
    qr, err = start_qr_login()
    instructions = ("Scan the QR code with the Steam mobile app (Steam Guard → scan) "
                    "and just wait — the dialog closes by itself. The code refreshes "
                    "by itself when it expires. Or log in below; your password and "
                    "the Steam Guard code go to DepotDownloader only and are never "
                    "stored, and the login key Steam issues stays in this plugin's "
                    "private data folder.")
    if err and not qr:
        instructions = f"QR login unavailable: {err}\n\n{instructions}"
    return {
        "instructions": instructions,
        "qr": qr,
        "fields": [
            {"id": "username", "label": "Steam account name (empty = I scanned the QR)",
             "placeholder": "your Steam login, or empty for QR login"},
            {"id": "password", "label": "password", "secret": True},
            {"id": "guard", "label": "Steam Guard code — only if your account asks for one",
             "secret": True, "placeholder": "5 characters, or leave empty"},
        ],
    }


def auth_complete(params):
    fields = ((params or {}).get("fields") or {})
    username = (fields.get("username") or "").strip()
    password = fields.get("password") or ""
    guard = (fields.get("guard") or "").strip()
    if not username and not password:
        # Empty form = "I scanned the QR code": wait for the background
        # DepotDownloader to be approved by the phone and finish.
        return wait_qr_login()
    if not username or not password:
        raise RPCError("enter your Steam account name and password")
    stop_qr_login()
    # One DepotDownloader run with -remember-password: it asks for the
    # password on stdin, then possibly a Steam Guard code, and persists the
    # login key into the isolated storage under our HOME. `-app 0` validates
    # the login without downloading anything.
    feed = [(r"Enter account password", password)]
    if guard:
        feed.append((r"2 factor auth code|authentication code", guard))
    depotdownloader_login(["-app", "0", "-username", username,
                           "-remember-password", "-manifest-only",
                           "-loginid", LOGINID], feed)
    token = refresh_token()
    if not token:
        raise RPCError("login failed: DepotDownloader didn't persist a login key. "
                       "Check the account name and password, and try again with a fresh "
                       "Steam Guard code.")
    save_state("session.json", {"account": username})
    # The token store carries the same name for later runs (dd_login_args).
    st = load_state("token.json", {})
    st["account"] = username
    save_state("token.json", st)
    return auth_status()


def wait_qr_login(timeout=300):
    """Waits for the background -qr DepotDownloader to be approved (the phone
    confirmed) and reports the result, like a password login."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        with qr_lock:
            state, err = qr_state["state"], qr_state["error"]
        if state == "ok":
            stop_qr_login()
            return auth_status()
        if state == "failed":
            stop_qr_login()
            raise RPCError("the QR login was rejected or failed: " + err)
        time.sleep(0.5)
    stop_qr_login()
    raise RPCError("nobody scanned the QR code in time; try again")


def auth_logout(_params):
    stop_qr_login()
    # Wipe the whole private data folder so no login key, guard data or
    # cached token survives.
    shutil.rmtree(data_dir(), ignore_errors=True)
    os.makedirs(data_dir(), exist_ok=True)
    return {"loggedIn": False}


# --- access token (CM exchange) ---------------------------------------------
#
# The refresh token DepotDownloader persists is a SteamClient token: the Web
# API rejects it with 401, and GenerateAccessTokenForApp refuses it over
# plain REST (AccessDenied, since 2025-04-30). It only works from an
# authenticated CM session, so the plugin logs on to a CM itself
# (steam_cm.py) once per access-token lifetime and calls the Web API with
# the derived access token afterwards.

cm_lock = threading.Lock()


def jwt_exp(token):
    try:
        return int(steam_cm.jwt_payload(token).get("exp") or 0)
    except (ValueError, KeyError, IndexError):
        return 0


def access_token():
    """The access token for the Web API, from the cache while it lasts, else
    from a fresh CM logon with the persisted refresh token.

    CODE_AUTH_REQUIRED is raised only when there's no refresh token at all or
    Steam says it's invalid/expired/revoked — every other failure is a normal
    error that surfaces its real message, so the Library never shows "logged
    out" for a network hiccup."""
    st = load_state("steam-access.json", {})
    token = st.get("access_token") or ""
    if token and jwt_exp(token) - ACCESS_TOKEN_MARGIN > time.time():
        return token
    refresh = refresh_token()
    if not refresh:
        raise RPCError("no Steam session available; log in again", CODE_AUTH_REQUIRED)
    with cm_lock:
        # Re-check inside the lock: a concurrent library.list may have
        # exchanged already.
        st = load_state("steam-access.json", {})
        token = st.get("access_token") or ""
        if token and jwt_exp(token) - ACCESS_TOKEN_MARGIN > time.time():
            return token
        try:
            token = steam_cm.exchange(refresh)
        except steam_cm.CMError as e:
            if e.auth:
                raise RPCError(f"Steam rejected the stored login key ({e}); log in again",
                               CODE_AUTH_REQUIRED)
            raise RPCError(str(e))
        save_state("steam-access.json", {"access_token": token,
                                         "exp": jwt_exp(token)})
        return token


# Library calls run in threads; persona lookups must not repeat per call.
persona_lock = threading.Lock()


def persona_name(steamid):
    """The account's public persona name, for auth.status — from the CM
    session itself (Player.GetPlayerLinkDetails#1), since the Web API's
    GetPlayerSummaries now demands an API key. Saved in session.json; an
    empty result is a non-fatal miss (profiles can be private)."""
    with persona_lock:
        st = load_state("session.json", {})
        if st.get("persona"):
            return st["persona"]
    try:
        token = access_token()  # cached; opens one CM session if needed
        session = steam_cm.CMSession(int(steamid), refresh_token())
        try:
            body = session.call("Player.GetPlayerLinkDetails#1",
                                steam_cm.pb_msg(1, steam_cm.pb_int(1, int(steamid))))
        finally:
            session.logoff()
        link = steam_cm.pb_parse(steam_cm.pb_parse(body).get(1, [b""])[0])
        pub = steam_cm.pb_parse(link.get(1, [b""])[0])
        name = pub.get(10, [b""])[0].decode("utf-8", "replace")  # persona_name
    except Exception:
        return ""
    if name:
        with persona_lock:
            st = load_state("session.json", {})
            st["persona"] = name
            save_state("session.json", st)
    return name



def library_list(_params):
    if not logged_in():
        raise RPCError("log in to Steam first", CODE_AUTH_REQUIRED)
    token = access_token()
    steamid = steam_cm.jwt_payload(token).get("sub")
    try:
        # steamid is a routing parameter: without it the Web API answers
        # 400 "missing required routing parameter" for token auth.
        data = api_get("https://api.steampowered.com/IPlayerService/GetOwnedGames/v0001/"
                       f"?include_appinfo=1&include_played_free_games=1&steamid={steamid}", token)
    except Exception as e:
        raise RPCError(f"Steam Web API is unreachable: {e}")
    games = (data.get("response") or {}).get("games") or []
    persona_name(steamid)  # best effort, for auth.status
    installed = load_state("installed.json", {})
    out = []
    deadline = time.time() + STORE_BUDGET
    for g in games:
        app = str(g.get("appid") or "")
        if not app:
            continue
        store = store_app(app, fetch=time.time() < deadline)
        entry = {
            "id": app,
            "title": store.get("name") or g.get("name") or f"App {app}",
            "installed": app in installed,
            "installable": True,
        }
        if app in installed:
            ig = installed[app]
            entry["installPath"] = ig.get("path", "")
            entry["version"] = ig.get("version", "")
            if ig.get("native"):
                entry["native"] = True
            entry["note"] = mode_note(ig.get("mode") or "none")
        if store:
            entry["coverUrl"] = f"https://cdn.cloudflare.steamstatic.com/steam/apps/{app}/library_600x900_2x.jpg"
            entry["heroUrl"] = f"https://cdn.cloudflare.steamstatic.com/steam/apps/{app}/library_hero_2x.jpg"
            entry["bannerUrl"] = f"https://cdn.cloudflare.steamstatic.com/steam/apps/{app}/header.jpg"
        # Tools, movies, music etc. aren't depot installs Hydra can run.
        app_type = (store.get("type") or "").lower()
        if app_type and app_type not in ("game", "demo", "beta", "application"):
            entry["installable"] = False
            entry["note"] = f"This entry is a {app_type}, not a game."
        out.append(entry)
    save_store_cache()
    for app, ig in installed.items():  # installed but missing from the owned list
        if not any(e["id"] == app for e in out):
            out.append({
                "id": app, "title": ig.get("title") or f"App {app}",
                "installable": False, "installed": True,
                "installPath": ig.get("path", ""),
                "native": True if ig.get("native") else False,
                "note": mode_note(ig.get("mode") or "none"),
            })
    return {"games": out}


def mode_note(mode):
    """What the game page says about how the game launches."""
    return {
        "none": "Launch mode: no Steamworks — runs directly, fully without Steam.",
        "optional": "Launch mode: Steamworks present but optional — runs directly with SteamAppId set.",
        "client": "Launch mode: needs the Steam client — Hydra starts the real client hidden.",
    }.get(mode, "")


CELL_RE = re.compile(r'"CellIDServerOverride"\s+"(\d+)"')


def dd_cell_args():
    """-cellid for downloads: DepotDownloader picks a content server on its
    own, which can be a slow one. HYDRA_STEAM_CELLID wins; otherwise the
    download region the user set in the Steam client (CellIDServerOverride in
    its config.vdf). Nothing when neither is set: DepotDownloader decides."""
    cell = os.environ.get("HYDRA_STEAM_CELLID", "").strip()
    if not cell.isdigit():
        cell = ""
        for rel in (".local/share/Steam/config/config.vdf", ".steam/steam/config/config.vdf"):
            try:
                with open(os.path.join(os.path.expanduser("~"), rel)) as f:
                    m = CELL_RE.search(f.read())
            except OSError:
                continue
            if m:
                cell = m.group(1)
                break
    return ["-cellid", cell] if cell and int(cell) > 0 else []


def dd_max_downloads():
    """Parallel chunk downloads. DepotDownloader defaults to 8; a content
    server that throttles each connection is helped by more. HYDRA_STEAM_MAX_DOWNLOADS
    overrides."""
    n = os.environ.get("HYDRA_STEAM_MAX_DOWNLOADS", "").strip()
    return n if n.isdigit() and int(n) > 0 else "24"


def dd_login_args():
    """The -username/-remember-password pair that makes DepotDownloader reuse
    the stored login key: tokens are keyed by account name, and DD refuses
    -remember-password without a username (its own message). The name comes
    from the login (password logins know it, QR logins read it from the
    LoginTokens key in account.config)."""
    name = load_state("token.json", {}).get("account") or state_user()
    return ["-username", name, "-remember-password"] if name else []


def install_size(params):
    """Depot sizes from -manifest-only: the real DepotDownloader dumps one
    manifest_<depot>_<id>.txt per depot into -dir (the sizes are in the
    files, not stdout); manifests only, no game data. Linux depots first,
    Windows fallback — the same order an install uses."""
    app = str(params["id"])
    d = os.path.join(data_dir(), "sizes", app)
    disk = compressed = 0
    auth_failed = False
    text = ""
    for osname in ("linux", "windows"):
        # Start clean: a previous run's dumps must not be counted again.
        if os.path.isdir(d):
            for f in os.listdir(d):
                if f.startswith("manifest_"):
                    os.unlink(os.path.join(d, f))
        rc, out, err = depotdownloader_simple(
            ["-app", app, "-manifest-only", "-os", osname, *dd_login_args(), "-dir", d],
            timeout=900)
        text = out + err
        if rc != 0:
            if re.search(r"not available from this account|Unable to get steam3 credentials|Insufficient privileges", text, re.IGNORECASE):
                auth_failed = True
                break
            # a real failure; not just "no depots for this platform"
            if not re.search(r"Couldn't find any depots to download|No depot", text, re.IGNORECASE):
                break
            continue  # try the next platform
        for f in os.listdir(d):
            if not f.startswith("manifest_"):
                continue
            with open(os.path.join(d, f)) as fh:
                for line in fh:
                    if DISK_RE.search(line):
                        disk += int(DISK_RE.search(line).group(1))
                    m = COMPRESSED_RE.search(line)
                    if m:
                        compressed += int(m.group(1))
        if disk:
            break  # this platform has the depots; sizes are for it
    if disk == 0:
        if auth_failed:
            raise RPCError("log in to Steam first", CODE_AUTH_REQUIRED)
        if text:
            raise RPCError(f"couldn't get the size for app {app}: {tail(text)}")
        raise RPCError(f"depotdownloader produced no manifest sizes for app {app}")
    return {"downloadBytes": compressed, "diskBytes": disk}


# --- jobs ------------------------------------------------------------------

def start_job(params, kind):
    app, job_id = str(params["id"]), params["jobId"]
    if kind == "uninstall":
        if app not in load_state("installed.json", {}):
            raise RPCError(f"app {app} is not installed")
        threading.Thread(target=follow_uninstall, args=(job_id, app), daemon=True).start()
        return {}
    install_dir = params.get("installDir") or ""
    if not os.path.isabs(install_dir):
        raise RPCError("installDir is missing or relative; Hydra always sends one")
    # One folder per game under Hydra's install dir, like steamapps/common/<name>.
    game_dir = os.path.join(install_dir, game_dir_name(app))
    os.makedirs(game_dir, exist_ok=True)
    threading.Thread(target=follow_install, args=(job_id, app, game_dir), daemon=True).start()
    return {}


def game_dir_name(app):
    installed = load_state("installed.json", {})
    if app in installed and installed[app].get("dir_name"):
        return installed[app]["dir_name"]
    name = store_app(app).get("name") or f"app_{app}"
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", name).strip("_") or f"app_{app}"
    return safe


def follow_install(job_id, app, game_dir):
    """DepotDownloader run with progress; Linux depots first, Windows fallback
    (most Steam games ship Windows only; the platform used decides `native`)."""
    with jobs_lock:
        jobs[job_id] = {"canceled": False, "id": app, "dir": game_dir}
    base = ["-app", app, "-dir", game_dir, *dd_login_args(), *dd_cell_args(), "-max-downloads", dd_max_downloads()]
    os_used, last_text = None, ""
    for osname in ("linux", "windows"):
        with jobs_lock:
            if jobs.get(job_id, {}).get("canceled"):
                return
        proc = subprocess.Popen(["depotdownloader", *base, "-os", osname],
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True, bufsize=1,
                                env=dd_env())
        with jobs_lock:
            jobs[job_id]["proc"] = proc
        state = {"jobId": job_id, "phase": "downloading", "percent": 0}
        text = []
        for line in proc.stdout:
            line = line.rstrip()
            text.append(line)
            m = PROGRESS_RE.match(line)
            if m:
                state["percent"] = float(m.group(1))
                notify("job.progress", dict(state))
        rc = proc.wait()
        last_text = "\n".join(text)
        if rc == 0:
            os_used = osname
            break
        if not re.search(r"Couldn't find any depots to download|No depot", last_text, re.IGNORECASE):
            break  # a real failure (auth, network), not just "no Linux depots"
    with jobs_lock:
        job = jobs.pop(job_id, {})
    if job.get("canceled"):
        return
    if os_used is None:
        if re.search(r"not available from this account|Unable to get steam3 credentials|Insufficient privileges", last_text, re.IGNORECASE):
            notify("job.failed", {"jobId": job_id, "error": "log in to Steam first (the session expired)"})
        else:
            notify("job.failed", {"jobId": job_id, "error": f"depotdownloader failed: {tail(last_text)}"})
        return
    record_install(app, game_dir, os_used)
    notify("job.done", {"jobId": job_id})


def record_install(app, game_dir, os_used):
    """Remember the install: where it is, what runs it and which launch mode
    applies (see launch modes below)."""
    exe = find_executable(game_dir, native=os_used == "linux")
    installed = load_state("installed.json", {})
    installed[app] = {
        "path": game_dir,
        "dir_name": os.path.basename(game_dir),
        "executable": exe,
        "native": os_used == "linux",
        "mode": detect_mode(game_dir),
        "version": "",
        "title": store_app(app).get("name") or "",
    }
    save_state("installed.json", installed)


def is_elf(path):
    try:
        with open(path, "rb") as f:
            return f.read(4) == b"\x7fELF"
    except OSError:
        return False


def find_executable(game_dir, native=False):
    """The game's entry point: a Linux binary/script (native builds), or the
    biggest .exe in the root (Steam Windows builds ship many helper exes).
    Depots don't always mark the Linux binary executable, so a pick that
    isn't gets its owner exec bit here."""
    if native:
        exe = find_native_executable(game_dir)
        if exe:
            return exe
    best, size = "", 0
    try:
        for entry in os.scandir(game_dir):
            if not entry.is_file():
                continue
            name = entry.name
            lower = name.lower()
            if lower.endswith((".exe",)) and not lower.startswith(
                    ("uninst", "setup", "redist", "dxsetup", "vcredist", "dotnet")):
                s = entry.stat().st_size
                if s > size:
                    best, size = entry.path, s
            elif lower.endswith(".sh") and os.access(entry.path, os.X_OK) and not best:
                best = entry.path
    except OSError:
        pass
    return best


def find_native_executable(game_dir):
    """A start script (.sh) in the root, else the biggest ELF binary there
    (shared libraries and installers excluded)."""
    script, elf, size = "", "", 0
    try:
        for entry in sorted(os.scandir(game_dir), key=lambda e: e.name):
            if not entry.is_file():
                continue
            lower = entry.name.lower()
            if lower.endswith(".sh"):
                script = script or entry.path
            elif not re.search(r"\.so(\.\d+)*$", lower) and not lower.startswith(("unins", "setup", "install")):
                s = entry.stat().st_size
                if s > size and is_elf(entry.path):
                    elf, size = entry.path, s
    except OSError:
        return ""
    best = script or elf
    if best and not os.access(best, os.X_OK):
        try:
            os.chmod(best, os.stat(best).st_mode | 0o100)
        except OSError:
            return ""
    return best


# --- launch modes ----------------------------------------------------------
#
# 1. "none"    No Steamworks dependency (no steam_api*.dll / libsteam_api.so
#              anywhere in the install): launch directly. Fully launcher-free.
# 2. "optional" Steamworks files exist, but most such games only use them for
#              achievements or overlay and run fine when SteamAPI_Init fails:
#              launch directly with SteamAppId/SteamGameId set so the game
#              doesn't try to relaunch itself through Steam.
# 3. "client"  The game needs the real client (fatal SteamAPI_Init failure or
#              Steam's DRM wrapper): Hydra starts the real Steam client
#              hidden (`steam -silent`) and asks it to start the game; the
#              game runs against the live client for its licence check and
#              achievements. No Steam API emulators, ever.
#
# 2 vs 3 can't be told apart reliably by inspection. The plugin tries direct
# first; if the game dies within seconds with a Steamworks init error
# (Hydra's session tracker reports it), retrying on the game page marks it
# "needs client" and mode 3 is used from then on. Community data plugins can
# pre-seed that flag.

STEAMWORKS_RE = re.compile(r"^(steam_api(64)?\.dll|libsteam_api\.so(\.\d+)*)$", re.IGNORECASE)


def has_steamworks(game_dir):
    try:
        for _root, _dirs, files in os.walk(game_dir):
            for f in files:
                if STEAMWORKS_RE.match(f):
                    return True
    except OSError:
        pass
    return False


def detect_mode(game_dir):
    if not has_steamworks(game_dir):
        return "none"
    return "optional"


def launch_spec(params):
    app = str(params["id"])
    installed = load_state("installed.json", {})
    ig = installed.get(app)
    if not ig:
        raise RPCError(f"app {app} is not installed")
    path, exe = ig.get("path") or "", ig.get("executable") or ""
    if not exe or not os.path.isfile(exe):
        exe = find_executable(path, native=bool(ig.get("native")))
        if not exe:
            raise RPCError(f"couldn't find a game executable in {path or 'the install folder'}")
        ig["executable"] = exe
        save_state("installed.json", installed)
    mode = ig.get("mode") or "none"
    native = bool(ig.get("native"))
    if mode in ("none", "optional"):
        spec = {
            "exe": exe,
            "args": [],
            "cwd": os.path.dirname(exe),
            "env": {},
            "needsWine": not native,
            "native": native,
        }
        if mode == "optional":
            # Tell the game which app it is so SteamAPI_Init-less runs don't
            # try to relaunch through Steam. SteamAppId/SteamGameId are not
            # on Hydra's launch-env denylist (only STEAM_COMPAT_* are).
            spec["env"]["SteamAppId"] = app
            spec["env"]["SteamGameId"] = app
        return spec
    # mode == "client": the real client, started hidden. Hydra runs the
    # command and follows the game through find.cmdline (Steam's reaper marks
    # the game process with AppId=<id>), so session tracking works.
    return {
        "delegate": "store-client",
        "client": "Steam",
        "command": ["steam", "-silent", "-applaunch", app],
        "find": {"cmdline": [f"AppId={app}"]},
        "startTimeout": 300,
    }


def mark_needs_client(params):
    """After a mode-'optional' game died with a Steamworks init error, the
    game page's retry calls this; the next launch uses the real client."""
    app = str((params or {}).get("id") or "")
    installed = load_state("installed.json", {})
    if app not in installed:
        raise RPCError(f"app {app} is not installed")
    installed[app]["mode"] = "client"
    save_state("installed.json", installed)
    return {"ok": True}


def game_details(params):
    """Public store metadata, no login needed (same API the built-in Steam
    store uses)."""
    app = str(params["id"])
    try:
        data = api_get(f"https://store.steampowered.com/api/appdetails?appids={app}&l=english")
    except Exception:
        return {}
    if isinstance(data, dict) and data.get("_test"):
        data = data["_test"]
    entry = (data or {}).get(app)
    if not entry or not entry.get("success"):
        return {}
    d = entry.get("data") or {}
    out = {}
    if d.get("short_description"):
        out["summary"] = re.sub(r"<[^>]+>", " ", d["short_description"]).strip()
    if d.get("screenshots"):
        out["screenshots"] = [s.get("path_full") or s.get("path_thumbnail")
                              for s in d["screenshots"][:6] if isinstance(s, dict)]
    if d.get("genres"):
        out["genres"] = [g.get("description") for g in d["genres"][:4] if g.get("description")]
    if d.get("developers"):
        out["developers"] = d["developers"][:4]
    if d.get("publishers"):
        out["publishers"] = d["publishers"][:4]
    date = (d.get("release_date") or {}).get("date") or ""
    if date:
        out["releaseDate"] = date
    out["heroUrl"] = f"https://cdn.cloudflare.steamstatic.com/steam/apps/{app}/library_hero_2x.jpg"
    return {k: v for k, v in out.items() if v}


# --- uninstall -------------------------------------------------------------

def follow_uninstall(job_id, app):
    time.sleep(0.1)
    installed = load_state("installed.json", {})
    ig = installed.pop(app, None)
    if ig and ig.get("path") and os.path.isdir(ig["path"]):
        shutil.rmtree(ig["path"], ignore_errors=True)
    save_state("installed.json", installed)
    notify("job.done", {"jobId": job_id})


def stop_proc(proc, grace=15):
    if proc is None:
        return
    try:
        proc.send_signal(signal.SIGINT)
        proc.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        proc.kill()
    except ProcessLookupError:
        pass


def job_cancel(params):
    with jobs_lock:
        job = jobs.get(params.get("jobId"))
        if job:
            job["canceled"] = True
            proc = job.get("proc")
        else:
            proc = None
    if proc:
        threading.Thread(target=stop_proc, args=(proc,), daemon=True).start()
    return {}


# --- dispatch --------------------------------------------------------------

def initialize(params):
    return {"name": "Steam (standalone)", "version": "0.1.0", "api": API,
            "capabilities": ["library", "install", "launch", "auth"], "missing": []}


METHODS = {
    "initialize": initialize,
    "auth.status": auth_status,
    "auth.begin": auth_begin,
    "auth.complete": auth_complete,
    "auth.logout": auth_logout,
    "library.list": library_list,
    "game.details": game_details,
    "game.installSize": install_size,
    "game.install": lambda p: start_job(p, "install"),
    "game.update": lambda p: start_job(p, "install"),
    "game.uninstall": lambda p: start_job(p, "uninstall"),
    "job.cancel": job_cancel,
    "game.launchSpec": launch_spec,
}


def handle(msg):
    fn = METHODS.get(msg.get("method"))
    resp = {"id": msg["id"]}
    if fn is None:
        resp["error"] = {"code": -32601, "message": f"method not found: {msg.get('method')}"}
    else:
        try:
            result = fn(msg.get("params") or {})
            resp["result"] = result if result is not None else {}
        except RPCError as e:
            resp["error"] = {"code": e.code, "message": str(e)}
        except (KeyError, TypeError) as e:
            resp["error"] = {"code": -32602, "message": f"invalid params: {e}"}
        except Exception as e:  # report, never crash the plugin
            resp["error"] = {"code": -32000, "message": f"{type(e).__name__}: {e}"}
    send(resp)


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError as e:
            send({"error": {"code": -32700, "message": str(e)}})
            continue
        if "id" not in msg:
            continue  # notifications need no answer
        # Library listing and logins can take seconds; keep reading so
        # job.cancel stays responsive.
        threading.Thread(target=handle, args=(msg,), daemon=True).start()
    with jobs_lock:
        procs = [j.get("proc") for j in jobs.values()]
    for p in procs:
        stop_proc(p, grace=5)


if __name__ == "__main__":
    main()
